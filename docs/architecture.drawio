<mxfile host="app.diagrams.net" type="device">
  <diagram id="page1" name="1. Компоненты">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1" value="&lt;b&gt;Текущая система vitauto1c&lt;/b&gt; — сервер UUU2 (Windows Server 2019), состояние на 28.10.2026" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1180" height="30" as="geometry"/></mxCell>
        <mxCell id="p2" value="Сервер UUU2" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=none;rounded=0;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1180" height="760" as="geometry"/></mxCell>
        <mxCell id="p3" value="&lt;b&gt;Тонкий клиент 1С&lt;/b&gt; (1cv8c)&lt;br&gt;пользователи ИБ: Автосервис (без пароля),&lt;br&gt;arm.*, Администратор, xorit" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p2"><mxGeometry x="20" y="50" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="p4" value="&lt;b&gt;Браузер&lt;/b&gt;&lt;br&gt;PWA АРМ: http://127.0.0.1:5173&lt;br&gt;вход — пользователь ИБ 1С (Basic)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p2"><mxGeometry x="300" y="50" width="250" height="80" as="geometry"/></mxCell>
        <mxCell id="p5" value="&lt;b&gt;PWA — Vite dev-сервер :5173&lt;/b&gt;&lt;br&gt;pwa/ (Vue 3 + Pinia), npm run dev:vitauto&lt;br&gt;прокси /odata → :8090/vitauto/odata/standard.odata&lt;br&gt;убирает WWW-Authenticate у 401&lt;br&gt;Node 22 portable (не служба, не в PATH)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="p2"><mxGeometry x="600" y="50" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="p6" value="&lt;b&gt;Apache 2.4.66 win32 :8090&lt;/b&gt;&lt;br&gt;D:\1c\apache\httpd-1c.conf (+ 1c-publish-*.conf)&lt;br&gt;модуль 1С: wsap24.dll (_1cws_module)&lt;br&gt;публикации (default.vrd, standardOdata):&lt;br&gt;  /vitauto → localhost\vitauto&lt;br&gt;  /autoservice → localhost\autoservice&lt;br&gt;запуск вручную (не служба)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p2"><mxGeometry x="600" y="200" width="300" height="140" as="geometry"/></mxCell>
        <mxCell id="p7" value="&lt;b&gt;Сервер 1С:Предприятие 8.3.27.2342 (x86)&lt;/b&gt;&lt;br&gt;служба «1C:Enterprise 8.3 Server Agent»&lt;br&gt;ragent :1540, rmngr :1541, rphost :1560–1591&lt;br&gt;кластер «Локальный кластер», каталог C:\srvinfo" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2"><mxGeometry x="20" y="200" width="530" height="80" as="geometry"/></mxCell>
        <mxCell id="p8" value="&lt;b&gt;ИБ vitauto — РАБОЧАЯ&lt;/b&gt;&lt;br&gt;Автосервис 3.0.11.169&lt;br&gt;расширения: EF_00_00185532 (патч),&lt;br&gt;АРМЗакупокИПродаж, АРМ_OData 1.1&lt;br&gt;11 пользователей ИБ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2"><mxGeometry x="30" y="290" width="200" height="110" as="geometry"/></mxCell>
        <mxCell id="p9" value="&lt;b&gt;ИБ autoservice&lt;/b&gt;&lt;br&gt;опубликована /autoservice" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2"><mxGeometry x="245" y="290" width="140" height="110" as="geometry"/></mxCell>
        <mxCell id="p10" value="&lt;b&gt;ИБ autoservice_main&lt;/b&gt;&lt;br&gt;копия из дампа (тесты PWA)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p2"><mxGeometry x="400" y="290" width="140" height="110" as="geometry"/></mxCell>
        <mxCell id="p11" value="&lt;b&gt;RAS :1545&lt;/b&gt;&lt;br&gt;ras.exe cluster — для rac&lt;br&gt;(запускается вручную)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="p2"><mxGeometry x="600" y="380" width="300" height="60" as="geometry"/></mxCell>
        <mxCell id="p12" value="&lt;b&gt;PostgreSQL 1C 18&lt;/b&gt; — служба postgresql-1c-18&lt;br&gt;порт &lt;b&gt;5433&lt;/b&gt; (не 5432), данные D:\PostgreSQL 1C\18\data&lt;br&gt;postgresql-1c-15 (C:\PGDATA15) — остановлен" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p2"><mxGeometry x="20" y="450" width="530" height="70" as="geometry"/></mxCell>
        <mxCell id="p13" value="vitauto&lt;br&gt;1,9 ГБ" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p2"><mxGeometry x="40" y="540" width="120" height="80" as="geometry"/></mxCell>
        <mxCell id="p14" value="autoservice&lt;br&gt;1,9 ГБ" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p2"><mxGeometry x="210" y="540" width="120" height="80" as="geometry"/></mxCell>
        <mxCell id="p15" value="autoservice_main&lt;br&gt;1,6 ГБ" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p2"><mxGeometry x="380" y="540" width="140" height="80" as="geometry"/></mxCell>
        <mxCell id="p16" value="&lt;b&gt;Бэкапы&lt;/b&gt; D:\1c_bases\backup&lt;br&gt;backup-1c-full.ps1:&lt;br&gt;  &amp;lt;база&amp;gt;_&amp;lt;дата&amp;gt;.dump (pg_dump -Fc)&lt;br&gt;  &amp;lt;база&amp;gt;_&amp;lt;дата&amp;gt;\&amp;lt;база&amp;gt;.cf / .dt&lt;br&gt;  settings.json, BACKUP-REPORT.txt" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p2"><mxGeometry x="600" y="480" width="300" height="110" as="geometry"/></mxCell>
        <mxCell id="p17" value="&lt;b&gt;Скрипты репозитория&lt;/b&gt;&lt;br&gt;install-1c-pgsql.ps1 — PG + 1С + база&lt;br&gt;  (-SourceDump / -SourceDt)&lt;br&gt;install_Apache.ps1 — модули веб-сервера 1С&lt;br&gt;checkApacheOdata.ps1 — Apache + публикация&lt;br&gt;restore-1c-pgsql.ps1 — дамп в существующую базу&lt;br&gt;backup-1c-full.ps1 — дамп + .cf/.dt + настройки&lt;br&gt;odata/grant-arm-roles.ps1 — роли arm.*&lt;br&gt;odata/enable-odata.ps1 — состав OData&lt;br&gt;pwa/ — клиент PWA" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="p2"><mxGeometry x="930" y="50" width="230" height="220" as="geometry"/></mxCell>
        <mxCell id="p18" value="&lt;b&gt;Права в OData&lt;/b&gt;&lt;br&gt;роли Арм_* не дают «Чтение» регистров АРМ;&lt;br&gt;читать Арм_ДанныеЗакупокИПродаж может&lt;br&gt;только ПолныеПрава → arm.* без неё&lt;br&gt;получают 401 (см. страницу 2, TODO)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p2"><mxGeometry x="930" y="300" width="230" height="110" as="geometry"/></mxCell>
        <mxCell id="p19" value="TCP 1541" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p3" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p20" value="HTTP :5173" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21" value="/odata → /vitauto/odata (Basic)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p22" value="wsap24 → 1541" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p6" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p23" value="libpq :5433" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7" target="p12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p24" value="rac localhost:1545" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p25" value="pg_dump" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p16" target="p12"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page2" name="2. Запрос PWA">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="PWA1" value="&lt;b&gt;Путь запроса PWA → OData 1С&lt;/b&gt; (вход arm.manager; почему 401)" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="PWA2" value="&lt;b&gt;1. Браузер&lt;/b&gt;&lt;br&gt;форма входа PWA&lt;br&gt;Authorization: Basic (UTF-8)&lt;br&gt;первый запрос: регистр АРМ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="PWA3" value="&lt;b&gt;2. Vite :5173&lt;/b&gt;&lt;br&gt;прокси /odata&lt;br&gt;нет 1С → 502 api_unavailable&lt;br&gt;у 401 убирает WWW-Authenticate" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="230" y="60" width="190" height="90" as="geometry"/></mxCell>
        <mxCell id="PWA4" value="&lt;b&gt;3. Apache :8090&lt;/b&gt;&lt;br&gt;/vitauto → default.vrd&lt;br&gt;SetEnvIf: переносит только Bearer,&lt;br&gt;Basic идёт в 1С как есть" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="450" y="60" width="200" height="90" as="geometry"/></mxCell>
        <mxCell id="PWA5" value="&lt;b&gt;4. wsap24 → сервер 1С&lt;/b&gt;&lt;br&gt;standardOdata: reuseSessions=autouse,&lt;br&gt;poolSize=10, sessionMaxAge=20&lt;br&gt;сеанс ODataConnection" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="210" height="90" as="geometry"/></mxCell>
        <mxCell id="PWA6" value="Пользователь ИБ и пароль верны?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="200" width="170" height="100" as="geometry"/></mxCell>
        <mxCell id="PWA7" value="&lt;b&gt;HTTP 401&lt;/b&gt;&lt;br&gt;журнал: Сеанс.Ошибка аутентификации&lt;br&gt;PWA: «неверный логин или пароль»" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="930" y="210" width="220" height="80" as="geometry"/></mxCell>
        <mxCell id="PWA8" value="Есть право «Чтение» на объект?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="700" y="340" width="170" height="100" as="geometry"/></mxCell>
        <mxCell id="PWA9" value="&lt;b&gt;HTTP 401&lt;/b&gt; (не 403)&lt;br&gt;журнал: Доступ.Отказ в доступе «Чтение»&lt;br&gt;PWA показывает то же «неверный пароль»&lt;br&gt;причина: у ролей Арм_* нет прав на&lt;br&gt;Арм_ДанныеЗакупокИПродаж / КомандыPWA" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="930" y="345" width="240" height="100" as="geometry"/></mxCell>
        <mxCell id="PWA10" value="&lt;b&gt;HTTP 200 JSON&lt;/b&gt;&lt;br&gt;данные из PostgreSQL vitauto (:5433)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="700" y="490" width="170" height="60" as="geometry"/></mxCell>
        <mxCell id="PWA11" value="PostgreSQL&lt;br&gt;vitauto" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="735" y="590" width="100" height="70" as="geometry"/></mxCell>
        <mxCell id="PWA12" value="&lt;b&gt;Кто может читать регистры АРМ&lt;/b&gt; (28.10.2026)&lt;br&gt;ПолныеПрава — чтение и запись всех трёх&lt;br&gt;Арм_Пользователь / Арм_ОсновнаяРоль /&lt;br&gt;Арм_Администратор — ничего&lt;br&gt;временно: grant-arm-roles.ps1 -FullRights&lt;br&gt;правильно: права в ролях расширений (TODO)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="330" width="330" height="120" as="geometry"/></mxCell>
        <mxCell id="PWA13" value="&lt;b&gt;Команды АРМ&lt;/b&gt; (АРМ_OData v1.1)&lt;br&gt;POST InformationRegister_АрмOData_КомандыPWA&lt;br&gt;{Ид, Команда, Параметры} → ПередЗаписью&lt;br&gt;выполняет код АРМ в сеансе пользователя PWA:&lt;br&gt;ВРаботе, СтатусСнабжения, ПровестиЗаказ, СоздатьЗаказ" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="330" height="110" as="geometry"/></mxCell>
        <mxCell id="PWA14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PWA2" target="PWA3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="PWA15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PWA3" target="PWA4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="PWA16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PWA4" target="PWA5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="PWA17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PWA5" target="PWA6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="PWA18" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PWA6" target="PWA7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="PWA19" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PWA6" target="PWA8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="PWA20" value="нет" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PWA8" target="PWA9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="PWA21" value="да" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="PWA8" target="PWA10"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="PWA22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;endArrow=none;dashed=1;" edge="1" parent="1" source="PWA10" target="PWA11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="PWA23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="PWA9" target="PWA12"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page3" name="3. Бэкап и развёртывание">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="p1" value="&lt;b&gt;Копия vitauto на новой машине с нуля&lt;/b&gt; (docs/DEPLOY-LOCAL.md)" style="text;html=1;fontSize=16;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1100" height="30" as="geometry"/></mxCell>
        <mxCell id="p2" value="Текущий сервер UUU2" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=none;rounded=0;fontStyle=1;fillColor=#f8cecc;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="360" height="560" as="geometry"/></mxCell>
        <mxCell id="p3" value="Новая машина (Windows x64, диск D:, PowerShell от администратора)" style="swimlane;whiteSpace=wrap;html=1;startSize=28;fillColor=none;rounded=0;fontStyle=1;fillColor=#dae8fc;swimlaneFillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="400" y="40" width="760" height="560" as="geometry"/></mxCell>
        <mxCell id="p4" value="&lt;b&gt;A1. Свежий дамп&lt;/b&gt; (без блокировки)&lt;br&gt;backup-1c-full.ps1 -Database vitauto&lt;br&gt;  -IbName vitauto -PgPort 5433 -NoCfg&lt;br&gt;→ D:\1c_bases\backup\vitauto_&amp;lt;дата&amp;gt;.dump&lt;br&gt;+ settings.json (кластер, публикации)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p2"><mxGeometry x="20" y="50" width="320" height="110" as="geometry"/></mxCell>
        <mxCell id="p5" value="&lt;b&gt;A2. Перенести файлы&lt;/b&gt; в D:\1c новой машины&lt;br&gt;обязательно: vitauto_&amp;lt;дата&amp;gt;.dump&lt;br&gt;по желанию (иначе скачаются):&lt;br&gt;  windows_8_3_27_2342.rar (платформа)&lt;br&gt;  PostgreSQL_1C_18.4_64bit_Setup.exe&lt;br&gt;  httpd-2.4.66-251206-win32-vs17.zip" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="p2"><mxGeometry x="20" y="200" width="320" height="130" as="geometry"/></mxCell>
        <mxCell id="p6" value="&lt;b&gt;Что в дампе&lt;/b&gt; (проверено 28.10.2026:&lt;br&gt;дамп → временная БД, сравнение таблиц)&lt;br&gt;v8users — пользователи, пароли, роли&lt;br&gt;_commonsettings / _systemsettings /&lt;br&gt;_frmdtsettings — настройки пользователей&lt;br&gt;config, _extensionsinfo — конфигурация,&lt;br&gt;расширения (патч, АРМ, АРМ_OData 1.1)&lt;br&gt;_odatasettings — состав OData" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="p2"><mxGeometry x="20" y="370" width="320" height="160" as="geometry"/></mxCell>
        <mxCell id="p7" value="&lt;b&gt;B0.&lt;/b&gt; git clone → C:\Bases1C\vitauto1c&lt;br&gt;дамп и архивы → D:\1c" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="p3"><mxGeometry x="20" y="50" width="340" height="50" as="geometry"/></mxCell>
        <mxCell id="p8" value="&lt;b&gt;B1. install-1c-pgsql.ps1&lt;/b&gt; -Force -SourceDump D:\1c\vitauto_&amp;lt;дата&amp;gt;.dump&lt;br&gt;  -IbName vitauto -IbTitle vitauto -ExtensionFile '' -AdminUser ''&lt;br&gt;  -IbUser Автосервис -NoSeed&lt;br&gt;шаг 0: удаление прошлой установки 1С этой версии&lt;br&gt;шаг 1–3: платформа (WEBSERVEREXT=1), PostgreSQL 18, служба 1С&lt;br&gt;шаг 4: CREATE DATABASE + pg_restore + CREATEINFOBASE CrSQLDB=N&lt;br&gt;расширения не перегружаются — остаются из дампа" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="p3"><mxGeometry x="20" y="120" width="720" height="130" as="geometry"/></mxCell>
        <mxCell id="p9" value="&lt;b&gt;B2. checkApacheOdata.ps1&lt;/b&gt;&lt;br&gt;(по умолчанию vitauto → /vitauto, Автосервис)&lt;br&gt;Apache win32 → D:\1c\apache, httpd-1c.conf,&lt;br&gt;webinst + default.vrd, запуск, проверка OData" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="p3"><mxGeometry x="20" y="270" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="p10" value="&lt;b&gt;B2a.&lt;/b&gt; только если платформа стояла&lt;br&gt;раньше без модулей веб-сервера:&lt;br&gt;install_Apache.ps1 (WEBSERVEREXT=1)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="p3"><mxGeometry x="400" y="270" width="340" height="100" as="geometry"/></mxCell>
        <mxCell id="p11" value="&lt;b&gt;B3. PWA&lt;/b&gt;&lt;br&gt;Node.js 22 LTS → cd pwa → npm ci&lt;br&gt;npm run dev:vitauto → http://127.0.0.1:5173" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="p3"><mxGeometry x="20" y="390" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="p12" value="&lt;b&gt;B4. Проверки&lt;/b&gt;&lt;br&gt;OData /vitauto: Автосервис → 200&lt;br&gt;регистр АРМ $count = как на сервере&lt;br&gt;вход 1С тем же пользователем и паролем" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="p3"><mxGeometry x="400" y="390" width="340" height="80" as="geometry"/></mxCell>
        <mxCell id="p13" value="&lt;b&gt;B5. По желанию:&lt;/b&gt; запрет регламентных заданий копии&lt;br&gt;(обмены/рассылки не должны идти из копии) — rac infobase update&lt;br&gt;--scheduled-jobs-deny=on" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="p3"><mxGeometry x="20" y="490" width="720" height="55" as="geometry"/></mxCell>
        <mxCell id="p14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p15" value="копирование" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p5" target="p7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p7" target="p8"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p8" target="p9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p10" target="p9"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p9" target="p11"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="p11" target="p12"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p21" value="всё это приезжает с дампом" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;endArrow=open;" edge="1" parent="1" source="p6" target="p8"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
