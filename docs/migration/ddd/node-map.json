{
 "about": "Ручная часть DDD: контексты, агрегаты, события и сопоставление каждого узла process.html с командой, API, событием, уведомлением, этапом плана и тестами. Генератор tools/migration/ddd-gen.mjs соединяет её с domain-model.json; тесты tools/migration/tests проверяют полноту.",
 "contexts": [
  {"id": "intake", "title": "Приём заявок", "type": "core", "owns": ["ClientRequest", "ImportBatch"], "upstream": ["catalog"], "description": "Заявка клиента (Excel, фото, лист покупателя), импорт табличных данных, создание заказа покупателя и строк АРМ."},
  {"id": "catalog", "title": "НСИ (номенклатура, контрагенты, цены)", "type": "supporting", "owns": ["Nomenclature", "Counterparty", "Contract", "Car", "PricePolicy"], "upstream": [], "description": "Поиск и подбор номенклатуры, создание и подтверждение карточек, неопознанные позиции, РРЦ и коэффициенты."},
  {"id": "lines", "title": "Строки АРМ (ядро)", "type": "core", "owns": ["Line", "CustomerOrder"], "upstream": ["catalog", "access"], "description": "Агрегат строки заказа: статусы, автомат переходов, матрица прав по колонкам, разделение строк, связь продажи и закупки (КлючСвязиСтрок), формулы цены."},
  {"id": "procurement", "title": "Закупка", "type": "core", "owns": ["SupplierOrder", "VirtualPurchase"], "upstream": ["lines", "catalog"], "description": "Заказ поставщику, оплата, «в пути», самовывоз у поставщика, виртуальный закуп с подтверждением админом."},
  {"id": "warehouse", "title": "Склад", "type": "core", "owns": ["Warehouse", "StorageCell", "Receipt", "StockMove", "StockBalance", "Transfer", "StockSearch"], "upstream": ["lines", "procurement"], "description": "Приёмка по УПД, размещение по складам и ячейкам (зоны process.html), резерв и остатки, комплектация и сборочный лист, розыск, перемещения."},
  {"id": "shipping", "title": "Отгрузка и документы", "type": "core", "owns": ["Shipment", "PrintForm"], "upstream": ["lines", "warehouse"], "description": "Отгрузочная ведомость и корректировка, отгрузка клиенту / ТК, контроль документов (подпись, оригинал), печатные формы."},
  {"id": "returns", "title": "Возвраты", "type": "core", "owns": ["ReturnRequest"], "upstream": ["shipping", "warehouse", "procurement"], "description": "Возврат от клиента, возврат поставщику, отказ при получении."},
  {"id": "workshop", "title": "Ремонтная зона (заказ-наряды)", "type": "supporting", "owns": ["WorkOrder", "LaborHours"], "upstream": ["lines", "warehouse"], "description": "Заказ-наряд главного механика, выдача в ремонтную зону, нормо-часы, выдача авто. В 1С не реализовано; после переключения (этап 12)."},
  {"id": "notifications", "title": "Уведомления", "type": "generic", "owns": ["Notice"], "upstream": ["lines", "warehouse", "procurement", "catalog", "access"], "description": "Политики «событие → уведомление роли» (M8, M11, M17/K9, M18/G8, M9, M10, запрос прав); доставка по WebSocket."},
  {"id": "access", "title": "Доступ: роли и матрица", "type": "generic", "owns": ["User", "Role", "MatrixPolicy", "AccessRequest"], "upstream": [], "description": "Пользователи, роли, матрица прав колонок по статусам, доступ к складам, запрос прав у администратора (M13 → A3)."},
  {"id": "accounting", "title": "Интеграция с бухгалтерией", "type": "generic", "owns": ["OutboxMessage", "ObjectMap", "PeriodLock"], "upstream": ["shipping", "warehouse", "procurement", "returns"], "description": "Outbox → 1С (вариант A): отгрузки, приёмки, возвраты, перемещения; обратно оплаты, УПД, дата запрета изменений. Anti-corruption layer к 1С."}
 ],
 "contextMap": [
  {"from": "intake", "to": "lines", "relation": "customer-supplier", "via": "команда CreateLines"},
  {"from": "catalog", "to": "lines", "relation": "customer-supplier", "via": "NomenclatureMatched / NomenclatureApproved"},
  {"from": "lines", "to": "procurement", "relation": "partnership", "via": "КлючСвязиСтрок: продажа ↔ закупка"},
  {"from": "procurement", "to": "warehouse", "relation": "customer-supplier", "via": "SupplierOrderPaid, GoodsInTransit → приёмка"},
  {"from": "warehouse", "to": "lines", "relation": "partnership", "via": "GoodsPlaced, LineAssembled меняют статус строки"},
  {"from": "lines", "to": "shipping", "relation": "customer-supplier", "via": "LineReadyToShip"},
  {"from": "shipping", "to": "returns", "relation": "customer-supplier", "via": "Shipped → возврат"},
  {"from": "access", "to": "lines", "relation": "conformist", "via": "матрица прав проверяется в агрегате Line"},
  {"from": "*", "to": "notifications", "relation": "published-language", "via": "доменные события (sys.change_log, AsyncAPI)"},
  {"from": "shipping", "to": "accounting", "relation": "anti-corruption-layer", "via": "outbox → OData 1С"},
  {"from": "accounting", "to": "lines", "relation": "anti-corruption-layer", "via": "PaymentReceived → paid"}
 ],
 "aggregates": [
  {"id": "Line", "context": "lines", "table": "arm.line", "root": true, "invariants": ["Статус меняется только по автомату переходов (fsm) и только разрешённой ролью", "Поле меняется, только если матрица роли разрешает его в текущем статусе ('+'; 'c' — только автору строки)", "Строка в статусе closed меняется только администратором; исключение — «Документ подписан оригинал»", "Заблокированная фоновым заданием строка не меняется (locked_background)", "Одно из: Наименование / Артикул / Код А-А; одно из: Госномер / Агрегат (fieldRules oneOfRequired)", "Цена продажи и суммы считаются по формулам fieldRules", "Изменение — только с актуальной версией (If-Match), иначе 409"], "events": ["LinesCreated", "LineChanged", "LineStatusChanged", "LinesSplit", "StockReserved", "AssemblyRequested", "AssemblyRejected", "LineAssembled", "DocumentsControlled", "LineStruck"]},
  {"id": "CustomerOrder", "context": "lines", "table": "doc.customer_order", "root": true, "invariants": ["Шапка (заказчик, договор) едина для строк заказа", "Договор принадлежит заказчику (fieldRules filter)", "Проведённый заказ меняется только через строки АРМ"], "events": ["CustomerOrderCreated", "CustomerOrderPosted"]},
  {"id": "ClientRequest", "context": "intake", "table": "imp.batch", "root": true, "invariants": ["Строки заявки проверяются до создания заказа (предпросмотр)", "Партия пишется целиком или не пишется"], "events": ["ClientRequestReceived", "ImportCommitted", "ImportRolledBack"]},
  {"id": "ImportBatch", "context": "intake", "table": "imp.batch", "root": true, "invariants": ["Откат возможен, пока на записи нет ссылок из более поздних документов"], "events": ["ImportCommitted", "ImportRolledBack"]},
  {"id": "Nomenclature", "context": "catalog", "table": "ref.nomenclature", "root": true, "invariants": ["Черновик менеджера (M2a) становится рабочей позицией только после подтверждения админом (A2)", "Неопознанная позиция живёт в папке «Не опознанные» с фото (A1)", "Артикул + производитель уникальны среди рабочих позиций"], "events": ["NomenclatureDrafted", "NomenclatureApproved", "ItemUnidentified", "NomenclatureMatched"]},
  {"id": "Counterparty", "context": "catalog", "table": "ref.counterparty", "root": true, "invariants": ["ИНН+КПП уникальны"], "events": ["CounterpartyChanged"]},
  {"id": "Contract", "context": "catalog", "table": "ref.contract", "root": false, "invariants": ["Владелец — контрагент"], "events": []},
  {"id": "Car", "context": "catalog", "table": "ref.car", "root": true, "invariants": ["Выбор госномера заполняет Марку, Модель, VIN, Двигатель, № шасси (fieldRules autofill)"], "events": []},
  {"id": "PricePolicy", "context": "catalog", "table": "ref.price", "root": true, "invariants": ["НМЦК = РРЦ × 1,5 (A0)", "Цена продажи = (РРЦ > 0 ? РРЦ : себестоимость) × коэффициент"], "events": ["PricePolicyChanged"]},
  {"id": "SupplierOrder", "context": "procurement", "table": "doc.supplier_order", "root": true, "invariants": ["Порядок M4 → P1 → M7 → P2", "Статусы канбана снабжения: paid, in_transit, acceptance, to_stock, assembly, assembled"], "events": ["SupplierOrderPlaced", "SupplierOrderConfirmed", "SupplierOrderPaid", "GoodsInTransit", "SelfPickupRecorded"]},
  {"id": "VirtualPurchase", "context": "procurement", "table": "arm.line", "root": false, "invariants": ["Чек виртуального закупа проводит только администратор (A3)"], "events": ["VirtualPurchaseConfirmed"]},
  {"id": "Warehouse", "context": "warehouse", "table": "ref.warehouse", "root": true, "invariants": ["Ровно один основной склад", "Кладовщик работает только со своими складами (auth.user_warehouse)"], "events": ["WarehouseChanged"]},
  {"id": "StorageCell", "context": "warehouse", "table": "ref.storage_cell", "root": false, "invariants": ["Код ячейки уникален в складе", "Заблокированная ячейка не принимает размещение"], "events": []},
  {"id": "Receipt", "context": "warehouse", "table": "doc.receipt", "root": true, "invariants": ["Приёмка K1 всегда продолжается размещением K2"], "events": ["GoodsReceived"]},
  {"id": "StockMove", "context": "warehouse", "table": "stock.move", "root": true, "invariants": ["Остаток по ключу (склад, ячейка, номенклатура, партия, заказ) не уходит в минус", "Движения создаются только проведением документов"], "events": ["GoodsPlaced", "StockMoved"]},
  {"id": "StockBalance", "context": "warehouse", "table": "stock.balance", "root": false, "invariants": ["Равен сумме движений (R5)"], "events": []},
  {"id": "Transfer", "context": "warehouse", "table": "doc.transfer", "root": true, "invariants": ["Склад-отправитель ≠ склад-получатель либо ячейки различаются"], "events": ["StockMoved"]},
  {"id": "StockSearch", "context": "warehouse", "table": "arm.line", "root": false, "invariants": ["Розыск закрывается находкой (→ K2) или неопознанной позицией (→ M18 ∥ G8)"], "events": ["ItemFound", "ItemUnidentified"]},
  {"id": "Shipment", "context": "shipping", "table": "doc.shipment", "root": true, "invariants": ["Нужны дата и номер отгрузки", "Отгружаются строки ready_to_ship (или paid/in_transit при самовывозе)"], "events": ["Shipped"]},
  {"id": "PrintForm", "context": "shipping", "table": null, "root": false, "invariants": ["Печать по заказам отмеченных строк, без отметок — по заказу текущей строки"], "events": ["PrintFormRendered"]},
  {"id": "ReturnRequest", "context": "returns", "table": "doc.return", "root": true, "invariants": ["Возврат от клиента — после отгрузки", "Возврат поставщику — через склад (K6) или сразу со склада к поставщику (P3)"], "events": ["ReturnRequested", "ReturnAccepted", "SupplierReturnRequested", "SupplierReturnAccepted"]},
  {"id": "WorkOrder", "context": "workshop", "table": "doc.work_order", "root": true, "invariants": ["Запчасти выдаются в ремонтную зону по заказ-наряду"], "events": ["WorkOrderOpened", "PartsIssuedToRepair", "LaborCalculated", "CarReleased"]},
  {"id": "LaborHours", "context": "workshop", "table": "doc.work_order_labor", "root": false, "invariants": ["Стоимость часа — по типу техники"], "events": ["LaborCalculated"]},
  {"id": "Notice", "context": "notifications", "table": "arm.notice", "root": true, "invariants": ["Одно непрочитанное уведомление на узел + роль + заказ за день, строки без дублей", "Снабжение и кладовщик видят общие уведомления; админ — все"], "events": ["NoticeCreated", "NoticeRead"]},
  {"id": "User", "context": "access", "table": "auth.user", "root": true, "invariants": ["Пароль задаётся при первом входе", "Отключённый пользователь теряет сессии сразу (WS session)"], "events": ["UserChanged"]},
  {"id": "Role", "context": "access", "table": "auth.user_role", "root": false, "invariants": ["Одна роль интерфейса на пользователя"], "events": ["RoleChanged"]},
  {"id": "MatrixPolicy", "context": "access", "table": "arm.matrix_column", "root": true, "invariants": ["Маска прав — символ на каждый из 15 статусов", "Изменение матрицы принудительно перестраивает интерфейс у всех (WS matrix)"], "events": ["MatrixChanged"]},
  {"id": "AccessRequest", "context": "access", "table": "auth.access_request", "root": true, "invariants": ["Запрос рассматривает только администратор", "Одобрение выполняет исходную команду от имени администратора и пишется в журнал"], "events": ["RightsRequested", "RightsGranted", "RightsDenied"]},
  {"id": "OutboxMessage", "context": "accounting", "table": "integration.outbox", "root": true, "invariants": ["Пишется в одной транзакции с бизнес-изменением", "Повторная отправка идемпотентна (Ref_Key = UUID)"], "events": ["SentToAccounting", "AccountingFailed"]},
  {"id": "ObjectMap", "context": "accounting", "table": "integration.object_map", "root": false, "invariants": ["Для варианта A — тождество UUID"], "events": []},
  {"id": "PeriodLock", "context": "accounting", "table": "integration.period_lock", "root": true, "invariants": ["Документы закрытого периода не редактируются"], "events": ["PeriodLocked"]}
 ],
 "events": {
  "LinesCreated": "строки АРМ созданы (заявка, импорт)", "LineChanged": "изменены поля строки", "LineStatusChanged": "статус строки изменён", "LinesSplit": "строка разделена по остаткам и партиям («В работе»)",
  "LineStruck": "строка вычеркнута", "StockReserved": "товар зарезервирован", "AssemblyRequested": "задание на комплектацию", "AssemblyRejected": "комплектация отклонена с причиной",
  "LineAssembled": "строка собрана (Собран / Подготовлено)", "DocumentsControlled": "контроль документов выполнен, оригинал получен",
  "CustomerOrderCreated": "создан заказ покупателя", "CustomerOrderPosted": "заказ покупателя проведён",
  "ClientRequestReceived": "получена заявка клиента", "ImportCommitted": "партия импорта записана", "ImportRolledBack": "партия импорта отменена",
  "NomenclatureDrafted": "менеджер создал черновик номенклатуры", "NomenclatureApproved": "админ подтвердил позицию", "ItemUnidentified": "позиция не опознана", "NomenclatureMatched": "номенклатура подобрана к строке",
  "CounterpartyChanged": "изменён контрагент", "PricePolicyChanged": "изменены РРЦ / коэффициенты",
  "SupplierOrderPlaced": "заказ поставщику оформлен", "SupplierOrderConfirmed": "поставщик подтвердил заказ", "SupplierOrderPaid": "заказ поставщику оплачен", "GoodsInTransit": "товар в пути", "SelfPickupRecorded": "клиент забрал товар у поставщика",
  "VirtualPurchaseConfirmed": "админ подтвердил чек виртуального закупа",
  "WarehouseChanged": "изменён склад", "GoodsReceived": "товар принят по УПД", "GoodsPlaced": "товар размещён на склад / в ячейку", "StockMoved": "перемещение между складами / ячейками", "ItemFound": "позиция найдена при розыске",
  "Shipped": "отгружено клиенту / ТК", "PrintFormRendered": "сформирована печатная форма",
  "ReturnRequested": "возврат от клиента", "ReturnAccepted": "возврат принят на склад", "SupplierReturnRequested": "заявка на возврат поставщику", "SupplierReturnAccepted": "поставщик принял возврат",
  "WorkOrderOpened": "открыт заказ-наряд", "PartsIssuedToRepair": "запчасти выданы в ремонтную зону", "LaborCalculated": "нормо-часы рассчитаны", "CarReleased": "автомобиль выдан",
  "NoticeCreated": "создано уведомление", "NoticeRead": "уведомление прочитано",
  "UserChanged": "изменён пользователь", "RoleChanged": "изменена роль", "MatrixChanged": "изменена матрица прав", "RightsRequested": "запрошены права у администратора", "RightsGranted": "права выданы (команда выполнена)", "RightsDenied": "в правах отказано",
  "SentToAccounting": "документ передан в бухгалтерию", "AccountingFailed": "ошибка обмена с бухгалтерией", "PeriodLocked": "период закрыт в бухгалтерии", "PaymentReceived": "оплата из бухгалтерии"
 },
 "fsmAdditions": [
  {"from": ["new", "in_work", "reserve"], "to": "ordered", "roles": ["manager", "admin"], "via": "POST /sales/jobs («В работе»: разделение строк, автозакупки) → заказ поставщику", "nodes": ["M4"], "alsoTo": "partially_ordered"},
  {"from": ["ordered"], "to": "paid", "roles": ["manager", "supply", "admin"], "via": "POST /supply/status {status: paid}; из бухгалтерии — PaymentReceived", "nodes": ["M7", "A3"], "gap": "по схеме оплату контролирует менеджер (M7), в коде PWA /supply/status разрешён только supply и admin — в Go разрешается manager, решение подтвердить у заказчика"},
  {"from": ["paid"], "to": "in_transit", "roles": ["supply", "admin", "supplier"], "via": "POST /supply/status {status: in_transit}; поставщик — портал (этап 12)", "nodes": ["P2"]},
  {"from": ["in_transit", "paid"], "to": "acceptance", "roles": ["storekeeper", "supply", "admin"], "via": "POST /supply/status {status: acceptance} / POST /lines/transition {to: acceptance}", "nodes": ["K1"]},
  {"from": ["acceptance"], "to": "to_stock", "roles": ["storekeeper", "supply", "admin"], "via": "POST /stock/placements (размещение в ячейку, раздел 13) / POST /supply/status {status: to_stock}", "nodes": ["K2"]},
  {"from": ["ready_to_ship"], "to": "shipped", "roles": ["storekeeper", "manager", "admin"], "via": "POST /sales/shipments (дата и номер отгрузки)", "nodes": ["K5"]},
  {"from": ["paid", "in_transit"], "to": "shipped", "roles": ["manager", "admin"], "actor": "client", "via": "POST /lines/transition {to: shipped} — самовывоз фиксирует менеджер", "nodes": ["N4"]},
  {"from": ["shipped"], "to": "return", "roles": ["manager", "storekeeper", "admin"], "actor": "client", "via": "POST /lines/transition {to: return} — возврат клиента фиксирует менеджер / кладовщик", "nodes": ["N3"]},
  {"from": ["new"], "to": "in_work", "roles": ["manager", "admin"], "via": "POST /sales/jobs («В работе»)", "nodes": ["M2"]}
 ],
 "nodes": {
  "N1": {"context": "intake", "aggregate": "ClientRequest", "command": "SubmitClientRequest", "api": "POST /imports (kind=customer_sheet); сейчас POST /sales/imports", "emits": ["ClientRequestReceived"], "notifies": [], "screen": "ImportView", "stage": 8, "tests": ["T-N1", "S-happy"]},
  "N2a": {"context": "shipping", "aggregate": "Shipment", "command": "HandOverGoods", "api": null, "manual": "физическая выдача товара; в системе фиксируется отгрузкой K5", "emits": [], "notifies": [], "screen": "—", "stage": 4, "tests": ["T-N2a", "S-happy"]},
  "N3": {"context": "returns", "aggregate": "ReturnRequest", "command": "RequestCustomerReturn", "api": "POST /lines/transition {to: return}", "emits": ["ReturnRequested", "LineStatusChanged"], "notifies": ["storekeeper"], "screen": "LinesView", "stage": 4, "tests": ["T-N3", "S-return", "S-return_internal"]},
  "N4": {"context": "procurement", "aggregate": "SupplierOrder", "command": "RecordSelfPickup", "api": "POST /lines/transition {to: shipped}", "emits": ["SelfPickupRecorded", "LineStatusChanged"], "notifies": ["manager", "storekeeper"], "screen": "LinesView", "stage": 4, "tests": ["T-N4", "S-delivery_split"]},
  "M1": {"context": "intake", "aggregate": "CustomerOrder", "command": "ImportCustomerSheet", "api": "POST /sales/imports; POST /lines", "emits": ["CustomerOrderCreated", "LinesCreated"], "notifies": [], "screen": "ImportView", "stage": 4, "tests": ["T-M1", "S-happy"]},
  "M2": {"context": "catalog", "aggregate": "Line", "command": "MatchNomenclature", "api": "GET /catalog/goods; PATCH /lines/{id} {field: Номенклатура}", "emits": ["NomenclatureMatched", "LineChanged"], "notifies": [], "screen": "LineSheet / RefPicker", "stage": 4, "tests": ["T-M2", "S-happy"]},
  "M2a": {"context": "catalog", "aggregate": "Nomenclature", "command": "DraftNomenclature", "api": "POST /catalog/goods (draft)", "emits": ["NomenclatureDrafted"], "notifies": ["admin"], "screen": "CatalogView", "stage": 4, "tests": ["T-M2a"]},
  "M3": {"context": "lines", "aggregate": "Line", "command": "ReserveStock", "api": "POST /lines/transition {to: reserve}", "emits": ["StockReserved", "LineStatusChanged"], "notifies": [], "screen": "LinesView", "stage": 4, "tests": ["T-M3", "S-stock", "S-mixed_order"]},
  "M4": {"context": "procurement", "aggregate": "SupplierOrder", "command": "OrderFromSupplier", "api": "POST /sales/jobs; POST /sales/supplier-orders", "emits": ["LinesSplit", "SupplierOrderPlaced", "LineStatusChanged"], "notifies": [], "screen": "LinesView / JobDialog", "stage": 4, "tests": ["T-M4", "S-happy"]},
  "M7": {"context": "procurement", "aggregate": "SupplierOrder", "command": "ConfirmPayment", "api": "POST /supply/status {status: paid}", "emits": ["SupplierOrderPaid", "LineStatusChanged"], "notifies": [], "screen": "LinesView (канбан снабжения)", "stage": 4, "tests": ["T-M7", "S-happy"]},
