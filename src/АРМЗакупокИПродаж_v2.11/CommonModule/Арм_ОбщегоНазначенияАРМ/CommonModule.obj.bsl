Процедура ПолучитьОстаткиПоСтрокам(НоменклатураНовоеЗначение, СсылкаНаЗаказ = Неопределено, Знач ЭтоИнтерактивнаяЗапись = Ложь) Экспорт
	Перем ЭтоФоновыйПоток;

	ЭтоФоновыйПоток = ПользователиИнформационнойБазы.ТекущийПользователь() = Неопределено;
	НужноСтавитьЗамок = Не ЭтоИнтерактивнаяЗапись И Не ЭтоФоновыйПоток;

	Если НужноСтавитьЗамок Тогда

		ВнутренняяТранзакцияОткрыта = Ложь;
		Если Не ТранзакцияАктивна() Тогда
			НачатьТранзакцию();
			ВнутренняяТранзакцияОткрыта = Истина;
		КонецЕсли;

		БлокировкаФИФО = Новый БлокировкаДанных;
		ЭлементБлок = БлокировкаФИФО.Добавить("Справочник.Номенклатура");
		ЭлементБлок.УстановитьЗначение("Ссылка", НоменклатураНовоеЗначение);
		ЭлементБлок.Режим = РежимБлокировкиДанных.Исключительный;

		Попытка
			БлокировкаФИФО.Заблокировать();
		Исключение
			Если ВнутренняяТранзакцияОткрыта И ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;

			ПодробныйТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("АРМ.КонфликтБлокировокФИФО", УровеньЖурналаРегистрации.Ошибка, , , ПодробныйТекстОшибки, РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);






			ВызватьИсключение "Ресурс заблокирован другим пользователем (пересчет FIFO). Пожалуйста, повторите операцию через секунду.";
		КонецПопытки;

	КонецЕсли;

	СхлопнутьСтрокиПродажПартии(НоменклатураНовоеЗначение);

	ОчиститьАвтоматическиеЗакупки(НоменклатураНовоеЗначение);

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ЗапасыОстатки.Партия КАК Партия,
	|	ЗапасыОстатки.КоличествоОстаток КАК Остаток,
	|	ЗапасыОстатки.СуммаОстаток КАК СуммаОстаток
	|ПОМЕСТИТЬ втВсеДоступныеОстатки
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(&Граница, Номенклатура = &Номенклатура И ЗаказПокупателя = ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)) КАК ЗапасыОстатки
	|ГДЕ
	|	ЗапасыОстатки.КоличествоОстаток > 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗапасыОстатки.Партия,
	|	ЗапасыОстатки.КоличествоОстаток,
	|	ЗапасыОстатки.СуммаОстаток
	|ИЗ
	|	РегистрНакопления.Запасы.Остатки(&Граница, Номенклатура = &Номенклатура И ЗаказПокупателя = &ТекущийЗаказ) КАК ЗапасыОстатки
	|ГДЕ
	|	ЗапасыОстатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Партия КАК Партия,
	|	ЕСТЬNULL(СпрПартии.ВладелецПартии, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Поставщик,
	|	СУММА(Т.Остаток) КАК Остаток,
	|	СУММА(Т.СуммаОстаток) КАК СуммаОстаток,
	|	МИНИМУМ(ЕСТЬNULL(Запасы.Период, ДАТАВРЕМЯ(3999, 12, 31))) КАК ДатаПрихода
	|ПОМЕСТИТЬ втСкладскиеОстатки
	|ИЗ
	|	втВсеДоступныеОстатки КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПартииНоменклатуры КАК СпрПартии
	|		ПО Т.Партия = СпрПартии.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.Запасы КАК Запасы
	|		ПО Т.Партия = Запасы.Партия
	|			И (Запасы.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Партия,
	|	ЕСТЬNULL(СпрПартии.ВладелецПартии, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Партия КАК Партия,
	|	Т.Количество КАК Количество
	|ПОМЕСТИТЬ втВсеБрони
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.Номенклатура = &Номенклатура
	|	И Т.СтатусСтроки <> ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Отгружено)
	|	И Т.Удаление = ЛОЖЬ
	|	И Т.РучнаяПравкаПартии = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Партия,
	|	Т.Количество
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.Номенклатура = &Номенклатура
	|	И Т.СтатусСтроки <> ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Отгружено)
	|	И Т.Удаление = ЛОЖЬ
	|	И Т.РучноеРазделениеСУчетомПартий = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.Партия,
	|	Т.Количество
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.Номенклатура = &Номенклатура
	|	И Т.СтатусСтроки <> ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Отгружено)
	|	И Т.Удаление = ЛОЖЬ
	|	И Т.ОтметкаСтроки = ИСТИНА
	|	И Т.АвторСтроки <> &Автор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.Партия КАК Партия,
	|	СУММА(Т.Количество) КАК КолВоРуч
	|ПОМЕСТИТЬ втРучныеБрони
	|ИЗ
	|	втВсеБрони КАК Т
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.Партия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Склад.Партия КАК Партия,
	|	Склад.Поставщик КАК Поставщик,
	|	Склад.Остаток - ЕСТЬNULL(Руч.КолВоРуч, 0) КАК ДоступноДляАвто,
	|	ВЫБОР КОГДА Склад.Остаток = 0 ТОГДА 0 
	|		ИНАЧЕ Склад.СуммаОстаток / Склад.Остаток 
	|	КОНЕЦ КАК СебестоимостьЕдиницы,
	|	Склад.СуммаОстаток КАК СуммаПартииИтого
	|ИЗ
	|	втСкладскиеОстатки КАК Склад
	|		ЛЕВОЕ СОЕДИНЕНИЕ втРучныеБрони КАК Руч
	|		ПО Склад.Партия = Руч.Партия
	|ГДЕ
	|	Склад.Остаток - ЕСТЬNULL(Руч.КолВоРуч, 0) > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Склад.ДатаПрихода
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.*
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.Номенклатура = &Номенклатура
	|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|	И Т.СтатусСтроки <> ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Отгружено)
	|	И Т.Удаление = ЛОЖЬ
	|	И Т.РучнаяПравкаПартии = ЛОЖЬ
	|	И Т.РучноеРазделениеСУчетомПартий = ЛОЖЬ
	|	И Т.ОтметкаСтроки = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Т.*
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.Номенклатура = &Номенклатура
	|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|	И Т.СтатусСтроки <> ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Отгружено)
	|	И Т.Удаление = ЛОЖЬ
	|	И Т.РучнаяПравкаПартии = ЛОЖЬ
	|	И Т.РучноеРазделениеСУчетомПартий = ЛОЖЬ
	|	И Т.ОтметкаСтроки = ИСТИНА
	|	И Т.АвторСтроки = &Автор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";








	Запрос.УстановитьПараметр("Номенклатура", НоменклатураНовоеЗначение);
	Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("Граница", Новый Граница(КонецДня(ТекущаяДатаСеанса()), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ТекущийЗаказ", ?(СсылкаНаЗаказ = Неопределено, Документы.ЗаказПокупателя.ПустаяСсылка(), СсылкаНаЗаказ));


	Результаты = Запрос.ВыполнитьПакет();
	ТаблицаПартий = Результаты[4].Выгрузить();
	ВыборкаПродаж = Результаты[5].Выбрать();

	Пока ВыборкаПродаж.Следующий() Цикл

		НужноеКоличество = ВыборкаПродаж.Количество;
		ПерваяИтерация = Истина;

		ТекущийСкладскойОстаток = 0;
		Для каждого СтрТЗ Из ТаблицаПартий Цикл
			ТекущийСкладскойОстаток = ТекущийСкладскойОстаток + СтрТЗ.ДоступноДляАвто;
		КонецЦикла;

		Для каждого СтрПартии Из ТаблицаПартий Цикл
			Если НужноеКоличество <= 0 Тогда Прервать; КонецЕсли;
			Если СтрПартии.ДоступноДляАвто <= 0 Тогда Продолжить; КонецЕсли;

			ВзятьИзПартии = Мин(НужноеКоличество, СтрПартии.ДоступноДляАвто);
			ТекущийСкладскойОстаток = ТекущийСкладскойОстаток - ВзятьИзПартии;

			Если ВзятьИзПартии = СтрПартии.ДоступноДляАвто Тогда
				СебестоимостьДляСтроки = СтрПартии.СуммаПартииИтого;
			Иначе
				СебестоимостьДляСтроки = Окр(ВзятьИзПартии * СтрПартии.СебестоимостьЕдиницы, 2);
			КонецЕсли;
			СтрПартии.СуммаПартииИтого = СтрПартии.СуммаПартииИтого - СебестоимостьДляСтроки;

			Если ПерваяИтерация Тогда
				ОбновитьЗаписьПродажи(ВыборкаПродаж, СтрПартии.Партия, СтрПартии.Поставщик, ВзятьИзПартии, ТекущийСкладскойОстаток, СебестоимостьДляСтроки, СтрПартии.СебестоимостьЕдиницы);








				ПерваяИтерация = Ложь;
			Иначе
				СоздатьДопСтрокуПродажи(ВыборкаПродаж, СтрПартии.Партия, СтрПартии.Поставщик, ВзятьИзПартии, ТекущийСкладскойОстаток, СебестоимостьДляСтроки, СтрПартии.СебестоимостьЕдиницы);








			КонецЕсли;

			НужноеКоличество = НужноеКоличество - ВзятьИзПартии;
			СтрПартии.ДоступноДляАвто = СтрПартии.ДоступноДляАвто - ВзятьИзПартии;
		КонецЦикла;

		Если НужноеКоличество > 0 Тогда
			Если ПерваяИтерация Тогда
				ОбновитьЗаписьПродажи(ВыборкаПродаж, Справочники.ПартииНоменклатуры.ПустаяСсылка(), Справочники.Контрагенты.ПустаяСсылка(), НужноеКоличество, 0, 0, 0);
			Иначе








				СоздатьДопСтрокуПродажи(ВыборкаПродаж, Справочники.ПартииНоменклатуры.ПустаяСсылка(), Справочники.Контрагенты.ПустаяСсылка(), НужноеКоличество, 0, 0, 0);








			КонецЕсли;

			УправлятьСтрокойЗакупки(ВыборкаПродаж, НужноеКоличество, Ложь);
		КонецЕсли;
	КонецЦикла;

	Если НужноСтавитьЗамок И ВнутренняяТранзакцияОткрыта Тогда
		Если ТранзакцияАктивна() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры


Процедура СоздатьДопСтрокуПродажи(ДанныеВыборки, ПартияДляЗаписи, Поставщик, КоличествоДляЗаписи, ОстатокДляСтроки, Себестоимость, СебестоимостьЕдиницы)

	МЗ = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МЗ, ДанныеВыборки);
	МЗ.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
	МЗ.ОстатокДляСтроки = ОстатокДляСтроки;
	МЗ.Количество = КоличествоДляЗаписи;
	МЗ.Партия = ПартияДляЗаписи;
	МЗ.Поставщик = Поставщик;
	МЗ.Себестоимость = Себестоимость;
	МЗ.СебестоимостьЕдиницы = СебестоимостьЕдиницы;

	Попытка
		МЗ.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("АРМ.СозданиеХвоста", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки(), РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);







		ВызватьИсключение "Ошибка при записи АРМ регистра при создании дополниткльной строки";
	КонецПопытки;

КонецПроцедуры


Процедура ОбновитьЗаписьПродажи(ДанныеВыборки, ПартияДляЗаписи, Поставщик, КоличествоДляЗаписи, ОстатокДляСтроки, Себестоимость, СебестоимостьЕдиницы)

	МЗ = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(МЗ, ДанныеВыборки);
	МЗ.Прочитать();

	МЗ.ОстатокДляСтроки = ОстатокДляСтроки;
	МЗ.Количество = КоличествоДляЗаписи;
	МЗ.Партия = ПартияДляЗаписи;
	МЗ.Поставщик = Поставщик;
	МЗ.Себестоимость = Себестоимость;
	МЗ.СебестоимостьЕдиницы = СебестоимостьЕдиницы;

	Попытка
		МЗ.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("АРМ.ОбновлениеПродажи", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки(), РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);







		ВызватьИсключение "Ошибка при обновлении записи продажи";
	КонецПопытки;

КонецПроцедуры


Процедура ОчиститьАвтоматическиеЗакупки(Номенклатура)

	ЗапросЧистки = Новый Запрос;
	ЗапросЧистки.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.*
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.Номенклатура = &Номенклатура
	|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
	|	И Т.СтатусСтроки В (&МассивСтатусов)
	|	И Т.РучнаяПравка = ЛОЖЬ";


	ЗапросЧистки.УстановитьПараметр("Номенклатура", Номенклатура);
	МассивСтатусов = Новый Массив;
	МассивСтатусов.Добавить(Перечисления.Арм_СтатусыАРМ.Черновик);
	МассивСтатусов.Добавить(Перечисления.Арм_СтатусыАРМ.Собран);

	ЗапросЧистки.УстановитьПараметр("МассивСтатусов", МассивСтатусов);
	ВыборкаЧистки = ЗапросЧистки.Выполнить().Выбрать();

	Пока ВыборкаЧистки.Следующий() Цикл

		МЗ = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, ВыборкаЧистки);

		Попытка
			МЗ.Удалить();
		Исключение
			ЗаписьЖурналаРегистрации("АРМ.ОчисткаАвтоЗакупок", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки(), РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);







			ВызватьИсключение "Ошибка при очистке строк закупки";
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры


Процедура СхлопнутьСтрокиПродажПартии(Номенклатура)

	ЗапросСхлоп = Новый Запрос;
	ЗапросСхлоп.Текст = "ВЫБРАТЬ
	|	Т.КлючСвязиСтрок КАК КлючСвязиСтрок,
	|	Т.ДокументЗаказПокупателя КАК ДокументЗаказПокупателя,
	|	МАКСИМУМ(Т.ДокументЗаказПоставщика) КАК ДокументЗаказПоставщика,
	|	МАКСИМУМ(Т.ДокументПриходнаяНакладная) КАК ДокументПриходнаяНакладная,
	|	СУММА(Т.Количество) КАК ОбщееКоличество,
	|	МАКСИМУМ(Т.ИдентификаторЗаписи) КАК ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.Номенклатура = &Номенклатура
	|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|	И Т.РучнаяПравкаПартии = ЛОЖЬ
	|	И Т.РучноеРазделениеСУчетомПартий = ЛОЖЬ
	|	И Т.ОтметкаСтроки = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.КлючСвязиСтрок,
	|	Т.ДокументЗаказПокупателя";


	ЗапросСхлоп.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = ЗапросСхлоп.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
		Набор.Отбор.КлючСвязиСтрок.Установить(Выборка.КлючСвязиСтрок);
		Набор.Отбор.ВидОперации.Установить(Перечисления.Арм_ВидыОпераций.Продажа);

		Набор.Прочитать();

		Если Набор.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		СтруктураЗаписи = Новый Структура;
		Для каждого Колонка Из Набор.Выгрузить().Колонки Цикл
			СтруктураЗаписи.Вставить(Колонка.Имя, Набор[0][Колонка.Имя]);
		КонецЦикла;

		Набор.Очистить();
		НоваяЗапись = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, СтруктураЗаписи);
		НоваяЗапись.ДокументЗаказПоставщика = Выборка.ДокументЗаказПоставщика;
		НоваяЗапись.ДокументПриходнаяНакладная = Выборка.ДокументПриходнаяНакладная;

		НоваяЗапись.Количество = Выборка.ОбщееКоличество;
		НоваяЗапись.Партия = Справочники.ПартииНоменклатуры.ПустаяСсылка();
		НоваяЗапись.ОстатокДляСтроки = 0;
		НоваяЗапись.ИдентификаторЗаписи = Выборка.ИдентификаторЗаписи;

		Попытка
			Набор.Записать();
		Исключение
			ЗаписьЖурналаРегистрации("АРМ.СхлопываениеСтрокПартий", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки(), РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);







			ВызватьИсключение "Ошибка записи строк АРМ регистра при схлопывании строк партий";
		КонецПопытки;

	КонецЦикла;

КонецПроцедуры


Процедура УправлятьСтрокойЗакупки(ДанныеПродажи, НужноеКоличество, РучнаяПравка = Ложь)

	ЧистаяПотребность = НужноеКоличество;

	Если Не РучнаяПравка Тогда

		ЗапросРучных = Новый Запрос;
		ЗапросРучных.Текст = "ВЫБРАТЬ
		|	ЕСТЬNULL(СУММА(Т.Количество), 0) КАК РучноеКоличество
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.Номенклатура = &Номенклатура
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
		|	И Т.РучнаяПравка = ИСТИНА
		|	И НЕ Т.Удаление
		|	И Т.ДокументЗаказПокупателя = &ТекущийЗаказ
		|	И Т.КлючСвязиСтрок = &КлючСвязиСтрок";


		ЗапросРучных.УстановитьПараметр("Номенклатура", ДанныеПродажи.Номенклатура);

		ЗапросРучных.УстановитьПараметр("ТекущийЗаказ", ДанныеПродажи.ДокументЗаказПокупателя);
		ЗапросРучных.УстановитьПараметр("КлючСвязиСтрок", ДанныеПродажи.КлючСвязиСтрок);

		ВыборкаРучных = ЗапросРучных.Выполнить().Выбрать();
		Если ВыборкаРучных.Следующий() Тогда

			ЧистаяПотребность = ЧистаяПотребность - ВыборкаРучных.РучноеКоличество;
		КонецЕсли;

	КонецЕсли;


	Если ЧистаяПотребность <= 0 Тогда
		Возврат;
	КонецЕсли;



	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();


	Набор.Отбор.КлючСвязиСтрок.Установить(ДанныеПродажи.КлючСвязиСтрок);
	Набор.Отбор.ВидОперации.Установить(Перечисления.Арм_ВидыОпераций.Закупка);
	Набор.Отбор.РучнаяПравка.Установить(РучнаяПравка);
	Набор.Прочитать();

	Если Набор.Количество() = 0 Тогда
		Запись = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, ДанныеПродажи);
		Запись.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		Запись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
		Запись.КлючСвязиСтрок = ДанныеПродажи.КлючСвязиСтрок;
		Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка;
		Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик;
	Иначе
		Запись = Набор[0];
	КонецЕсли;

	Приоритет = ПолучитьПриоритет(ДанныеПродажи.Номенклатура);


	Запись.Количество = ЧистаяПотребность;
	Запись.Порядок = Приоритет + 0.1;
	Запись.Цена = 0;

	Попытка
		Набор.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("АРМ.ОбновлениеСтрокЗакупок", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки(), РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);






		ВызватьИсключение "Ошибка при создании строк закупок";
	КонецПопытки;

КонецПроцедуры

Процедура УдалитьСтрокуЗакупки(КлючСвязи, ВидОперацииЗакупка, РучнаяПравка = Ложь) Экспорт
	Перем Набор;

	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();

	Набор.Отбор.КлючСвязиСтрок.Установить(КлючСвязи);
	Набор.Отбор.ВидОперации.Установить(ВидОперацииЗакупка);
	Набор.Отбор.РучнаяПравка.Установить(РучнаяПравка);


	Попытка
		Набор.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("АРМ.Удаление", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры


Функция ПолучитьПриоритет(Номенклатура) Экспорт

	ЗапросПриоритета = Новый Запрос;
	ЗапросПриоритета.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(ЕСТЬNULL(Арм_ДанныеЗакупокИПродаж.Порядок, 0)) КАК МаксимальныйПорядок
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
	|ГДЕ
	|	Арм_ДанныеЗакупокИПродаж.Номенклатура = &Номенклатура";

	ЗапросПриоритета.УстановитьПараметр("Номенклатура", Номенклатура);
	Результат = ЗапросПриоритета.Выполнить().Выбрать();

	НовыйПриоритет = 0;
	Если Результат.Следующий() И Результат.МаксимальныйПорядок <> Null Тогда
		НовыйПриоритет = Результат.МаксимальныйПорядок + 1;
	Иначе
		НовыйПриоритет = 1000;
	КонецЕсли;

	Возврат НовыйПриоритет;

КонецФункции


Процедура ЗаписатьСтрокуАРМ(ИдентификаторЗаписи, ПартияЗначение, КоличествоЗначение, СамаяРанняяПартия = 1)

	Себестоимость = 0;
	Поставщик = Справочники.Контрагенты.ПустаяСсылка();
	Если ЗначениеЗаполнено(ПартияЗначение) Тогда
		ЗапросЦены = Новый Запрос;
		ЗапросЦены.Текст = "ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗапасыОстатки.КоличествоОстаток <> 0
		|			ТОГДА ЗапасыОстатки.СуммаОстаток / ЗапасыОстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Цена,
		|	ПартииНоменклатуры.ВладелецПартии КАК Поставщик
		|ИЗ
		|	РегистрНакопления.Запасы.Остатки(, Партия = &Партия) КАК ЗапасыОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПартииНоменклатуры КАК ПартииНоменклатуры
		|		ПО ЗапасыОстатки.Партия = ПартииНоменклатуры.Ссылка";


		ЗапросЦены.УстановитьПараметр("Партия", ПартияЗначение);
		ВыборкаЦены = ЗапросЦены.Выполнить().Выбрать();

		Если ВыборкаЦены.Следующий() Тогда
			Себестоимость = ВыборкаЦены.Цена;
			Поставщик = ВыборкаЦены.Поставщик;
		КонецЕсли;
	КонецЕсли;

	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
	Набор.Прочитать();

	Если Набор.Количество() > 0 Тогда

		Попытка
			Запись = Набор[0];
			Запись.Партия = ?(ПартияЗначение = Неопределено, Справочники.ПартииНоменклатуры.ПустаяСсылка(), ПартияЗначение);
			Запись.Поставщик = Поставщик;
			Запись.Себестоимость = Себестоимость;
			Запись.Количество = ?(СамаяРанняяПартия, КоличествоЗначение, КоличествоЗначение / СамаяРанняяПартия);

			Набор.Записать();
		Исключение
			Набор.Очистить();
			Набор.Записать();
			ЗаписьЖурналаРегистрации("АРМ.ОбновлениеСтроки", УровеньЖурналаРегистрации.Ошибка);
		КонецПопытки;

	КонецЕсли;

КонецПроцедуры


Процедура СоздатьНовуюСтрокуПродажи(ДанныеСтроки, ПартияЗначение, КоличествоЗначение, СамаяРанняяПартия = 1)

	Себестоимость = 0;
	Поставщик = Справочники.Контрагенты.ПустаяСсылка();
	Если ЗначениеЗаполнено(ПартияЗначение) Тогда
		ЗапросЦены = Новый Запрос;
		ЗапросЦены.Текст = "ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ЗапасыОстатки.КоличествоОстаток <> 0
		|			ТОГДА ЗапасыОстатки.СуммаОстаток / ЗапасыОстатки.КоличествоОстаток
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Цена,
		|	ПартииНоменклатуры.ВладелецПартии КАК Поставщик
		|ИЗ
		|	РегистрНакопления.Запасы.Остатки(, Партия = &Партия) КАК ЗапасыОстатки
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПартииНоменклатуры КАК ПартииНоменклатуры
		|		ПО ЗапасыОстатки.Партия = ПартииНоменклатуры.Ссылка";


		ЗапросЦены.УстановитьПараметр("Партия", ПартияЗначение);
		ВыборкаЦены = ЗапросЦены.Выполнить().Выбрать();

		Если ВыборкаЦены.Следующий() Тогда
			Себестоимость = ВыборкаЦены.Цена;
			Поставщик = ВыборкаЦены.Поставщик;
		КонецЕсли;
	КонецЕсли;

	НовыйПриоритет = Арм_ОбщегоНазначенияАРМ.ПолучитьПриоритет(ДанныеСтроки.Номенклатура);

	Попытка
		Менеджер = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(Менеджер, ДанныеСтроки);
		Менеджер.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
		Менеджер.Поставщик = Поставщик;
		Менеджер.Себестоимость = Себестоимость;
		Менеджер.Цена = 0;

		Менеджер.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа;
		Менеджер.Партия = ?(ПартияЗначение = Неопределено, Справочники.ПартииНоменклатуры.ПустаяСсылка(), ПартияЗначение);
		Менеджер.Количество = ?(СамаяРанняяПартия, КоличествоЗначение, КоличествоЗначение / СамаяРанняяПартия);
		Менеджер.Порядок = НовыйПриоритет + 0.01;
		Менеджер.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("АРМ.СозданиеСтрокиПартии", УровеньЖурналаРегистрации.Ошибка);
	КонецПопытки;

КонецПроцедуры

Функция НайтиДоговор(Контрагент) Экспорт
	Перем ДоговорКонтрагента;

	ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();

	Если ЗначениеЗаполнено(Контрагент) Тогда

		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
		|	И ДоговорыКонтрагентов.Владелец.Ссылка = &Ссылка
		|	И НЕ ДоговорыКонтрагентов.Владелец.Недействителен
		|	И ДоговорыКонтрагентов.ДатаДоговора <= &ТекущаяДата
		|	И ДоговорыКонтрагентов.СрокДействия >= &ТекущаяДата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
		|	И ДоговорыКонтрагентов.Владелец.Ссылка = &Ссылка
		|	И НЕ ДоговорыКонтрагентов.Владелец.Недействителен
		|	И ДоговорыКонтрагентов.СрокДействия = ДАТАВРЕМЯ(1, 1, 1)";


		Запрос.УстановитьПараметр("Ссылка", Контрагент);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДоговор = РезультатЗапроса.Выбрать();

		Если ВыборкаДоговор.Следующий() Тогда
			ДоговорКонтрагента = ВыборкаДоговор.Ссылка;
		КонецЕсли;

	КонецЕсли;

	Возврат ДоговорКонтрагента;

КонецФункции

Функция ПолучитьМассивОтмеченныхКлючейСвязи(Знач МассивВалидныхСтатусов = Неопределено) Экспорт
	Перем ЕстьФильтрСтатусов;

	ЕстьФильтрСтатусов = МассивВалидныхСтатусов <> Неопределено И МассивВалидныхСтатусов.Количество() > 0;
	ВалидныеСтатусы = ?(ЕстьФильтрСтатусов, МассивВалидныхСтатусов, Новый Массив);

	МассивКлючей = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.КлючСвязиСтрок КАК КлючСвязиСтрок
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	НЕ Т.Удаление
	|	И Т.ОтметкаСтроки = ИСТИНА
	|	И Т.АвторСтроки = &Автор
	|	И НЕ &ЕстьФильтрСтатусов
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.КлючСвязиСтрок
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	НЕ Т.Удаление
	|	И Т.ОтметкаСтроки = ИСТИНА
	|	И Т.АвторСтроки = &Автор
	|	И &ЕстьФильтрСтатусов
	|	И Т.СтатусСтроки В(&ВалидныеСтатусы)";


	Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("ЕстьФильтрСтатусов", ЕстьФильтрСтатусов);
	Запрос.УстановитьПараметр("ВалидныеСтатусы", ВалидныеСтатусы);

	Результат = Запрос.Выполнить();

	Если Не Результат.Пустой() Тогда
		МассивКлючей = Результат.Выгрузить().ВыгрузитьКолонку("КлючСвязиСтрок");
	КонецЕсли;

	Возврат МассивКлючей;

КонецФункции


Функция ПолучитьМассивОтмеченныхИдентификаторов(ВидОперации) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	НЕ Т.Удаление
	|	И Т.ВидОперации = &ВидОперации
	|	И Т.ОтметкаСтроки = ИСТИНА
	|	И Т.АвторСтроки = &Автор";


	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);

	Результат = Запрос.Выполнить();

	Если Не Результат.Пустой() Тогда
		МассивИдентификаторов = Результат.Выгрузить().ВыгрузитьКолонку("ИдентификаторЗаписи");
	КонецЕсли;

	Возврат МассивИдентификаторов;

КонецФункции



Функция ПроверитьНеобходимостьСплитаНаСервере_ТЗ_Часть2() Экспорт

	ТЗ_Результаты = Новый ТаблицаЗначений;
	ТЗ_Результаты.Колонки.Добавить("ДокументЗаказПокупателя");
	ТЗ_Результаты.Колонки.Добавить("ТребуетсяРазделение", Новый ОписаниеТипов("Булево"));
	ТЗ_Результаты.Колонки.Добавить("КолВоВыбранных", Новый ОписаниеТипов("Число"));
	ТЗ_Результаты.Колонки.Добавить("ОбщееКолВо", Новый ОписаниеТипов("Число"));

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Внутр.ДокументЗаказПокупателя КАК Заказ
	|ПОМЕСТИТЬ втЗадействованныеЗаказы
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Внутр
	|ГДЕ
	|	Внутр.ОтметкаСтроки = ИСТИНА
	|	И НЕ Внутр.Удаление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.ДокументЗаказПокупателя КАК ДокументЗаказПокупателя,
	|	СУММА(Т.Количество) КАК ВсегоШтукВЗаказе,
	|	СУММА(ВЫБОР
	|			КОГДА Т.ОтметкаСтроки = ИСТИНА
	|				ТОГДА Т.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОтмеченоШтукНаЭкране,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА Т.ОтметкаСтроки = ИСТИНА
	|				ТОГДА Т.ИдентификаторЗаписи
	|		КОНЕЦ) КАК КолВоВыбранных
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗадействованныеЗаказы КАК ВТ_Заказы
	|		ПО Т.ДокументЗаказПокупателя = ВТ_Заказы.Заказ
	|ГДЕ
	|	НЕ Т.Удаление
	|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.ДокументЗаказПокупателя";


	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ВсегоШтукВЗаказе = ?(Выборка.ВсегоШтукВЗаказе = Null, 0, Выборка.ВсегоШтукВЗаказе);
		ОтмеченоШтукНаЭкране = ?(Выборка.ОтмеченоШтукНаЭкране = Null, 0, Выборка.ОтмеченоШтукНаЭкране);

		СплитДляТекущегоЗаказа = ВсегоШтукВЗаказе > ОтмеченоШтукНаЭкране И ОтмеченоШтукНаЭкране > 0;

		НоваяСтрока = ТЗ_Результаты.Добавить();
		НоваяСтрока.ДокументЗаказПокупателя = Выборка.ДокументЗаказПокупателя;
		НоваяСтрока.ТребуетсяРазделение = СплитДляТекущегоЗаказа;
		НоваяСтрока.КолВоВыбранных = Выборка.КолВоВыбранных;
		НоваяСтрока.ОбщееКолВо = ВсегоШтукВЗаказе;

	КонецЦикла;

	Возврат ТЗ_Результаты;

КонецФункции


Функция ПроверитьНеобходимостьСплитаНаСервере() Экспорт

	СтатусыДляМенеджера = Новый Массив;
	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.ВРаботе"));
	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Черновик"));
	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Собран"));
	МассивКлючей = ПолучитьМассивОтмеченныхКлючейСвязи(СтатусыДляМенеджера);

	ТЗ_Ключи = Новый ТаблицаЗначений;
	КвалификаторыСтроки = Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная);
	МассивТиповСтроки = Новый Массив;
	МассивТиповСтроки.Добавить(Тип("Строка"));
	ОписаниеТипаСтрока = Новый ОписаниеТипов(МассивТиповСтроки, Неопределено, КвалификаторыСтроки);

	ТЗ_Ключи.Колонки.Добавить("КлючСвязиСтрок", ОписаниеТипаСтрока);

	Для каждого Ключ Из МассивКлючей Цикл
		ТЗ_Ключи.Добавить().КлючСвязиСтрок = Ключ;
	КонецЦикла;

	Запрос = Новый Запрос;
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;

	Запрос.Текст = "ВЫБРАТЬ
	|	Т.КлючСвязиСтрок КАК КлючСвязи
	|ПОМЕСТИТЬ втОтмеченныеКлючи
	|ИЗ
	|	&МассивКлючей КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Рег.ДокументЗаказПокупателя КАК Заказ
	|ПОМЕСТИТЬ втЗадействованныеЗаказы
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОтмеченныеКлючи КАК вт
	|		ПО Рег.КлючСвязиСтрок = вт.КлючСвязи
	|ГДЕ
	|	НЕ Рег.Удаление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Рег.КлючСвязиСтрок) КАК ВсегоВЗаказах
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗадействованныеЗаказы КАК вт
	|		ПО Рег.ДокументЗаказПокупателя = вт.Заказ
	|ГДЕ
	|	НЕ Рег.Удаление";


	Запрос.УстановитьПараметр("МассивКлючей", ТЗ_Ключи);

	Выборка = Запрос.Выполнить().Выбрать();

	ОбщееКолВо = 0;
	Если Выборка.Следующий() Тогда
		ОбщееКолВо = Выборка.ВсегоВЗаказах;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ТребуетсяРазделение", ОбщееКолВо > МассивКлючей.Количество());
	Результат.Вставить("КолВоВыбранных", МассивКлючей.Количество());
	Результат.Вставить("ОбщееКолВо", ОбщееКолВо);

	Возврат Результат;

КонецФункции


// v2.11 (T07, D1b/D3): гейт ролей для записи на форме снабжения (смена статусов цепочки закупки, отметки строк).
// Допустимы Менеджер, Снабжение, Кладовщик, Администратор; роль строго из Арм_ПраваПользователей
// (нет записи / Клиент / Поставщик / ГлавныйМеханик - отказ). Возвращает "" - можно, иначе текст отказа.
Функция ОтказРолиСнабжения() Экспорт

	Роль = РегистрыСведений.Арм_ПраваПользователей.ПолучитьРольИнтерфейсаСтрого(ПараметрыСеанса.ТекущийПользователь);
	Если Роль <> Перечисления.Арм_РолиИнтерфейса.Менеджер
		И Роль <> Перечисления.Арм_РолиИнтерфейса.Снабжение
		И Роль <> Перечисления.Арм_РолиИнтерфейса.Кладовщик
		И Роль <> Перечисления.Арм_РолиИнтерфейса.Администратор Тогда
		Возврат "Действие на форме снабжения доступно ролям Менеджер, Снабжение, Кладовщик и Администратор. "
			+ "Проверьте роль в регистре «Права пользователей АРМ».";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ИзменитьСтатусыВРегистреСнабжения(Знач МассивИдентификаторов, Знач ЦелевойСтатус) Экспорт

	Итог = Новый Структура("Успешно, КоличествоОбработанных, ТекстОшибки", Ложь, 0, "");

	// v2.11 (T07, D1b/D3): цепочка закупки (Оплачено ... Собран) из ФормаСнабжение - только роли Менеджер, Снабжение,
	// Кладовщик, Администратор; роль строго из Арм_ПраваПользователей (нет записи / Клиент / Поставщик / ГлавныйМеханик - отказ).
	// Побитовую матрицу (line_status) к цепочке снабжения не применяем: см. tasks/storekeeper-vs-supply.md.
	ТекстОтказаРоли = ОтказРолиСнабжения();
	Если ЗначениеЗаполнено(ТекстОтказаРоли) Тогда
		Итог.ТекстОшибки = ТекстОтказаРоли;
		Возврат Итог;
	КонецЕсли;

	ПредыдущийСтатус = Неопределено;

	Если ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Оплачено Тогда
		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.Заказано;

	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.ТоварВПути Тогда
		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.Оплачено;

	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Приходуется Тогда
		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.ТоварВПути;

	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.НаСкладе Тогда
		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.Приходуется;

	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Комплектуется Тогда
		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.НаСкладе;

	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Собран Тогда
		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.Комплектуется;
	КонецЕсли;

	ЗапросЗаказы = Новый Запрос;
	ЗапросЗаказы.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.ДокументЗаказПокупателя КАК Заказ
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.ИдентификаторЗаписи В(&МассивИдентификаторов)
	|	И НЕ Т.Удаление";

	ЗапросЗаказы.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
	ВыгрузкаЗаказов = ЗапросЗаказы.Выполнить().Выгрузить().ВыгрузитьКолонку("Заказ");

	МассивЗаказовПоставщиков = Новый Массив;
	КоличествоИзмененных = 0;

	Для каждого ТекущийЗаказ Из ВыгрузкаЗаказов Цикл

		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
		Набор.Отбор.ДокументЗаказПокупателя.Установить(ТекущийЗаказ);
		Набор.Прочитать();

		Изменено = Ложь;
		ПарыЗакупокДляСинхронизации = Новый Соответствие;

		Для каждого Запись Из Набор Цикл

			Если Не Запись.Удаление И Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка И МассивИдентификаторов.Найти(Запись.ИдентификаторЗаписи) <> Неопределено Тогда



				Если ПредыдущийСтатус <> Неопределено И Запись.СтатусСтроки <> ПредыдущийСтатус Тогда
					Продолжить;
				КонецЕсли;

				Запись.СтатусСтроки = ЦелевойСтатус;
				Запись.ОтметкаСтроки = Ложь;
				Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();

				КоличествоИзмененных = КоличествоИзмененных + 1;
				Изменено = Истина;
				ПарыЗакупокДляСинхронизации.Вставить(Запись.КлючСвязиСтрок, Запись.Количество);

				Если ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Собран И ЗначениеЗаполнено(Запись.ДокументЗаказПоставщика) И МассивЗаказовПоставщиков.Найти(Запись.ДокументЗаказПоставщика) = Неопределено Тогда


					МассивЗаказовПоставщиков.Добавить(Запись.ДокументЗаказПоставщика);
				КонецЕсли;

			КонецЕсли;
		КонецЦикла;

		Если ПарыЗакупокДляСинхронизации.Количество() > 0 Тогда

			Для каждого Запись Из Набор Цикл

				Если Не Запись.Удаление И Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда

					ЦелевоеКоличествоЗакупки = ПарыЗакупокДляСинхронизации.Получить(Запись.КлючСвязиСтрок);

					Если ЦелевоеКоличествоЗакупки <> Неопределено И Запись.Количество = ЦелевоеКоличествоЗакупки И Не ЗначениеЗаполнено(Запись.Партия) Тогда



						Запись.СтатусСтроки = ЦелевойСтатус;
						Запись.ОтметкаСтроки = Ложь;
						Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
						Изменено = Истина;
						ПарыЗакупокДляСинхронизации.Удалить(Запись.КлючСвязиСтрок);

					КонецЕсли;

				КонецЕсли;
			КонецЦикла;

		КонецЕсли;

		Если Изменено Тогда
			Попытка
				Набор.Записать();
			Исключение
				ЗаписьЖурналаРегистрации("АРМ.ЗаписьСтатусовСнабжение", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));






			КонецПопытки;
		КонецЕсли;

	КонецЦикла;

	Если ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Собран И МассивЗаказовПоставщиков.Количество() > 0 Тогда

		НачатьТранзакцию();


		Попытка
			СтавкаНДС20 = НайтиСтавкуНДС();
			СоответствиеДокументовПН = Новый Соответствие;

			Для каждого ЗаказПост Из МассивЗаказовПоставщиков Цикл

				ПН_Объект = Документы.ПриходнаяНакладная.СоздатьДокумент();
				ПН_Объект.Дата = ТекущаяДатаСеанса();
				ПН_Объект.Заполнить(Неопределено);
				ПН_Объект.Запасы.Очистить();
				ЗаказПостОбъект = ЗаказПост.ПолучитьОбъект();
				ЗаполнитьЗначенияСвойств(ПН_Объект, ЗаказПостОбъект, "Организация, Контрагент, Договор, ВалютаДокумента, Кратность, Курс, СуммаВключаетНДС, НалогообложениеНДС");
				ПН_Объект.Заказ = ЗаказПост;
				ПН_Объект.ДокументОснование = ЗаказПост;
				ПН_Объект.ДополнительныеСвойства.Вставить("Арм_ПрограммнаяЗапись", Истина);

				ПараметрыРасчетаПН = Новый Структура("СуммаВключаетНДС", ПН_Объект.СуммаВключаетНДС);

				ЗапросСтрокПрихода = Новый Запрос;
				ЗапросСтрокПрихода.Текст = "ВЫБРАТЬ
				|	Т.*
				|ИЗ
				|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
				|ГДЕ
				|	Т.ИдентификаторЗаписи В (&МассивИдентификаторов)
				|	И Т.ДокументЗаказПоставщика = &ЗаказПост
				|	И НЕ Т.Удаление";

				ЗапросСтрокПрихода.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
				ЗапросСтрокПрихода.УстановитьПараметр("ЗаказПост", ЗаказПост);
				ТаблицаСтрокПрихода = ЗапросСтрокПрихода.Выполнить().Выгрузить();

				Для каждого СтрРег Из ТаблицаСтрокПрихода Цикл

					НоваяСтрПН = ПН_Объект.Запасы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрПН, СтрРег);

					НоваяПартияСсылка = Справочники.ПартииНоменклатуры.ПустаяСсылка();
					Если Не ЗначениеЗаполнено(СтрРег.Партия) Тогда
						ПартияОбъект = Справочники.ПартииНоменклатуры.СоздатьЭлемент();
						ПартияОбъект.ВладелецПартии = СтрРег.Поставщик;
						ПартияОбъект.Владелец = СтрРег.Номенклатура;
						ПартияОбъект.Наименование = СтрШаблон("АРМ Поставка (%1) от %2", ЗаказПостОбъект.Контрагент, Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy"));




						ПартияОбъект.Статус = Перечисления.СтатусыПартий.СобственныеЗапасы;
						Попытка
							ПартияОбъект.Записать();
							НоваяПартияСсылка = ПартияОбъект.Ссылка;
						Исключение
							ВызватьИсключение "Ошибка при создании партии " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						КонецПопытки;
					КонецЕсли;

					НоваяСтрПН.Партия = НоваяПартияСсылка;

					НоваяСтрПН.ЗаказПокупателя = СтрРег.ДокументЗаказПокупателя;

					Если Не ЗначениеЗаполнено(НоваяСтрПН.ЕдиницаИзмерения) Тогда
						НоваяСтрПН.ЕдиницаИзмерения = СтрРег.Номенклатура.ЕдиницаИзмерения;
					КонецЕсли;

					ПН_Объект.Заказ = ЗаказПост;
					НоваяСтрПН.Цена = СтрРег.Цена;
					НоваяСтрПН.Сумма = НоваяСтрПН.Количество * НоваяСтрПН.Цена;
					НоваяСтрПН.СтавкаНДС = СтавкаНДС20;
					ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммуНДСИВсего(НоваяСтрПН, ПараметрыРасчетаПН);

				КонецЦикла;

				ПН_Объект.Записать(РежимЗаписиДокумента.Проведение);
				СоответствиеДокументовПН.Вставить(ЗаказПост, ПН_Объект.Ссылка);

			КонецЦикла;

			ЗафиксироватьТранзакцию();
		Исключение

			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации("АРМ.ОшибкаКанбанСнабжения", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);







			Итог.ТекстОшибки = СтрШаблон("Сбой базы данных: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат Итог;
		КонецПопытки;

		ЗапросНоменклатуры = Новый Запрос;
		ЗапросНоменклатуры.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.Номенклатура КАК Номенклатура,
		|	Т.ДокументЗаказПокупателя КАК Заказ
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.ИдентификаторЗаписи В(&МассивИдентификаторов)
		|	И НЕ Т.Удаление";

		ЗапросНоменклатуры.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
		ТаблицаНоменклатуры = ЗапросНоменклатуры.Выполнить().Выгрузить();

		Для каждого ТекущийЗаказ Из ВыгрузкаЗаказов Цикл

			НаборПН = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
			НаборПН.Отбор.ДокументЗаказПокупателя.Установить(ТекущийЗаказ);
			НаборПН.Прочитать();

			ИзмененоПН = Ложь;
			КуцыеЗакупки = Новый Соответствие;

			Для каждого ЗаписьПН Из НаборПН Цикл
				Если Не ЗаписьПН.Удаление И ЗаписьПН.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка Тогда
					СсылкаНаПН = СоответствиеДокументовПН.Получить(ЗаписьПН.ДокументЗаказПоставщика);
					Если СсылкаНаПН <> Неопределено Тогда

						ЗаписьПН.ДокументПриходнаяНакладная = СсылкаНаПН;
						ЗаполнитьУПДИзПриходнойЕслиЕсть(ЗаписьПН); // v2.11 (T05)
						КуцыеЗакупки.Вставить(ЗаписьПН.КлючСвязиСтрок, ЗаписьПН.Количество);
						ИзмененоПН = Истина;

					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

			Для каждого ЗаписьПН Из НаборПН Цикл
				Если Не ЗаписьПН.Удаление И ЗаписьПН.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда

					ЦелевоеКоличество = КуцыеЗакупки.Получить(ЗаписьПН.КлючСвязиСтрок);

					Если ЦелевоеКоличество <> Неопределено И ЗаписьПН.Количество = ЦелевоеКоличество И Не ЗначениеЗаполнено(ЗаписьПН.Партия) Тогда



						СсылкаНаПН = СоответствиеДокументовПН.Получить(ЗаписьПН.ДокументЗаказПоставщика);
						Если СсылкаНаПН <> Неопределено Тогда

							ЗаписьПН.ДокументПриходнаяНакладная = СсылкаНаПН;
							ЗаполнитьУПДИзПриходнойЕслиЕсть(ЗаписьПН); // v2.11 (T05)
							КуцыеЗакупки.Удалить(ЗаписьПН.КлючСвязиСтрок);
							ИзмененоПН = Истина;

						КонецЕсли;
					КонецЕсли;

				КонецЕсли;
			КонецЦикла;

			Если ИзмененоПН Тогда
				Попытка
					НаборПН.Записать();
				Исключение
					ЗаписьЖурналаРегистрации("АРМ.ЗаписьПНВРегистр", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), );






				КонецПопытки;
			КонецЕсли;
		КонецЦикла;

		Для каждого СтрНом Из ТаблицаНоменклатуры Цикл
			ПолучитьОстаткиПоСтрокам(СтрНом.Номенклатура, СтрНом.Заказ);
		КонецЦикла;
































	КонецЕсли;

	Итог.Успешно = Истина;
	Итог.КоличествоОбработанных = КоличествоИзмененных;

	Возврат Итог;

КонецФункции


// v2.11 (T05, D4): ДатаУПД / НомерУПД строки регистра из приходной накладной - ТОЛЬКО если в ней есть подходящие
// реквизиты (разведка по метаданным в рантайме: кандидаты - входящие номер/дата документа поставщика) и в строке
// поля ещё пусты. Если реквизитов нет - ничего не делает, поля заполняются вручную по ACL (роль × статус × поле).
// Запись набора выполняет вызывающий код.
Процедура ЗаполнитьУПДИзПриходнойЕслиЕсть(ЗаписьРегистра)

	Если ЗначениеЗаполнено(ЗаписьРегистра.ДатаУПД) И ЗначениеЗаполнено(ЗаписьРегистра.НомерУПД) Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗаписьРегистра.ДокументПриходнаяНакладная) Тогда
		Возврат;
	КонецЕсли;

	Реквизиты = Метаданные.Документы.ПриходнаяНакладная.Реквизиты;
	ИмяДаты = "";
	Для Каждого Кандидат Из СтрРазделить("ДатаВходящегоДокумента,ДатаУПД,ДатаДокументаПоставщика", ",") Цикл
		Если Реквизиты.Найти(Кандидат) <> Неопределено Тогда
			ИмяДаты = Кандидат;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ИмяНомера = "";
	Для Каждого Кандидат Из СтрРазделить("НомерВходящегоДокумента,НомерУПД,НомерДокументаПоставщика", ",") Цикл
		Если Реквизиты.Найти(Кандидат) <> Неопределено Тогда
			ИмяНомера = Кандидат;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(ИмяДаты) И ПустаяСтрока(ИмяНомера) Тогда
		Возврат;
	КонецЕсли;

	СписокРеквизитов = ?(ПустаяСтрока(ИмяДаты), "", ИмяДаты) + ?(ПустаяСтрока(ИмяДаты) Или ПустаяСтрока(ИмяНомера), "", ",")
		+ ?(ПустаяСтрока(ИмяНомера), "", ИмяНомера);
	Значения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаписьРегистра.ДокументПриходнаяНакладная, СписокРеквизитов);

	Если Не ПустаяСтрока(ИмяДаты) И Не ЗначениеЗаполнено(ЗаписьРегистра.ДатаУПД)
		И ТипЗнч(Значения[ИмяДаты]) = Тип("Дата") И ЗначениеЗаполнено(Значения[ИмяДаты]) Тогда
		ЗаписьРегистра.ДатаУПД = Значения[ИмяДаты];
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяНомера) И Не ЗначениеЗаполнено(ЗаписьРегистра.НомерУПД) Тогда
		ЗаписьРегистра.НомерУПД = Лев(СокрЛП(Строка(Значения[ИмяНомера])), 50);
	КонецЕсли;

КонецПроцедуры

Функция НайтиСтавкуНДС() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтавкиНДС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|ГДЕ
	|	СтавкиНДС.Наименование = &Наименование
	|	И НЕ СтавкиНДС.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтавкиНДС.Ссылка
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|ГДЕ
	|	СтавкиНДС.Ставка = &РазмерСтавки
	|	И НЕ СтавкиНДС.ПометкаУдаления";


	Запрос.УстановитьПараметр("Наименование", "20%");
	Запрос.УстановитьПараметр("РазмерСтавки", 20);
	РезультатЗапросаСтавка = Запрос.Выполнить();
	ВыборкаСтавкаНДС = РезультатЗапросаСтавка.Выбрать();

	Если ВыборкаСтавкаНДС.Следующий() Тогда
		Возврат ВыборкаСтавкаНДС.Ссылка;
	КонецЕсли;

	Возврат Справочники.СтавкиНДС.ПустаяСсылка();

КонецФункции




