	ПолеЦена = ЭлементЗакупки.Поля.Элементы.Добавить();
	ПолеЦена.Поле = Новый ПолеКомпоновкиДанных("Цена");
	
	ПолеПоставщик = ЭлементЗакупки.Поля.Элементы.Добавить();
