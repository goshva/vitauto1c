	ПолеНом = ЭлементНом.Поля.Элементы.Добавить();
	ПолеНом.Поле = Новый ПолеКомпоновкиДанных("Номенклатура");
	
	// дата отгрузки
	ЭлементДатаОтгрузки = ДанныеАРМОтображение.УсловноеОформление.Элементы.Добавить();
	ЭлементДатаОтгрузки.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветОшибки);

	ОтборДатаОтгрузки = ЭлементДатаОтгрузки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборДатаОтгрузки.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДатаОтгрузки");
	ОтборДатаОтгрузки.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеЗаполнено;

	ПолеОфДатаОтгрузки = ЭлементДатаОтгрузки.Поля.Элементы.Добавить();
	ПолеОфДатаОтгрузки.Поле = Новый ПолеКомпоновкиДанных("ДатаОтгрузки"); 
	
	// Номер отгрузки (v2.10): красным не подсвечивается - заполняется системно из РН.

	// 2. Поля "ДатаПоступления", "Цена" и "Поставщик" в закупках
	ЭлементЗакупки = ДанныеАРМОтображениеЗакупки.УсловноеОформление.Элементы.Добавить();
	ЭлементЗакупки.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветОшибки);

	// Условие: Только для тех строк, где стоит галка "Заказать"
	ОтборГалка = ЭлементЗакупки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборГалка.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ОтметкаСтроки");
	ОтборГалка.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборГалка.ПравоеЗначение = Истина;

	// Группа условий "ИЛИ" для пустых полей
	ГруппаИЛИ = ЭлементЗакупки.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;

	// Цена не заполнена
	ОтборЦена = ГруппаИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЦена.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Цена");
	ОтборЦена.ВидСравнения  = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
	ОтборЦена.ПравоеЗначение = 0; 
	
	// Поставщик не заполнен
	ОтборПоставщик = ГруппаИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПоставщик.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Поставщик");
	ОтборПоставщик.ВидСравнения  = ВидСравненияКомпоновкиДанных.НеЗаполнено; 
	
