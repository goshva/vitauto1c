&НаСервере
Процедура ИзменитьЦенуНаСервере(ДанныеСтроки)

	// v2.11 (T01): серверная проверка прав на поле (роль × статус × поле).
	ПроверитьПравоНаПолеИлиОтказать(ДанныеСтроки.ИдентификаторЗаписи, "Цена");
	// v2.12.1 (audit F-11): нулевая/отрицательная цена не записывается.
	Если ДанныеСтроки.Цена <= 0 Тогда
		ЗаписьЖурналаРегистрации("АРМ.ОтказДанных", УровеньЖурналаРегистрации.Предупреждение,,,
			СтрШаблон("Цена <= 0, строка %1 - запись пропущена", Строка(ДанныеСтроки.ИдентификаторЗаписи)));
		Возврат;
	КонецЕсли;
	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(ДанныеСтроки.ИдентификаторЗаписи);
	Набор.Прочитать();
	Запись = Набор[0];
	Запись.Цена = ДанныеСтроки.Цена;
	ПересчитатьЦеныСтрокиАРМ(Запись, "Цена");
	Попытка
		Набор.Записать();       
	Исключение
		ТекстОшибки = СтрШаблон(
			"Ошибка записи в АРМ-регистр. Цена: %1, Описание: %2", 
			Строка(ДанныеСтроки.ИдентификаторЗаписи), 
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
		);
		ЗаписьЖурналаРегистрации("АРМ.ЗаписьДанных", УровеньЖурналаРегистрации.Ошибка, ,	, ТекстОшибки);
	КонецПопытки;
КонецПроцедуры

&НаСервере
