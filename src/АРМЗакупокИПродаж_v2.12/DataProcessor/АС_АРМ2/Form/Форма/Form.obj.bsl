&НаКлиенте
Процедура ДанныеАРМОтображениеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
    СтандартнаяОбработка = Ложь;
	
    ДанныеСтроки = Элемент.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Администратор: без проверки статуса. Свои обработчики Выбор работают как раньше,
	// плюс общий ввод для ПоляРедактируемыеАдминистратором(). Колонки вне whitelist — только просмотр.
	Если РежимАдминистратораАРМ = Истина Тогда

		Если ТипЗнч(ВыбраннаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка")
			Или Не ДанныеСтроки.Свойство("ИдентификаторЗаписи")
			Или ДанныеСтроки.Свойство("ГруппировкаСтроки") Тогда
			Возврат;
		КонецЕсли;
		Если ДанныеСтроки.Свойство("СтрокаЗаблокирована") И ДанныеСтроки.СтрокаЗаблокирована = Истина Тогда
			Возврат;
		КонецЕсли;

		ПрефиксАдмин = "ДанныеАРМОтображение";
		ИмяПоляАдмин = "";
		Если СтрНачинаетсяС(Поле.Имя, ПрефиксАдмин) Тогда
			ИмяПоляАдмин = Сред(Поле.Имя, СтрДлина(ПрефиксАдмин) + 1);
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяПоляАдмин)
			И СтрНайти("," + ПоляИзменяемыеАдминистратором() + ",", "," + ИмяПоляАдмин + ",") = 0 Тогда
			Возврат; // колонка матрицы «только просмотр» / реквизит номенклатуры / заглушка
		КонецЕсли;
		Если ОбработатьВыборАдминистратора(Поле, ДанныеСтроки) Тогда
			Возврат;
		КонецЕсли;
		// Иначе — ниже сработают штатные обработчики (номенклатура, количество, …) без отсечения по статусу.

	Иначе

		Если Не ДанныеСтроки.Свойство("СтатусСтроки") Тогда
			Возврат;
		КонецЕсли;

		// v2.11 (T01): жёсткий список статусов ВРаботе/Собран/Черновик заменён матрицей прав (роль × статус × поле):
		// проверка ниже (ОтказПоПравамАРМ) и повторно на сервере при записи.
		Если ДанныеСтроки.Свойство("СтрокаЗаблокирована") И ДанныеСтроки.СтрокаЗаблокирована Тогда
			Возврат;
		КонецЕсли;

	КонецЕсли;

	Если ТипЗнч(ВыбраннаяСтрока) = Тип("СтрокаГруппировкиДинамическогоСписка") Тогда
		Если ВыбраннаяСтрока.ИмяГруппировки = "ДокументЗаказПокупателя" Тогда
			ПоказатьЗначение(, ВыбраннаяСтрока.Ключ);	
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ДанныеСтроки.Свойство("ГруппировкаСтроки") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДанныеСтроки.Свойство("ИдентификаторЗаписи") Тогда
		Возврат;
	КонецЕсли;

	// v2.11 (T02): общий ввод (покупатель, договор, марка, госномер…) для ролей без Администратора - по ACL.
	// Администратор обработан выше.
	Если РежимАдминистратораАРМ <> Истина Тогда
		Если ОбработатьВыборАдминистратора(Поле, ДанныеСтроки) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	// v2.11 (T01): права на правку этой колонки (роль × статус × поле) - до открытия диалога ввода.
	ИмяПоляАРМ = ИмяПоляРегистраПоЭлементуАРМ(Поле.Имя);
	Если ЗначениеЗаполнено(ИмяПоляАРМ) Тогда
		ТекстОтказа = ОтказПоПравамАРМ(ДанныеСтроки.ИдентификаторЗаписи, ИмяПоляАРМ);
		Если ЗначениеЗаполнено(ТекстОтказа) Тогда
			ПоказатьОповещениеПользователя("Внимание!", , ТекстОтказа);
			Возврат;
		КонецЕсли;
	КонецЕсли;
    
	Если Поле.Имя = "ДанныеАРМОтображениеНоменклатура" //Или Поле.Имя = "ДанныеАРМОтображениеЗакупкиНоменклатура" 
		Или Поле.Имя = "ДанныеАРМОтображениеНоменклатураАртикул" Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ИдентификаторЗаписи", ДанныеСтроки.ИдентификаторЗаписи);
		ДопПараметры.Вставить("ИмяПоля", "Номенклатура");
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораЗначенияНоменклатура", ЭтотОбъект, ДопПараметры);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина); 
		ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
		
		ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыФормы, Элемент, , , , Оповещение);
		
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеЗакупкиНоменклатура" Тогда
		
		ТекстСообщения = "Если Вы хотите закупить товар-аналог, в Закупках " 
			+ "нажмите ""Скопировать продажу"" и выберите нужный товар";
		ПоказатьОповещениеПользователя("Внимание!", , ТекстСообщения);
		Возврат;
		
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеКомментарийКСтроке" Тогда
		
		Если Не ДанныеСтроки.Свойство("КомментарийКСтроке") Тогда
			Возврат;
		КонецЕсли;
		СтрокаДляВвода = ДанныеСтроки.КомментарийКСтроке;
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаКомментария", ЭтотОбъект, ДанныеСтроки);
		ПоказатьВводСтроки(ОписаниеОповещения, СтрокаДляВвода, "Введите комментарий к строке:", 150, Ложь);
		
	//ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеГРЗКлиента" Тогда
	//	
	//	Если Не ДанныеСтроки.Свойство("ГРЗКлиента") Тогда
	//		Возврат;
	//	КонецЕсли;
	//	СтрокаДляВвода = ДанныеСтроки.ГРЗКлиента;
	//	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаГРЗКлиента", ЭтотОбъект, ДанныеСтроки);
	//	ПоказатьВводСтроки(ОписаниеОповещения, СтрокаДляВвода, "Введите ГРЗ:", 10, Ложь);
		
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеКоличество" Или Поле.Имя = "ДанныеАРМОтображениеЗакупкиКоличество" Тогда
		
		Если Не ДанныеСтроки.Свойство("Количество") Тогда
			Возврат;
		КонецЕсли;
		ЧислоДляВвода = ДанныеСтроки.Количество;
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаКоличества", ЭтотОбъект, ДанныеСтроки);
		ПоказатьВводЧисла(ОписаниеОповещения, ЧислоДляВвода, "Введите количество:", 15, 3);
		
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеЦена" Или Поле.Имя = "ДанныеАРМОтображениеЗакупкиЦена" Тогда
		
		Если Не ДанныеСтроки.Свойство("Цена") Тогда
			Возврат;
		КонецЕсли;
		ЧислоДляВвода = ДанныеСтроки.Цена;
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаЦены", ЭтотОбъект, ДанныеСтроки);
		ПоказатьВводЧисла(ОписаниеОповещения, ЧислоДляВвода, "Введите цену:", 15, 3);
		
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеКоэффициент" Тогда
		
		Если Не ДанныеСтроки.Свойство("Коэффициент") Тогда
			Возврат;
		КонецЕсли;
		ЧислоДляВвода = ДанныеСтроки.Коэффициент;
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаКоэффициента", ЭтотОбъект, ДанныеСтроки);
		ПоказатьВводЧисла(ОписаниеОповещения, ЧислоДляВвода, "Введите коэффициент:", 15, 3);
	
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеВидОперации" Или Поле.Имя = "ДанныеАРМОтображениеЗакупкиВидОперации" Тогда
		
		Возврат;
		
		Если ЗначениеЗаполнено(ДанныеСтроки.Номенклатура) 
			И ДанныеСтроки.ВидОперации = ПредопределенноеЗначение("Перечисление.Арм_ВидыОпераций.Закупка") Тогда
			Возврат;
		КонецЕсли;
		
		Если ДанныеСтроки.ИдентификаторЗаписи <> ДанныеСтроки.КлючСвязиСтрок Тогда
			ВыбранноеЗначение = Неопределено;
			ТипВыбора = Новый ОписаниеТипов("ПеречислениеСсылка.Арм_ВидыОпераций");
			Оповещение = Новый ОписаниеОповещения("ЗавершениеВыбораВидаОперации", ЭтотОбъект, ДанныеСтроки);
			ПоказатьВводЗначения(Оповещение, Неопределено, "Выберите вид операции", ТипВыбора);
		КонецЕсли;
		
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеПартия" Тогда
		
		СтандартнаяОбработка = Ложь;
		Если ДанныеСтроки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если Не ДанныеСтроки.Свойство("Номенклатура") Тогда
			Возврат;
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораПартии", ЭтотОбъект, ДанныеСтроки);
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Номенклатура", ДанныеСтроки.Номенклатура);
		ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
		ОткрытьФорму("Справочник.ПартииНоменклатуры.Форма.Арм_ФормаВыбора", ПараметрыОткрытия, Элемент, , , , Оповещение);
		
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеЗакупкиПоставщик" Тогда
		    
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораПоставщика", ЭтотОбъект, ДанныеСтроки); 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина); 
		ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
		ОткрытьФорму("Справочник.Контрагенты.ФормаСписка", ПараметрыФормы , Элемент, , , , Оповещение);
		
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеВидУслуги" Тогда
		    
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораУслуги", ЭтотОбъект, ДанныеСтроки); 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина); 
		ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
		ОткрытьФорму("Справочник.Арм_ВидыУслуги.ФормаВыбора", ПараметрыФормы , Элемент, , , , Оповещение);
		
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеФормаОплаты" Тогда
		    
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораФормыОплаты", ЭтотОбъект, ДанныеСтроки); 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина); 
		ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
		ОткрытьФорму("Справочник.Арм_ФормыОплаты.ФормаВыбора", ПараметрыФормы , Элемент, , , , Оповещение);
		
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеЗакупкиДоговор" Тогда
		
		Если Не ДанныеСтроки.Свойство("Поставщик") Тогда
			Возврат;
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораДоговора", ЭтотОбъект, ДанныеСтроки);
		
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Владелец", ДанныеСтроки.Поставщик);
		ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
		ОткрытьФорму("Справочник.ДоговорыКонтрагентов.Форма.ФормаВыбора", ПараметрыОткрытия, Элемент, , , , Оповещение);
		
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеДатаОтгрузки" Тогда
		
		Если Не ДанныеСтроки.Свойство("ДатаОтгрузки") Тогда
			Возврат;
		КонецЕсли;
		
		Если ДанныеСтроки.Свойство("Партия") И Не ЗначениеЗаполнено(ДанныеСтроки.Партия) Тогда
			Возврат;
		КонецЕсли;
		
		ДатаДляВвода = ?(ЗначениеЗаполнено(ДанныеСтроки.ДатаОтгрузки), ДанныеСтроки.ДатаОтгрузки, ТекущаяДата());
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаДатыОтгрузки", ЭтотОбъект, ДанныеСтроки);
		ПоказатьВводДаты(ОписаниеОповещения, ДатаДляВвода, "Укажите дату отгрузки:", ЧастиДаты.Дата);	
		
	ИначеЕсли Поле.Имя = "ДанныеАРМОтображениеНомерОтгрузки" Тогда
		
		// Номер отгрузки только системно из РН (матрица RO) - ручной ввод отключен.
		ПоказатьПредупреждение(, "Номер заполняется из расходной накладной.");
		Возврат;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаказПоставщику(Команда)
	СоздатьЗаказПоставщикуНаСервере();
