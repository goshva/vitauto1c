&НаСервере
Процедура СоздатьЗаказыПоставщикамНаСервере_________2(ТЗ_Данные)
	
	ТЗ_Поставщики = ТЗ_Данные.Скопировать();
	ТЗ_Поставщики.Свернуть("Поставщик, Договор, ДокументЗаказПокупателя");
	
	Для Каждого СтрПоставщик Из ТЗ_Поставщики Цикл
		
		Если Не ЗначениеЗаполнено(СтрПоставщик.Поставщик) Тогда 
			Продолжить; 
		КонецЕсли;
		
		ЗаказОбъект = Документы.ЗаказПоставщику.СоздатьДокумент();
		ЗаказОбъект.Заполнить(Неопределено);
		ЗаказОбъект.Дата = ТекущаяДатаСеанса();
		ЗаказОбъект.Контрагент = СтрПоставщик.Поставщик;
		
		СостояниеЗаказа = Справочники.СостоянияЗаказовПоставщикам.НайтиПоНаименованию("В работе");
		Если СостояниеЗаказа = Неопределено Тогда
			СостояниеЗаказа = Справочники.СостоянияЗаказовПоставщикам.СоздатьЭлемент();
			СостояниеЗаказа.Наименование = "В работе";
			СостояниеЗаказа.Записать();	
		КонецЕсли;
		
		ЗаказОбъект.СостояниеЗаказа = СостояниеЗаказа.Ссылка;
		
		Если ЗначениеЗаполнено(СтрПоставщик.Договор) Тогда
			ДоговорПоставщика = СтрПоставщик.Договор;
		Иначе
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
				|ГДЕ
				|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
				|	И ДоговорыКонтрагентов.Владелец.Ссылка = &Ссылка
				|	И НЕ ДоговорыКонтрагентов.Владелец.Недействителен
				|	И ДоговорыКонтрагентов.ДатаДоговора <= &ТекущаяДата
				|	И ДоговорыКонтрагентов.СрокДействия >= &ТекущаяДата
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	ДоговорыКонтрагентов.Ссылка
				|ИЗ
				|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
				|ГДЕ
				|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
				|	И ДоговорыКонтрагентов.Владелец.Ссылка = &Ссылка
				|	И НЕ ДоговорыКонтрагентов.Владелец.Недействителен
				|	И ДоговорыКонтрагентов.СрокДействия = ДАТАВРЕМЯ(1, 1, 1)";
			
			Запрос.УстановитьПараметр("Ссылка", СтрПоставщик.Поставщик);
			Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
			РезультатЗапроса = Запрос.Выполнить();
			ВыборкаДоговор = РезультатЗапроса.Выбрать();
			
			Если ВыборкаДоговор.Следующий() Тогда
				ДоговорПоставщика = ВыборкаДоговор.Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		ЗаказОбъект.Договор = ДоговорПоставщика;		
		ЗаказОбъект.ДатаПоступления = ТекущаяДатаСеанса();
	    ЗаказОбъект.ДокументОснование = СтрПоставщик.ДокументЗаказПокупателя;
		ЗаказОбъект.ЗаказПокупателя = СтрПоставщик.ДокументЗаказПокупателя;
		
		СтрокиДляЗаказа = ТЗ_Данные.НайтиСтроки(Новый Структура("Поставщик", СтрПоставщик.Поставщик));
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	СтавкиНДС.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.СтавкиНДС КАК СтавкиНДС
			|ГДЕ
			|	СтавкиНДС.Наименование = &Наименование
			|	И НЕ СтавкиНДС.ПометкаУдаления
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	СтавкиНДС.Ссылка
			|ИЗ
			|	Справочник.СтавкиНДС КАК СтавкиНДС
			|ГДЕ
			|	СтавкиНДС.Ставка = &РазмерСтавки
			|	И НЕ СтавкиНДС.ПометкаУдаления";
		
		Запрос.УстановитьПараметр("Наименование", "20%");
		Запрос.УстановитьПараметр("РазмерСтавки", 20);
		РезультатЗапросаСтавка = Запрос.Выполнить();
		ВыборкаСтавкаНДС = РезультатЗапросаСтавка.Выбрать();
		
		Если ВыборкаСтавкаНДС.Следующий() Тогда
			СтавкаНДС = ВыборкаСтавкаНДС.Ссылка; 
		КонецЕсли;
		
		Для Каждого Стр Из СтрокиДляЗаказа Цикл
			
			НоваяСтр = ЗаказОбъект.Запасы.Добавить();
			НоваяСтр.Номенклатура = Стр.Номенклатура;
			НоваяСтр.Количество = Стр.Количество;
			НоваяСтр.Цена = Стр.Цена;
			НоваяСтр.Сумма = Стр.Количество * Стр.Цена;
			НоваяСтр.СтавкаНДС = СтавкаНДС;

			ПараметрыРасчета = Новый Структура;
			ПараметрыРасчета.Вставить("СуммаВключаетНДС", ЗаказОбъект.СуммаВключаетНДС);
			ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммуНДСИВсего(НоваяСтр, ПараметрыРасчета) ;
			
		КонецЦикла;
		
		ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
		ОбновитьСсылкуВРегистре(СтрокиДляЗаказа, ЗаказОбъект.Ссылка);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСсылкуВРегистре(СтрокиТЗ, СсылкаНаЗаказ = Неопределено)
	Для Каждого Стр Из СтрокиТЗ Цикл
		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
		Набор.Отбор.ИдентификаторЗаписи.Установить(Стр.ИдентификаторЗаписи);
		Набор.Прочитать();
		Если Набор.Количество() > 0 Тогда
			//Набор[0].СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Заказано;
			Если ЗначениеЗаполнено(СсылкаНаЗаказ) Тогда
				Набор[0].ДокументЗаказПоставщика = СсылкаНаЗаказ;
			КонецЕсли;
			Набор.Записать(); 
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЗаказПокупателя(Команда)
	ОткрытьФорму("Документ.ЗаказПокупателя.ФормаОбъекта");
КонецПроцедуры

&НаКлиенте
Процедура Подготовлено(Команда)
	ПодготовленоНаСервере();
	Элементы.ДанныеАРМОтображение.Обновить();
	Элементы.ДанныеАРМОтображениеЗакупки.Обновить();
КонецПроцедуры

&НаСервере
Процедура ПодготовленоНаСервере()

	// v2.12.1 (audit F-02): серверный gate роли (менеджер/администратор).
	ТекстОтказаРоли = ОтказЕслиНеМенеджерИлиАдминАРМ();
	Если ЗначениеЗаполнено(ТекстОтказаРоли) Тогда
		ЗаписьЖурналаРегистрации("АРМ.ОтказПрав", УровеньЖурналаРегистрации.Предупреждение,,,
			СтрШаблон("%1: %2", "Подготовлено", ТекстОтказаРоли));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОтказаРоли);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =  
		"ВЫБРАТЬ
		|	Т_Закупка.КлючСвязиСтрок КАК КлючСвязиСтрок
		|ПОМЕСТИТЬ втНезавершенныеЗакупки
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т_Закупка
		|ГДЕ
		|	Т_Закупка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
		|	И Т_Закупка.СтатусСтроки <> ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.НаСкладе)
		|	И НЕ Т_Закупка.Удаление
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.ОтметкаСтроки = ИСТИНА
		|	И Т.АвторСтроки = &АвторСтроки
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|	И Т.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	И Т.Поставщик <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|	И Т.Количество <> 0
		|	И Т.Цена <> 0
		|	И Т.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.ВРаботе)
		|	И НЕ Т.Удаление
		|	И НЕ Т.КлючСвязиСтрок В
		|				(ВЫБРАТЬ
		|					втНезавершенныеЗакупки.КлючСвязиСтрок КАК КлючСвязиСтрок
		|				ИЗ
		|					втНезавершенныеЗакупки КАК втНезавершенныеЗакупки)";
	
	Запрос.УстановитьПараметр("АвторСтроки", ПараметрыСеанса.ТекущийПользователь);
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В строках есть незавершенные закупки");
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
		Набор.Отбор.ИдентификаторЗаписи.Установить(Выборка.ИдентификаторЗаписи);
		Набор.Прочитать();
		
		Если Набор.Количество() > 0 Тогда
			
			Запись = Набор[0]; 
			Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Подготовлено;
			Запись.ОтметкаСтроки = Ложь;
			Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
			
			Попытка
				Набор.Записать();
			Исключение
				ЗаписьЖурналаРегистрации("АРМ.Подготовлено к продаже", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПровестиЗаказПокупателя(Команда)
	ПровестиЗаказПокупателяНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПровестиЗаказПокупателяНаСервере()

	// v2.12.1 (audit F-02): серверный gate роли (менеджер/администратор).
	ТекстОтказаРоли = ОтказЕслиНеМенеджерИлиАдминАРМ();
	Если ЗначениеЗаполнено(ТекстОтказаРоли) Тогда
		ЗаписьЖурналаРегистрации("АРМ.ОтказПрав", УровеньЖурналаРегистрации.Предупреждение,,,
			СтрШаблон("%1: %2", "ПровестиЗаказПокупателя", ТекстОтказаРоли));
		ОбщегоНазначения.СообщитьПользователю(ТекстОтказаРоли);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
		|	Т.ДокументЗаказПокупателя КАК Заказ,
		|	Т.Покупатель КАК Покупатель,
		|	Т.Договор КАК Договор,
		|	Т.Номенклатура КАК Номенклатура,
		|	Т.Количество КАК Количество,
		|	Т.Цена КАК Цена,
		|	Т.Партия КАК Партия,
		|	Т.КоличествоНормаЧас КАК КоличествоНормаЧас
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.ОтметкаСтроки = ИСТИНА
		|	И Т.АвторСтроки = &АвторСтроки
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|	И Т.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	И Т.Количество <> 0
		|	И Т.Цена <> 0
		|	И Т.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Подготовлено)
		|	И НЕ Т.Удаление
		|ИТОГИ
		|	МАКСИМУМ(Покупатель),
		|	МАКСИМУМ(Договор)
		|ПО
		|	Заказ";
	
	Запрос.УстановитьПараметр("АвторСтроки", ПараметрыСеанса.ТекущийПользователь);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаЗаказ = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЗаказ.Следующий() Цикл
		
		Если ВыборкаЗаказ.Заказ.Пустая() Тогда 
			Продолжить; 
		КонецЕсли;
		
		ИмяДокумента = СокрЛП(Строка(ВыборкаЗаказ.Заказ));
		
		Если Не ЗначениеЗаполнено(ВыборкаЗаказ.Покупатель) Тогда
			ТекстСообщения = СтрШаблон("В документе %1 не заполнен покупатель", ИмяДокумента); 
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения); 
			Возврат;
		Иначе
			Покупатель = ВыборкаЗаказ.Покупатель;
		КонецЕсли;
		
		ДоговорПокупателя = ВыборкаЗаказ.Договор;
		Если Не ЗначениеЗаполнено(ДоговорПокупателя) Тогда
			ДоговорПокупателя = Арм_ОбщегоНазначенияАРМ.НайтиДоговор(Покупатель);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДоговорПокупателя) Тогда
			ТекстСообщения = СтрШаблон("В документе %1 не заполнен договор", ИмяДокумента); 
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения); 
			Возврат;	
		КонецЕсли;
		
		ОбъектЗаказа = ВыборкаЗаказ.Заказ.ПолучитьОбъект();
        ОбъектЗаказа.Контрагент = Покупатель;
		ОбъектЗаказа.Договор = ДоговорПокупателя;
		
		ОбъектЗаказа.Запасы.Очистить(); 
		
		// v2.12.1 (audit F-04): строки регистра закрываем только после успешного проведения документа.
		ИдентификаторыЗаказа = Новый Массив;
		
		ВыборкаДетали = ВыборкаЗаказ.Выбрать();
		Пока ВыборкаДетали.Следующий() Цикл
			
			НоваяСтрока = ОбъектЗаказа.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетали);
			ИдентификаторыЗаказа.Добавить(ВыборкаДетали.ИдентификаторЗаписи);
			
		КонецЦикла;
		
		Попытка
			ОбъектЗаказа.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			// Документ не проведён - статусы и отметки строк регистра не трогаем.
			Сообщить("Не удалось провести " + СокрЛП(Строка(ОбъектЗаказа)) + ": " + ОписаниеОшибки());
			Продолжить;
		КонецПопытки;
		
		Для Каждого ИдентификаторСтроки Из ИдентификаторыЗаказа Цикл
			
			Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
			Набор.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторСтроки);
			Набор.Прочитать();
			
			Если Набор.Количество() > 0 Тогда
				
				Запись = Набор[0]; 
				Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Завершено;
				Запись.ОтметкаСтроки = Ложь;
				Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
				
				Попытка
					Набор.Записать();
				Исключение
					ЗаписьЖурналаРегистрации(
						"АРМ.Проведение Заказа покупателя", 
						УровеньЖурналаРегистрации.Ошибка, 
						, 
						, 
						ОписаниеОшибки()
					);
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

