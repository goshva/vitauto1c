&НаКлиенте
Перем РежимАдминистратораАРМ; // Истина — роль интерфейса «Администратор»: правка колонок матрицы двойным щелчком

#Область ОбработчикиФормы

&НаКлиенте
Процедура ДобавитьСтрокиПодборНоменклатуры(Команда)
	ТекущиеДанныеСтрока = Элементы.ДанныеАРМОтображение.ТекущиеДанные;
	Если ТекущиеДанныеСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанныеСтрока.Свойство("ГруппировкаСтроки") Тогда
		ТекстСообщения = "Для копирования строки встаньте на строку, а не на группировку";
		ПоказатьОповещениеПользователя("Внимание!", , ТекстСообщения);
		Возврат;
	КонецЕсли;
	ДобавитьСтрокиПодборНоменклатурыНаСервере(ТекущиеДанныеСтрока);
	ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.Арм_ДанныеЗакупокИПродаж"));
	Элементы.ДанныеАРМОтображение.Обновить();
	Элементы.ДанныеАРМОтображениеЗакупки.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокиПодборНоменклатурыЗакупка(Команда)
	ТекущиеДанныеСтрока = Элементы.ДанныеАРМОтображениеЗакупки.ТекущиеДанные;
	Если ТекущиеДанныеСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанныеСтрока.Свойство("ГруппировкаСтроки") Тогда
		ТекстСообщения = "Для копирования строки встаньте на строку, а не на группировку";
		ПоказатьОповещениеПользователя("Внимание!", , ТекстСообщения);
		Возврат;
	КонецЕсли;
	ДобавитьСтрокиПодборНоменклатурыНаСервере(ТекущиеДанныеСтрока);
	ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.Арм_ДанныеЗакупокИПродаж"));
	Элементы.ДанныеАРМОтображение.Обновить();
	Элементы.ДанныеАРМОтображениеЗакупки.Обновить();
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокиПодборНоменклатурыНаСервере(ТекущиеДанныеСтрока) 
	
	Если ТекущиеДанныеСтрока <> Неопределено Тогда
		
		НоваяЗапись = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьМенеджерЗаписи();
		НоваяЗапись.ДокументЗаказПокупателя = ТекущиеДанныеСтрока.ДокументЗаказПокупателя;
		НоваяЗапись.ДокументЗаказПоставщика = ТекущиеДанныеСтрока.ДокументЗаказПоставщика;
		НоваяЗапись.ДокументПриходнаяНакладная = ТекущиеДанныеСтрока.ДокументПриходнаяНакладная;
		НоваяЗапись.НоменклатураКлиента = ТекущиеДанныеСтрока.НоменклатураКлиента;
		НоваяЗапись.КоличествоКлиента = ТекущиеДанныеСтрока.КоличествоКлиента;
		НоваяЗапись.КлючСвязиСтрок = ТекущиеДанныеСтрока.КлючСвязиСтрок;
		НоваяЗапись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
		НоваяЗапись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик;
		НоваяЗапись.ВидОперации = ТекущиеДанныеСтрока.ВидОперации;
		
		Попытка
			НоваяЗапись.Записать();
		Исключение
			ТекстОшибки = СтрШаблон(
				"Ошибка записи в АРМ-регист. Копирование строки: %1", 
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			);
			ЗаписьЖурналаРегистрации(
				"АРМ.ВыборВидОперации", 
				УровеньЖурналаРегистрации.Ошибка, 
				, 
				, 
				ТекстОшибки
			);	
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИнвертироватьФлагНаСервере(Знач ИдентификаторЗаписи, Знач ЗначениеФлага)
	
	// v2.12 (H01, D11=A): отметка А1 — личная отметка автора строки, не cell_select матрицы.
	// Чужую отметку снять/поставить нельзя; матричный ACL к А1 не применяется.
	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
	Набор.Прочитать();
	
	Если Набор.Количество() > 0 Тогда
		
		Запись = Набор[0]; 
		
		Если ЗначениеЗаполнено(Запись.АвторСтроки) И Запись.АвторСтроки <> ПараметрыСеанса.ТекущийПользователь Тогда
			Возврат; 
		КонецЕсли;
		
		Запись.ОтметкаСтроки = Не ЗначениеФлага;
		
		Если (Не ЗначениеФлага) = Ложь Тогда
			Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
		Иначе
			Запись.АвторСтроки = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
		
		Попытка
			Набор.Записать();
		Исключение
			ТекстОшибки = СтрШаблон(
				"Ошибка записи флажка для ID %1: %2", 
				ИдентификаторЗаписи, 
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			);
			ЗаписьЖурналаРегистрации("АРМ.ОшибкаГалки", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	РежимАдминистратораАРМ = ЭтоАдминистраторАРМ();
	Элементы.ДанныеАРМОтображение.ТекущийЭлемент = Элементы.ДанныеАРМОтображениеНоменклатураКлиента;
	ПодключитьОбработчикОжидания("ОбновитьСписокПоТаймеру", 30);
	ОтображениеКнопокДокументов(Элементы.ДанныеАРМОтображениеЗакупки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВРаботе(Команда)
	
	ВыполнитьОсновнуюОбработку(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВРаботеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Элементы.Заказать.Доступность = Ложь;
		Элементы.ПровестиЗаказПокупателя.Доступность = Ложь;
		ВыполнитьОсновнуюОбработку(Истина);
	Иначе
		СброситьБлокировкуИнтерфейса();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОсновнуюОбработку(Знач ФлагРазрешитьСплит)

	СтатусыДляМенеджера = Новый Массив;
	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.ВРаботе"));
	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Черновик"));
	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Собран"));
	МассивКлючейДляФона = Арм_ОбщегоНазначенияАРМ.ПолучитьМассивОтмеченныхКлючейСвязи(СтатусыДляМенеджера);
	Если МассивКлючейДляФона.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Элементы.Заказать.Доступность = Ложь; 
	Элементы.ПровестиЗаказПокупателя.Доступность = Ложь;
	ВременноЗаблокированныеКлючи.Очистить();
	ВременноЗаблокированныеКлючи.ЗагрузитьЗначения(МассивКлючейДляФона);
	УправлятьИнтерфейснымЛокомНаСервере(МассивКлючейДляФона, Истина);
	ОбновитьСписокПоТаймеру();
	
	Попытка
		ЗапуститьФоновоеЗаданиеНаСервере(МассивКлючейДляФона, ФлагРазрешитьСплит); 
		ПодключитьОбработчикОжидания("ПроверитьСтатусФоновогоЗадания", 2);
	Исключение
		СброситьБлокировкуИнтерфейса();
		ОбщегоНазначенияКлиент.СообщитьПользователю("Критическая ошибка при попытке запустить фоновый поток.");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура УправлятьИнтерфейснымЛокомНаСервере(МассивКлючей, Знач ВключитьЛок)
	
	КоллекцияДляСКД = Новый СписокЗначений;
	Если ВключитьЛок Тогда
		КоллекцияДляСКД.ЗагрузитьЗначения(МассивКлючей);
	КонецЕсли;
	
	ДанныеАРМОтображение.Параметры.УстановитьЗначениеПараметра("ВременноЗаблокированныеКлючи", КоллекцияДляСКД);
	ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("ВременноЗаблокированныеКлючи", КоллекцияДляСКД);
	
КонецПроцедуры

&НаСервере
Процедура ЗапуститьФоновоеЗаданиеНаСервере(Знач МассивКлючей, Знач ФлагРазрешитьСплит)

	// v2.12.1 (audit F-02): серверный gate роли (менеджер/администратор).
	ТекстОтказаРоли = ОтказЕслиНеМенеджерИлиАдминАРМ();
	Если ЗначениеЗаполнено(ТекстОтказаРоли) Тогда
		ЗаписьЖурналаРегистрации("АРМ.ОтказПрав", УровеньЖурналаРегистрации.Предупреждение,,,
			СтрШаблон("%1: %2", "ЗапуститьФоновоеЗадание", ТекстОтказаРоли));
		ВызватьИсключение ТекстОтказаРоли;
	КонецЕсли;
	
	ЗапросЗаказы = Новый Запрос;
	ЗапросЗаказы.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Рег.ДокументЗаказПокупателя КАК Заказ
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
		|ГДЕ
		|	Рег.КлючСвязиСтрок В(&МассивКлючей)
		|	И НЕ Рег.Удаление";
	ЗапросЗаказы.УстановитьПараметр("МассивКлючей", МассивКлючей);
	МассивЗаказов = ЗапросЗаказы.Выполнить().Выгрузить().ВыгрузитьКолонку("Заказ");
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, ЭтотОбъект.УникальныйИдентификатор);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
	ПараметрыПроцедуры.Вставить("МассивКлючей",        МассивКлючей);
	ПараметрыПроцедуры.Вставить("МассивЗаказов",       МассивЗаказов); 
	ПараметрыПроцедуры.Вставить("АдресРезультата",     АдресРезультата);
	ПараметрыПроцедуры.Вставить("РазрешитьСплит",      ФлагРазрешитьСплит);
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(ПараметрыПроцедуры);
	
	Задание = ФоновыеЗадания.Выполнить(
		"Арм_ДанныеЗакупокИПродажФон.СформироватьЗаказыФоновоеЗадание", 
		МассивПараметров, 
		"АРМ_Заказы_" + Строка(ПараметрыСеанса.ТекущийПользователь.УникальныйИдентификатор())
	);
	
	ЭтотОбъект.ИдентификаторФоновогоЗадания   = Задание.УникальныйИдентификатор;
	ЭтотОбъект.АдресРезультатаФоновогоЗадания = АдресРезультата;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСтатусФоновогоЗадания()
	
	СостояниеЗадания = ПроверитьСтатусФоновогоНаСервере(ИдентификаторФоновогоЗадания);
	
	Если СостояниеЗадания = "Active" Или СостояниеЗадания = "Активно" Или СостояниеЗадания = "Задание выполняется" Тогда
		Возврат; 
	КонецЕсли;
	
	Если СостояниеЗадания = "Completed" Или СостояниеЗадания = "Завершено" Или СостояниеЗадания = "Задание выполнено" Тогда
		
		РезультатОбработки = ПолучитьИзВременногоХранилищаНаСервере(АдресРезультатаФоновогоЗадания);
		
		Если РезультатОбработки <> Неопределено 
			И РезультатОбработки.СтатусВалидации = "ТребуетсяПодтверждениеМенеджера" Тогда
			
			ОтключитьОбработчикОжидания("ПроверитьСтатусФоновогоЗадания");
			УдалитьИзВременногоХранилища(АдресРезультатаФоновогоЗадания);			
			ТекстВопроса = СтрШаблон(
				"Выбраны не все позиции по заказам (отмечено %1 шт. из %2 шт.). 
				|Оставшиеся строки будут перенесены в новые заказы. 
				|Продолжить?", 
				РезультатОбработки.ВсегоВыбраноШтук, 
				РезультатОбработки.ВсегоВБазеШтук
			);
			
			ПараметрыОповещения = Новый Структура("РазрешитьСплит", Истина);
			ОписаниеОповещения  = Новый ОписаниеОповещения("ВРаботеЗавершение", ЭтотОбъект, ПараметрыОповещения);
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Сплит заказа");
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПроверитьСтатусФоновогоЗадания");
	СброситьБлокировкуИнтерфейса();
	
	Если СостояниеЗадания = "Completed" Или СостояниеЗадания = "Завершено" Или СостояниеЗадания = "Задание выполнено" Тогда
		
		Если РезультатОбработки <> Неопределено Тогда
			
			Если РезультатОбработки.Успешно Тогда
				ПоказатьОповещениеПользователя("Успешно", , "Все документы оформлены!");
				ОбновитьСписокПоТаймеру();
			Иначе
				ТекстОшибкиВалидации = РезультатОбработки.ТекстОшибки;
				ПоказатьПредупреждение(, ТекстОшибкиВалидации);
				ОбновитьСписокПоТаймеру();
			КонецЕсли;
			
		Иначе
			ПоказатьПредупреждение(, "Документы обработаны, но ответ от сервера не получен. Обновите список вручную.");
			ОбновитьСписокПоТаймеру();
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(, "Критический сбой потока на сервере 1С. Изменения отменены. Проверьте Журнал Регистрации.");
		ОбновитьСписокПоТаймеру();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьСтатусФоновогоНаСервере(Знач ИДЗадания)
	
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИДЗадания);
	 Если Задание = Неопределено Тогда
		Возврат "НеНайдено";
	КонецЕсли;
	
	Возврат Строка(Задание.Состояние); 
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИзВременногоХранилищаНаСервере(Знач Адрес)
	
	Возврат ПолучитьИзВременногоХранилища(Адрес);
	
КонецФункции

&НаКлиенте
Процедура СброситьБлокировкуИнтерфейса()
	Элементы.Заказать.Доступность = Истина;
	Элементы.ПровестиЗаказПокупателя.Доступность = Истина;
	ВременноЗаблокированныеКлючи.Очистить();
	УправлятьИнтерфейснымЛокомНаСервере(Новый Массив, Ложь);
КонецПроцедуры

&НаСервере
Функция ПодготовитьИПровестиЗаказыНаСервере(МассивКлючейСвязи) /// удалить
	
	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	
	ЗапросВалидация = Новый Запрос;
	ЗапросВалидация.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.Номенклатура.Наименование КАК Номенклатура
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.КлючСвязиСтрок В(&МассивКлючей)
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|	И Т.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Т.Номенклатура.Наименование
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.КлючСвязиСтрок В(&МассивКлючей)
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|	И Т.Количество <= 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Т.Номенклатура.Наименование
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.КлючСвязиСтрок В(&МассивКлючей)
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|	И Т.Цена <= 0";

	ЗапросВалидация.УстановитьПараметр("МассивКлючей", МассивКлючейСвязи);
	Результат = ЗапросВалидация.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		ТекстОшибки = СтрШаблон("Заказ не создан! В связанных продажах не заполнена цена или товар: %1", Символы.ПС);
		Пока Выборка.Следующий() Цикл
			ТекстОшибки = СтрШаблон("%1 - %2 %3", ТекстОшибки, Выборка.Номенклатура, Символы.ПС);
		КонецЦикла;
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь; 
	КонецЕсли;
	
	ПровестиЗаказПокупателяНаСервере();
	
	ЗапросЗаказы = Новый Запрос;
	ЗапросЗаказы.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.ДокументЗаказПокупателя КАК Заказ
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.КлючСвязиСтрок В(&МассивКлючей)";
	ЗапросЗаказы.УстановитьПараметр("МассивКлючей", МассивКлючейСвязи);
	ВыборкаЗаказов = ЗапросЗаказы.Выполнить().Выбрать();
	
	Пока ВыборкаЗаказов.Следующий() Цикл
		Если Не ЗначениеЗаполнено(ВыборкаЗаказов.Заказ) Тогда 
			Продолжить; 
		КонецЕсли;
		
		ДокОбъект = ВыборкаЗаказов.Заказ.ПолучитьОбъект();
		Если ДокОбъект <> Неопределено Тогда
			Если НЕ ДокОбъект.Записать(РежимЗаписиДокумента.Проведение) Тогда
				ПолныйТекстОшибки = СтрШаблон("Заказ %1 не провелся! Список ошибки ниже ", Строка(ВыборкаЗаказов.Заказ));
				ОбщегоНазначения.СообщитьПользователю(ПолныйТекстОшибки);
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ДанныеАРМОтображениеПриАктивизацииЯчейки(Элемент)
	
	//Если Элемент.ТекущийЭлемент = Неопределено Тогда
	//	Возврат;
	//КонецЕсли;

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	Если ТекущиеДанные.Свойство("СтрокаЗаблокирована") И ТекущиеДанные.СтрокаЗаблокирована Тогда 
		Возврат; 
	КонецЕсли;	
	
	Если Не ТекущиеДанные.Свойство("ИдентификаторЗаписи") Или Не ТекущиеДанные.Свойство("ОтметкаСтроки") Тогда
		Возврат;
	КонецЕсли;
	Если Элемент.ТекущийЭлемент.Имя = "ДанныеАРМОтображениеОтметкаСтроки" 
		Или Элемент.ТекущийЭлемент.Имя = "ДанныеАРМОтображениеЗакупкиОтметкаСтроки" Тогда
		ИнвертироватьФлагНаСервере(ТекущиеДанные.ИдентификаторЗаписи, ТекущиеДанные.ОтметкаСтроки);
		ОбновитьСписокПоТаймеру();
		Если Элемент.ТекущийЭлемент.Имя = "ДанныеАРМОтображениеОтметкаСтроки" Тогда
			Элементы.ДанныеАРМОтображение.ТекущийЭлемент = Элементы.ДанныеАРМОтображениеНоменклатураКлиента;
		ИначеЕсли Элемент.ТекущийЭлемент.Имя = "ДанныеАРМОтображениеЗакупкиОтметкаСтроки" Тогда
			Элементы.ДанныеАРМОтображениеЗакупки.ТекущийЭлемент = Элементы.ДанныеАРМОтображениеЗакупкиНоменклатураКлиента;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОформлениеБлокировкиФоном()
	
	МассивСписков = Новый Массив;
	МассивСписков.Добавить(ДанныеАРМОтображение);
	МассивСписков.Добавить(ДанныеАРМОтображениеЗакупки);
	
	Для Каждого ТекущийСписок Из МассивСписков Цикл
		
		УсловноеОформлениеСписок = ТекущийСписок.УсловноеОформление;
		
		ЭлементОформления = УсловноеОформлениеСписок.Элементы.Добавить();
		
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона",    WebЦвета.Серый);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
		ЭлементУсловия = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементУсловия.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("СтрокаЗаблокирована");
		ЭлементУсловия.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементУсловия.ПравоеЗначение = Истина; 
		ЭлементУсловия.Использование  = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

// Колонки таблицы продаж по канону матрицы прав (index.html, column-matrix.json).
// Формат строки: ИмяПоляСписка|Заголовок|Вид|Код
//   Код — код колонки в матрице (column-codes.js): буква группы и цифра; выводится перед заголовком.
//   Порядок строк — порядок колонок в матрице.
//   Вид: пусто — существующая колонка формы (только заголовок и порядок);
//        Р — поле регистра Арм_ДанныеЗакупокИПродаж, добавляется в запрос списка и в форму;
//        П — поле регистра, уже выбранное запросом списка, добавляется только колонка формы;
//        С — заглушка-строка; Б — заглушка-флажок (данных пока нет, только вид формы).
&НаСервере
Функция ОписаниеКолонокПоМатрице()

	Возврат
	"ОтметкаСтроки|||А1
	|Порядок|№ п/п|П|А2
	|ДокументПодписанОригинал|Документ подписан оригинал|Р|А3
	|ДатаОтгрузки|Дата отгрузки||В1
	|НомерОтгрузки|Номер отгрузки||В2
	|ДатаЗаказа|Дата заказа||В3
	|НомерЗаказа|№ заказ внутренний наш||В4
	|НомерЗаказаКлиента|№ заказ клиент||В5
	|Покупатель|Заказчик||В6
	|Договор|Договор с заказчиком|Р|В7
	|ВидУслуги|Вид услуги||В8
	|Марка|Марка|Р|Е1
	|Модель|Модель|Р|Е2
	|Агрегат|Агрегат|Р|Е3
	|Госномер|Госномер|Р|Е4
	|НомерШасси|№ Шасси|Р|Е5
	|VIN|VIN (ХТС)|Р|Е6
	|Двигатель|Двигатель|Р|Е7
	|СрочностьКлиента|Срочность (ФАКТ) / комментарий заказчика||К1
	|ГРЗКлиента|Машина ГРЗ (ФАКТ)||К2
	|ТерриторияКлиента|Территория (ФАКТ)||К3
	|НоменклатураКлиента|Наименование (ФАКТ)||К4
	|АртикулКлиента|Артикул (ФАКТ)||К5
	|КоличествоКлиента|Кол-во (ФАКТ)||К6
	|ЕдиницаИзмеренияКлиента|Ед. изм. (ФАКТ)||К7
	|Номенклатура|Наименование||М1
	|НоменклатураАртикул|Артикул||М2
	|НоменклатураАС_КодАвтоАльянс|Код А-А / код поставщика||М3
	|НоменклатураЕдиницаИзмерения|Ед. изм.||М4
	|Количество|Кол-во||Н0
	|ОстатокДляСтроки|Кол-во в наличии на складе||Н1
	|КоличествоВРезерве|Кол-во в резерве|Р|Н2
	|КоличествоВПути|Кол-во заказанного в пути / свободное|Р|Н3
	|Партия|№ партии ФИФО / выбор партии||Н4
	|СтатусСтроки|Статус заявки||Н5
	|СебестоимостьЕдиницы|Цена (себес.)||О1
	|Себестоимость|Сумма (себес.)||О2
	|ФормаОплаты|Форма оплаты||О3
	|РРЦ|РРЦ|Р|О4
	|Оплачено|Оплачено (счёт, оплата, постоплата)|Р|О5
	|КоличествоНормаЧас|Кол-во норма час товар для клиента|Р|Р0
	|Коэффициент|Коэфф||Р1
	|Цена|Цена продажи||Р2
	|Сумма|Сумма продажи||Р3
	|Поставщик|Поставщик||С1
	|ДатаПоступления|Дата получения|Р|С2
	|ДатаУПД|Дата УПД|Р|С3
	|НомерУПД|№ УПД|Р|С4
	|ТерриторияОтгрузкиПоставщиком|Территория отгрузки поставщиком|Р|С5
	|КомментарийКСтроке|Комментарий||Т1";

КонецФункции

// Таблица продаж по матрице: заголовки и порядок колонок, поля регистра и заглушки.
// Имена существующих элементов не меняются (на них завязан код формы).
// Технические колонки АРМ, которых нет в матрице, уходят в конец с прежней видимостью.
&НаСервере
Процедура ПрименитьКолонкиПоМатрице()

	Префикс = "ДанныеАРМОтображение";
	Таблица = Элементы.ДанныеАРМОтображение;
	РежимАдминистратора = ЭтоАдминистраторАРМ();
	Изменяемые = "," + ПоляИзменяемыеАдминистратором() + ",";

	Колонки = Новый Массив;
	Для Каждого Строка Из СтрРазделить(ОписаниеКолонокПоМатрице(), Символы.ПС, Ложь) Цикл
		Части = СтрРазделить(СокрЛП(Строка), "|", Истина);
		Колонки.Добавить(Новый Структура("Поле, Заголовок, Вид, Код", Части[0], Части[1], Части[2],
			?(Части.Количество() > 3, Части[3], "")));
	КонецЦикла;

	// 1. Поля регистра и заглушки — в запрос динамического списка (сразу после внешнего ВЫБРАТЬ,
	//    внешний запрос выбирает из регистра под псевдонимом ОсновнаяТаблица).
	ДопПоля = "";
	Для Каждого Колонка Из Колонки Цикл
		Если Колонка.Вид = "Р" Тогда
			ДопПоля = ДопПоля + Символы.ПС + Символы.Таб + "ОсновнаяТаблица." + Колонка.Поле + " КАК " + Колонка.Поле + ",";
		ИначеЕсли Колонка.Вид = "С" Тогда
			ДопПоля = ДопПоля + Символы.ПС + Символы.Таб + """"" КАК " + Колонка.Поле + ",";
		ИначеЕсли Колонка.Вид = "Б" Тогда
			ДопПоля = ДопПоля + Символы.ПС + Символы.Таб + "ЛОЖЬ КАК " + Колонка.Поле + ",";
		КонецЕсли;
	КонецЦикла;

	ПоляДобавлены = Ложь;
	Если ЗначениеЗаполнено(ДопПоля) Тогда
		ТекстЗапроса = ДанныеАРМОтображение.ТекстЗапроса;
		Позиция = СтрНайти(ТекстЗапроса, "ВЫБРАТЬ");
		Если Позиция > 0 Тогда
			ДанныеАРМОтображение.ТекстЗапроса = Лев(ТекстЗапроса, Позиция + 6) + ДопПоля + Сред(ТекстЗапроса, Позиция + 7);
			ПоляДобавлены = Истина;
		Иначе
			ЗаписьЖурналаРегистрации("АРМ.КолонкиПоМатрице", УровеньЖурналаРегистрации.Предупреждение,,,
				"В запросе списка не найден ВЫБРАТЬ — поля регистра и заглушки не добавлены");
		КонецЕсли;
	КонецЕсли;

	// Сумма продажи по матрице (Р3): норма-час × цена продажи, если норма-час заполнена;
	// иначе количество × цена продажи.
	ВыражениеСуммы = "ОсновнаяТаблица.Количество * ОсновнаяТаблица.Цена КАК Сумма";
	Если ПоляДобавлены И СтрНайти(ДанныеАРМОтображение.ТекстЗапроса, ВыражениеСуммы) > 0 Тогда
		ДанныеАРМОтображение.ТекстЗапроса = СтрЗаменить(ДанныеАРМОтображение.ТекстЗапроса, ВыражениеСуммы,
			"ВЫБОР КОГДА ОсновнаяТаблица.КоличествоНормаЧас > 0 ТОГДА ОсновнаяТаблица.КоличествоНормаЧас"
			+ " ИНАЧЕ ОсновнаяТаблица.Количество КОНЕЦ * ОсновнаяТаблица.Цена КАК Сумма");
	КонецЕсли;

	// 2. Технические колонки (не из матрицы) — запомнить в исходном порядке.
	ИменаМатрицы = Новый Соответствие;
	Для Каждого Колонка Из Колонки Цикл
		ИменаМатрицы.Вставить(Префикс + Колонка.Поле, Истина);
	КонецЦикла;
	Технические = Новый Массив;
	Для Каждого Элемент Из Таблица.ПодчиненныеЭлементы Цикл
		Если ИменаМатрицы.Получить(Элемент.Имя) = Неопределено Тогда
			Технические.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;

	// 3. Колонки матрицы: создать недостающие, выставить заголовки, переставить по порядку.
	Для Каждого Колонка Из Колонки Цикл
		ИмяЭлемента = Префикс + Колонка.Поле;
		Элемент = Элементы.Найти(ИмяЭлемента);

		Если Элемент = Неопределено Тогда
			Если Не ЗначениеЗаполнено(Колонка.Вид) Тогда
				Продолжить; // существующей колонки нет в форме — пропускаем
			КонецЕсли;
			Если Колонка.Вид <> "П" И Не ПоляДобавлены Тогда
				Продолжить; // поля нет в запросе — колонку не создаём
			КонецЕсли;
			Элемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Таблица);
			Флажок = Колонка.Вид = "Б" Или (Колонка.Вид = "Р" И ЭтоБулевоПолеАРМ(Колонка.Поле));
			Элемент.Вид = ?(Флажок, ВидПоляФормы.ПолеФлажка, ВидПоляФормы.ПолеВвода);
			Элемент.ПутьКДанным = "ДанныеАРМОтображение." + Колонка.Поле;
			Элемент.ТолькоПросмотр = Истина;
			Если Колонка.Вид = "С" Или Колонка.Вид = "Б" Тогда
				Элемент.Подсказка = "Заглушка: колонка из матрицы прав, данные пока не заполняются";
			КонецЕсли;
		КонецЕсли;

		// T09: единица измерения клиента правится только выбором из списка (двойной щелчок), не вводом в ячейке.
		МожноМенять = РежимАдминистратора И СтрНайти(Изменяемые, "," + Колонка.Поле + ",") > 0
			И Колонка.Поле <> "ЕдиницаИзмеренияКлиента";
		Если МожноМенять Тогда
			// Приёмка admin-columns-matrix п.7: снять ТолькоПросмотр для администратора.
			Элемент.ТолькоПросмотр = Ложь;
			Элемент.УстановитьДействие("ПриИзменении", "ДанныеАРМОтображениеКолонкаПриИзменении");
			Элемент.Подсказка = "Администратор: значение сохраняется при изменении ячейки";
		Иначе
			Элемент.ТолькоПросмотр = Истина;
		КонецЕсли;

		Если ЗначениеЗаполнено(Колонка.Заголовок) Тогда
			Элемент.Заголовок = СокрЛ(Колонка.Код + " " + Колонка.Заголовок);
		КонецЕсли;
		Элементы.Переместить(Элемент, Таблица);
	КонецЦикла;

	Для Каждого Элемент Из Технические Цикл
		Элементы.Переместить(Элемент, Таблица);
	КонецЦикла;

	// Колонки «Есть дефицит» в матрице нет — с экрана убрана. Поле ЕстьДефицит остаётся в запросе:
	// по нему подсвечиваются строки и работает отбор «Только с закупками».
	КолонкаДефицит = Элементы.Найти(Префикс + "ЕстьДефицит");
	Если КолонкаДефицит <> Неопределено Тогда
		КолонкаДефицит.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

#Область РедактированиеАдминистратором

// Роль интерфейса текущего пользователя — «Администратор».
&НаСервереБезКонтекста
Функция ЭтоАдминистраторАРМ()

	Возврат РегистрыСведений.Арм_ПраваПользователей.ПолучитьРольИнтерфейсаПользователя(ПараметрыСеанса.ТекущийПользователь)
		= Перечисления.Арм_РолиИнтерфейса.Администратор;

КонецФункции

// v2.11 (T01): ЕДИНАЯ точка ACL «роль × статус строки × поле» (общий модуль Арм_МатрицаПрав, канон — вкладка manager).
// Роль берётся строго из Арм_ПраваПользователей (нет записи - отказ, D1b), статус - из регистра по идентификатору,
// а не из данных клиента. Администратор - whitelist ПоляИзменяемыеАдминистратором без статуса (D1e=B);
// ЗаблокированоФоном - запрет всем. Возвращает "" - можно править, иначе текст отказа.
&НаСервереБезКонтекста
Функция ОтказПоПравамАРМ(Знач ИдентификаторЗаписи, Знач ИмяПоля)

	Возврат РегистрыСведений.Арм_ПраваПользователей.ОтказПоПравамНаПолеСтроки(ИдентификаторЗаписи, ИмяПоля);

КонецФункции

// v2.11 (T01): серверная защита процедур записи - клиент проверяет права до диалога, но запись обязана проверить сама.
&НаСервереБезКонтекста
Процедура ПроверитьПравоНаПолеИлиОтказать(Знач ИдентификаторЗаписи, Знач ИмяПоля)

	ТекстОтказа = ОтказПоПравамАРМ(ИдентификаторЗаписи, ИмяПоля);
	Если ЗначениеЗаполнено(ТекстОтказа) Тогда
		ЗаписьЖурналаРегистрации("АРМ.ОтказПрав", УровеньЖурналаРегистрации.Предупреждение,,,
			СтрШаблон("Поле %1, строка %2: %3", ИмяПоля, Строка(ИдентификаторЗаписи), ТекстОтказа));
		ВызватьИсключение ТекстОтказа;
	КонецЕсли;

КонецПроцедуры

// v2.11 (T01): имя поля регистра по имени колонки таблицы продаж/закупок, для которой есть обработчик Выбор.
// Пустая строка - колонка без обработчика правки (ACL не применяется, двойной щелчок ничего не делает).
&НаКлиентеНаСервереБезКонтекста
Функция ИмяПоляРегистраПоЭлементуАРМ(Знач ИмяЭлемента)

	Если ИмяЭлемента = "ДанныеАРМОтображениеНоменклатура" Или ИмяЭлемента = "ДанныеАРМОтображениеНоменклатураАртикул" Тогда
		Возврат "Номенклатура";
	ИначеЕсли ИмяЭлемента = "ДанныеАРМОтображениеКомментарийКСтроке" Тогда
		Возврат "КомментарийКСтроке";
	ИначеЕсли ИмяЭлемента = "ДанныеАРМОтображениеКоличество" Или ИмяЭлемента = "ДанныеАРМОтображениеЗакупкиКоличество" Тогда
		Возврат "Количество";
	ИначеЕсли ИмяЭлемента = "ДанныеАРМОтображениеЦена" Или ИмяЭлемента = "ДанныеАРМОтображениеЗакупкиЦена" Тогда
		Возврат "Цена";
	ИначеЕсли ИмяЭлемента = "ДанныеАРМОтображениеКоэффициент" Тогда
		Возврат "Коэффициент";
	ИначеЕсли ИмяЭлемента = "ДанныеАРМОтображениеПартия" Тогда
		Возврат "Партия";
	ИначеЕсли ИмяЭлемента = "ДанныеАРМОтображениеЗакупкиПоставщик" Тогда
		Возврат "Поставщик";
	ИначеЕсли ИмяЭлемента = "ДанныеАРМОтображениеВидУслуги" Тогда
		Возврат "ВидУслуги";
	ИначеЕсли ИмяЭлемента = "ДанныеАРМОтображениеФормаОплаты" Тогда
		Возврат "ФормаОплаты";
	ИначеЕсли ИмяЭлемента = "ДанныеАРМОтображениеЗакупкиДоговор" Тогда
		Возврат "Договор";
	ИначеЕсли ИмяЭлемента = "ДанныеАРМОтображениеДатаОтгрузки" Тогда
		Возврат "ДатаОтгрузки";
	КонецЕсли;

	Возврат "";

КонецФункции

// Поля строки продаж, которые администратор меняет через общий ввод значения (двойной щелчок).
// Ссылочные и простые типы без отдельного обработчика Выбор. Реквизиты номенклатуры
// (артикул, код, ед. изм.) здесь не меняются — это данные справочника.
&НаКлиентеНаСервереБезКонтекста
Функция ПоляРедактируемыеАдминистратором()

	Возврат "ДокументПодписанОригинал,ДатаЗаказа,НомерЗаказаКлиента,Покупатель,Договор,"
		+ "Марка,Модель,Агрегат,Госномер,VIN,Двигатель,"
		+ "СрочностьКлиента,ГРЗКлиента,ТерриторияКлиента,НоменклатураКлиента,АртикулКлиента,КоличествоКлиента,ЕдиницаИзмеренияКлиента,"
		+ "КоличествоНормаЧас,СебестоимостьЕдиницы,РРЦ,Оплачено,Поставщик,ТерриторияОтгрузкиПоставщиком";

КонецФункции

// Все поля матрицы, которые администратор может менять (снятие ТолькоПросмотр + запись).
// = поля общего ввода + колонки со своими обработчиками Выбор. Без реквизитов номенклатуры
// и без колонок «только просмотр» матрицы (номер отгрузки, статус, суммы, остатки, заглушки…).
&НаКлиентеНаСервереБезКонтекста
Функция ПоляИзменяемыеАдминистратором()

	Возврат ПоляРедактируемыеАдминистратором() + ","
		+ "ОтметкаСтроки,Номенклатура,Количество,Цена,Коэффициент,Партия,ВидУслуги,ФормаОплаты,"
		+ "ДатаОтгрузки,КомментарийКСтроке";

КонецФункции

// v2.11 (T05, D4) / v2.12 (H01): поля ручного ввода только по ACL (роль × статус × поле), которых нет в whitelist
// администратора. Администратору (D1e=B) они не добавлены — в матрице у admin на этих колонках нет права.
// Должно совпадать с Арм_МатрицаПрав.ПоляВводаПоACL() (проверяет тест).
&НаКлиентеНаСервереБезКонтекста
Функция ПоляВводаПоACL()

	Возврат "НомерШасси,КоличествоВРезерве,КоличествоВПути,ДатаУПД,НомерУПД,ДатаПоступления";

КонецФункции

// v2.11 (T09, D5): допустимые единицы измерения клиента (источник - index.html, 6 значений).
// Хранится строкой в ЕдиницаИзмеренияКлиента (String 10); количество при смене единицы НЕ пересчитывается;
// М4 «Ед. изм.» (единица номенклатуры) остаётся только для просмотра.
&НаКлиентеНаСервереБезКонтекста
Функция СписокЕдиницИзмеренияАРМ()

	Возврат "шт,компл,л,кг,м,н/ч";

КонецФункции

// Метаданные поля регистра Арм_ДанныеЗакупокИПродаж (ресурс, измерение или реквизит).
&НаСервереБезКонтекста
Функция МетаданныеПоляАРМ(Знач ИмяПоля)

	МД = Метаданные.РегистрыСведений.Арм_ДанныеЗакупокИПродаж;
	Поле = МД.Ресурсы.Найти(ИмяПоля);
	Если Поле = Неопределено Тогда
		Поле = МД.Измерения.Найти(ИмяПоля);
	КонецЕсли;
	Если Поле = Неопределено Тогда
		Поле = МД.Реквизиты.Найти(ИмяПоля);
	КонецЕсли;
	Возврат Поле;

КонецФункции

&НаСервереБезКонтекста
Функция ОписаниеТипаПоляАРМ(Знач ИмяПоля)

	Поле = МетаданныеПоляАРМ(ИмяПоля);
	Возврат ?(Поле = Неопределено, Новый ОписаниеТипов("Строка"), Поле.Тип);

КонецФункции

&НаСервереБезКонтекста
Функция ЭтоБулевоПолеАРМ(Знач ИмяПоля)

	ОписаниеТипа = ОписаниеТипаПоляАРМ(ИмяПоля);
	Возврат ОписаниеТипа.Типы().Количество() = 1 И ОписаниеТипа.СодержитТип(Тип("Булево"));

КонецФункции

// База цены продажи: РРЦ (О4), если она заполнена; иначе цена себестоимости (О1).
&НаСервереБезКонтекста
Функция БазаЦеныПродажиАРМ(Запись)

	Возврат ?(Запись.РРЦ <> 0, Запись.РРЦ, Запись.СебестоимостьЕдиницы);

КонецФункции

// Формулы матрицы после изменения поля ИмяПоля в записи регистра:
//   Сумма себес. (О2)  = Цена себес. (О1) × Кол-во (Н0);
//   Цена продажи (Р2)  = база × Коэфф (Р1), база — см. БазаЦеныПродажиАРМ();
//   при ручном вводе цены продажи Коэфф пересчитывается обратно: Коэфф = Цена продажи / база.
// Пока Коэфф не заполнен, цена продажи не пересчитывается.
&НаСервереБезКонтекста
Процедура ПересчитатьЦеныСтрокиАРМ(Запись, Знач ИмяПоля)

	Если ИмяПоля = "СебестоимостьЕдиницы" Или ИмяПоля = "Количество" Тогда
		Запись.Себестоимость = Запись.СебестоимостьЕдиницы * Запись.Количество;
	КонецЕсли;

	Если Запись.ВидОперации <> Перечисления.Арм_ВидыОпераций.Продажа Тогда
		Возврат;
	КонецЕсли;
	База = БазаЦеныПродажиАРМ(Запись);
	Если База = 0 Тогда
		Возврат;
	КонецЕсли;

	Если ИмяПоля = "Цена" Тогда
		Запись.Коэффициент = Запись.Цена / База;
		Запись.ТипИзмененияЦены = 1;
	ИначеЕсли ИмяПоля = "Коэффициент" Или ИмяПоля = "РРЦ" Или ИмяПоля = "СебестоимостьЕдиницы" Тогда
		Если Запись.Коэффициент <> 0 Тогда
			Запись.Цена = База * Запись.Коэффициент;
			Если ИмяПоля = "Коэффициент" Тогда
				Запись.ТипИзмененияЦены = 2;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

// Двойной щелчок по колонке из ПоляРедактируемыеАдминистратором() (общий ввод значения).
// v2.11 (T02): вызывается и для ролей без Администратора - тогда до диалога проверяется ACL (роль × статус × поле);
// у Администратора проверки статуса нет (D1e=B). Запись всё равно перепроверяется на сервере (ЗаписатьПолеСтрокиАРМ).
// Возвращает Истина, если щелчок обработан здесь.
&НаКлиенте
Функция ОбработатьВыборАдминистратора(Поле, ДанныеСтроки)

	Префикс = "ДанныеАРМОтображение";
	Если Не СтрНачинаетсяС(Поле.Имя, Префикс) Тогда
		Возврат Ложь;
	КонецЕсли;
	ИмяПоля = Сред(Поле.Имя, СтрДлина(Префикс) + 1);
	// v2.11 (T05): кроме whitelist общего ввода - поля ручного ввода только по ACL (ПоляВводаПоACL).
	Если СтрНайти("," + ПоляРедактируемыеАдминистратором() + ",", "," + ИмяПоля + ",") = 0
		И СтрНайти("," + ПоляВводаПоACL() + ",", "," + ИмяПоля + ",") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;

	ТекущееЗначение = Неопределено;
	Если Не ДанныеСтроки.Свойство(ИмяПоля, ТекущееЗначение) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если РежимАдминистратораАРМ <> Истина Тогда
		ТекстОтказа = ОтказПоПравамАРМ(ДанныеСтроки.ИдентификаторЗаписи, ИмяПоля);
		Если ЗначениеЗаполнено(ТекстОтказа) Тогда
			ПоказатьОповещениеПользователя("Внимание!", , ТекстОтказа);
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;

	ДопПараметры = Новый Структура("ИдентификаторЗаписи, ИмяПоля", ДанныеСтроки.ИдентификаторЗаписи, ИмяПоля);
	ОписаниеТипа = ОписаниеТипаПоляАРМ(ИмяПоля);

	Если ИмяПоля = "Договор" Тогда
		ПокупательСтроки = Неопределено;
		ДанныеСтроки.Свойство("Покупатель", ПокупательСтроки);
		Если Не ЗначениеЗаполнено(ПокупательСтроки) Тогда
			ПоказатьПредупреждение(, "Сначала выберите Заказчика в этой строке");
			Возврат Истина;
		КонецЕсли;
		Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначенияАдминистратором", ЭтотОбъект, ДопПараметры);
		ПараметрыОткрытия = Новый Структура;
		ПараметрыОткрытия.Вставить("Владелец", ПокупательСтроки);
		ПараметрыОткрытия.Вставить("РежимВыбора", Истина);
		ПараметрыОткрытия.Вставить("ЗакрыватьПриВыборе", Истина);
		ОткрытьФорму("Справочник.ДоговорыКонтрагентов.Форма.ФормаВыбора", ПараметрыОткрытия,
			Элементы.ДанныеАРМОтображение, , , , Оповещение);
		Возврат Истина;
	КонецЕсли;

	// T09 (D5): единица измерения клиента - выпадающий список из 6 значений (ACL уже проверен выше).
	Если ИмяПоля = "ЕдиницаИзмеренияКлиента" Тогда
		СписокЕдиниц = Новый СписокЗначений;
		СписокЕдиниц.ЗагрузитьЗначения(СтрРазделить(СписокЕдиницИзмеренияАРМ(), ","));
		НачальныйВыбор = СписокЕдиниц.НайтиПоЗначению(СокрЛП(ТекущееЗначение));
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораЕдиницыИзмерения", ЭтотОбъект, ДопПараметры);
		ПоказатьВыборИзСписка(Оповещение, СписокЕдиниц, Элементы.ДанныеАРМОтображение, НачальныйВыбор);
		Возврат Истина;
	КонецЕсли;

	Если ОписаниеТипа.Типы().Количество() = 1 И ОписаниеТипа.СодержитТип(Тип("Булево")) Тогда
		ПослеВводаЗначенияАдминистратором(Не (ТекущееЗначение = Истина), ДопПараметры);
	Иначе
		Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначенияАдминистратором", ЭтотОбъект, ДопПараметры);
		ПоказатьВводЗначения(Оповещение, ТекущееЗначение, Поле.Заголовок, ОписаниеТипа);
	КонецЕсли;
	Возврат Истина;

КонецФункции

// T09: результат выбора единицы измерения из списка -> общая запись поля (ACL перепроверяется на сервере).
&НаКлиенте
Процедура ПослеВыбораЕдиницыИзмерения(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПослеВводаЗначенияАдминистратором(Результат.Значение, ДопПараметры);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаЗначенияАдминистратором(Результат, ДопПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекстОшибки = ЗаписатьПолеСтрокиАРМ(ДопПараметры.ИдентификаторЗаписи, ДопПараметры.ИмяПоля, Результат);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Возврат;
	КонецЕсли;
	ОбновитьСписокПоТаймеру();

КонецПроцедуры

// Inline-правка администратором (ТолькоПросмотр снят): сохранить значение из ячейки в регистр.
&НаКлиенте
Процедура ДанныеАРМОтображениеКолонкаПриИзменении(Элемент)

	Если РежимАдминистратораАРМ <> Истина Тогда
		Возврат;
	КонецЕсли;

	Префикс = "ДанныеАРМОтображение";
	Если Не СтрНачинаетсяС(Элемент.Имя, Префикс) Тогда
		Возврат;
	КонецЕсли;
	ИмяПоля = Сред(Элемент.Имя, СтрДлина(Префикс) + 1);
	Если СтрНайти("," + ПоляИзменяемыеАдминистратором() + ",", "," + ИмяПоля + ",") = 0 Тогда
		Возврат;
	КонецЕсли;

	ДанныеСтроки = Элементы.ДанныеАРМОтображение.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Или Не ДанныеСтроки.Свойство("ИдентификаторЗаписи") Тогда
		Возврат;
	КонецЕсли;
	Если ДанныеСтроки.Свойство("СтрокаЗаблокирована") И ДанныеСтроки.СтрокаЗаблокирована = Истина Тогда
		ОбновитьСписокПоТаймеру();
		Возврат;
	КонецЕсли;

	ЗначениеПоля = Неопределено;
	Если Не ДанныеСтроки.Свойство(ИмяПоля, ЗначениеПоля) Тогда
		Возврат;
	КонецЕсли;

	ТекстОшибки = ЗаписатьПолеСтрокиАРМ(ДанныеСтроки.ИдентификаторЗаписи, ИмяПоля, ЗначениеПоля);
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
	КонецЕсли;
	ОбновитьСписокПоТаймеру(); // пересчитанные цена, коэффициент и суммы видны сразу

КонецПроцедуры

// Запись одного поля строки продаж в регистр. Возвращает текст ошибки или пустую строку.
// v2.11 (T01/T02): вместо «только администратор» - ACL роль × статус × поле на сервере (ОтказПоПравамАРМ):
// Администратор - поля ПоляИзменяемыеАдминистратором без статуса (D1e=B); остальные роли - по матрице и только
// поля общего ввода (ПоляРедактируемыеАдминистратором): номенклатура, количество, цена, коэффициент, партия
// пишутся своими процедурами со своей логикой. ЗаблокированоФоном - отказ всем.
&НаСервереБезКонтекста
Функция ЗаписатьПолеСтрокиАРМ(Знач ИдентификаторЗаписи, Знач ИмяПоля, Знач Значение)

	Если МетаданныеПоляАРМ(ИмяПоля) = Неопределено Тогда
		Возврат СтрШаблон("Поле ""%1"" нельзя изменить из АРМ.", ИмяПоля);
	КонецЕсли;
	Если Не ЭтоАдминистраторАРМ() И СтрНайти("," + ПоляРедактируемыеАдминистратором() + ",", "," + ИмяПоля + ",") = 0
		И СтрНайти("," + ПоляВводаПоACL() + ",", "," + ИмяПоля + ",") = 0 Тогда
		Возврат СтрШаблон("Поле ""%1"" нельзя изменить общим вводом.", ИмяПоля);
	КонецЕсли;
	
	// T09 (D5): единица измерения клиента - строка из фиксированного списка (значения вне списка не пишем).
	Если ИмяПоля = "ЕдиницаИзмеренияКлиента" И ЗначениеЗаполнено(Значение)
		И СтрНайти("," + СписокЕдиницИзмеренияАРМ() + ",", "," + СокрЛП(Значение) + ",") = 0 Тогда
		Возврат СтрШаблон("Единица измерения ""%1"" не из списка (%2).", Значение, СписокЕдиницИзмеренияАРМ());
	КонецЕсли;
	ТекстОтказа = ОтказПоПравамАРМ(ИдентификаторЗаписи, ИмяПоля);
	Если ЗначениеЗаполнено(ТекстОтказа) Тогда
		Возврат ТекстОтказа;
	КонецЕсли;

	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		Возврат "Строка не найдена — возможно, её уже удалили. Обновите список.";
	КонецЕсли;

	// v2.11 (T08): обязательные поля матрицы (статусы «Черновик»/«В работе») нельзя очистить из UI (не администратором).
	Если Не ЭтоАдминистраторАРМ() Тогда
		ТекстОбязательности = ОтказОчисткиОбязательногоПоляАРМ(Набор[0], ИмяПоля, Значение);
		Если ЗначениеЗаполнено(ТекстОбязательности) Тогда
			Возврат ТекстОбязательности;
		КонецЕсли;
	КонецЕсли;

	Если ИмяПоля = "Договор" И ЗначениеЗаполнено(Значение) Тогда
		ПокупательЗаписи = Набор[0].Покупатель;
		Если Значение.Владелец <> ПокупательЗаписи Тогда
			Возврат СтрШаблон("Договор «%1» не принадлежит заказчику «%2»",
				Строка(Значение), Строка(ПокупательЗаписи));
		КонецЕсли;
	КонецЕсли;

	Для Каждого Запись Из Набор Цикл
		Запись[ИмяПоля] = Значение;
		ПересчитатьЦеныСтрокиАРМ(Запись, ИмяПоля);
		
		// v2.10: при смене заказчика договор другого владельца сбрасывается.
		Если ИмяПоля = "Покупатель" И ЗначениеЗаполнено(Запись.Договор)
			И Запись.Договор.Владелец <> Значение Тогда
			Запись.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		КонецЕсли;
		
		// v2.10 (А3): документ подписан оригинал - снять авторскую блокировку строки.
		Если ИмяПоля = "ДокументПодписанОригинал" И Значение = Истина Тогда
			Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
			Запись.ОтметкаСтроки = Ложь;
		КонецЕсли;
	КонецЦикла;

	Попытка
		Набор.Записать();
	Исключение
		ЗаписьЖурналаРегистрации("АРМ.ОшибкаЗаписиПоля", УровеньЖурналаРегистрации.Ошибка,,,
			СтрШаблон("Поле %1: %2", ИмяПоля, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		Возврат "Не удалось сохранить значение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;

	Возврат "";

КонецФункции

// v2.11 (T08, Phase A = вариант C: ручной ввод, без нового справочника ТС): обязательность полей матрицы
// (бит required, статусы new / in_work; oneOfRequired из index.html) проверяется ТОЛЬКО здесь - в интерактивной
// записи поля из UI (ЗаписатьПолеСтрокиАРМ) и в явном переходе статуса командой менеджера.
// В ПриЗаписи документов, при создании строк из заказов, в фоне и в seed обязательность НЕ проверяется.
// Список для проверки (строка продаж): ДатаЗаказа, НомерЗаказаКлиента, Количество > 0, Номенклатура,
// «Госномер или Агрегат». Поставщик (required в матрице) относится к строке закупки и здесь не проверяется.
&НаСервереБезКонтекста
Функция СтатусКонтроляОбязательныхАРМ(Знач СтатусСтроки)

	Возврат СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик Или СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ВРаботе;

КонецФункции

// Массив названий незаполненных обязательных полей строки продаж (пустой - всё заполнено).
&НаСервереБезКонтекста
Функция НезаполненныеОбязательныеПоляАРМ(Знач Запись)

	Незаполненные = Новый Массив;
	Если Не ЗначениеЗаполнено(Запись.ДатаЗаказа) Тогда
		Незаполненные.Добавить("Дата заказа");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Запись.НомерЗаказаКлиента) Тогда
		Незаполненные.Добавить("№ заказ клиент");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Запись.Номенклатура) Тогда
		Незаполненные.Добавить("Наименование");
	КонецЕсли;
	Если Запись.Количество <= 0 Тогда
		Незаполненные.Добавить("Кол-во");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Запись.Госномер) И Не ЗначениеЗаполнено(Запись.Агрегат) Тогда
		Незаполненные.Добавить("Госномер или Агрегат");
	КонецЕсли;
	Возврат Незаполненные;

КонецФункции

// Пустая строка - запись значения разрешена; иначе текст отказа: нельзя очистить обязательное поле
// (для «Госномер»/«Агрегат» - нельзя очистить последнее заполненное из пары).
&НаСервереБезКонтекста
Функция ОтказОчисткиОбязательногоПоляАРМ(Знач Запись, Знач ИмяПоля, Знач Значение)

	Если ЗначениеЗаполнено(Значение) Или Не СтатусКонтроляОбязательныхАРМ(Запись.СтатусСтроки) Тогда
		Возврат "";
	КонецЕсли;

	Если ИмяПоля = "ДатаЗаказа" Или ИмяПоля = "НомерЗаказаКлиента" Тогда
		Возврат СтрШаблон("Поле ""%1"" обязательно в статусе ""%2"" - очищать нельзя.", ИмяПоля, Строка(Запись.СтатусСтроки));
	КонецЕсли;
	Если (ИмяПоля = "Госномер" И Не ЗначениеЗаполнено(Запись.Агрегат))
		Или (ИмяПоля = "Агрегат" И Не ЗначениеЗаполнено(Запись.Госномер)) Тогда
		Возврат "Должно быть заполнено одно из полей: Госномер или Агрегат - очищать последнее заполненное нельзя.";
	КонецЕсли;

	Возврат "";

КонецФункции

// v2.10 (MVP): переходы статусов строк продаж Резервирование / ОжидаемПоступление / Возврат.
// v2.11 (T03, D2): статус меняют менеджер и администратор; разрешение по строке - Арм_МатрицаПрав.МожноРедактироватьПоле
// для поля СтатусСтроки (менеджер - по матрице line_status для текущего статуса строки), администратор - всегда.
// v2.12 (H02, D12=A): дополнительно whitelist from→to — см. ДопустимПереходСтатусаМВП и tasks/line-status-ownership.md.
// Кнопки добавляются программно в группу ГруппаРаботаСоСтатусами (Form.elem.json не меняется).
&НаСервере
Процедура НастроитьКомандыСтатусовАдминистратора()

	Если Не РольМожетМенятьСтатусыАРМ() Тогда
		Возврат;
	КонецЕсли;

	Группа = Элементы.Найти("ГруппаРаботаСоСтатусами");
	Если Группа = Неопределено Тогда
		Возврат;
	КонецЕсли;

	// Соответствие не подходит (порядок кнопок), "Возврат" - ключевое слово, поэтому массив пар.
	Статусы = Новый Массив;
	Статусы.Добавить(Новый Структура("Имя, Заголовок", "Резервирование", "Статус: резервирование"));
	Статусы.Добавить(Новый Структура("Имя, Заголовок", "ОжидаемПоступление", "Статус: ожидаем поступление"));
	Статусы.Добавить(Новый Структура("Имя, Заголовок", "Возврат", "Статус: возврат"));

	Для Каждого Статус Из Статусы Цикл
		ИмяКоманды = "УстановитьСтатус" + Статус.Имя;
		Команда = Команды.Добавить(ИмяКоманды);
		Команда.Действие = ИмяКоманды;
		Команда.Заголовок = Статус.Заголовок;
		Команда.Подсказка = "Менеджер/администратор: установить статус отмеченных строк продаж (или текущей строки)";
		
		Кнопка = Элементы.Добавить("Кнопка" + ИмяКоманды, Тип("КнопкаФормы"), Группа);
		Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
		Кнопка.ИмяКоманды = ИмяКоманды;
		Кнопка.Заголовок = Статус.Заголовок;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусРезервирование(Команда)
	УстановитьСтатусСтрокАдминистратором("Резервирование");
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусОжидаемПоступление(Команда)
	УстановитьСтатусСтрокАдминистратором("ОжидаемПоступление");
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусВозврат(Команда)
	УстановитьСтатусСтрокАдминистратором("Возврат");
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСтатусСтрокАдминистратором(Знач ИмяСтатуса)

	// v2.11 (T03): роль и статус каждой строки проверяет сервер (УстановитьСтатусСтрокАдминистраторомНаСервере).
	ИдентификаторТекущей = Неопределено;
	ТекущиеДанные = Элементы.ДанныеАРМОтображение.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Свойство("ИдентификаторЗаписи") Тогда
		ИдентификаторТекущей = ТекущиеДанные.ИдентификаторЗаписи;
	КонецЕсли;

	Результат = УстановитьСтатусСтрокАдминистраторомНаСервере(ИмяСтатуса, ИдентификаторТекущей);
	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
		ПоказатьПредупреждение(, Результат.Ошибка);
	ИначеЕсли Результат.Изменено = 0 Тогда
		ПоказатьПредупреждение(, "Нет строк продаж для смены статуса: отметьте строки или выберите текущую.");
	КонецЕсли;
	ОбновитьСписокПоТаймеру();

КонецПроцедуры

// v2.11 (T03, D2): менеджер или администратор; роль строго из Арм_ПраваПользователей (нет записи - запрет, D1b).
&НаСервереБезКонтекста
Функция РольМожетМенятьСтатусыАРМ()

	Роль = РегистрыСведений.Арм_ПраваПользователей.ПолучитьРольИнтерфейсаСтрого(ПараметрыСеанса.ТекущийПользователь);
	Возврат Роль = Перечисления.Арм_РолиИнтерфейса.Администратор Или Роль = Перечисления.Арм_РолиИнтерфейса.Менеджер;

КонецФункции

// v2.12.1 (audit F-02): текст отказа если роль не менеджер/админ (команды заказа).
&НаСервереБезКонтекста
Функция ОтказЕслиНеМенеджерИлиАдминАРМ()
	Если Не РольМожетМенятьСтатусыАРМ() Тогда
		Возврат "Действие доступно менеджеру и администратору АРМ.";
	КонецЕсли;
	Возврат "";
КонецФункции

// v2.12 (H02, D12=A): допустим ли переход текущий → целевой для трёх MVP-кнопок.
// Запрещены from: ЗаблокированоФоном, Завершено; повтор той же цели — нет.
// v2.12.1 (F-07): явный whitelist from → to для каждой из трёх целей (см. tasks/line-status-ownership.md).
&НаСервереБезКонтекста
Функция ДопустимПереходСтатусаМВП(Знач ТекущийСтатус, Знач НовыйСтатус)

	Если Не ЗначениеЗаполнено(НовыйСтатус) Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТекущийСтатус = НовыйСтатус Тогда
		Возврат Ложь;
	КонецЕсли;
	Если ТекущийСтатус = Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном
		Или ТекущийСтатус = Перечисления.Арм_СтатусыАРМ.Завершено Тогда
		Возврат Ложь;
	КонецЕсли;

	// v2.12.1 (audit F-07): реальный whitelist from → to.
	Допустимые = Новый Массив;
	Если НовыйСтатус = Перечисления.Арм_СтатусыАРМ.Резервирование Тогда
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Черновик);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.ВРаботе);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.НаСкладе);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Комплектуется);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Собран);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Подготовлено);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.ЧастичноЗаказано);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Приходуется);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.ОжидаемПоступление);
	ИначеЕсли НовыйСтатус = Перечисления.Арм_СтатусыАРМ.ОжидаемПоступление Тогда
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Черновик);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.ВРаботе);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Заказано);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Оплачено);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.ТоварВПути);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.ЧастичноЗаказано);
	ИначеЕсли НовыйСтатус = Перечисления.Арм_СтатусыАРМ.Возврат Тогда
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Отгружено);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Собран);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Подготовлено);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Резервирование);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.НаСкладе);
		Допустимые.Добавить(Перечисления.Арм_СтатусыАРМ.Выполнено);
	Иначе
		Возврат Ложь;
	КонецЕсли;

	Возврат Допустимые.Найти(ТекущийСтатус) <> Неопределено;

КонецФункции

// Ставит статус у отмеченных текущим пользователем строк продаж; если отметок нет - у текущей строки.
// Строки в работе фоновой обработки (ЗаблокированоФоном) и удаленные пропускаются.
// v2.11: строку, для которой роль не вправе менять статус (матрица, поле СтатусСтроки), пропускаем.
// v2.12 (H02): + whitelist from→to (ДопустимПереходСтатусаМВП).
&НаСервереБезКонтекста
Функция УстановитьСтатусСтрокАдминистраторомНаСервере(Знач ИмяСтатуса, Знач ИдентификаторТекущей)

	Результат = Новый Структура("Изменено, Ошибка, Отказано", 0, "", 0);
	Неполных = 0;
	ТекстНеполных = "";
	ОтказПерехода = 0;

	Если Не РольМожетМенятьСтатусыАРМ() Тогда
		Результат.Ошибка = "Смена статуса доступна менеджеру и администратору АРМ.";
		Возврат Результат;
	КонецЕсли;
	Роль = РегистрыСведений.Арм_ПраваПользователей.ПолучитьРольИнтерфейсаСтрого(ПараметрыСеанса.ТекущийПользователь);

	Если ИмяСтатуса = "Резервирование" Тогда
		НовыйСтатус = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Резервирование");
	ИначеЕсли ИмяСтатуса = "ОжидаемПоступление" Тогда
		НовыйСтатус = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.ОжидаемПоступление");
	ИначеЕсли ИмяСтатуса = "Возврат" Тогда
		// "Возврат" - ключевое слово BSL, поэтому значение берется через строку.
		НовыйСтатус = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Возврат");
	Иначе
		Результат.Ошибка = СтрШаблон("Статус ""%1"" не поддерживается.", ИмяСтатуса);
		Возврат Результат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.ОтметкаСтроки
		|	И Т.АвторСтроки = &АвторСтроки
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|	И НЕ Т.Удаление";
	Запрос.УстановитьПараметр("АвторСтроки", ПараметрыСеанса.ТекущийПользователь);
	Идентификаторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторЗаписи");

	Если Идентификаторы.Количество() = 0 И ЗначениеЗаполнено(ИдентификаторТекущей) Тогда
		Идентификаторы.Добавить(ИдентификаторТекущей);
	КонецЕсли;

	Для Каждого Идентификатор Из Идентификаторы Цикл
		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
		Набор.Отбор.ИдентификаторЗаписи.Установить(Идентификатор);
		Набор.Прочитать();
		Если Набор.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		Запись = Набор[0];
		Если Запись.Удаление
			Или Запись.ВидОперации <> Перечисления.Арм_ВидыОпераций.Продажа
			Или Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном Тогда
			Продолжить;
		КонецЕсли;
		// D2: администратор - всегда (ЗаблокированоФоном отсеяно выше); менеджер - по матрице (колонка line_status).
		Если Роль <> Перечисления.Арм_РолиИнтерфейса.Администратор
			И Не Арм_МатрицаПрав.МожноРедактироватьПоле(Роль, Запись.СтатусСтроки, "СтатусСтроки") Тогда
			Результат.Отказано = Результат.Отказано + 1;
			Продолжить;
		КонецЕсли;
		// v2.12 (H02, D12=A): whitelist from→to для трёх MVP-кнопок.
		Если Не ДопустимПереходСтатусаМВП(Запись.СтатусСтроки, НовыйСтатус) Тогда
			ОтказПерехода = ОтказПерехода + 1;
			Продолжить;
		КонецЕсли;
		// v2.11 (T08): менеджер не переводит из «Черновик»/«В работе» строку с незаполненными обязательными полями.
		Если Роль = Перечисления.Арм_РолиИнтерфейса.Менеджер И СтатусКонтроляОбязательныхАРМ(Запись.СтатусСтроки) Тогда
			Незаполненные = НезаполненныеОбязательныеПоляАРМ(Запись);
			Если Незаполненные.Количество() > 0 Тогда
				Неполных = Неполных + 1;
				Для Каждого ИмяНезаполненного Из Незаполненные Цикл
					Если СтрНайти(ТекстНеполных, ИмяНезаполненного) = 0 Тогда
						ТекстНеполных = ТекстНеполных + ?(ПустаяСтрока(ТекстНеполных), "", "; ") + ИмяНезаполненного;
					КонецЕсли;
				КонецЦикла;
				Продолжить;
			КонецЕсли;
		КонецЕсли;

		Запись.СтатусСтроки = НовыйСтатус;
		Запись.ОтметкаСтроки = Ложь;
		Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();

		Попытка
			Набор.Записать();
			Результат.Изменено = Результат.Изменено + 1;
		Исключение
			ЗаписьЖурналаРегистрации("АРМ.ОшибкаСменыСтатуса", УровеньЖурналаРегистрации.Ошибка,,,
				СтрШаблон("Строка %1, статус %2: %3", Строка(Идентификатор), ИмяСтатуса,
					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			Результат.Ошибка = "Часть строк не удалось сохранить: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		КонецПопытки;
	КонецЦикла;

	Если Результат.Изменено = 0 И Результат.Отказано > 0 И Не ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Результат.Ошибка = СтрШаблон("Роль «%1» не вправе менять статус выбранных строк в их текущем статусе (матрица прав АРМ): %2 шт.",
			Строка(Роль), Результат.Отказано);
	КонецЕсли;
	Если Результат.Изменено = 0 И ОтказПерехода > 0 И Не ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Результат.Ошибка = СтрШаблон(
			"Переход в статус «%1» недопустим из текущего статуса строк (закрытые/тот же статус): %2 шт.",
			ИмяСтатуса, ОтказПерехода);
	КонецЕсли;
	Если Неполных > 0 И Не ЗначениеЗаполнено(Результат.Ошибка) Тогда
		Результат.Ошибка = СтрШаблон("Статус не изменён у строк с незаполненными обязательными полями (%1 шт.): %2.",
			Неполных, ТекстНеполных);
	КонецЕсли;

	Возврат Результат;

КонецФункции

#КонецОбласти

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Попытка
		ПрименитьКолонкиПоМатрице();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	КонецПопытки;
	Попытка
		НастроитьКомандыСтатусовАдминистратора();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	КонецПопытки;
	Попытка
		НастроитьУсловноеОформление();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		МассивВидовОперация = Новый Массив;
		МассивВидовОперация.Добавить(Перечисления.Арм_ВидыОпераций.Закупка);
		МассивВидовОперация.Добавить(Перечисления.Арм_ВидыОпераций.ПустаяСсылка());
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("МассивВидОперации", МассивВидовОперация);
		Период.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
		ДанныеАРМОтображение.Параметры.УстановитьЗначениеПараметра("ВременноЗаблокированныеКлючи", Новый Массив);
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("ВременноЗаблокированныеКлючи", Новый Массив);
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		НастроитьОформлениеБлокировкиФоном();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		УстановитьПериодНаСервере();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		ОбновитьФлагГруппировки();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		ОбновитьФлагТолькоСЗакупками();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		ОбновитьФлагСкрытьОтгруженные();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		ОбновитьФлагСкрытьВычеркнутыеЗаписи();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		УстановитьОформлениеПриВводеЦеныКоэффициента();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	КонецПопытки;
	Попытка
		УстановитьЗначокМашинки();
	Исключение
		
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьЗначокМашинки()
	
	ЭлементМашинка = УсловноеОформление.Элементы.Добавить();
	
	ЭлементМашинка.Оформление.УстановитьЗначениеПараметра("Картинка", БиблиотекаКартинок.Арм_Грузовичок);
	
	УсловиеСтатуса = ЭлементМашинка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	УсловиеСтатуса.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДанныеАРМОтображение.СтатусСтроки");
	УсловиеСтатуса.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	УсловиеСтатуса.ПравоеЗначение = Перечисления.Арм_СтатусыАРМ.Заказано;
	
	ПолеСтатуса = ЭлементМашинка.Поля.Элементы.Добавить();
	ПолеСтатуса.Поле = Новый ПолеКомпоновкиДанных("ДанныеАРМОтображениеСтатусСтроки");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОформлениеПриВводеЦеныКоэффициента()
	
	ОформлениеЦена = УсловноеОформление.Элементы.Добавить();
	ОформлениеЦена.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина));
	
	УсловиеЦена = ОформлениеЦена.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	УсловиеЦена.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДанныеАРМОтображение.ТипИзмененияЦены");
	УсловиеЦена.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	УсловиеЦена.ПравоеЗначение = 1;
	
	ПолеЦена = ОформлениеЦена.Поля.Элементы.Добавить();
	ПолеЦена.Поле = Новый ПолеКомпоновкиДанных("ДанныеАРМОтображениеЦена");
	
	ОформлениеКоэф = УсловноеОформление.Элементы.Добавить();
	ОформлениеКоэф.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина)); 
	
	УсловиеКоэф = ОформлениеКоэф.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	УсловиеКоэф.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДанныеАРМОтображение.ТипИзмененияЦены");
	УсловиеКоэф.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	УсловиеКоэф.ПравоеЗначение = 2;
	
	ПолеКоэф = ОформлениеКоэф.Поля.Элементы.Добавить();
	ПолеКоэф.Поле = Новый ПолеКомпоновкиДанных("ДанныеАРМОтображениеКоэффициент");
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОшибкуУсловногоОформления()
	
	ТекстОшибкиИнтерфейса = СтрШаблон(
		"Сбой при сборке условного оформления АРМа: %1", 
		КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
	);
	
	ЗаписьЖурналаРегистрации(
		"АРМ.ОшибкаИнтерфейса", 
		УровеньЖурналаРегистрации.Предупреждение, 
		, 
		, 
		ТекстОшибкиИнтерфейса
	);
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьФлагСкрытьОтгруженные()
	
	СохраненноеЗначение = ХранилищеОбщихНастроек.Загрузить("АРМ_Автосервис_Настройки", "СкрытьОтгруженные");
	СкрытьОтгруженные = ?(СохраненноеЗначение = Неопределено, Истина, СохраненноеЗначение);
	СкрытьОтгруженныеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФлагГруппировки()
	
	ФлагЗаказ1С      = ХранилищеОбщихНастроек.Загрузить("АРМ_НастройкаГруппировки", "ФлагГруппировкиЗаказ1С");
	ФлагЗаказКлиента = ХранилищеОбщихНастроек.Загрузить("АРМ_НастройкаГруппировки", "ФлагГруппировкиЗаказКлиента");
	
	СгруппироватьПоЗаказуПокупателя   = ?(ФлагЗаказ1С = Неопределено,      Ложь, ФлагЗаказ1С);
	ГруппироватьПоНомеруЗаказаКлиента = ?(ФлагЗаказКлиента = Неопределено, Ложь, ФлагЗаказКлиента);
	
	Если СгруппироватьПоЗаказуПокупателя И ГруппироватьПоНомеруЗаказаКлиента Тогда
		ГруппироватьПоНомеруЗаказаКлиента = Ложь;
	КонецЕсли;
	
	УстановитьГруппировкуАРМНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФлагТолькоСЗакупками()
	СохраненноеЗначение = ХранилищеОбщихНастроек.Загрузить("АС_АРМ_Снабжение", "ТолькоСЗакупками");
    Если СохраненноеЗначение <> Неопределено Тогда
        ТолькоСЗакупками = СохраненноеЗначение;
        УстановитьОтборПоЗакупкам(); 
    КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФлагСкрытьВычеркнутыеЗаписи()
	
	ЗначениеИзХранилища = ХранилищеОбщихНастроек.Загрузить("АРМ_НастройкиДанных", "НеПоказыватьВычеркнутые");
	НеПоказыватьВычеркнутыеПозиции = ?(ЗначениеИзХранилища = Неопределено, Ложь, ЗначениеИзХранилища);
	СкрытьПоказатьВычеркнутыеПозицииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформление()
	
	Автор = ПараметрыСеанса.ТекущийПользователь;
	ДанныеАРМОтображение.УсловноеОформление.Элементы.Очистить();
	
	// общее оформление для всего списка (текст мельче)
	ЭлементОбщий = ДанныеАРМОтображение.УсловноеОформление.Элементы.Добавить();
	// шрифт 
	ЭлементОбщий.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт("MS Shell Dlg", 8, Ложь, Ложь, Ложь));
	ЭлементОбщий.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(60, 60, 60));
	
	// вычеркнутые
	ЭлементВычеркнутые = ДанныеАРМОтображение.УсловноеОформление.Элементы.Добавить();
	ШрифтЗачеркнутый = Новый Шрифт(,,,,, Истина); // Последний параметр - Зачеркивание
	ЭлементВычеркнутые.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЗачеркнутый);
	ЭлементВычеркнутые.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(160, 160, 160)); //ЦветаСтиля.ТекстВторостепеннойНадписи);
	
	// условие по удаленным
	ВычеркнутыеСтроки = ЭлементВычеркнутые.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ВычеркнутыеСтроки.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Удаление");
	ВычеркнутыеСтроки.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ВычеркнутыеСтроки.ПравоеЗначение = Истина;
	
	// вычеркнутые закупки
	ЭлементВычеркнутыеЗакупки = ДанныеАРМОтображениеЗакупки.УсловноеОформление.Элементы.Добавить();
	ШрифтЗачеркнутый = Новый Шрифт(,,,,, Истина); // Последний параметр - Зачеркивание
	ЭлементВычеркнутыеЗакупки.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЗачеркнутый);
	ЭлементВычеркнутыеЗакупки.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(160, 160, 160)); //ЦветаСтиля.ТекстВторостепеннойНадписи);
	
	// условие по удаленным
	ВычеркнутыеСтрокиЗакупки = ЭлементВычеркнутыеЗакупки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ВычеркнутыеСтрокиЗакупки.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Удаление");
	ВычеркнутыеСтрокиЗакупки.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ВычеркнутыеСтрокиЗакупки.ПравоеЗначение = Истина;
	
	//
	ЭлементПродажи = ДанныеАРМОтображение.УсловноеОформление.Элементы.Добавить();
	ЭлементПродажи.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 224, 178)); 
	
	//
	ОтборПродажи = ЭлементПродажи.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПродажи.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ВидОперации");
	ОтборПродажи.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПродажи.ПравоеЗначение = Перечисления.Арм_ВидыОпераций.Закупка;
	//
	
	// настройка для своих галочек
	ЭлементСвои = ДанныеАРМОтображение.УсловноеОформление.Элементы.Добавить();
	ЭлементСвои.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(220, 255, 220)); 
	
	// условие 1: ОтметкаСтроки = Истина
	ОтборСвои = ЭлементСвои.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСвои.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ОтметкаСтроки");
	ОтборСвои.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборСвои.ПравоеЗначение = Истина;
	
	// условие 2: Автор = ТекущийПользователь
	ОтборСвоиАвтор = ЭлементСвои.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСвоиАвтор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("АвторСтроки");
	ОтборСвоиАвтор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборСвоиАвтор.ПравоеЗначение = Автор;
	
	// настройках для чужих галочек
	ЭлементЧужие = ДанныеАРМОтображение.УсловноеОформление.Элементы.Добавить();
	ЭлементЧужие.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(160, 160, 160));	
	// условие 1: ОтметкаСтроки = Истина
	ОтборЧужие = ЭлементЧужие.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЧужие.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ОтметкаСтроки");
