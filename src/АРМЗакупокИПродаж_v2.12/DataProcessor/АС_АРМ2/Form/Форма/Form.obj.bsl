	ПолеОфКол.Поле = Новый ПолеКомпоновкиДанных("Количество"); 

	// 2. Поле "Цена" в продажах (ОТДЕЛЬНЫМ элементом)
	ЭлементЦена = ДанныеАРМОтображение.УсловноеОформление.Элементы.Добавить();
	ЭлементЦена.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветОшибки);

	ОтборЦена = ЭлементЦена.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЦена.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Цена");
	ОтборЦена.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЦена.ПравоеЗначение = 0;

	ПолеОфЦена = ЭлементЦена.Поля.Элементы.Добавить();
	ПолеОфЦена.Поле = Новый ПолеКомпоновкиДанных("Цена");
	
