&НаСервере
Процедура СоздатьЗаказПоставщикуНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
		|	Т.ДокументЗаказПокупателя КАК ДокументЗаказПокупателя,
		|	Т.КлючСвязиСтрок КАК КлючСвязиСтрок,
		|	Т.Номенклатура КАК Номенклатура,
		|	Т.Количество КАК Количество,
		|	Т.Поставщик КАК Поставщик,
		|	Т.Договор КАК Договор,
		|	Т.Цена КАК Цена
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.ОтметкаСтроки
		|	И Т.АвторСтроки = &АвторСтроки
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
		|	И Т.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Черновик)
		|	И НЕ Т.Удаление";
	
	Запрос.УстановитьПараметр("АвторСтроки", ПараметрыСеанса.ТекущийПользователь);
	РезультатЗапроса = Запрос.Выполнить();
	ТЗ_Выделенные = РезультатЗапроса.Выгрузить();
	
	Если ТЗ_Выделенные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	///==/////СоздатьЗаказыПоставщикамНаСервере(ТЗ_Выделенные);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыбораВидаОперации(Результат, ДанныеСтроки) Экспорт
    
    Если Результат <> Неопределено Тогда
        
        УстановитьВидОперацииНаСервере(ДанныеСтроки, Результат);
        Элементы.ДанныеАРМОтображение.Обновить(); 
		Элементы.ДанныеАРМОтображениеЗакупки.Обновить();
        
