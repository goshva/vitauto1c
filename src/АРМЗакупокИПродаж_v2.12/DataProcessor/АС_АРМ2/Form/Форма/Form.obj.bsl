    Набор.Прочитать();
    
    Если Набор.Количество() > 0 Тогда
        
        Запись = Набор[0];
        Запись.ДатаОтгрузки = ДанныеСтроки.ДатаОтгрузки;
        
        Попытка
            Набор.Записать();
        Исключение
