&НаКлиенте
Процедура ПоказатьДокументРасходнаяНакладная(Команда)
	СписокДокументов = ПолучитьСписокНужныхДокументовДляОткрытия("РасходнаяНакладная");
    Для Каждого ДокументСсылка Из СписокДокументов Цикл
        ПоказатьЗначение(, ДокументСсылка);
	КонецЦикла;
	Если СписокДокументов.Количество() = 0 Тогда
		ТекстСообщения = "Для выделенных строк отсутствует документ расходная накладная";
		ПоказатьОповещениеПользователя("Не данных для отображения", , ТекстСообщения);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ГруппироватьПоНомеруЗаказаКлиентаПриИзменении(Элемент)
	
	Если ГруппироватьПоНомеруЗаказаКлиента Тогда
		СгруппироватьПоЗаказуПокупателя = Ложь;
	КонецЕсли;
	
	УстановитьГруппировкуАРМНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьГруппировкуАРМНаСервере()
    
    Настройки = ДанныеАРМОтображение.КомпоновщикНастроек.Настройки;
    Настройки.Структура.Очистить();
    
    Если СгруппироватьПоЗаказуПокупателя Тогда
		
        ГруппировкаПоЗаказу = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
        ПолеГрупп = ГруппировкаПоЗаказу.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
        ПолеГрупп.Поле = Новый ПолеКомпоновкиДанных("ДокументЗаказПокупателя");
        ПолеГрупп.Использование = Истина;
        
        Детальные = ГруппировкаПоЗаказу.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		
    ИначеЕсли ГруппироватьПоНомеруЗаказаКлиента Тогда
		
		ГруппировкаПоНомера = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
        ПолеГрупп = ГруппировкаПоНомера.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
        ПолеГрупп.Поле = Новый ПолеКомпоновкиДанных("НомерЗаказаКлиента");
        ПолеГрупп.Использование = Истина;
        
        Детальные = ГруппировкаПоНомера.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		
    Иначе
		
        Детальные = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		
    КонецЕсли;
    
    Детальные.Использование = Истина;
    Детальные.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
    
    ДанныеАРМОтображение.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	
	ХранилищеОбщихНастроек.Сохранить("АРМ_НастройкаГруппировки", "ФлагГруппировкиЗаказ1С", СгруппироватьПоЗаказуПокупателя);
	ХранилищеОбщихНастроек.Сохранить("АРМ_НастройкаГруппировки", "ФлагГруппировкиЗаказКлиента", ГруппироватьПоНомеруЗаказаКлиента);

КонецПроцедуры

