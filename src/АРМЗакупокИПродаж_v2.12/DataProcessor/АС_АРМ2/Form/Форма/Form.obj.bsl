	ОтборДоговр = ГруппаИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборДоговр.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Договор");
	ОтборДоговр.ВидСравнения  = ВидСравненияКомпоновкиДанных.НеЗаполнено;

