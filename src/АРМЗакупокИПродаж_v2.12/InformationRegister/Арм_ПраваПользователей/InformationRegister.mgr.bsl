Функция ПолучитьРольИнтерфейсаПользователя(Знач ТекущийПользователь) Экспорт
	
	ЗначениеПоУмолчанию = Перечисления.Арм_РолиИнтерфейса.Менеджер;
	
	Если Не ЗначениеЗаполнено(ТекущийПользователь) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	ЗапросПрава = Новый Запрос;
	ЗапросПрава.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Рег.РольИнтерфейса КАК РольИнтерфейса
		|ИЗ
		|	РегистрСведений.Арм_ПраваПользователей КАК Рег
		|ГДЕ
		|	Рег.Пользователь = &Пользователь";
		
	ЗапросПрава.УстановитьПараметр("Пользователь", ТекущийПользователь);
	Выборка = ЗапросПрава.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.РольИнтерфейса;
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

// v2.11 (T01, D1b): строгая роль для проверок ПРАВ — без подстановки «Менеджер».
// ПолучитьРольИнтерфейсаПользователя() выше остаётся «мягкой» (fail-open) и нужна только для выбора формы
// (ОбработкаПолученияФормы), чтобы пользователь без записи мог открыть АРМ на просмотр.
// Возвращает Перечисления.Арм_РолиИнтерфейса.ПустаяСсылка(), если у пользователя нет записи в регистре.
Функция ПолучитьРольИнтерфейсаСтрого(Знач Пользователь) Экспорт
	
	Если Не ЗначениеЗаполнено(Пользователь) Тогда
		Возврат Перечисления.Арм_РолиИнтерфейса.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Рег.РольИнтерфейса КАК РольИнтерфейса
		|ИЗ
		|	РегистрСведений.Арм_ПраваПользователей КАК Рег
		|ГДЕ
		|	Рег.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.РольИнтерфейса;
	КонецЕсли;
	
	Возврат Перечисления.Арм_РолиИнтерфейса.ПустаяСсылка();
	
КонецФункции

// v2.11 (T01): единая серверная точка ACL «роль × статус × поле».
// Роль — строго из регистра (нет записи — отказ), статус строки — из Арм_ДанныеЗакупокИПродаж (не от клиента).
// Возвращает пустую строку, если правка разрешена, иначе текст отказа. Правила — общий модуль Арм_МатрицаПрав.
Функция ОтказПоПравамНаПолеСтроки(Знач ИдентификаторЗаписи, Знач ИмяПоляРегистра, Знач Пользователь = Неопределено) Экспорт
	
	Если Пользователь = Неопределено Тогда
		Пользователь = ПараметрыСеанса.ТекущийПользователь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.СтатусСтроки КАК СтатусСтроки
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.ИдентификаторЗаписи = &ИдентификаторЗаписи";
	Запрос.УстановитьПараметр("ИдентификаторЗаписи", ИдентификаторЗаписи);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		Возврат "Строка не найдена — возможно, её уже удалили. Обновите список.";
	КонецЕсли;
	
	// Правила (в т.ч. текст отказа) — в общем модуле Арм_МатрицаПрав; роль строго из регистра (D1b).
	СтатусСтроки = Выборка.СтатусСтроки;
	Роль = ПолучитьРольИнтерфейсаСтрого(Пользователь);
	
	Если Арм_МатрицаПрав.МожноРедактироватьПоле(Роль, СтатусСтроки, ИмяПоляРегистра) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Роль) Тогда
		Возврат "Для вашей учётной записи не задана роль в регистре «Права пользователей АРМ». Обратитесь к администратору.";
	КонецЕсли;
	Если СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном Тогда
		Возврат "Строка обрабатывается фоновым заданием — правка недоступна. Повторите позже.";
	КонецЕсли;
	Возврат СтрШаблон("Роль «%1» не может менять поле «%2» в статусе строки «%3» (матрица прав АРМ).",
		Строка(Роль), ИмяПоляРегистра, Строка(СтатусСтроки));
	
КонецФункции

// v2.11 (D1b): отчёт «пользователи без записи в Арм_ПраваПользователей» — им правка в АРМ запрещена (fail-closed).
// Возвращает ТаблицаЗначений: Пользователь, Наименование. Для запуска из консоли запросов/внешней обработки на ТЕСТОВОЙ ИБ.
Функция ПользователиБезПравАРМ() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	П.Ссылка КАК Пользователь,
		|	П.Наименование КАК Наименование
		|ИЗ
		|	Справочник.Пользователи КАК П
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Арм_ПраваПользователей КАК Рег
		|		ПО (Рег.Пользователь = П.Ссылка)
		|ГДЕ
		|	Рег.Пользователь ЕСТЬ NULL
		|	И НЕ П.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции