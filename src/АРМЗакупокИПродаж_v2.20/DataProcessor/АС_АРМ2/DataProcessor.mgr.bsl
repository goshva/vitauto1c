
Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	ТекущаяРоль = РегистрыСведений.Арм_ПраваПользователей.ПолучитьРольИнтерфейсаПользователя(ПараметрыСеанса.ТекущийПользователь);
	
	Если ТекущаяРоль = Перечисления.Арм_РолиИнтерфейса.Снабжение Тогда
		СтандартнаяОбработка = Ложь;
		ВыбраннаяФорма = "Обработка.АС_АРМ2.Форма.ФормаСнабжение";
	КонецЕсли; 
	
	Если ТекущаяРоль = Перечисления.Арм_РолиИнтерфейса.Менеджер Тогда
		СтандартнаяОбработка = Ложь;
		ВыбраннаяФорма = "Обработка.АС_АРМ2.Форма.Форма";
	КонецЕсли;

	// Администратор работает в форме продаж: видит все колонки матрицы и правит разрешённые ему
	Если ТекущаяРоль = Перечисления.Арм_РолиИнтерфейса.Администратор Тогда
		СтандартнаяОбработка = Ложь;
		ВыбраннаяФорма = "Обработка.АС_АРМ2.Форма.Форма";
	КонецЕсли;
	
	// Роли матрицы без собственной формы: кладовщик, главный механик, клиент, поставщик.
	// Пока работают в форме продаж; права по колонкам и статусам — отдельные задачи.
	Если ТекущаяРоль = Перечисления.Арм_РолиИнтерфейса.Кладовщик
		Или ТекущаяРоль = Перечисления.Арм_РолиИнтерфейса.ГлавныйМеханик
		Или ТекущаяРоль = Перечисления.Арм_РолиИнтерфейса.Клиент
		Или ТекущаяРоль = Перечисления.Арм_РолиИнтерфейса.Поставщик Тогда
		СтандартнаяОбработка = Ложь;
		ВыбраннаяФорма = "Обработка.АС_АРМ2.Форма.Форма";
	КонецЕсли;
	
КонецПроцедуры
