Процедура ОбновитьДанныеПоОбъекту(СсылкаНаОбъект, ТаблицаЗапасов, Знач ЭтоИнтерактивнаяЗапись = Ложь) Экспорт
	
	ТипОбъекта = ТипЗнч(СсылкаНаОбъект);
	ИмяИзмерения = "";
	
	ПоставщикСсыылка = Справочники.Контрагенты.ПустаяСсылка();
	ПокупательСсылка = Справочники.Контрагенты.ПустаяСсылка();
	ДоговорСсылка = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	РеквизитыКонтрагентИДоговор = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, "Контрагент, Договор, НомерЗаказаКлиента, Дата, Номер");
	
	Если ТипОбъекта = Тип("ДокументСсылка.ЗаказПокупателя") Тогда
		ИмяИзмерения = "ДокументЗаказПокупателя";
		ВводВидаОперации = Перечисления.Арм_ВидыОпераций.Продажа;
		ПокупательСсылка = РеквизитыКонтрагентИДоговор.Контрагент;
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.ЗаказПоставщику") Тогда
		ИмяИзмерения = "ДокументЗаказПоставщику";
		ВводВидаОперации = Перечисления.Арм_ВидыОпераций.Закупка;
		ПоставщикСсыылка = РеквизитыКонтрагентИДоговор.Контрагент;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИмяИзмерения) Тогда 
		Возврат; 
	КонецЕсли;
	
	ДоговорСсылка = РеквизитыКонтрагентИДоговор.Договор;
	Если Не ЗначениеЗаполнено(ДоговорСсылка) Тогда
		ДоговорСсылка = Арм_ОбщегоНазначенияАРМ.НайтиДоговор(РеквизитыКонтрагентИДоговор.Контрагент);
	КонецЕсли;
	
	ЗапросМакс = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(МАКСИМУМ(Порядок), 0) КАК Макс ИЗ РегистрСведений.Арм_ДанныеЗакупокИПродаж");
	ВыборкаМакс = ЗапросМакс.Выполнить().Выбрать();
	ПоследнийПорядок = ?(ВыборкаМакс.Следующий(), ВыборкаМакс.Макс, 0);

	ЗапросСтарые = Новый Запрос;
	ЗапросСтарые.Текст = 
		"ВЫБРАТЬ ИдентификаторЗаписи, Порядок 
		|ИЗ РегистрСведений.Арм_ДанныеЗакупокИПродаж 
		|ГДЕ " + ИмяИзмерения + " = &Документ";
	ЗапросСтарые.УстановитьПараметр("Документ", СсылкаНаОбъект);
	
	СтарыеПорядки = Новый Соответствие;
	ВыборкаСтарые = ЗапросСтарые.Выполнить().Выбрать();
	Пока ВыборкаСтарые.Следующий() Цикл
		СтарыеПорядки.Вставить(ВыборкаСтарые.ИдентификаторЗаписи, ВыборкаСтарые.Порядок);
	КонецЦикла;
	
	Набор = СоздатьНаборЗаписей();
	Набор.Отбор[ИмяИзмерения].Установить(СсылкаНаОбъект);
	
	Для Каждого СтрокаТЧ Из ТаблицаЗапасов Цикл
		НоваяЗапись = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаТЧ);
		НоваяЗапись[ИмяИзмерения] = СсылкаНаОбъект;
		НоваяЗапись.ВидОперации = ВводВидаОперации;
		НоваяЗапись.ИдентификаторЗаписи = СтрокаТЧ.КлючСвязиСтрок;
		НоваяЗапись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ВРаботе;
		НоваяЗапись.Поставщик = ПоставщикСсыылка;
		НоваяЗапись.Покупатель = ПокупательСсылка;
		НоваяЗапись.Договор = ДоговорСсылка;
		НоваяЗапись.НомерЗаказаКлиента = РеквизитыКонтрагентИДоговор.НомерЗаказаКлиента;
		НоваяЗапись.ДатаЗаказа = РеквизитыКонтрагентИДоговор.Дата;
		НоваяЗапись.НомерЗаказа = РеквизитыКонтрагентИДоговор.Номер;
		
		СтарыйПорядокДляСтроки = СтарыеПорядки[НоваяЗапись.ИдентификаторЗаписи];
		Если СтарыйПорядокДляСтроки <> Неопределено Тогда
			НоваяЗапись.Порядок = СтарыйПорядокДляСтроки;
		Иначе
			ПоследнийПорядок = ПоследнийПорядок + 1;
			НоваяЗапись.Порядок = ПоследнийПорядок;
		КонецЕсли;
	КонецЦикла;
	
	Попытка
        Набор.Записать(); 
	Исключение
	    ТекстОшибки = СтрШаблон(
	        "Ошибка записи в АРМ-регистр. Документ: %1, Описание: %2", 
	        Строка(СсылкаНаОбъект), 
	        КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
	    );
	    ЗаписьЖурналаРегистрации(
	        "АРМ.ЗаписьДанных", 
	        УровеньЖурналаРегистрации.Ошибка, 
	        СсылкаНаОбъект.Метаданные(), 
	        СсылкаНаОбъект, 
	        ТекстОшибки
	    );
		Возврат;
	КонецПопытки;
	
	Если ВводВидаОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда
        Для Каждого Запись Из Набор Цикл
            
            ДанныеДляРаспределения = Новый Структура;
			МетаданныеРегистра = Метаданные.РегистрыСведений.Арм_ДанныеЗакупокИПродаж;
			МассивКоллекций = Новый Массив;
			МассивКоллекций.Добавить(МетаданныеРегистра.Измерения);
			МассивКоллекций.Добавить(МетаданныеРегистра.Ресурсы);
			МассивКоллекций.Добавить(МетаданныеРегистра.Реквизиты);
			
			Для Каждого Коллекция Из МассивКоллекций Цикл
				Для Каждого ЭлементМетаданных Из Коллекция Цикл
					ИмяПоля = ЭлементМетаданных.Имя;
					ДанныеДляРаспределения.Вставить(ИмяПоля, Запись[ИмяПоля]);
				КонецЦикла;
			КонецЦикла;
            
            ДанныеДляРаспределения.РучнаяПравкаПартии = Ложь;
            ДанныеДляРаспределения.РучноеРазделениеСУчетомПартий = Ложь;
			
        КонецЦикла;
    КонецЕсли;
	
	СписокНоменклатуры = Новый Соответствие;
    Для Каждого Запись Из Набор Цикл
        Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда
            СписокНоменклатуры.Вставить(Запись.Номенклатура, Истина);
        КонецЕсли;
    КонецЦикла;
    
	СсылкаДляРезерва = ?(ТипЗнч(СсылкаНаОбъект) = Тип("ДокументСсылка.ЗаказПокупателя"), 
                     СсылкаНаОбъект, 
                     Документы.ЗаказПокупателя.ПустаяСсылка());
					 
	Для Каждого КлючИЗначение Из СписокНоменклатуры Цикл
        Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(КлючИЗначение.Ключ, СсылкаДляРезерва, ЭтоИнтерактивнаяЗапись);
    КонецЦикла;
	
КонецПроцедуры 

Процедура СброситьФлагиПользователя(Пользователь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	* 
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.АвторСтроки = &Пользователь
		|	И Т.ОтметкаСтроки = ИСТИНА";
	
	Запрос.УстановитьПараметр("Пользователь", Пользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		МЗ = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(МЗ, Выборка);
		
		МЗ.Прочитать();
		Если МЗ.Выбран() Тогда
			МЗ.ОтметкаСтроки = Ложь;
			МЗ.АвторСтроки   = Справочники.Пользователи.ПустаяСсылка();
			Попытка
				МЗ.Записать();
			Исключение
				ТекстОшибки = СтрШаблон(
					"Ошибка снятия ОтметкаСтроки в АРМ-регистре: пользователь: %1, Описание: %2", 
					Строка(Пользователь), 
					КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
	   			 );
				ЗаписьЖурналаРегистрации(
					"АРМ.СнятиеОтмеченныхСтрок", 
					УровеньЖурналаРегистрации.Ошибка, 
					, 
					, 
					ТекстОшибки
				);	
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры  

