&НаСервере
Процедура УстановитьВидОперацииНаСервере(ДанныеСтроки, НовыйВидОперации)
	
	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(ДанныеСтроки.ИдентификаторЗаписи);
	Набор.Прочитать();
	
	Если Набор.Количество() > 0 Тогда
		Запись = Набор[0];
		Запись.ВидОперации = НовыйВидОперации;
		Попытка
			Набор.Записать();
			
			// пересчет остатков для строки
			Если ЗначениеЗаполнено(ДанныеСтроки.Номенклатура) Тогда
				Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(ДанныеСтроки.Номенклатура, ДанныеСтроки.ДокументЗаказПокупателя);
			КонецЕсли;
			
		Исключение
			ТекстОшибки = СтрШаблон(
				"Ошибка записи в АРМ-регистр. ВидОперации: %1, Описание: %2", 
				Строка(ДанныеСтроки.ИдентификаторЗаписи), 
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			);
			ЗаписьЖурналаРегистрации(
				"АРМ.ВыборВидОперации", 
				УровеньЖурналаРегистрации.Ошибка, 
				, 
				, 
				ТекстОшибки
			);
		КонецПопытки;
	КонецЕсли;
        
КонецПроцедуры

