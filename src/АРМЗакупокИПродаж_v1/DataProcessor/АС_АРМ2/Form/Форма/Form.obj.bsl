&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьСписокАРМ" Тогда
		//ОбновитьСписокПоТаймеру();
		
		ПолеОтбора = Новый ПолеКомпоновкиДанных("ДокументЗаказПокупателя");
		
		ГруппаОтбора = ДанныеАРМОтображение.КомпоновщикНастроек.ФиксированныеНастройки.Отбор;
		
		Для Каждого Элемент Из ГруппаОтбора.Элементы Цикл
			Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") 
				И Элемент.ЛевоеЗначение = ПолеОтбора Тогда
				ГруппаОтбора.Элементы.Удалить(Элемент);
			КонецЕсли;
		КонецЦикла;
		
		НовыйОтбор = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		НовыйОтбор.ЛевоеЗначение  = ПолеОтбора;
		НовыйОтбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		НовыйОтбор.ПравоеЗначение = Параметр;
		НовыйОтбор.Использование  = Истина;
		
		ОбновитьСписокПоТаймеру();
		
	КонецЕсли;
	
КонецПроцедуры

