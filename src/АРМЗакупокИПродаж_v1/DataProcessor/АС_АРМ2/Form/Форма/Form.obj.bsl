&НаСервере
Процедура ИзменитьКоличествоНаСервере(ДанныеСтроки)
	
	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	
	// ПРАВКА №1 БРО! Жестко запираем СУБД по обоим ведущим измерениям регистра!
	// Теперь платформа 1С прочитает строго ТУ ОДНУ СТРОКУ, которую менеджер меняет на экране,
	// полностью исключив сбои кэша и ложное размножение строк-паразитов!
	Набор.Отбор.ДокументЗаказПокупателя.Установить(ДанныеСтроки.ДокументЗаказПокупателя);
	Набор.Отбор.ИдентификаторЗаписи.Установить(ДанныеСтроки.ИдентификаторЗаписи);
	Набор.Прочитать();

	Если Набор.Количество() > 0 Тогда
		Запись = Набор[0];
	Иначе 
		Возврат;
	КонецЕсли;
	
	СтароеКоличество   = Запись.Количество;
	НовоеКоличество    = ДанныеСтроки.Количество;
	СтараяНоменклатура = Запись.Номенклатура;
	
	Если СтароеКоличество = НовоеКоличество Тогда
		Возврат;
	КонецЕсли;
	
	// -------------------------------------------------------------------------
	// КОНТУР ОБНУЛЕНИЯ СТРОК АРМА (ЕСЛИ ВВЕЛИ 0)
	
	Если НовоеКоличество = 0 И Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка Тогда
		Набор.Очистить();
		Набор.Записать();
		Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(ДанныеСтроки.Номенклатура, ДанныеСтроки.ДокументЗаказПокупателя);
		Возврат; 
	КонецЕсли;

	Если НовоеКоличество = 0 И Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ

			|	КОЛИЧЕСТВО(Арм_ДанныеЗакупокИПродаж.ИдентификаторЗаписи) КАК СтрокВЗаказе
			|ИЗ
			|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж

			|ГДЕ
			|	Арм_ДанныеЗакупокИПродаж.ДокументЗаказПокупателя = &ДокументЗаказПокупателя";
		
		Запрос.УстановитьПараметр("ДокументЗаказПокупателя", ДанныеСтроки.ДокументЗаказПокупателя);
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаСтрокВЗаказе = РезультатЗапроса.Выбрать();
		Если ВыборкаСтрокВЗаказе.Следующий() Тогда
			Если ВыборкаСтрокВЗаказе.СтрокВЗаказе > 1 Тогда
				Набор.Очистить();
				Набор.Записать();
				Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(ДанныеСтроки.Номенклатура, ДанныеСтроки.ДокументЗаказПокупателя);
				Возврат;
			Иначе
				Возврат;
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	// -------------------------------------------------------------------------
	// КОНТУР ДРОБЛЕНИЯ СТРОК СНАБЖЕНИЯ ПРИ ИЗМЕНЕНИИ КОЛИЧЕСТВА
	
	Если ДанныеСтроки.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка Тогда
			
		Если Запись.РучнаяПравка = Истина Тогда
			Запись.Количество = НовоеКоличество;
		Иначе
			КоличествоДельты = 0;
			Если НовоеКоличество > СтароеКоличество Тогда
				
				// КЕЙС А: Увеличение количества (6 меняем на 10 штук)
				КоличествоДельты = НовоеКоличество - СтароеКоличество; // 10 - 6 = 4 шт
				
				// Рождаем изолированную верхушку запаса на 4 шт со своим уникальным GUID-ключом связи
				СоздатьРучнуюДельтуНаСервере(ДанныеСтроки, КоличествоДельты, Запись.НомерЗаказаКлиента);
				
				// ХИРУРГИЧЕСКИЙ ФИКС БРО! Убираем отсюда ложное Запись.РучнаяПравка = Истина!
				// Исходная строка (6 шт) остается чистокровным АВТО-ДЕФИЦИТОМ (РучнаяПравка = ЛОЖЬ),
				// а новая верхушка запаса (4 шт) ложится рядом как честная Ручная Правка!
				Запись.Количество = СтароеКоличество; // Честно возвращаем исходные 6 шт авто-дефицита
				
				// Возвращаем визуал на форме для синхронизации интерфейса
				ДанныеСтроки.Количество = СтароеКоличество; 
				
			ИначеЕсли НовоеКоличество < СтароеКоличество Тогда
				
				// КЕЙС Б: Уменьшение количества (ИЗОЛЯЦИЯ УРЕЗАННОЙ ЗАКУПКИ ПО НОВОМУ КЛЮЧУ)
				КоличествоДельты = СтароеКоличество - НовоеКоличество; // 5 - 3 = 2 шт
				
				// 1. Исходная строка закупки (3 шт) становится ручной правкой 
				// и получает АБСОЛЮТНО НОВЫЙ уникальный ключ связи, полностью изолируясь от авто-робота!
				Запись.Количество          = НовоеКоличество;
				Запись.РучнаяПравка        = Истина;
				Запись.КлючСвязиСтрок      = Строка(Новый УникальныйИдентификатор);
				Запись.НомерЗаказаКлиента = ДанныеСтроки.НомерЗаказаКлиента;
				
				// Фиксируем урезание в параметрах клиента для синхронизации интерфейса
				ДанныеСтроки.Количество = НовоеКоличество; 
				
				// 2. Рождаем новую авто-Закупку на остаток дефицита (2 шт)
				// ВНИМАНИЕ БРО: Мы оставляем ей СТАРЫЙ исторический ключ связи продаж,
				// чтобы FIFO-монстр мог правильно обсчитать под нее дефицит и ОстатокДляСтроки!
				НоваяЗапись = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьМенеджерЗаписи();
		        ЗаполнитьЗначенияСвойств(НоваяЗапись, ДанныеСтроки);
		        
		        НоваяЗапись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор());
		        НоваяЗапись.КлючСвязиСтрок      = ДанныеСтроки.КлючСвязиСтрок; // Старый ключ продаж!
		        НоваяЗапись.НомерЗаказаКлиента = Запись.НомерЗаказаКлиента;
		        
		        НоваяЗапись.Количество          = КоличествоДельты; // Получит честные 2 шт дефицита
		        НоваяЗапись.РучнаяПравка        = Ложь; // Она остается в авто-контуре!
		        НоваяЗапись.Порядок             = ДанныеСтроки.Порядок + 0.01;
				НоваяЗапись.Цена				= 0;
				
				Попытка
		        	НоваяЗапись.Записать();
				Исключение
					ТекстОшибки = СтрШаблон("Ошибка записи сплит-строки АРМ: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
					ЗаписьЖурналаРегистрации("АРМ.ЗаписьДанных", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
				КонецПопытки;
				
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			Набор.Записать();
			Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(ДанныеСтроки.Номенклатура, ДанныеСтроки.ДокументЗаказПокупателя);
		Исключение
			ТекстОшибки = СтрШаблон("Ошибка записи набора закупки АРМ: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации("АРМ.ЗаписьДанных", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
		
	Иначе
		
		// Контур Сбыта (Продажи) — пишем изменения количества «как есть»
		Запись.Количество = ДанныеСтроки.Количество;
		
		// ПРАВКА №5: На всякий случай страхуем Номер Заказа Клиента в продажах при перезаписи
		Запись.НомерЗаказаКлиента = ДанныеСтроки.НомерЗаказаКлиента;
		
		Попытка
			Набор.Записать();
			Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда
				Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(ДанныеСтроки.Номенклатура, ДанныеСтроки.ДокументЗаказПокупателя);
			КонецЕсли;
		Исключение
			ТекстОшибки = СтрШаблон("Ошибка записи набора продаж АРМ: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации("АРМ.ЗаписьДанных", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораЗначенияНоменклатура(РезультатВыбора, ДополнительныеПараметры) Экспорт
    
    Если РезультатВыбора <> Неопределено Тогда
		ЗаписатьЗначениеВРегистрНаСервереНоменклатура(
			ДополнительныеПараметры.ИдентификаторЗаписи, 
			ДополнительныеПараметры.ИмяПоля, 
			РезультатВыбора
		);
		Элементы.ДанныеАРМОтображение.Обновить();
		Элементы.ДанныеАРМОтображениеЗакупки.Обновить();
	КонецЕсли;
    
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЗначениеВРегистрНаСервереНоменклатура(Идентификатор, ИмяПоля, НоменклатураНовоеЗначение)
	
	СтараяНоменклатура = Справочники.Номенклатура.ПустаяСсылка();
	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(Идентификатор);
	Набор.Прочитать();

	Если Набор.Количество() > 0 Тогда
	    СтараяНоменклатура = Набор[0].Номенклатура;
		СсылкаНаЗаказ = Набор[0].ДокументЗаказПокупателя; 
	КонецЕсли;
	
	НоменклатураИзменена = (СтараяНоменклатура <> НоменклатураНовоеЗначение);
	
	Если Не НоменклатураИзменена Тогда
		Возврат;
	КонецЕсли;
	
    Если Набор.Количество() > 0 Тогда
        Запись = Набор[0];
		
		Если Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда
			Запись.КлючСвязиСтрок = Строка(Новый УникальныйИдентификатор());
			Запись.Партия = Справочники.ПартииНоменклатуры.ПустаяСсылка();
		КонецЕсли;

        Запись[ИмяПоля] = НоменклатураНовоеЗначение;
        Запись.Порядок  = Арм_ОбщегоНазначенияАРМ.ПолучитьПриоритет(НоменклатураНовоеЗначение);
		Запись.ОстатокДляСтроки = 0; 

        Набор.Записать();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтараяНоменклатура) Тогда
		Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(СтараяНоменклатура, СсылкаНаЗаказ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НоменклатураНовоеЗначение) Тогда
		Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(НоменклатураНовоеЗначение, СсылкаНаЗаказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтроку(Команда)
	ВычеркнутьСтрокуНаСервере();
	Элементы.ДанныеАРМОтображение.Обновить();
	Элементы.ДанныеАРМОтображениеЗакупки.Обновить();
КонецПроцедуры

