	//		Элементы.ВыделитьВсеСтрокиЗаказа.Картинка = БиблиотекаКартинок.УстановитьФлажки;
	//	КонецЕсли;
	//	
	//	ОтображениеКнопокДокументов(Элементы.ДанныеАРМОтображениеЗакупки);
	//Иначе
	//    ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("ДокументЗаказПокупателя", "");
	//КонецЕсли;   
	//
	//ОбновитьИтогиВыделения(); 
	
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		
		Флаг1С      = Ложь;
		ФлагКлиента = Ложь;
		ФлагКлюча   = Ложь;
		
		ЗначениеЗаказа1С      = ПредопределенноеЗначение("Документ.ЗаказПокупателя.ПустаяСсылка");
		ЗначениеЗаказаКлиента = "";
		ЗначениеКлючаСвязи    = "";
		
		Если СгруппироватьПоЗаказуПокупателя Тогда
			Если ТекущиеДанные.Свойство("ДокументЗаказПокупателя") Тогда
				Флаг1С           = Истина;
				ЗначениеЗаказа1С = ТекущиеДанные.ДокументЗаказПокупателя;
			КонецЕсли;
		ИначеЕсли ГруппироватьПоНомеруЗаказаКлиента Тогда
			Если ТекущиеДанные.Свойство("НомерЗаказаКлиента") Тогда
				ФлагКлиента           = Истина;
				ЗначениеЗаказаКлиента = ТекущиеДанные.НомерЗаказаКлиента;
			КонецЕсли;
		Иначе
			Если ТекущиеДанные.Свойство("КлючСвязиСтрок") Тогда
				ФлагКлюча          = Истина;
				ЗначениеКлючаСвязи = ТекущиеДанные.КлючСвязиСтрок;
			КонецЕсли;
		КонецЕсли;
		
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("ОтборПоЗаказу1С",         Флаг1С);
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("ДокументЗаказПокупателя", ЗначениеЗаказа1С);
		
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("ОтборПоЗаказуКлиента", 	 ФлагКлиента);
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("НомерЗаказаКлиента",   	 ЗначениеЗаказаКлиента);
		
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("ОтборПоКлючуСвязи",     	 ФлагКлюча);
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("КлючСвязиСтрок",          ЗначениеКлючаСвязи);
		
		Если ТекущиеДанные.Свойство("Удаление") И ТекущиеДанные.Удаление Тогда
			Элементы.ВычеркнутьТовар.Заголовок = "Восстановить товар";
			Элементы.ВычеркнутьТовар.Картинка = БиблиотекаКартинок.ВосстановитьЗначения; 
		КонецЕсли;
		Если ТекущиеДанные.Свойство("Удаление") И Не ТекущиеДанные.Удаление Тогда 
			Элементы.ВычеркнутьТовар.Заголовок = "Вычеркнуть товар";
			Элементы.ВычеркнутьТовар.Картинка = БиблиотекаКартинок.Удалить;
		КонецЕсли;
		
		Если ТекущиеДанные.Свойство("ОтметкаСтроки") И ТекущиеДанные.ОтметкаСтроки Тогда
			Элементы.ВыделитьВсеСтрокиЗаказа.Заголовок = "Отменить выделение всех";
			Элементы.ВыделитьВсеСтрокиЗаказа.Картинка = БиблиотекаКартинок.СнятьФлажки; 
		КонецЕсли;
		Если ТекущиеДанные.Свойство("ОтметкаСтроки") И Не ТекущиеДанные.ОтметкаСтроки Тогда 
			Элементы.ВыделитьВсеСтрокиЗаказа.Заголовок = "Выделить все";
			Элементы.ВыделитьВсеСтрокиЗаказа.Картинка = БиблиотекаКартинок.УстановитьФлажки;
		КонецЕсли;
		
		ОтображениеКнопокДокументов(Элементы.ДанныеАРМОтображениеЗакупки);
	Иначе
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("ОтборПоЗаказу1С",       Ложь);
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("ОтборПоЗаказуКлиента",  Ложь);
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("ОтборПоКлючуСвязи",     Ложь);
	КонецЕсли;   
	
	ОбновитьИтогиВыделения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьИтогиВыделения();
	ВыделенныеСтроки = Элементы.ДанныеАРМОтображение.ВыделенныеСтроки;
	ПоказатьСуммуКоличество(ВыделенныеСтроки);	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСуммуКоличество(ВыделенныеСтроки)
	
	ЭтотОбъект.Количество = 0;
    ЭтотОбъект.Сумма = 0;
    
    Если ВыделенныеСтроки.Количество() > 0 Тогда
        
		Для Каждого Идентификатор Из ВыделенныеСтроки Цикл 
			
			СтрокаДанных = Элементы.ДанныеАРМОтображение.ДанныеСтроки(Идентификатор);
			
			Если СтрокаДанных <> Неопределено Тогда
				Если СтрокаДанных.Свойство("Количество") И СтрокаДанных.Свойство("Цена") Тогда
					ЭтотОбъект.Количество = ЭтотОбъект.Количество + СтрокаДанных.Количество;
					ЭтотОбъект.Сумма = ЭтотОбъект.Сумма + СтрокаДанных.Цена;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
        
    КонецЕсли;
    
КонецПроцедуры

