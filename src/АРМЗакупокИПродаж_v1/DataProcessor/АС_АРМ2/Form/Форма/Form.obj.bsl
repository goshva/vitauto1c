&НаКлиенте
Процедура ДанныеАРМОтображениеЗакупкиПриАктивизацииСтроки(Элемент)
	
	ОтображениеКнопокДокументов(Элемент);
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Свойство("ОтметкаСтроки") И ТекущиеДанные.ОтметкаСтроки Тогда
		Элементы.ВыделитьВсеСтрокиЗаказаЗакупки.Заголовок = "Отменить выделение всех";
		Элементы.ВыделитьВсеСтрокиЗаказаЗакупки.Картинка = БиблиотекаКартинок.СнятьФлажки; 
	КонецЕсли;
	Если ТекущиеДанные.Свойство("ОтметкаСтроки") И Не ТекущиеДанные.ОтметкаСтроки Тогда 
		Элементы.ВыделитьВсеСтрокиЗаказаЗакупки.Заголовок = "Выделить все";
		Элементы.ВыделитьВсеСтрокиЗаказаЗакупки.Картинка = БиблиотекаКартинок.УстановитьФлажки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтображениеКнопокДокументов(Элемент)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Элементы.ПоказатьДокументЗаказПоставщику.Доступность = Ложь;
		Элементы.Заказать.Доступность = Ложь;
		Возврат;
	КонецЕсли;
	
	ДокументЕсть = Ложь;
	Если ТекущиеДанные.Свойство("ДокументЗаказПоставщика") Тогда
		ДокументЕсть = ЗначениеЗаполнено(ТекущиеДанные.ДокументЗаказПоставщика);
	КонецЕсли;
	
	ЭтоЗакупка = Ложь;
	Если ТекущиеДанные.Свойство("ВидОперации") Тогда
		ЭтоЗакупка = (ТекущиеДанные.ВидОперации = ПредопределенноеЗначение("Перечисление.Арм_ВидыОпераций.Закупка"));
	КонецЕсли;
	
	Элементы.ПоказатьДокументЗаказПоставщику.Доступность = ДокументЕсть;
	Элементы.Заказать.Доступность = Не ДокументЕсть И ЭтоЗакупка;
	
КонецПроцедуры

