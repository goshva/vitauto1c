&НаСервереБезКонтекста
Функция ПолучитьСписокДокументовДляОткрытия()
	
	Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |	Т.Ссылка КАК Ссылка
        |ИЗ
        |	(ВЫБРАТЬ
        |		Арм_ДанныеЗакупокИПродаж.ДокументЗаказПокупателя КАК Ссылка
        |	ИЗ
        |		РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
        |	ГДЕ
        |		Арм_ДанныеЗакупокИПродаж.ОтметкаСтроки
        |		И Арм_ДанныеЗакупокИПродаж.АвторСтроки = &Автор
        |		И Арм_ДанныеЗакупокИПродаж.ДокументЗаказПокупателя <> &ПустойЗаказПокупателя
        |	
        |	ОБЪЕДИНИТЬ ВСЕ
        |	
        |	ВЫБРАТЬ
        |		Арм_ДанныеЗакупокИПродаж.ДокументЗаказПоставщика
        |	ИЗ
        |		РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
        |	ГДЕ
        |		Арм_ДанныеЗакупокИПродаж.ОтметкаСтроки
        |		И Арм_ДанныеЗакупокИПродаж.АвторСтроки = &Автор
        |		И Арм_ДанныеЗакупокИПродаж.ДокументЗаказПоставщика <> &ПустойЗаказПоставщика
		|
		|	ОБЪЕДИНИТЬ ВСЕ
        |	
        |	ВЫБРАТЬ
        |		Арм_ДанныеЗакупокИПродаж.РасходнаяНакладная
        |	ИЗ
        |		РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
        |	ГДЕ
        |		Арм_ДанныеЗакупокИПродаж.ОтметкаСтроки
        |		И Арм_ДанныеЗакупокИПродаж.АвторСтроки = &Автор
        |		И Арм_ДанныеЗакупокИПродаж.РасходнаяНакладная <> &ПустаяРасходнаяНакладная
        |	
        |	ОБЪЕДИНИТЬ ВСЕ
        |	
        |	ВЫБРАТЬ
        |		Арм_ДанныеЗакупокИПродаж.ДокументПриходнаяНакладная
        |	ИЗ
        |		РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
        |	ГДЕ
        |		Арм_ДанныеЗакупокИПродаж.ОтметкаСтроки
        |		И Арм_ДанныеЗакупокИПродаж.АвторСтроки = &Автор
        |		И Арм_ДанныеЗакупокИПродаж.ДокументПриходнаяНакладная <> &ПустаяПриходнаяНакладная) КАК Т";
    
    Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);
    
    Запрос.УстановитьПараметр("ПустойЗаказПокупателя",		Документы.ЗаказПокупателя.ПустаяСсылка());
    Запрос.УстановитьПараметр("ПустойЗаказПоставщика", 		Документы.ЗаказПоставщику.ПустаяСсылка());
    Запрос.УстановитьПараметр("ПустаяПриходнаяНакладная",   Документы.ПриходнаяНакладная.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяРасходнаяНакладная",   Документы.РасходнаяНакладная.ПустаяСсылка());
	
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
Конецфункции

&НаСервереБезКонтекста
Функция ПолучитьСписокНужныхДокументовДляОткрытия(НужныйДокумент)
	
	Запрос = Новый Запрос;
    Запрос.Текст = 
        "ВЫБРАТЬ РАЗЛИЧНЫЕ
        |	Т.Ссылка КАК Ссылка
        |ИЗ
        |	(ВЫБРАТЬ
        |		Арм_ДанныеЗакупокИПродаж.НужныйДокумент КАК Ссылка
        |	ИЗ
        |		РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
        |	ГДЕ
        |		Арм_ДанныеЗакупокИПродаж.ОтметкаСтроки
        |		И Арм_ДанныеЗакупокИПродаж.АвторСтроки = &Автор
        |		И Арм_ДанныеЗакупокИПродаж.НужныйДокумент <> &ПустойДокумент) КАК Т";
	
	Запрос.Текст = СтрЗаменить(
		Запрос.Текст, 
		"Арм_ДанныеЗакупокИПродаж.НужныйДокумент", 
		"Арм_ДанныеЗакупокИПродаж." + НужныйДокумент
	);	
    Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);
	
	Если НужныйДокумент = "ДокументЗаказПокупателя" Тогда
    	Запрос.УстановитьПараметр("ПустойДокумент", Документы.ЗаказПокупателя.ПустаяСсылка());
	ИначеЕсли НужныйДокумент = "ДокументЗаказПоставщика" Тогда
		Запрос.УстановитьПараметр("ПустойДокумент", Документы.ЗаказПоставщику.ПустаяСсылка());
	ИначеЕсли НужныйДокумент = "ДокументПриходнаяНакладная" Тогда
		Запрос.УстановитьПараметр("ПустойДокумент", Документы.ПриходнаяНакладная.ПустаяСсылка());
	Иначе
		Запрос.УстановитьПараметр("ПустойДокумент", Документы.РасходнаяНакладная.ПустаяСсылка());
	КонецЕсли;
    
    Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
Конецфункции

&НаСервереБезКонтекста
Процедура ВычеркнутьСтрокуНаСервере()
	
	СписокДляПересчета = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Арм_ДанныеЗакупокИПродаж.КлючСвязиСтрок КАК КлючСвязиСтрок
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_Отмеченные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
		|		ПО Арм_Отмеченные.КлючСвязиСтрок = Арм_ДанныеЗакупокИПродаж.КлючСвязиСтрок
		|ГДЕ
		|	Арм_Отмеченные.ОтметкаСтроки
		|	И Арм_Отмеченные.АвторСтроки = &АвторСтроки
		|	И Арм_Отмеченные.ВидОперации В(&ВидОперации)
		|	И Арм_Отмеченные.СтатусСтроки В(&СтатусыСтрок)";
	
	Запрос.УстановитьПараметр("АвторСтроки", ПараметрыСеанса.ТекущийПользователь);
	МассивВидовОперации = Новый Массив;
	МассивВидовОперации.Добавить(Перечисления.Арм_ВидыОпераций.Продажа);
	МассивВидовОперации.Добавить(Перечисления.Арм_ВидыОпераций.Закупка);
	Запрос.УстановитьПараметр("ВидОперации", МассивВидовОперации);
	МассивСтатусыСтрок = Новый Массив;
	МассивСтатусыСтрок.Добавить(Перечисления.Арм_СтатусыАРМ.Черновик);
	МассивСтатусыСтрок.Добавить(Перечисления.Арм_СтатусыАРМ.ВРаботе);
	Запрос.УстановитьПараметр("СтатусыСтрок", МассивСтатусыСтрок);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаОтмеченныхСтрок = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаОтмеченныхСтрок.Следующий() Цикл
		
		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	    Набор.Отбор.КлючСвязиСтрок.Установить(ВыборкаОтмеченныхСтрок.КлючСвязиСтрок);
	    Набор.Прочитать();
		
		Если Набор.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		НовоеСостояниеУдаления = Не Набор[0].Удаление; 
		
		Для Каждого Запись Из Набор Цикл
			
			Если Запись.РучнаяПравка Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда
				
				Запись.Удаление = НовоеСостояниеУдаления; 
				Запись.ОтметкаСтроки = Ложь;
				Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
				Если НовоеСостояниеУдаления = Ложь Тогда
					Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ВРаботе;
				Иначе
					Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик;
				КонецЕсли;
				СтруктураКлюч = Новый Структура("Номенклатура, Заказ", Запись.Номенклатура, Запись.ДокументЗаказПокупателя);
				СписокДляПересчета.Вставить(СтруктураКлюч, Истина);
				
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			Набор.Записать();
		Исключение
			ЗаписьЖурналаРегистрации("АРМ.Вычеркивание", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
	Для Каждого КлючИЗначение Из СписокДляПересчета Цикл
        Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(КлючИЗначение.Ключ.Номенклатура, КлючИЗначение.Ключ.Заказ);
    КонецЦикла;
	
КонецПроцедуры

