&НаСервере
Процедура ЗафиксироватьПартиюНаСервере(ДанныеСтроки, ВыбраннаяПартия)
	
    Менеджер = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьМенеджерЗаписи();
    ЗаполнитьЗначенияСвойств(Менеджер, ДанныеСтроки);
    Менеджер.Прочитать();
    
    Если Менеджер.Выбран() Тогда
        
        Менеджер.Партия = ВыбраннаяПартия;
        Менеджер.РучнаяПравкаПартии = Истина;
        
        ЗапросЦены = Новый Запрос;
        ЗапросЦены.Текст = 
            "ВЫБРАТЬ
            |	ВЫБОР
            |		КОГДА ЗапасыОстатки.КоличествоОстаток <> 0
            |			ТОГДА ЗапасыОстатки.СуммаОстаток / ЗапасыОстатки.КоличествоОстаток
            |		ИНАЧЕ 0
            |	КОНЕЦ КАК Цена,
            |	ПартииНоменклатуры.ВладелецПартии КАК Поставщик
            |ИЗ
            |	РегистрНакопления.Запасы.Остатки(, Партия = &Партия) КАК ЗапасыОстатки
            |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПартииНоменклатуры КАК ПартииНоменклатуры
            |		ПО ЗапасыОстатки.Партия = ПартииНоменклатуры.Ссылка";
        
        ЗапросЦены.УстановитьПараметр("Партия", ВыбраннаяПартия);
        ВыборкаЦены = ЗапросЦены.Выполнить().Выбрать();
        
        Если ВыборкаЦены.Следующий() Тогда
            Менеджер.Себестоимость = ВыборкаЦены.Цена;
			Менеджер.Поставщик = ВыборкаЦены.Поставщик;
        КонецЕсли;
		
		Попытка
        	Менеджер.Записать();
		Исключение
			ЗаписьЖурналаРегистрации("АРМ.ВыборПартии", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
		КонецПопытки;
        
        Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(Менеджер.Номенклатура, Менеджер.ДокументЗаказПокупателя); 
        
    КонецЕсли;
    
КонецПроцедуры

