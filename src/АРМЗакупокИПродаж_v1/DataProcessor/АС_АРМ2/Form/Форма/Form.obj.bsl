	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(ДанныеСтроки.ИдентификаторЗаписи);
	Набор.Прочитать();
	Запись = Набор[0];
	Запись.Коэффициент = ДанныеСтроки.Коэффициент;
	Если ДанныеСтроки.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа И ДанныеСтроки.СебестоимостьЕдиницы <> 0 Тогда
		Запись.Цена = ДанныеСтроки.Коэффициент * ДанныеСтроки.СебестоимостьЕдиницы;
		Запись.ТипИзмененияЦены = 2;
	КонецЕсли;
	Попытка
		Набор.Записать();       
	Исключение
		ТекстОшибки = СтрШаблон(
			"Ошибка записи в АРМ-регистр. Коэффициент: %1, Описание: %2", 
			Строка(ДанныеСтроки.ИдентификаторЗаписи), 
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
		);
		ЗаписьЖурналаРегистрации("АРМ.ЗаписьДанных", УровеньЖурналаРегистрации.Ошибка, ,	, ТекстОшибки);
	КонецПопытки;
КонецПроцедуры

