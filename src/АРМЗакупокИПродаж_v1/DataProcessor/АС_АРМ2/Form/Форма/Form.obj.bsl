#Область ОбработчикиФормы

&НаКлиенте
Процедура ДобавитьСтрокиПодборНоменклатуры(Команда)
	ТекущиеДанныеСтрока = Элементы.ДанныеАРМОтображение.ТекущиеДанные;
	Если ТекущиеДанныеСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанныеСтрока.Свойство("ГруппировкаСтроки") Тогда
		ТекстСообщения = "Для копирования строки встаньте на строку, а не на группировку";
		ПоказатьОповещениеПользователя("Внимание!", , ТекстСообщения);
		Возврат;
	КонецЕсли;
	ДобавитьСтрокиПодборНоменклатурыНаСервере(ТекущиеДанныеСтрока);
	ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.Арм_ДанныеЗакупокИПродаж"));
	Элементы.ДанныеАРМОтображение.Обновить();
	Элементы.ДанныеАРМОтображениеЗакупки.Обновить();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокиПодборНоменклатурыЗакупка(Команда)
	ТекущиеДанныеСтрока = Элементы.ДанныеАРМОтображениеЗакупки.ТекущиеДанные;
	Если ТекущиеДанныеСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекущиеДанныеСтрока.Свойство("ГруппировкаСтроки") Тогда
		ТекстСообщения = "Для копирования строки встаньте на строку, а не на группировку";
		ПоказатьОповещениеПользователя("Внимание!", , ТекстСообщения);
		Возврат;
	КонецЕсли;
	ДобавитьСтрокиПодборНоменклатурыНаСервере(ТекущиеДанныеСтрока);
	ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.Арм_ДанныеЗакупокИПродаж"));
	Элементы.ДанныеАРМОтображение.Обновить();
	Элементы.ДанныеАРМОтображениеЗакупки.Обновить();
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокиПодборНоменклатурыНаСервере(ТекущиеДанныеСтрока) 
	
	Если ТекущиеДанныеСтрока <> Неопределено Тогда
		
		НоваяЗапись = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьМенеджерЗаписи();
		НоваяЗапись.ДокументЗаказПокупателя = ТекущиеДанныеСтрока.ДокументЗаказПокупателя;
		НоваяЗапись.ДокументЗаказПоставщика = ТекущиеДанныеСтрока.ДокументЗаказПоставщика;
		НоваяЗапись.ДокументПриходнаяНакладная = ТекущиеДанныеСтрока.ДокументПриходнаяНакладная;
		НоваяЗапись.НоменклатураКлиента = ТекущиеДанныеСтрока.НоменклатураКлиента;
		НоваяЗапись.КоличествоКлиента = ТекущиеДанныеСтрока.КоличествоКлиента;
		НоваяЗапись.КлючСвязиСтрок = ТекущиеДанныеСтрока.КлючСвязиСтрок;
		НоваяЗапись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
		НоваяЗапись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик;
		НоваяЗапись.ВидОперации = ТекущиеДанныеСтрока.ВидОперации;
		
		Попытка
			НоваяЗапись.Записать();
		Исключение
			ТекстОшибки = СтрШаблон(
				"Ошибка записи в АРМ-регист. Копирование строки: %1", 
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			);
			ЗаписьЖурналаРегистрации(
				"АРМ.ВыборВидОперации", 
				УровеньЖурналаРегистрации.Ошибка, 
				, 
				, 
				ТекстОшибки
			);	
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИнвертироватьФлагНаСервере(Знач ИдентификаторЗаписи, Знач ЗначениеФлага)
	
	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
	Набор.Прочитать();
	
	Если Набор.Количество() > 0 Тогда
		
		Запись = Набор[0]; 
		
		Если ЗначениеЗаполнено(Запись.АвторСтроки) И Запись.АвторСтроки <> ПараметрыСеанса.ТекущийПользователь Тогда
			Возврат; 
		КонецЕсли;
		
		Запись.ОтметкаСтроки = Не ЗначениеФлага;
		
		Если (Не ЗначениеФлага) = Ложь Тогда
			Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
		Иначе
			Запись.АвторСтроки = ПараметрыСеанса.ТекущийПользователь;
		КонецЕсли;
		
		Попытка
			Набор.Записать();
		Исключение
			ТекстОшибки = СтрШаблон(
				"Ошибка записи флажка для ID %1: %2", 
				ИдентификаторЗаписи, 
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
			);
			ЗаписьЖурналаРегистрации("АРМ.ОшибкаГалки", УровеньЖурналаРегистрации.Ошибка, , , ТекстОшибки);
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	Элементы.ДанныеАРМОтображение.ТекущийЭлемент = Элементы.ДанныеАРМОтображениеНоменклатураКлиента;
	ПодключитьОбработчикОжидания("ОбновитьСписокПоТаймеру", 30);
	ОтображениеКнопокДокументов(Элементы.ДанныеАРМОтображениеЗакупки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВРаботе(Команда)
	
	ВыполнитьОсновнуюОбработку(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ВРаботеЗавершение(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		Элементы.Заказать.Доступность = Ложь;
		Элементы.ПровестиЗаказПокупателя.Доступность = Ложь;
		ВыполнитьОсновнуюОбработку(Истина);
	Иначе
		СброситьБлокировкуИнтерфейса();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОсновнуюОбработку(Знач ФлагРазрешитьСплит)

	СтатусыДляМенеджера = Новый Массив;
	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.ВРаботе"));
	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Черновик"));
	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Собран"));
	МассивКлючейДляФона = Арм_ОбщегоНазначенияАРМ.ПолучитьМассивОтмеченныхКлючейСвязи(СтатусыДляМенеджера);
	Если МассивКлючейДляФона.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Элементы.Заказать.Доступность = Ложь; 
	Элементы.ПровестиЗаказПокупателя.Доступность = Ложь;
	ВременноЗаблокированныеКлючи.Очистить();
	ВременноЗаблокированныеКлючи.ЗагрузитьЗначения(МассивКлючейДляФона);
	УправлятьИнтерфейснымЛокомНаСервере(МассивКлючейДляФона, Истина);
	ОбновитьСписокПоТаймеру();
	
	Попытка
		ЗапуститьФоновоеЗаданиеНаСервере(МассивКлючейДляФона, ФлагРазрешитьСплит); 
		ПодключитьОбработчикОжидания("ПроверитьСтатусФоновогоЗадания", 2);
	Исключение
		СброситьБлокировкуИнтерфейса();
		ОбщегоНазначенияКлиент.СообщитьПользователю("Критическая ошибка при попытке запустить фоновый поток.");
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура УправлятьИнтерфейснымЛокомНаСервере(МассивКлючей, Знач ВключитьЛок)
	
	КоллекцияДляСКД = Новый СписокЗначений;
	Если ВключитьЛок Тогда
		КоллекцияДляСКД.ЗагрузитьЗначения(МассивКлючей);
	КонецЕсли;
	
	ДанныеАРМОтображение.Параметры.УстановитьЗначениеПараметра("ВременноЗаблокированныеКлючи", КоллекцияДляСКД);
	ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("ВременноЗаблокированныеКлючи", КоллекцияДляСКД);
	
КонецПроцедуры

&НаСервере
Процедура ЗапуститьФоновоеЗаданиеНаСервере(Знач МассивКлючей, Знач ФлагРазрешитьСплит)
	
	ЗапросЗаказы = Новый Запрос;
	ЗапросЗаказы.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Рег.ДокументЗаказПокупателя КАК Заказ
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
		|ГДЕ
		|	Рег.КлючСвязиСтрок В(&МассивКлючей)
		|	И НЕ Рег.Удаление";
	ЗапросЗаказы.УстановитьПараметр("МассивКлючей", МассивКлючей);
	МассивЗаказов = ЗапросЗаказы.Выполнить().Выгрузить().ВыгрузитьКолонку("Заказ");
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, ЭтотОбъект.УникальныйИдентификатор);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ТекущийПользователь", ПараметрыСеанса.ТекущийПользователь);
	ПараметрыПроцедуры.Вставить("МассивКлючей",        МассивКлючей);
	ПараметрыПроцедуры.Вставить("МассивЗаказов",       МассивЗаказов); 
	ПараметрыПроцедуры.Вставить("АдресРезультата",     АдресРезультата);
	ПараметрыПроцедуры.Вставить("РазрешитьСплит",      ФлагРазрешитьСплит);
	
	МассивПараметров = Новый Массив;
	МассивПараметров.Добавить(ПараметрыПроцедуры);
	
	Задание = ФоновыеЗадания.Выполнить(
		"Арм_ДанныеЗакупокИПродажФон.СформироватьЗаказыФоновоеЗадание", 
		МассивПараметров, 
		"АРМ_Заказы_" + Строка(ПараметрыСеанса.ТекущийПользователь.УникальныйИдентификатор())
	);
	
	ЭтотОбъект.ИдентификаторФоновогоЗадания   = Задание.УникальныйИдентификатор;
	ЭтотОбъект.АдресРезультатаФоновогоЗадания = АдресРезультата;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСтатусФоновогоЗадания()
	
	СостояниеЗадания = ПроверитьСтатусФоновогоНаСервере(ИдентификаторФоновогоЗадания);
	
	Если СостояниеЗадания = "Active" Или СостояниеЗадания = "Активно" Или СостояниеЗадания = "Задание выполняется" Тогда
		Возврат; 
	КонецЕсли;
	
	Если СостояниеЗадания = "Completed" Или СостояниеЗадания = "Завершено" Или СостояниеЗадания = "Задание выполнено" Тогда
		
		РезультатОбработки = ПолучитьИзВременногоХранилищаНаСервере(АдресРезультатаФоновогоЗадания);
		
		Если РезультатОбработки <> Неопределено 
			И РезультатОбработки.СтатусВалидации = "ТребуетсяПодтверждениеМенеджера" Тогда
			
			ОтключитьОбработчикОжидания("ПроверитьСтатусФоновогоЗадания");
			УдалитьИзВременногоХранилища(АдресРезультатаФоновогоЗадания);			
			ТекстВопроса = СтрШаблон(
				"Выбраны не все позиции по заказам (отмечено %1 шт. из %2 шт.). 
				|Оставшиеся строки будут перенесены в новые заказы. 
				|Продолжить?", 
				РезультатОбработки.ВсегоВыбраноШтук, 
				РезультатОбработки.ВсегоВБазеШтук
			);
			
			ПараметрыОповещения = Новый Структура("РазрешитьСплит", Истина);
			ОписаниеОповещения  = Новый ОписаниеОповещения("ВРаботеЗавершение", ЭтотОбъект, ПараметрыОповещения);
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, "Сплит заказа");
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОтключитьОбработчикОжидания("ПроверитьСтатусФоновогоЗадания");
	СброситьБлокировкуИнтерфейса();
	
	Если СостояниеЗадания = "Completed" Или СостояниеЗадания = "Завершено" Или СостояниеЗадания = "Задание выполнено" Тогда
		
		Если РезультатОбработки <> Неопределено Тогда
			
			Если РезультатОбработки.Успешно Тогда
				ПоказатьОповещениеПользователя("Успешно", , "Все документы оформлены!");
				ОбновитьСписокПоТаймеру();
			Иначе
				ТекстОшибкиВалидации = РезультатОбработки.ТекстОшибки;
				ПоказатьПредупреждение(, ТекстОшибкиВалидации);
				ОбновитьСписокПоТаймеру();
			КонецЕсли;
			
		Иначе
			ПоказатьПредупреждение(, "Документы обработаны, но ответ от сервера не получен. Обновите список вручную.");
			ОбновитьСписокПоТаймеру();
		КонецЕсли;
	Иначе
		ПоказатьПредупреждение(, "Критический сбой потока на сервере 1С. Изменения отменены. Проверьте Журнал Регистрации.");
		ОбновитьСписокПоТаймеру();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьСтатусФоновогоНаСервере(Знач ИДЗадания)
	
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИДЗадания);
	 Если Задание = Неопределено Тогда
		Возврат "НеНайдено";
	КонецЕсли;
	
	Возврат Строка(Задание.Состояние); 
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИзВременногоХранилищаНаСервере(Знач Адрес)
	
	Возврат ПолучитьИзВременногоХранилища(Адрес);
	
КонецФункции

&НаКлиенте
Процедура СброситьБлокировкуИнтерфейса()
	Элементы.Заказать.Доступность = Истина;
	Элементы.ПровестиЗаказПокупателя.Доступность = Истина;
	ВременноЗаблокированныеКлючи.Очистить();
	УправлятьИнтерфейснымЛокомНаСервере(Новый Массив, Ложь);
КонецПроцедуры

&НаСервере
Функция ПодготовитьИПровестиЗаказыНаСервере(МассивКлючейСвязи) /// удалить
	
	Пользователь = ПараметрыСеанса.ТекущийПользователь;
	
	ЗапросВалидация = Новый Запрос;
	ЗапросВалидация.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.Номенклатура.Наименование КАК Номенклатура
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.КлючСвязиСтрок В(&МассивКлючей)
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|	И Т.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Т.Номенклатура.Наименование
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.КлючСвязиСтрок В(&МассивКлючей)
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|	И Т.Количество <= 0
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Т.Номенклатура.Наименование
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.КлючСвязиСтрок В(&МассивКлючей)
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|	И Т.Цена <= 0";

	ЗапросВалидация.УстановитьПараметр("МассивКлючей", МассивКлючейСвязи);
	Результат = ЗапросВалидация.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		ТекстОшибки = СтрШаблон("Заказ не создан! В связанных продажах не заполнена цена или товар: %1", Символы.ПС);
		Пока Выборка.Следующий() Цикл
			ТекстОшибки = СтрШаблон("%1 - %2 %3", ТекстОшибки, Выборка.Номенклатура, Символы.ПС);
		КонецЦикла;
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Ложь; 
	КонецЕсли;
	
	ПровестиЗаказПокупателяНаСервере();
	
	ЗапросЗаказы = Новый Запрос;
	ЗапросЗаказы.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.ДокументЗаказПокупателя КАК Заказ
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.КлючСвязиСтрок В(&МассивКлючей)";
	ЗапросЗаказы.УстановитьПараметр("МассивКлючей", МассивКлючейСвязи);
	ВыборкаЗаказов = ЗапросЗаказы.Выполнить().Выбрать();
	
	Пока ВыборкаЗаказов.Следующий() Цикл
		Если Не ЗначениеЗаполнено(ВыборкаЗаказов.Заказ) Тогда 
			Продолжить; 
		КонецЕсли;
		
		ДокОбъект = ВыборкаЗаказов.Заказ.ПолучитьОбъект();
		Если ДокОбъект <> Неопределено Тогда
			Если НЕ ДокОбъект.Записать(РежимЗаписиДокумента.Проведение) Тогда
				ПолныйТекстОшибки = СтрШаблон("Заказ %1 не провелся! Список ошибки ниже ", Строка(ВыборкаЗаказов.Заказ));
				ОбщегоНазначения.СообщитьПользователю(ПолныйТекстОшибки);
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ДанныеАРМОтображениеПриАктивизацииЯчейки(Элемент)
	
	//Если Элемент.ТекущийЭлемент = Неопределено Тогда
	//	Возврат;
	//КонецЕсли;

	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда 
		Возврат; 
	КонецЕсли;
	
	Если ТекущиеДанные.Свойство("СтрокаЗаблокирована") И ТекущиеДанные.СтрокаЗаблокирована Тогда 
		Возврат; 
	КонецЕсли;	
	
	Если Не ТекущиеДанные.Свойство("ИдентификаторЗаписи") Или Не ТекущиеДанные.Свойство("ОтметкаСтроки") Тогда
		Возврат;
	КонецЕсли;
	Если Элемент.ТекущийЭлемент.Имя = "ДанныеАРМОтображениеОтметкаСтроки" 
		Или Элемент.ТекущийЭлемент.Имя = "ДанныеАРМОтображениеЗакупкиОтметкаСтроки" Тогда
		ИнвертироватьФлагНаСервере(ТекущиеДанные.ИдентификаторЗаписи, ТекущиеДанные.ОтметкаСтроки);
		ОбновитьСписокПоТаймеру();
		Если Элемент.ТекущийЭлемент.Имя = "ДанныеАРМОтображениеОтметкаСтроки" Тогда
			Элементы.ДанныеАРМОтображение.ТекущийЭлемент = Элементы.ДанныеАРМОтображениеНоменклатураКлиента;
		ИначеЕсли Элемент.ТекущийЭлемент.Имя = "ДанныеАРМОтображениеЗакупкиОтметкаСтроки" Тогда
			Элементы.ДанныеАРМОтображениеЗакупки.ТекущийЭлемент = Элементы.ДанныеАРМОтображениеЗакупкиНоменклатураКлиента;	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОформлениеБлокировкиФоном()
	
	МассивСписков = Новый Массив;
	МассивСписков.Добавить(ДанныеАРМОтображение);
	МассивСписков.Добавить(ДанныеАРМОтображениеЗакупки);
	
	Для Каждого ТекущийСписок Из МассивСписков Цикл
		
		УсловноеОформлениеСписок = ТекущийСписок.УсловноеОформление;
		
		ЭлементОформления = УсловноеОформлениеСписок.Элементы.Добавить();
		
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона",    WebЦвета.Серый);
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
		ЭлементУсловия = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементУсловия.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("СтрокаЗаблокирована");
		ЭлементУсловия.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементУсловия.ПравоеЗначение = Истина; 
		ЭлементУсловия.Использование  = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Попытка
		НастроитьУсловноеОформление();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		МассивВидовОперация = Новый Массив;
		МассивВидовОперация.Добавить(Перечисления.Арм_ВидыОпераций.Закупка);
		МассивВидовОперация.Добавить(Перечисления.Арм_ВидыОпераций.ПустаяСсылка());
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("МассивВидОперации", МассивВидовОперация);
		Период.Вариант = ВариантСтандартногоПериода.ЭтотМесяц;
		ДанныеАРМОтображение.Параметры.УстановитьЗначениеПараметра("ВременноЗаблокированныеКлючи", Новый Массив);
		ДанныеАРМОтображениеЗакупки.Параметры.УстановитьЗначениеПараметра("ВременноЗаблокированныеКлючи", Новый Массив);
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		НастроитьОформлениеБлокировкиФоном();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		УстановитьПериодНаСервере();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		ОбновитьФлагГруппировки();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		ОбновитьФлагТолькоСЗакупками();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		ОбновитьФлагСкрытьОтгруженные();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		ОбновитьФлагСкрытьВычеркнутыеЗаписи();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	Конецпопытки;
	Попытка
		УстановитьОформлениеПриВводеЦеныКоэффициента();
	Исключение
		ЗаписатьОшибкуУсловногоОформления();
	КонецПопытки;
	Попытка
		УстановитьЗначокМашинки();
	Исключение
		
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьЗначокМашинки()
	
	ЭлементМашинка = УсловноеОформление.Элементы.Добавить();
	
	ЭлементМашинка.Оформление.УстановитьЗначениеПараметра("Картинка", БиблиотекаКартинок.Арм_Грузовичок);
	
	УсловиеСтатуса = ЭлементМашинка.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	УсловиеСтатуса.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДанныеАРМОтображение.СтатусСтроки");
	УсловиеСтатуса.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	УсловиеСтатуса.ПравоеЗначение = Перечисления.Арм_СтатусыАРМ.Заказано;
	
	ПолеСтатуса = ЭлементМашинка.Поля.Элементы.Добавить();
	ПолеСтатуса.Поле = Новый ПолеКомпоновкиДанных("ДанныеАРМОтображениеСтатусСтроки");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОформлениеПриВводеЦеныКоэффициента()
	
	ОформлениеЦена = УсловноеОформление.Элементы.Добавить();
	ОформлениеЦена.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина));
	
	УсловиеЦена = ОформлениеЦена.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	УсловиеЦена.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДанныеАРМОтображение.ТипИзмененияЦены");
	УсловиеЦена.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	УсловиеЦена.ПравоеЗначение = 1;
	
	ПолеЦена = ОформлениеЦена.Поля.Элементы.Добавить();
	ПолеЦена.Поле = Новый ПолеКомпоновкиДанных("ДанныеАРМОтображениеЦена");
	
	ОформлениеКоэф = УсловноеОформление.Элементы.Добавить();
	ОформлениеКоэф.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,, Истина)); 
	
	УсловиеКоэф = ОформлениеКоэф.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	УсловиеКоэф.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДанныеАРМОтображение.ТипИзмененияЦены");
	УсловиеКоэф.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	УсловиеКоэф.ПравоеЗначение = 2;
	
	ПолеКоэф = ОформлениеКоэф.Поля.Элементы.Добавить();
	ПолеКоэф.Поле = Новый ПолеКомпоновкиДанных("ДанныеАРМОтображениеКоэффициент");
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОшибкуУсловногоОформления()
	
	ТекстОшибкиИнтерфейса = СтрШаблон(
		"Сбой при сборке условного оформления АРМа: %1", 
		КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
	);
	
	ЗаписьЖурналаРегистрации(
		"АРМ.ОшибкаИнтерфейса", 
		УровеньЖурналаРегистрации.Предупреждение, 
		, 
		, 
		ТекстОшибкиИнтерфейса
	);
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьФлагСкрытьОтгруженные()
	
	СохраненноеЗначение = ХранилищеОбщихНастроек.Загрузить("АРМ_Автосервис_Настройки", "СкрытьОтгруженные");
	СкрытьОтгруженные = ?(СохраненноеЗначение = Неопределено, Истина, СохраненноеЗначение);
	СкрытьОтгруженныеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФлагГруппировки()
	
	ФлагЗаказ1С      = ХранилищеОбщихНастроек.Загрузить("АРМ_НастройкаГруппировки", "ФлагГруппировкиЗаказ1С");
	ФлагЗаказКлиента = ХранилищеОбщихНастроек.Загрузить("АРМ_НастройкаГруппировки", "ФлагГруппировкиЗаказКлиента");
	
	СгруппироватьПоЗаказуПокупателя   = ?(ФлагЗаказ1С = Неопределено,      Ложь, ФлагЗаказ1С);
	ГруппироватьПоНомеруЗаказаКлиента = ?(ФлагЗаказКлиента = Неопределено, Ложь, ФлагЗаказКлиента);
	
	Если СгруппироватьПоЗаказуПокупателя И ГруппироватьПоНомеруЗаказаКлиента Тогда
		ГруппироватьПоНомеруЗаказаКлиента = Ложь;
	КонецЕсли;
	
	УстановитьГруппировкуАРМНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФлагТолькоСЗакупками()
	СохраненноеЗначение = ХранилищеОбщихНастроек.Загрузить("АС_АРМ_Снабжение", "ТолькоСЗакупками");
    Если СохраненноеЗначение <> Неопределено Тогда
        ТолькоСЗакупками = СохраненноеЗначение;
        УстановитьОтборПоЗакупкам(); 
    КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОбновитьФлагСкрытьВычеркнутыеЗаписи()
	
	ЗначениеИзХранилища = ХранилищеОбщихНастроек.Загрузить("АРМ_НастройкиДанных", "НеПоказыватьВычеркнутые");
	НеПоказыватьВычеркнутыеПозиции = ?(ЗначениеИзХранилища = Неопределено, Ложь, ЗначениеИзХранилища);
	СкрытьПоказатьВычеркнутыеПозицииНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьУсловноеОформление()
	
	Автор = ПараметрыСеанса.ТекущийПользователь;
	ДанныеАРМОтображение.УсловноеОформление.Элементы.Очистить();
	
	// общее оформление для всего списка (текст мельче)
	ЭлементОбщий = ДанныеАРМОтображение.УсловноеОформление.Элементы.Добавить();
	// шрифт 
	ЭлементОбщий.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт("MS Shell Dlg", 8, Ложь, Ложь, Ложь));
	ЭлементОбщий.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(60, 60, 60));
	
	// вычеркнутые
	ЭлементВычеркнутые = ДанныеАРМОтображение.УсловноеОформление.Элементы.Добавить();
	ШрифтЗачеркнутый = Новый Шрифт(,,,,, Истина); // Последний параметр - Зачеркивание
	ЭлементВычеркнутые.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЗачеркнутый);
	ЭлементВычеркнутые.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(160, 160, 160)); //ЦветаСтиля.ТекстВторостепеннойНадписи);
	
	// условие по удаленным
	ВычеркнутыеСтроки = ЭлементВычеркнутые.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ВычеркнутыеСтроки.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Удаление");
	ВычеркнутыеСтроки.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ВычеркнутыеСтроки.ПравоеЗначение = Истина;
	
	// вычеркнутые закупки
	ЭлементВычеркнутыеЗакупки = ДанныеАРМОтображениеЗакупки.УсловноеОформление.Элементы.Добавить();
	ШрифтЗачеркнутый = Новый Шрифт(,,,,, Истина); // Последний параметр - Зачеркивание
	ЭлементВычеркнутыеЗакупки.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтЗачеркнутый);
	ЭлементВычеркнутыеЗакупки.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(160, 160, 160)); //ЦветаСтиля.ТекстВторостепеннойНадписи);
	
	// условие по удаленным
	ВычеркнутыеСтрокиЗакупки = ЭлементВычеркнутыеЗакупки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ВычеркнутыеСтрокиЗакупки.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Удаление");
	ВычеркнутыеСтрокиЗакупки.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ВычеркнутыеСтрокиЗакупки.ПравоеЗначение = Истина;
	
	//
	ЭлементПродажи = ДанныеАРМОтображение.УсловноеОформление.Элементы.Добавить();
	ЭлементПродажи.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(255, 224, 178)); 
	
	//
	ОтборПродажи = ЭлементПродажи.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборПродажи.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ВидОперации");
	ОтборПродажи.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборПродажи.ПравоеЗначение = Перечисления.Арм_ВидыОпераций.Закупка;
	//
	
	// настройка для своих галочек
	ЭлементСвои = ДанныеАРМОтображение.УсловноеОформление.Элементы.Добавить();
	ЭлементСвои.Оформление.УстановитьЗначениеПараметра("ЦветФона", Новый Цвет(220, 255, 220)); 
	
	// условие 1: ОтметкаСтроки = Истина
	ОтборСвои = ЭлементСвои.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСвои.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ОтметкаСтроки");
	ОтборСвои.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборСвои.ПравоеЗначение = Истина;
	
	// условие 2: Автор = ТекущийПользователь
	ОтборСвоиАвтор = ЭлементСвои.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборСвоиАвтор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("АвторСтроки");
	ОтборСвоиАвтор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборСвоиАвтор.ПравоеЗначение = Автор;
	
	// настройках для чужих галочек
	ЭлементЧужие = ДанныеАРМОтображение.УсловноеОформление.Элементы.Добавить();
	ЭлементЧужие.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(160, 160, 160));	
	// условие 1: ОтметкаСтроки = Истина
	ОтборЧужие = ЭлементЧужие.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЧужие.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ОтметкаСтроки");
	ОтборЧужие.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЧужие.ПравоеЗначение = Истина;
	
	// условие 2: Автор НЕ РАВНО ТекущийПользователь
	ОтборЧужиеАвтор = ЭлементЧужие.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЧужиеАвтор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("АвторСтроки");
	ОтборЧужиеАвтор.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеРавно;
