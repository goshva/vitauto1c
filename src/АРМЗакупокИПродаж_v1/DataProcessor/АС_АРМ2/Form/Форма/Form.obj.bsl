	ОтборНом = ЭлементНом.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборНом.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Номенклатура");
	ОтборНом.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеЗаполнено;

