#Область Строки

Функция ТекстЗапросаСтрок()

	Возврат
	"ВЫБРАТЬ
	|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
	|	Т.КлючСвязиСтрок КАК КлючСвязиСтрок,
	|	Т.ВидОперации КАК ВидОперации,
	|	Т.СтатусСтроки КАК СтатусСтроки,
	|	Т.Удаление КАК Удаление,
	|	Т.ОтметкаСтроки КАК ОтметкаСтроки,
	|	Т.АвторСтроки КАК АвторСтроки,
	|	Т.Порядок КАК Порядок,
	|	Т.ДокументЗаказПокупателя КАК ДокументЗаказПокупателя,
	|	ЕСТЬNULL(Т.ДокументЗаказПокупателя.Номер, """") КАК ЗПНомер,
	|	ЕСТЬNULL(Т.ДокументЗаказПокупателя.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ЗПДата,
	|	ЕСТЬNULL(Т.ДокументЗаказПокупателя.Проведен, ЛОЖЬ) КАК ЗППроведен,
	|	Т.ДокументЗаказПоставщика КАК ДокументЗаказПоставщика,
	|	ЕСТЬNULL(Т.ДокументЗаказПоставщика.Номер, """") КАК ЗПсНомер,
	|	ЕСТЬNULL(Т.ДокументЗаказПоставщика.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ЗПсДата,
	|	ЕСТЬNULL(Т.ДокументЗаказПоставщика.Проведен, ЛОЖЬ) КАК ЗПсПроведен,
	|	Т.ДокументПриходнаяНакладная КАК ДокументПриходнаяНакладная,
	|	ЕСТЬNULL(Т.ДокументПриходнаяНакладная.Номер, """") КАК ПННомер,
	|	ЕСТЬNULL(Т.ДокументПриходнаяНакладная.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ПНДата,
	|	ЕСТЬNULL(Т.ДокументПриходнаяНакладная.Проведен, ЛОЖЬ) КАК ПНПроведен,
	|	Т.РасходнаяНакладная КАК РасходнаяНакладная,
	|	ЕСТЬNULL(Т.РасходнаяНакладная.Номер, """") КАК РННомер,
	|	ЕСТЬNULL(Т.РасходнаяНакладная.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК РНДата,
	|	ЕСТЬNULL(Т.РасходнаяНакладная.Проведен, ЛОЖЬ) КАК РНПроведен,
	|	Т.ДокументПодписанОригинал КАК ДокументПодписанОригинал,
	|	Т.ДатаОтгрузки КАК ДатаОтгрузки,
	|	Т.НомерОтгрузки КАК НомерОтгрузки,
	|	Т.ДатаЗаказа КАК ДатаЗаказа,
	|	Т.НомерЗаказа КАК НомерЗаказа,
	|	Т.НомерЗаказаКлиента КАК НомерЗаказаКлиента,
	|	Т.Покупатель КАК Покупатель,
	|	Т.Договор КАК Договор,
	|	Т.ВидУслуги КАК ВидУслуги,
	|	Т.Марка КАК Марка,
	|	Т.Модель КАК Модель,
	|	Т.Агрегат КАК Агрегат,
	|	Т.Госномер КАК Госномер,
	|	Т.VIN КАК VIN,
	|	Т.Двигатель КАК Двигатель,
	|	Т.СрочностьКлиента КАК СрочностьКлиента,
	|	Т.ГРЗКлиента КАК ГРЗКлиента,
	|	Т.ТерриторияКлиента КАК ТерриторияКлиента,
	|	Т.НоменклатураКлиента КАК НоменклатураКлиента,
	|	Т.АртикулКлиента КАК АртикулКлиента,
	|	Т.КоличествоКлиента КАК КоличествоКлиента,
	|	Т.ЕдиницаИзмеренияКлиента КАК ЕдиницаИзмеренияКлиента,
	|	Т.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(Т.Номенклатура.Артикул, """") КАК НомАртикул,
	|	ЕСТЬNULL(Т.Номенклатура.АС_КодАвтоАльянс, """") КАК НомКод,
	|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(Т.Номенклатура.ЕдиницаИзмерения), """") КАК НомЕдиница,
	|	Т.Количество КАК Количество,
	|	Т.КоличествоНормаЧас КАК КоличествоНормаЧас,
	|	Т.ОстатокДляСтроки КАК ОстатокДляСтроки,
	|	Т.Партия КАК Партия,
	|	Т.СебестоимостьЕдиницы КАК СебестоимостьЕдиницы,
	|	Т.Себестоимость КАК Себестоимость,
	|	Т.ФормаОплаты КАК ФормаОплаты,
	|	Т.РРЦ КАК РРЦ,
	|	Т.Оплачено КАК Оплачено,
	|	Т.Коэффициент КАК Коэффициент,
	|	Т.Цена КАК Цена,
	|	Т.Поставщик КАК Поставщик,
	|	Т.ДатаПоступления КАК ДатаПоступления,
	|	Т.ТерриторияОтгрузкиПоставщиком КАК ТерриторияОтгрузкиПоставщиком,
	|	Т.КомментарийКСтроке КАК КомментарийКСтроке,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Закупки.СуммаКол, 0) > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьДефицит
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			З.КлючСвязиСтрок КАК КлючСвязиСтрок,
	|			З.Номенклатура КАК Номенклатура,
	|			СУММА(З.Количество) КАК СуммаКол
	|		ИЗ
	|			РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК З
	|		ГДЕ
	|			З.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
	|			И НЕ З.Удаление
	|		СГРУППИРОВАТЬ ПО
	|			З.КлючСвязиСтрок,
	|			З.Номенклатура) КАК Закупки
	|		ПО Т.КлючСвязиСтрок = Закупки.КлючСвязиСтрок
	|			И Т.Номенклатура = Закупки.Номенклатура";

