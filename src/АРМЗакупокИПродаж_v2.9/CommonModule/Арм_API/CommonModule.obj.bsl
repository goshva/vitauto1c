Функция СтрокаВJSON(В)

	Л = Новый Структура;
	Л.Вставить("id", В.ИдентификаторЗаписи);
	Л.Вставить("linkKey", В.КлючСвязиСтрок);
	Л.Вставить("operation", ?(В.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка, "purchase", "sale"));
	Л.Вставить("status", КодСтатуса(В.СтатусСтроки));
	Л.Вставить("locked", В.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном);
	Л.Вставить("deleted", В.Удаление);
	Л.Вставить("marked", В.ОтметкаСтроки);
	Л.Вставить("markedBy", ?(ЗначениеЗаполнено(В.АвторСтроки), Строка(В.АвторСтроки), Неопределено));
	Л.Вставить("order", В.Порядок);
	Л.Вставить("hasDeficit", В.ЕстьДефицит);
	Л.Вставить("customerOrder", СсылкаДокумента(В.ДокументЗаказПокупателя, "customer_order", В.ЗПНомер, В.ЗПДата, В.ЗППроведен));
	Л.Вставить("supplierOrder", СсылкаДокумента(В.ДокументЗаказПоставщика, "supplier_order", В.ЗПсНомер, В.ЗПсДата, В.ЗПсПроведен));
	Л.Вставить("receipt", СсылкаДокумента(В.ДокументПриходнаяНакладная, "receipt", В.ПННомер, В.ПНДата, В.ПНПроведен));
	Л.Вставить("shipmentDoc", СсылкаДокумента(В.РасходнаяНакладная, "shipment", В.РННомер, В.РНДата, В.РНПроведен));
	Л.Вставить("signedOriginal", В.ДокументПодписанОригинал);
	Л.Вставить("shipmentDate", ДатаJSON(В.ДатаОтгрузки));
	Л.Вставить("shipmentNumber", В.НомерОтгрузки);
	Л.Вставить("orderDate", ДатаJSON(В.ДатаЗаказа));
	Л.Вставить("internalOrderNumber", В.НомерЗаказа);
	Л.Вставить("clientOrderNumber", В.НомерЗаказаКлиента);
	Л.Вставить("customer", ИменованнаяСсылка(В.Покупатель));
	Л.Вставить("contract", ИменованнаяСсылка(В.Договор));
	Л.Вставить("serviceType", ИменованнаяСсылка(В.ВидУслуги));
	Л.Вставить("brand", В.Марка);
	Л.Вставить("model", В.Модель);
	Л.Вставить("aggregate", В.Агрегат);
	Л.Вставить("plate", В.Госномер);
	Л.Вставить("chassis", Неопределено);
	Л.Вставить("vin", В.VIN);
	Л.Вставить("engine", В.Двигатель);
	Л.Вставить("urgency", В.СрочностьКлиента);
	Л.Вставить("vehiclePlate", В.ГРЗКлиента);
	Л.Вставить("territory", В.ТерриторияКлиента);
	Л.Вставить("factName", В.НоменклатураКлиента);
	Л.Вставить("factArticle", В.АртикулКлиента);
	Л.Вставить("factQty", В.КоличествоКлиента);
	Л.Вставить("factUnit", В.ЕдиницаИзмеренияКлиента);
	Если ЗначениеЗаполнено(В.Номенклатура) Тогда
		Л.Вставить("nomenclature", Новый Структура("id, name, article, code, unit",
			ИдСсылки(В.Номенклатура), Строка(В.Номенклатура), В.НомАртикул, В.НомКод, В.НомЕдиница));
	Иначе
		Л.Вставить("nomenclature", Неопределено);
	КонецЕсли;
	Л.Вставить("quantity", В.Количество);
	Л.Вставить("normHours", В.КоличествоНормаЧас);
	Л.Вставить("stockQty", В.ОстатокДляСтроки);
	Л.Вставить("reserveQty", Неопределено);
	Л.Вставить("inTransitQty", Неопределено);
	Л.Вставить("batch", ИменованнаяСсылка(В.Партия));
	Л.Вставить("costPrice", В.СебестоимостьЕдиницы);
	Л.Вставить("costSum", В.Себестоимость);
	Л.Вставить("paymentForm", ИменованнаяСсылка(В.ФормаОплаты));
	Л.Вставить("rrc", В.РРЦ);
	Л.Вставить("paid", В.Оплачено);
	Л.Вставить("coefficient", В.Коэффициент);
	Л.Вставить("salePrice", В.Цена);
	Л.Вставить("saleSum", ?(В.КоличествоНормаЧас > 0, В.КоличествоНормаЧас, В.Количество) * В.Цена);
	Л.Вставить("supplier", ИменованнаяСсылка(В.Поставщик));
	Л.Вставить("receiptDate", ДатаJSON(В.ДатаПоступления));
	Л.Вставить("updDate", Неопределено);
	Л.Вставить("updNumber", Неопределено);
	Л.Вставить("supplierShipTerritory", В.ТерриторияОтгрузкиПоставщиком);
	Л.Вставить("comment", В.КомментарийКСтроке);
	Возврат Л;

КонецФункции

Функция СтрокаПоИдентификатору(Ид, ОшибкаЕслиНет = Истина)

	Запрос = Новый Запрос(ТекстЗапросаСтрок() + "
		|ГДЕ
		|	Т.ИдентификаторЗаписи = &Ид");
	Запрос.УстановитьПараметр("Ид", Ид);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат СтрокаВJSON(Выборка);
	КонецЕсли;
	Если ОшибкаЕслиНет Тогда
		ВызватьОшибку(404, "not_found", "Строка " + Ид + " не найдена");
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Процедура СписокСтрок(Ответ, Сессия, Параметры)

	Вид = ПараметрЗапроса(Параметры, "view", "");
	ПроверитьВидСписка(Вид, Сессия, Истина);

	Условия = Новый Массив;
	Запрос = Новый Запрос;
	Если Вид = "sales" Тогда
		Условия.Добавить("Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)");
	Иначе
		Условия.Добавить("Т.ВидОперации В (ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка), ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.ПустаяСсылка))");
	КонецЕсли;
	Если ПараметрЗапроса(Параметры, "hideDeleted", "false") = "true" Тогда
		Условия.Добавить("НЕ Т.Удаление");
	КонецЕсли;
	Если ПараметрЗапроса(Параметры, "hideShipped", "false") = "true" Тогда
		Условия.Добавить("Т.СтатусСтроки <> ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Отгружено)");
	КонецЕсли;
	НачалоПериода = ПараметрЗапроса(Параметры, "periodFrom", "");
	Если ЗначениеЗаполнено(НачалоПериода) Тогда
		Условия.Добавить("ЕСТЬNULL(Т.ДокументЗаказПокупателя.Дата, ДАТАВРЕМЯ(1, 1, 1)) >= &НачалоПериода");
		Запрос.УстановитьПараметр("НачалоПериода", ДатаИзJSON(НачалоПериода, "periodFrom"));
	КонецЕсли;
	КонецПериода = ПараметрЗапроса(Параметры, "periodTo", "");
	Если ЗначениеЗаполнено(КонецПериода) Тогда
		Условия.Добавить("ЕСТЬNULL(Т.ДокументЗаказПокупателя.Дата, ДАТАВРЕМЯ(1, 1, 1)) <= &КонецПериода");
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(ДатаИзJSON(КонецПериода, "periodTo")));
	КонецЕсли;
	ИдЗаказа = ПараметрЗапроса(Параметры, "customerOrderId", "");
	Если ЗначениеЗаполнено(ИдЗаказа) Тогда
		Условия.Добавить("Т.ДокументЗаказПокупателя = &Заказ");
		Запрос.УстановитьПараметр("Заказ", Документы.ЗаказПокупателя.ПолучитьСсылку(УИД(ИдЗаказа, "customerOrderId")));
	КонецЕсли;
	Если ПараметрЗапроса(Параметры, "onlyWithPurchases", "false") = "true" Тогда
		Условия.Добавить("Т.КлючСвязиСтрок В
		|		(ВЫБРАТЬ
		|			Зк.КлючСвязиСтрок
		|		ИЗ
		|			РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Зк
		|		ГДЕ
		|			Зк.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
		|			И НЕ Зк.Удаление)");
	КонецЕсли;
	Порядок = ?(ПараметрЗапроса(Параметры, "groupByCustomerOrder", "false") = "true",
		"ЗПДата, ДокументЗаказПокупателя, Порядок, ИдентификаторЗаписи", "Порядок, ИдентификаторЗаписи");

	Запрос.Текст = ТекстЗапросаСтрок() + "
		|ГДЕ
		|	" + СтрСоединить(Условия, "
		|	И ") + "
		|УПОРЯДОЧИТЬ ПО
		|	" + Порядок;

	Лимит = ЧислоИзПараметра(ПараметрЗапроса(Параметры, "limit", "100"), 100, 1, 500);
	Смещение = ЧислоИзПараметра(ПараметрЗапроса(Параметры, "cursor", "0"), 0, 0, 1000000);
	Выборка = Запрос.Выполнить().Выбрать();
	Элементы = Новый Массив;
	Номер = 0;
	ЕстьЕще = Ложь;
	Пока Выборка.Следующий() Цикл
		Номер = Номер + 1;
		Если Номер <= Смещение Тогда
			Продолжить;
		КонецЕсли;
		Если Элементы.Количество() = Лимит Тогда
			ЕстьЕще = Истина;
			Прервать;
		КонецЕсли;
		Элементы.Добавить(СтрокаВJSON(Выборка));
	КонецЦикла;
	Ответ.Тело = Новый Структура("items, nextCursor", Элементы,
		?(ЕстьЕще, Формат(Смещение + Лимит, "ЧГ=0"), Неопределено));

КонецПроцедуры

Процедура ПроверитьВидСписка(Вид, Сессия, ДопускатьСнабжение)

	Если Вид <> "sales" И Вид <> "purchases" И Вид <> "supply" Тогда
		ВызватьОшибку(400, "bad_request", "view: sales, purchases или supply");
	КонецЕсли;
	Если Вид = "supply" И Сессия.Роль <> "supply" И Сессия.Роль <> "admin" Тогда
		ВызватьОшибку(403, "matrix_denied", "Канбан снабжения доступен только роли supply");
	КонецЕсли;
	Если Вид <> "supply" И Сессия.Роль = "supply" Тогда
		ВызватьОшибку(403, "matrix_denied", "Роли supply доступен только канбан снабжения (view=supply)");
	КонецЕсли;

КонецПроцедуры

// PATCH /lines/{id}: одно поле строки с проверкой матрицы, замка фона, автора и владельца договора.
Процедура ЗаписатьПолеСтроки(Ответ, Сессия, Ид, Данные)

	ИмяПоля = Строка(ЗначениеИзДанных(Данные, "field", ""));
	Если Не ЗначениеЗаполнено(ИмяПоля) Или Данные.Получить("value") = Неопределено И Не ЕстьКлюч(Данные, "value") Тогда
		ВызватьОшибку(400, "bad_request", "Нужны field и value");
	КонецЕсли;
	Значение = Данные.Получить("value");

	М = Матрица();
	Колонка = М.ПоПолю.Получить(ИмяПоля);
	Если Колонка = Неопределено Тогда
		Если МетаданныеПоля(ИмяПоля) <> Неопределено Тогда
			ВызватьОшибку(403, "field_readonly", "Поле не входит в матрицу и не меняется через API", ИмяПоля);
		КонецЕсли;
		ВызватьОшибку(400, "bad_request", "Неизвестное поле " + ИмяПоля, ИмяПоля);
	КонецЕсли;
	Если Не Колонка.Запись Или МетаданныеПоля(ИмяПоля) = Неопределено Тогда
		ВызватьОшибку(403, "field_readonly", "Поле только для чтения", ИмяПоля);
	КонецЕсли;

	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(Ид);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		ВызватьОшибку(404, "not_found", "Строка " + Ид + " не найдена");
	КонецЕсли;
	Запись = Набор[0];
	ПроверитьПравоНаПоле(Сессия, М, Колонка, Запись);

	НовоеЗначение = ПривестиЗначениеПоля(ИмяПоля, Значение);
	Если ИмяПоля = "Договор" И ЗначениеЗаполнено(НовоеЗначение) И НовоеЗначение.Владелец <> Запись.Покупатель Тогда
		ВызватьОшибку(409, "contract_owner",
			СтрШаблон("Договор «%1» не принадлежит заказчику «%2»", Строка(НовоеЗначение), Строка(Запись.Покупатель)), ИмяПоля);
	КонецЕсли;

	Для Каждого Стр Из Набор Цикл
		Стр[ИмяПоля] = НовоеЗначение;
		ПересчитатьЦеныСтроки(Стр, ИмяПоля);
	КонецЦикла;
	Набор.Записать();
	Ответ.Тело = СтрокаПоИдентификатору(Ид);

КонецПроцедуры

Процедура ПроверитьПравоНаПоле(Сессия, М, Колонка, Запись)

	КодСтатуса = КодСтатуса(Запись.СтатусСтроки);
	Если КодСтатуса = "locked_background" Тогда
		ВызватьОшибку(409, "row_locked", "Строка заблокирована фоновым заданием", Колонка.Поле, КодСтатуса);
	КонецЕсли;
	Индекс = М.Статусы.Найти(КодСтатуса);
	Маска = МаскаКолонки(Колонка, Сессия.Роль, М.Статусы.Количество());
	Символ = ?(Индекс = Неопределено, ".", Сред(Маска, Индекс + 1, 1));
	Если Символ = "c" Тогда
		Если Запись.АвторСтроки <> Сессия.Пользователь Тогда
			ВызватьОшибку(403, "not_author", "Поле меняет только автор строки", Колонка.Поле, КодСтатуса);
		КонецЕсли;
	ИначеЕсли Символ <> "+" Тогда
		ВызватьОшибку(403, "matrix_denied", "Матрица не разрешает роли " + Сессия.Роль + " менять поле в этом статусе", Колонка.Поле, КодСтатуса);
	КонецЕсли;

КонецПроцедуры

// Формулы матрицы: Сумма себес. = Цена себес. × Кол-во; Цена продажи = (РРЦ, если есть, иначе цена себес.) × Коэфф;
// ручная цена продажи пересчитывает Коэфф. Пока Коэфф не заполнен, цена не пересчитывается.
Процедура ПересчитатьЦеныСтроки(Запись, ИмяПоля)

	Если ИмяПоля = "СебестоимостьЕдиницы" Или ИмяПоля = "Количество" Тогда
		Запись.Себестоимость = Запись.СебестоимостьЕдиницы * Запись.Количество;
	КонецЕсли;
	Если Запись.ВидОперации <> Перечисления.Арм_ВидыОпераций.Продажа Тогда
		Возврат;
	КонецЕсли;
	База = ?(Запись.РРЦ <> 0, Запись.РРЦ, Запись.СебестоимостьЕдиницы);
	Если База = 0 Тогда
		Возврат;
	КонецЕсли;
	Если ИмяПоля = "Цена" Тогда
		Запись.Коэффициент = Запись.Цена / База;
		Запись.ТипИзмененияЦены = 1;
	ИначеЕсли (ИмяПоля = "Коэффициент" Или ИмяПоля = "РРЦ" Или ИмяПоля = "СебестоимостьЕдиницы") И Запись.Коэффициент <> 0 Тогда
		Запись.Цена = База * Запись.Коэффициент;
		Если ИмяПоля = "Коэффициент" Тогда
			Запись.ТипИзмененияЦены = 2;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Функция МетаданныеПоля(ИмяПоля)

	МД = Метаданные.РегистрыСведений.Арм_ДанныеЗакупокИПродаж;
	Поле = МД.Ресурсы.Найти(ИмяПоля);
	Если Поле = Неопределено Тогда
		Поле = МД.Измерения.Найти(ИмяПоля);
	КонецЕсли;
	Возврат Поле;

КонецФункции

Функция ПривестиЗначениеПоля(ИмяПоля, Значение)

	Тип = МетаданныеПоля(ИмяПоля).Тип;
	Если Значение = Неопределено Тогда
		Возврат Тип.ПривестиЗначение(Неопределено);
	КонецЕсли;
	Если Тип.СодержитТип(Тип("Число")) Тогда
		Попытка
			Возврат Тип.ПривестиЗначение(Число(Значение));
		Исключение
			ВызватьОшибку(400, "bad_request", "Ожидалось число", ИмяПоля);
		КонецПопытки;
	ИначеЕсли Тип.СодержитТип(Тип("Булево")) Тогда
		Если ТипЗнч(Значение) <> Тип("Булево") Тогда
			ВызватьОшибку(400, "bad_request", "Ожидалось true или false", ИмяПоля);
		КонецЕсли;
		Возврат Значение;
	ИначеЕсли Тип.СодержитТип(Тип("Дата")) Тогда
		Возврат ДатаИзJSON(Значение, ИмяПоля);
	ИначеЕсли Тип.СодержитТип(Тип("Строка")) Тогда
		Возврат Тип.ПривестиЗначение(Строка(Значение));
	КонецЕсли;

	// Ссылка: значение — uuid
	МетаТипа = Метаданные.НайтиПоТипу(Тип.Типы()[0]);
	Если МетаТипа = Неопределено Тогда
		ВызватьОшибку(400, "bad_request", "Поле не поддерживает запись через API", ИмяПоля);
	КонецЕсли;
	Если Метаданные.Справочники.Содержит(МетаТипа) Тогда
		Менеджер = Справочники[МетаТипа.Имя];
	ИначеЕсли Метаданные.Документы.Содержит(МетаТипа) Тогда
		Менеджер = Документы[МетаТипа.Имя];
	Иначе
		ВызватьОшибку(400, "bad_request", "Поле не поддерживает запись через API", ИмяПоля);
	КонецЕсли;
	Ссылка = Менеджер.ПолучитьСсылку(УИД(Строка(Значение), ИмяПоля));
	Если Не СсылкаСуществует(Ссылка) Тогда
		ВызватьОшибку(400, "bad_request", "Объект " + Строка(Значение) + " не найден", ИмяПоля);
	КонецЕсли;
	Возврат Ссылка;

КонецФункции

// POST /lines/{id}/mark — как ИнвертироватьФлагНаСервере формы: чужую отметку снять нельзя.
Процедура ПереключитьОтметку(Ответ, Сессия, Ид)

	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(Ид);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		ВызватьОшибку(404, "not_found", "Строка " + Ид + " не найдена");
	КонецЕсли;
	Запись = Набор[0];
	Если Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном Тогда
		ВызватьОшибку(409, "row_locked", "Строка заблокирована фоновым заданием");
	КонецЕсли;
	Если ЗначениеЗаполнено(Запись.АвторСтроки) И Запись.АвторСтроки <> Сессия.Пользователь Тогда
		ВызватьОшибку(409, "not_author", "Строку отметил другой пользователь: " + Строка(Запись.АвторСтроки));
	КонецЕсли;
	Запись.ОтметкаСтроки = Не Запись.ОтметкаСтроки;
	Запись.АвторСтроки = ?(Запись.ОтметкаСтроки, Сессия.Пользователь, Справочники.Пользователи.ПустаяСсылка());
	Набор.Записать();
	Ответ.Тело = СтрокаПоИдентификатору(Ид);

КонецПроцедуры

Процедура ИтогиВыделения(Ответ, Сессия, Параметры)

	Вид = ПараметрЗапроса(Параметры, "view", "");
	ПроверитьВидСписка(Вид, Сессия, Истина);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	КОЛИЧЕСТВО(*) КАК Строк,
		|	ЕСТЬNULL(СУММА(Т.Количество), 0) КАК Количество,
		|	ЕСТЬNULL(СУММА(ВЫБОР КОГДА Т.КоличествоНормаЧас > 0 ТОГДА Т.КоличествоНормаЧас ИНАЧЕ Т.Количество КОНЕЦ * Т.Цена), 0) КАК СуммаПродажи,
		|	ЕСТЬNULL(СУММА(Т.Себестоимость), 0) КАК СуммаСебестоимости
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.ОтметкаСтроки
		|	И Т.АвторСтроки = &Автор
		|	И НЕ Т.Удаление
		|	И Т.ВидОперации = &ВидОперации");
	Запрос.УстановитьПараметр("Автор", Сессия.Пользователь);
	Запрос.УстановитьПараметр("ВидОперации", ВидОперацииСписка(Вид));
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Ответ.Тело = Новый Структура("count, quantity, saleSum, costSum",
		Выборка.Строк, Выборка.Количество, Выборка.СуммаПродажи, Выборка.СуммаСебестоимости);

КонецПроцедуры

// POST /selection — «Выделить все строки заказа», как ВыделитьВсеСтрокиЗаказаНаСервере формы.
Процедура ОтметитьСтрокиЗаказа(Ответ, Сессия, Данные)

	Вид = Строка(ЗначениеИзДанных(Данные, "view", ""));
	ПроверитьВидСписка(Вид, Сессия, Истина);
	Заказ = Документы.ЗаказПокупателя.ПолучитьСсылку(УИД(Строка(ЗначениеИзДанных(Данные, "customerOrderId", "")), "customerOrderId"));
	Отметить = ЗначениеИзДанных(Данные, "marked", Неопределено);
	Если ТипЗнч(Отметить) <> Тип("Булево") Тогда
		ВызватьОшибку(400, "bad_request", "marked: true или false", "marked");
	КонецЕсли;
	ВидОперации = ВидОперацииСписка(Вид);
	Автор = ?(Отметить, Сессия.Пользователь, Справочники.Пользователи.ПустаяСсылка());

	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ДокументЗаказПокупателя.Установить(Заказ);
	Набор.Прочитать();
	Изменено = 0;
	Всего = 0;
	Для Каждого Запись Из Набор Цикл
		Если Запись.ВидОперации <> ВидОперации Или Запись.Удаление Тогда
			Продолжить;
		КонецЕсли;
		Всего = Всего + 1;
		Свободна = Не ЗначениеЗаполнено(Запись.АвторСтроки) Или Запись.АвторСтроки = Сессия.Пользователь;
		Если (Вид = "supply" Или Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ВРаботе
			Или Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик) И Свободна Тогда
			Запись.ОтметкаСтроки = Отметить;
			Запись.АвторСтроки = Автор;
			Изменено = Изменено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Изменено > 0 Тогда
		Набор.Записать();
	КонецЕсли;
	Ответ.Тело = Новый Структура("processed, total", Изменено, Всего);

КонецПроцедуры

// POST /lines — «Добавить строки» подбором номенклатуры.
Процедура ДобавитьСтроки(Ответ, Сессия, Данные)

	Вид = Строка(ЗначениеИзДанных(Данные, "view", ""));
	Если Вид <> "sales" И Вид <> "purchases" Тогда
		ВызватьОшибку(400, "bad_request", "view: sales или purchases", "view");
	КонецЕсли;
	ТребоватьЭкранПродаж(Сессия);
	Идентификаторы = ЗначениеИзДанных(Данные, "nomenclatureIds", Неопределено);
	Если ТипЗнч(Идентификаторы) <> Тип("Массив") Или Идентификаторы.Количество() = 0 Тогда
		ВызватьОшибку(400, "bad_request", "nomenclatureIds: непустой массив", "nomenclatureIds");
	КонецЕсли;

	М = Матрица();
	Колонка = М.ПоПолю.Получить("Номенклатура");
	Маска = МаскаКолонки(Колонка, Сессия.Роль, М.Статусы.Количество());
	Если Лев(Маска, 1) <> "+" Тогда
		ВызватьОшибку(403, "matrix_denied", "Матрица не разрешает роли " + Сессия.Роль + " подбирать номенклатуру в статусе «Новый»", "Номенклатура", "new");
	КонецЕсли;

	Шаблон = Новый Структура("ДокументЗаказПокупателя, КлючСвязиСтрок, Покупатель, Договор, НомерЗаказаКлиента, ДатаЗаказа, НомерЗаказа, НоменклатураКлиента, КоличествоКлиента");
	Если Вид = "sales" Тогда
		Заказ = Документы.ЗаказПокупателя.ПолучитьСсылку(УИД(Строка(ЗначениеИзДанных(Данные, "customerOrderId", "")), "customerOrderId"));
		Если Не СсылкаСуществует(Заказ) Тогда
			ВызватьОшибку(404, "not_found", "Заказ покупателя не найден", "customerOrderId");
		КонецЕсли;
		Шаблон.ДокументЗаказПокупателя = Заказ;
		Шаблон.Покупатель = Заказ.Контрагент;
		Шаблон.Договор = Заказ.Договор;
		Шаблон.НомерЗаказаКлиента = Заказ.НомерЗаказаКлиента;
		Шаблон.ДатаЗаказа = Заказ.Дата;
		Шаблон.НомерЗаказа = Заказ.Номер;
		ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа;
	Иначе
		ИсходнаяСтрока = Строка(ЗначениеИзДанных(Данные, "sourceLineId", ""));
		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
		Набор.Отбор.ИдентификаторЗаписи.Установить(ИсходнаяСтрока);
		Набор.Прочитать();
		Если Набор.Количество() = 0 Тогда
			ВызватьОшибку(404, "not_found", "Строка продажи " + ИсходнаяСтрока + " не найдена", "sourceLineId");
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Шаблон, Набор[0]);
		ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка;
	КонецЕсли;

	Порядок = МаксимальныйПорядок();
	Созданные = Новый Массив;
	Для Каждого ИдНоменклатуры Из Идентификаторы Цикл
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(УИД(Строка(ИдНоменклатуры), "nomenclatureIds"));
		Если Не СсылкаСуществует(Номенклатура) Тогда
			ВызватьОшибку(400, "bad_request", "Номенклатура " + Строка(ИдНоменклатуры) + " не найдена", "nomenclatureIds");
		КонецЕсли;
		Порядок = Порядок + 1;
		НоваяЗапись = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьМенеджерЗаписи();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Шаблон);
		Если Вид = "sales" Тогда
			НоваяЗапись.КлючСвязиСтрок = Строка(Новый УникальныйИдентификатор);
		КонецЕсли;
		НоваяЗапись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
		НоваяЗапись.ВидОперации = ВидОперации;
		НоваяЗапись.Номенклатура = Номенклатура;
		НоваяЗапись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик;
		НоваяЗапись.Порядок = Порядок;
		НоваяЗапись.Записать();
		Созданные.Добавить(СтрокаПоИдентификатору(НоваяЗапись.ИдентификаторЗаписи));
	КонецЦикла;
	Ответ.Код = 201;
	Ответ.Тело = Созданные;

КонецПроцедуры

// DELETE /lines/{id} — вычеркнуть строку: вся связка строк по ключу связи помечается удалением.
Процедура ВычеркнутьСтроку(Ответ, Сессия, Ид)

	ТребоватьЭкранПродаж(Сессия);
	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(Ид);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		ВызватьОшибку(404, "not_found", "Строка " + Ид + " не найдена");
	КонецЕсли;
	Запись = Набор[0];
	Если Запись.СтатусСтроки <> Перечисления.Арм_СтатусыАРМ.Черновик
		И Запись.СтатусСтроки <> Перечисления.Арм_СтатусыАРМ.ВРаботе Тогда
		ВызватьОшибку(409, "row_locked", "Вычеркнуть можно только строку в статусе «Черновик» или «В работе»", , КодСтатуса(Запись.СтатусСтроки));
	КонецЕсли;
	Если ЗначениеЗаполнено(Запись.АвторСтроки) И Запись.АвторСтроки <> Сессия.Пользователь Тогда
		ВызватьОшибку(409, "not_author", "Строку отметил другой пользователь: " + Строка(Запись.АвторСтроки));
	КонецЕсли;

	Связка = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Связка.Отбор.КлючСвязиСтрок.Установить(Запись.КлючСвязиСтрок);
	Связка.Прочитать();
	Для Каждого Стр Из Связка Цикл
		Стр.Удаление = Истина;
		Стр.ОтметкаСтроки = Ложь;
		Стр.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
	КонецЦикла;
	Связка.Записать();
	Ответ.Код = 204;

КонецПроцедуры

#КонецОбласти

#Область КомандыПродаж

// POST /sales/jobs — «В работе»: отмеченные ключи связи в статусах Черновик, В работе, Собран → фоновое задание формы.
Процедура ЗапуститьВРаботе(Ответ, Сессия, Данные)

	РазрешитьСплит = ЗначениеИзДанных(Данные, "allowSplit", Неопределено);
	Если ТипЗнч(РазрешитьСплит) <> Тип("Булево") Тогда
		ВызватьОшибку(400, "bad_request", "allowSplit: true или false", "allowSplit");
	КонецЕсли;
	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Черновик);
	Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.ВРаботе);
	Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Собран);
	Ключи = Арм_ОбщегоНазначенияАРМ.ПолучитьМассивОтмеченныхКлючейСвязи(Статусы);
	Если Ключи.Количество() = 0 Тогда
		ВызватьОшибку(409, "nothing_marked", "Нет отмеченных строк в статусах «Черновик», «В работе», «Собран»");
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Рег.ДокументЗаказПокупателя КАК Заказ
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
		|ГДЕ
		|	Рег.КлючСвязиСтрок В(&МассивКлючей)
		|	И НЕ Рег.Удаление");
	Запрос.УстановитьПараметр("МассивКлючей", Ключи);
	Заказы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Заказ");

	ИдЗадания = СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "");
	ПараметрыAPI = Новый Структура("ТекущийПользователь, МассивКлючей, МассивЗаказов, РазрешитьСплит, ИдентификаторЗадания",
		Сессия.Пользователь, Ключи, Заказы, РазрешитьСплит, ИдЗадания);
	Если СтрНайти(ВРег(СтрокаСоединенияИнформационнойБазы()), "FILE=") > 0 Тогда
		// Файловая база под веб-сервером: фоновое задание живёт в процессе веб-сервера и может не стартовать
		// после завершения сеанса HTTP-запроса — выполняем сразу, ответ — задание в конечном состоянии.
		ВыполнитьВРаботеФон(ПараметрыAPI);
		Ответ.Код = 202;
		СостояниеЗадания(Ответ, ИдЗадания);
		Ответ.Код = 202;
		Возврат;
	КонецЕсли;
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(ПараметрыAPI);
	ФоновыеЗадания.Выполнить("Арм_API.ВыполнитьВРаботеФон", ПараметрыЗадания, "Арм_API_" + ИдЗадания, "АРМ API: В работе");
	Ответ.Код = 202;
	Ответ.Тело = Новый Структура("id, state, processed", ИдЗадания, "running", 0);

КонецПроцедуры

Процедура СостояниеЗадания(Ответ, Ид)

	Результат = ХранилищеОбщихНастроек.Загрузить("Арм_API_Задание", Ид);
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если Результат.Свойство("СтатусВалидации") И Результат.СтатусВалидации = "ТребуетсяПодтверждениеМенеджера" Тогда
			Выбрано = 0;
			ВсегоШтук = 0;
			Результат.Свойство("ВсегоВыбраноШтук", Выбрано);
			Результат.Свойство("ВсегоВБазеШтук", ВсегоШтук);
			Ответ.Тело = Новый Структура("id, state, message", Ид, "need_split",
				СтрШаблон("Выбраны не все позиции по заказам (отмечено %1 из %2). Повторите с allowSplit=true", Выбрано, ВсегоШтук));
		ИначеЕсли Результат.Свойство("Успешно") И Результат.Успешно = Истина Тогда
			Ответ.Тело = Новый Структура("id, state, message", Ид, "done", "Все документы оформлены");
		Иначе
			ТекстОшибки = "";
			Результат.Свойство("ТекстОшибки", ТекстОшибки);
			Ответ.Тело = Новый Структура("id, state, message", Ид, "failed", Строка(ТекстОшибки));
		КонецЕсли;
		Возврат;
	КонецЕсли;

	Задания = ФоновыеЗадания.ПолучитьФоновыеЗадания(Новый Структура("Ключ", "Арм_API_" + Ид));
	Если Задания.Количество() = 0 Тогда
		ВызватьОшибку(404, "not_found", "Задание " + Ид + " не найдено");
	КонецЕсли;
	Задание = Задания[0];
	Если Задание.Состояние = СостояниеФоновогоЗадания.ЗавершеноАварийно Тогда
		Ответ.Тело = Новый Структура("id, state, message", Ид, "failed",
			?(Задание.ИнформацияОбОшибке = Неопределено, "Задание завершилось аварийно", КраткоеПредставлениеОшибки(Задание.ИнформацияОбОшибке)));
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Отменено Тогда
		Ответ.Тело = Новый Структура("id, state, message", Ид, "failed", "Задание отменено");
	ИначеЕсли Задание.Состояние = СостояниеФоновогоЗадания.Завершено Тогда
		Ответ.Тело = Новый Структура("id, state, message", Ид, "failed", "Задание завершилось, но не сохранило результат");
	Иначе
		Ответ.Тело = Новый Структура("id, state", Ид, "running");
	КонецЕсли;

КонецПроцедуры

// POST /sales/prepared — как ПодготовленоНаСервере формы.
Процедура Подготовлено(Ответ, Сессия)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т_Закупка.КлючСвязиСтрок КАК КлючСвязиСтрок
		|ПОМЕСТИТЬ втНезавершенныеЗакупки
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т_Закупка
		|ГДЕ
		|	Т_Закупка.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
		|	И Т_Закупка.СтатусСтроки <> ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.НаСкладе)
		|	И НЕ Т_Закупка.Удаление
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
		|	ВЫБОР
		|		КОГДА Т.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|				И Т.Поставщик <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|				И Т.Количество <> 0
		|				И Т.Цена <> 0
		|				И НЕ Т.КлючСвязиСтрок В
		|						(ВЫБРАТЬ
		|							втНезавершенныеЗакупки.КлючСвязиСтрок
		|						ИЗ
		|							втНезавершенныеЗакупки)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Готова
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.ОтметкаСтроки = ИСТИНА
		|	И Т.АвторСтроки = &АвторСтроки
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|	И Т.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.ВРаботе)
		|	И НЕ Т.Удаление");
	Запрос.УстановитьПараметр("АвторСтроки", Сессия.Пользователь);
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		ВызватьОшибку(409, "nothing_marked", "Нет отмеченных строк продажи в статусе «В работе»");
	КонецЕсли;
	Готовые = Таблица.НайтиСтроки(Новый Структура("Готова", Истина));
	Если Готовые.Количество() = 0 Тогда
		ВызватьОшибку(409, "unfinished_purchase", "В строках есть незавершённые закупки или не заполнены номенклатура, поставщик, количество, цена");
	КонецЕсли;
	Для Каждого Стр Из Готовые Цикл
		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
		Набор.Отбор.ИдентификаторЗаписи.Установить(Стр.ИдентификаторЗаписи);
		Набор.Прочитать();
		Если Набор.Количество() > 0 Тогда
			Набор[0].СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Подготовлено;
			Набор[0].ОтметкаСтроки = Ложь;
			Набор[0].АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
			Набор.Записать();
		КонецЕсли;
	КонецЦикла;
	Ответ.Тело = Новый Структура("processed, total", Готовые.Количество(), Таблица.Количество());

КонецПроцедуры

// POST /sales/customer-orders — новый заказ покупателя (пустой, строки добавляются POST /lines).
Процедура СоздатьЗаказПокупателя(Ответ, Сессия, Данные)

	Покупатель = Справочники.Контрагенты.ПолучитьСсылку(УИД(Строка(ЗначениеИзДанных(Данные, "customerId", "")), "customerId"));
	Если Не СсылкаСуществует(Покупатель) Тогда
		ВызватьОшибку(400, "bad_request", "Заказчик не найден", "customerId");
	КонецЕсли;
	Договор = ДоговорИзДанных(Данные, "contractId", Покупатель);
	Документ = Документы.ЗаказПокупателя.СоздатьДокумент();
	Документ.Заполнить(Неопределено);
	ДатаЗаказа = ЗначениеИзДанных(Данные, "date", "");
	Документ.Дата = ?(ЗначениеЗаполнено(ДатаЗаказа), ДатаИзJSON(ДатаЗаказа, "date"), ТекущаяДатаСеанса());
	Документ.Контрагент = Покупатель;
	Документ.Договор = Договор;
	Документ.НомерЗаказаКлиента = Строка(ЗначениеИзДанных(Данные, "clientOrderNumber", ""));
	Документ.Записать(РежимЗаписиДокумента.Запись);
	Ответ.Код = 201;
	Ответ.Тело = СсылкаДокумента(Документ.Ссылка, "customer_order", Документ.Номер, Документ.Дата, Документ.Проведен);

КонецПроцедуры

// POST /sales/imports — загрузка листа покупателя, как ФормаЗагрузкиДанных: заказ со строками клиента.
Процедура ЗагрузитьЛистПокупателя(Ответ, Сессия, Данные)

	Покупатель = Справочники.Контрагенты.ПолучитьСсылку(УИД(Строка(ЗначениеИзДанных(Данные, "customerId", "")), "customerId"));
	Если Не СсылкаСуществует(Покупатель) Тогда
		ВызватьОшибку(400, "bad_request", "Заказчик не найден", "customerId");
	КонецЕсли;
	Строки = ЗначениеИзДанных(Данные, "rows", Неопределено);
	Если ТипЗнч(Строки) <> Тип("Массив") Или Строки.Количество() = 0 Тогда
		ВызватьОшибку(400, "bad_request", "rows: непустой массив", "rows");
	КонецЕсли;
	Договор = ДоговорИзДанных(Данные, "contractId", Покупатель);

	Документ = Документы.ЗаказПокупателя.СоздатьДокумент();
	Документ.Заполнить(Неопределено);
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.Контрагент = Покупатель;
	Документ.Договор = Договор;
	НомерКлиента = Строка(ЗначениеИзДанных(Строки[0], "clientNumber", ""));
	Документ.НомерЗаказаКлиента = НомерКлиента;
	Для Каждого СтрокаЛиста Из Строки Цикл
		Наименование = СокрЛП(Строка(ЗначениеИзДанных(СтрокаЛиста, "name", "")));
		Артикул = СокрЛП(Строка(ЗначениеИзДанных(СтрокаЛиста, "article", "")));
		Если Не ЗначениеЗаполнено(Наименование) И Не ЗначениеЗаполнено(Артикул) Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтрока = Документ.Запасы.Добавить();
		НоваяСтрока.НомерКлиента = Строка(ЗначениеИзДанных(СтрокаЛиста, "clientNumber", НомерКлиента));
		НоваяСтрока.СрочностьКлиента = Строка(ЗначениеИзДанных(СтрокаЛиста, "urgency", ""));
		НоваяСтрока.ГРЗКлиента = Строка(ЗначениеИзДанных(СтрокаЛиста, "plate", ""));
		НоваяСтрока.ТерриторияКлиента = Строка(ЗначениеИзДанных(СтрокаЛиста, "territory", ""));
		НоваяСтрока.АртикулКлиента = Артикул;
		НоваяСтрока.НоменклатураКлиента = Наименование;
		НоваяСтрока.КоличествоКлиента = Строка(ЗначениеИзДанных(СтрокаЛиста, "quantity", ""));
	КонецЦикла;
	Если Документ.Запасы.Количество() = 0 Тогда
		ВызватьОшибку(400, "bad_request", "В листе нет строк с наименованием или артикулом", "rows");
	КонецЕсли;
	Документ.Записать(РежимЗаписиДокумента.Запись);

	// Если обработчик расширения на записи заказа не сработал (безопасный режим) — строки в регистр штатной процедурой.
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Поле ИЗ РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т ГДЕ Т.ДокументЗаказПокупателя = &Заказ");
	Запрос.УстановитьПараметр("Заказ", Документ.Ссылка);
	Если Запрос.Выполнить().Пустой() Тогда
		Для Каждого Стр Из Документ.Запасы Цикл
			Если Не ЗначениеЗаполнено(Стр.КлючСвязиСтрок) Тогда
				Стр.КлючСвязиСтрок = Строка(Новый УникальныйИдентификатор);
			КонецЕсли;
		КонецЦикла;
		Документ.ДополнительныеСвойства.Вставить("Арм_ПрограммнаяЗапись", Истина);
		Документ.Записать(РежимЗаписиДокумента.Запись);
		РегистрыСведений.Арм_ДанныеЗакупокИПродаж.ОбновитьДанныеПоОбъекту(Документ.Ссылка, Документ.Запасы.Выгрузить(), Истина);
	КонецЕсли;
	Ответ.Код = 201;
	Ответ.Тело = СсылкаДокумента(Документ.Ссылка, "customer_order", Документ.Номер, Документ.Дата, Документ.Проведен);

КонецПроцедуры

// POST /sales/customer-orders/{id}/post — как ПровестиЗаказПокупателяНаСервере формы, по одному заказу.
Процедура ПровестиЗаказПокупателя(Ответ, Сессия, ИдДокумента)

	Заказ = Документы.ЗаказПокупателя.ПолучитьСсылку(УИД(ИдДокумента, "documentId"));
	Если Не СсылкаСуществует(Заказ) Тогда
		ВызватьОшибку(404, "not_found", "Заказ покупателя не найден");
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
		|	Т.Номенклатура КАК Номенклатура,
		|	Т.Количество КАК Количество,
		|	Т.Цена КАК Цена,
		|	Т.КлючСвязиСтрок КАК КлючСвязиСтрок,
		|	Т.Покупатель КАК Покупатель,
		|	Т.Договор КАК Договор
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.ДокументЗаказПокупателя = &Заказ
		|	И Т.ОтметкаСтроки = ИСТИНА
		|	И Т.АвторСтроки = &АвторСтроки
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|	И Т.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	И Т.Количество <> 0
		|	И Т.Цена <> 0
		|	И Т.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Подготовлено)
		|	И НЕ Т.Удаление");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("АвторСтроки", Сессия.Пользователь);
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		ВызватьОшибку(409, "nothing_marked", "Нет отмеченных строк заказа в статусе «Подготовлено» с номенклатурой, количеством и ценой");
	КонецЕсли;
	Покупатель = Таблица[0].Покупатель;
	Если Не ЗначениеЗаполнено(Покупатель) Тогда
		ВызватьОшибку(409, "contract_owner", "В заказе не заполнен покупатель");
	КонецЕсли;
	Договор = Таблица[0].Договор;
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Договор = Арм_ОбщегоНазначенияАРМ.НайтиДоговор(Покупатель);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Договор) Тогда
		ВызватьОшибку(409, "contract_owner", "В заказе не заполнен договор");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Объект = Заказ.ПолучитьОбъект();
		Объект.Контрагент = Покупатель;
		Объект.Договор = Договор;
		ЗаполнитьПустыеРеквизитыЗаказа(Объект);
		Объект.Запасы.Очистить();
		ЕстьСумма = Метаданные.Документы.ЗаказПокупателя.ТабличныеЧасти.Запасы.Реквизиты.Найти("Сумма") <> Неопределено;
		Для Каждого Стр Из Таблица Цикл
			НоваяСтрока = Объект.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			Если ЕстьСумма Тогда
				НоваяСтрока.Сумма = Стр.Количество * Стр.Цена;
				НоваяСтрока.Всего = НоваяСтрока.Сумма;
				НоваяСтрока.ЕдиницаИзмерения = Стр.Номенклатура.ЕдиницаИзмерения;
				НоваяСтрока.ДатаОтгрузки = ?(ЗначениеЗаполнено(Объект.ДатаОтгрузки), Объект.ДатаОтгрузки, Объект.Дата);
			КонецЕсли;
			Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
			Набор.Отбор.ИдентификаторЗаписи.Установить(Стр.ИдентификаторЗаписи);
			Набор.Прочитать();
			Если Набор.Количество() > 0 Тогда
				Набор[0].СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Завершено;
				Набор[0].ОтметкаСтроки = Ложь;
				Набор[0].АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
				Набор.Записать();
			КонецЕсли;
		КонецЦикла;
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьОшибку(409, "unfinished_purchase", "Не удалось провести заказ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Ответ.Тело = Новый Структура("processed, total", Таблица.Количество(), Таблица.Количество());

КонецПроцедуры

// Пустые реквизиты шапки (организация, валюта, склад и т. п.) — значениями по умолчанию конфигурации,
// как у нового документа после Заполнить(Неопределено). Заказы, созданные не из формы, бывают без организации.
Процедура ЗаполнитьПустыеРеквизитыЗаказа(Объект)

	Образец = Документы.ЗаказПокупателя.СоздатьДокумент();
	Образец.Заполнить(Неопределено);
	Для Каждого Реквизит Из Метаданные.Документы.ЗаказПокупателя.Реквизиты Цикл
		Имя = Реквизит.Имя;
		Если Не ЗначениеЗаполнено(Объект[Имя]) И ЗначениеЗаполнено(Образец[Имя]) Тогда
			Объект[Имя] = Образец[Имя];
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Объект.ДатаОтгрузки) Тогда
		Объект.ДатаОтгрузки = Объект.Дата;
	КонецЕсли;

КонецПроцедуры

// DELETE /sales/customer-orders/{id} — как УдалитьВыбранныеЗаказыНаСервере формы.
Процедура УдалитьЗаказПокупателя(Ответ, Сессия, ИдДокумента)

	Заказ = Документы.ЗаказПокупателя.ПолучитьСсылку(УИД(ИдДокумента, "documentId"));
	Если Не СсылкаСуществует(Заказ) Тогда
		ВызватьОшибку(404, "not_found", "Заказ покупателя не найден");
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ЗаказПоставщику.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
		|ГДЕ
		|	ЗаказПоставщику.ЗаказПокупателя = &Заказ
		|	И ЗаказПоставщику.ПометкаУдаления = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	Т.СтатусСтроки КАК СтатусСтроки
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.ДокументЗаказПокупателя = &Заказ
		|	И НЕ Т.Удаление
		|	И НЕ Т.СтатусСтроки В (ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Черновик), ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.ВРаботе))");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Результаты = Запрос.ВыполнитьПакет();
	Если Не Результаты[0].Пустой() Тогда
		ВызватьОшибку(409, "unfinished_purchase", "По заказу есть заказ поставщику — удалить нельзя");
	КонецЕсли;
	Если Не Результаты[1].Пустой() Тогда
		ВызватьОшибку(409, "row_locked", "В заказе есть строки дальше статуса «В работе» — удалить нельзя");
	КонецЕсли;

	Объект = Заказ.ПолучитьОбъект();
	Если Не Объект.ПометкаУдаления Тогда
		Объект.УстановитьПометкуУдаления(Истина);
	КонецЕсли;
	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ДокументЗаказПокупателя.Установить(Заказ);
	Набор.Записать();
	Ответ.Код = 204;

КонецПроцедуры

// POST /sales/shipments — дата и номер отгрузки по заказу, как ОбновитьДанныеОтгрузкиВРегистреНаСервере формы.
Процедура ЗаполнитьОтгрузку(Ответ, Сессия, Данные)

	Заказ = Документы.ЗаказПокупателя.ПолучитьСсылку(УИД(Строка(ЗначениеИзДанных(Данные, "customerOrderId", "")), "customerOrderId"));
	ДатаОтгрузки = ДатаИзJSON(ЗначениеИзДанных(Данные, "shipmentDate", ""), "shipmentDate");
	НомерОтгрузки = Строка(ЗначениеИзДанных(Данные, "shipmentNumber", ""));
	Если Не ЗначениеЗаполнено(ДатаОтгрузки) Или Не ЗначениеЗаполнено(НомерОтгрузки) Тогда
		ВызватьОшибку(400, "bad_request", "Нужны shipmentDate и shipmentNumber");
	КонецЕсли;
	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ДокументЗаказПокупателя.Установить(Заказ);
	Набор.Прочитать();
	Изменено = 0;
	Для Каждого Запись Из Набор Цикл
		Свободна = Не ЗначениеЗаполнено(Запись.АвторСтроки) Или Запись.АвторСтроки = Сессия.Пользователь;
		Если ЗначениеЗаполнено(Запись.Партия) И Свободна И Не Запись.Удаление
			И (Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ВРаботе
				Или Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик) Тогда
			Запись.ДатаОтгрузки = ДатаОтгрузки;
			Запись.НомерОтгрузки = НомерОтгрузки;
			Изменено = Изменено + 1;
		КонецЕсли;
	КонецЦикла;
	Если Изменено > 0 Тогда
		Набор.Записать();
	КонецЕсли;
	Ответ.Тело = Новый Структура("processed, total", Изменено, Набор.Количество());

КонецПроцедуры

#КонецОбласти

#Область Снабжение

// POST /supply/status — кнопки формы снабжения через ИзменитьСтатусыВРегистреСнабжения.
Процедура СтатусСнабжения(Ответ, Сессия, Данные)

	Если Сессия.Роль <> "supply" И Сессия.Роль <> "admin" Тогда
		ВызватьОшибку(403, "matrix_denied", "Статусы канбана меняет роль supply");
	КонецЕсли;
	КодЦели = Строка(ЗначениеИзДанных(Данные, "status", ""));
	С = Перечисления.Арм_СтатусыАРМ;
	Цели = Новый Соответствие;
	Цели.Вставить("paid", С.Оплачено);
	Цели.Вставить("in_transit", С.ТоварВПути);
	Цели.Вставить("acceptance", С.Приходуется);
	Цели.Вставить("to_stock", С.НаСкладе);
	Цели.Вставить("assembly", С.Комплектуется);
	Цели.Вставить("assembled", С.Собран);
	Цель = Цели.Получить(КодЦели);
	Если Цель = Неопределено Тогда
		ВызватьОшибку(400, "bad_request", "status: paid, in_transit, acceptance, to_stock, assembly, assembled", "status");
	КонецЕсли;

	Идентификаторы = Арм_ОбщегоНазначенияАРМ.ПолучитьМассивОтмеченныхИдентификаторов(Перечисления.Арм_ВидыОпераций.Закупка);
	Если ТипЗнч(Идентификаторы) <> Тип("Массив") Или Идентификаторы.Количество() = 0 Тогда
		ВызватьОшибку(409, "nothing_marked", "Нет отмеченных закупок");
	КонецЕсли;
	ДатаПрихода = Дата(1, 1, 1);
	Если КодЦели = "assembled" И ЧастичныйПриход(Идентификаторы) Тогда
		Если ЗначениеИзДанных(Данные, "partialReceipt", Ложь) <> Истина Тогда
			ВызватьОшибку(409, "need_split", "Частичный приход по заказу поставщику: повторите с partialReceipt=true и receiptDate");
		КонецЕсли;
		ДатаПрихода = ДатаИзJSON(ЗначениеИзДанных(Данные, "receiptDate", ""), "receiptDate");
		Если Не ЗначениеЗаполнено(ДатаПрихода) Тогда
			ВызватьОшибку(400, "bad_request", "При частичном приходе нужна receiptDate", "receiptDate");
		КонецЕсли;
	КонецЕсли;

	Итог = Арм_ОбщегоНазначенияАРМ.ИзменитьСтатусыВРегистреСнабжения(Идентификаторы, Цель);
	Если Не Итог.Успешно Тогда
		ВызватьОшибку(409, "row_locked", Итог.ТекстОшибки);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаПрихода) Тогда
		Для Каждого Ид Из Идентификаторы Цикл
			Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
			Набор.Отбор.ИдентификаторЗаписи.Установить(Ид);
			Набор.Прочитать();
			Если Набор.Количество() > 0 Тогда
				Набор[0].ДатаПоступления = ДатаПрихода;
				Набор.Записать();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Ответ.Тело = Новый Структура("processed, total", Итог.КоличествоОбработанных, Идентификаторы.Количество());

КонецПроцедуры

// Как ПроверитьЧастичныйПриходНаСервере формы снабжения.
Функция ЧастичныйПриход(Идентификаторы)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Внутр.ДокументЗаказПоставщика КАК ЗаказПоставщика
		|ПОМЕСТИТЬ втВыбранныеЗаказы
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Внутр
		|ГДЕ
		|	Внутр.ИдентификаторЗаписи В(&МассивИдентификаторов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Поле
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВыбранныеЗаказы КАК ВТ_Заказы
		|		ПО Т.ДокументЗаказПоставщика = ВТ_Заказы.ЗаказПоставщика
		|ГДЕ
		|	НЕ Т.ИдентификаторЗаписи В (&МассивИдентификаторов)
		|	И НЕ Т.Удаление
		|	И Т.СтатусСтроки В (&МассивСтатусов)
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)");
	Запрос.УстановитьПараметр("МассивИдентификаторов", Идентификаторы);
	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Оплачено);
	Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.ТоварВПути);
	Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Приходуется);
	Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.НаСкладе);
	Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Комплектуется);
	Запрос.УстановитьПараметр("МассивСтатусов", Статусы);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

#КонецОбласти

#Область ДокументыИСправочники

Процедура КарточкаДокумента(Ответ, Вид, ИдДокумента)

	Виды = Новый Соответствие;
	Виды.Вставить("customer_order", "ЗаказПокупателя");
	Виды.Вставить("supplier_order", "ЗаказПоставщику");
	Виды.Вставить("receipt", "ПриходнаяНакладная");
	Виды.Вставить("shipment", "РасходнаяНакладная");
	ИмяДокумента = Виды.Получить(Вид);
	Если ИмяДокумента = Неопределено Тогда
		ВызватьОшибку(400, "bad_request", "kind: customer_order, supplier_order, receipt, shipment", "kind");
	КонецЕсли;
	Ссылка = Документы[ИмяДокумента].ПолучитьСсылку(УИД(ИдДокумента, "documentId"));
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Д.Ссылка КАК Ссылка,
		|	Д.Номер КАК Номер,
		|	Д.Дата КАК Дата,
		|	Д.Проведен КАК Проведен,
		|	Д.Контрагент КАК Контрагент,
		|	Д.Договор КАК Договор,
		|	Д.Комментарий КАК Комментарий
		|ИЗ
		|	Документ." + ИмяДокумента + " КАК Д
		|ГДЕ
		|	Д.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьОшибку(404, "not_found", "Документ не найден");
	КонецЕсли;
	Карточка = СсылкаДокумента(Выборка.Ссылка, Вид, Выборка.Номер, Выборка.Дата, Выборка.Проведен);
	Карточка.Вставить("counterparty", ИменованнаяСсылка(Выборка.Контрагент));
	Карточка.Вставить("contract", ИменованнаяСсылка(Выборка.Договор));
	Карточка.Вставить("comment", Выборка.Комментарий);
	Ответ.Тело = Карточка;

КонецПроцедуры

Процедура Справочник(Ответ, Имя, Параметры)

	Запрос = Новый Запрос;
	Строка = ПараметрЗапроса(Параметры, "q", "");
	Если Имя = "counterparties" Тогда
		Запрос.Текст = ТекстПоискаВСправочнике("Контрагенты", "Наименование", Строка, Запрос);
	ИначеЕсли Имя = "contracts" Тогда
		Владелец = Справочники.Контрагенты.ПолучитьСсылку(УИД(ПараметрЗапроса(Параметры, "ownerId", ""), "ownerId"));
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 200
			|	С.Ссылка КАК Ссылка,
			|	С.Наименование КАК Наименование
			|ИЗ
			|	Справочник.ДоговорыКонтрагентов КАК С
			|ГДЕ
			|	С.Владелец = &Владелец
			|	И НЕ С.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	Наименование";
		Запрос.УстановитьПараметр("Владелец", Владелец);
	ИначеЕсли Имя = "nomenclature" Тогда
		Если Не ЗначениеЗаполнено(Строка) Тогда
			ВызватьОшибку(400, "bad_request", "Нужен параметр q", "q");
		КонецЕсли;
		Запрос.Текст = ТекстПоискаВСправочнике("Номенклатура", "Наименование, Артикул, АС_КодАвтоАльянс", Строка, Запрос,
			"ЕСТЬNULL(С.Артикул, """") КАК Артикул, ЕСТЬNULL(С.АС_КодАвтоАльянс, """") КАК Код, ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(С.ЕдиницаИзмерения), """") КАК Единица");
	ИначеЕсли Имя = "batches" Тогда
		Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(УИД(ПараметрЗапроса(Параметры, "nomenclatureId", ""), "nomenclatureId"));
		УсловиеВладельца = ?(Метаданные.Справочники.ПартииНоменклатуры.Владельцы.Количество() > 0, "С.Владелец = &Номенклатура", "ИСТИНА");
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 200
			|	С.Ссылка КАК Ссылка,
			|	С.Наименование КАК Наименование
			|ИЗ
			|	Справочник.ПартииНоменклатуры КАК С
			|ГДЕ
			|	" + УсловиеВладельца + "
			|	И НЕ С.ПометкаУдаления
			|УПОРЯДОЧИТЬ ПО
			|	Наименование";
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	ИначеЕсли Имя = "service-types" Тогда
		Запрос.Текст = ТекстПоискаВСправочнике("Арм_ВидыУслуги", "Наименование", "", Запрос);
	ИначеЕсли Имя = "payment-forms" Тогда
		Запрос.Текст = ТекстПоискаВСправочнике("Арм_ФормыОплаты", "Наименование", "", Запрос);
	Иначе
		ВызватьОшибку(404, "not_found", "Нет справочника " + Имя);
	КонецЕсли;

	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура("id, name", ИдСсылки(Выборка.Ссылка), Выборка.Наименование);
		Если Имя = "nomenclature" Тогда
			Элемент.Вставить("article", Выборка.Артикул);
			Элемент.Вставить("code", Выборка.Код);
			Элемент.Вставить("unit", Выборка.Единица);
		ИначеЕсли Имя = "batches" Тогда
			Элемент.Вставить("available", Неопределено);
			Элемент.Вставить("costPrice", Неопределено);
			Элемент.Вставить("supplier", Неопределено);
		КонецЕсли;
		Результат.Добавить(Элемент);
	КонецЦикла;
	Ответ.Тело = Результат;

КонецПроцедуры

Функция ТекстПоискаВСправочнике(ИмяСправочника, ПоляПоиска, СтрокаПоиска, Запрос, ДопПоля = "")

	МД = Метаданные.Справочники[ИмяСправочника];
	Условия = Новый Массив;
	Условия.Добавить("НЕ С.ПометкаУдаления");
	Если МД.Иерархический И МД.ВидИерархии = Метаданные.СвойстваОбъектов.ВидИерархии.ИерархияГруппИЭлементов Тогда
		Условия.Добавить("НЕ С.ЭтоГруппа");
	КонецЕсли;
	Если ЗначениеЗаполнено(СтрокаПоиска) Тогда
		Поиск = Новый Массив;
		Для Каждого Поле Из СтрРазделить(ПоляПоиска, ", ", Ложь) Цикл
			Поиск.Добавить("С." + Поле + " ПОДОБНО &Строка СПЕЦСИМВОЛ ""~""");
		КонецЦикла;
		Условия.Добавить("(" + СтрСоединить(Поиск, " ИЛИ ") + ")");
		Шаблон = СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрЗаменить(СтрокаПоиска, "~", "~~"), "%", "~%"), "_", "~_"), "[", "~[");
		Запрос.УстановитьПараметр("Строка", "%" + Шаблон + "%");
	КонецЕсли;
	Возврат
		"ВЫБРАТЬ ПЕРВЫЕ 50
		|	С.Ссылка КАК Ссылка,
		|	С.Наименование КАК Наименование" + ?(ЗначениеЗаполнено(ДопПоля), ",
		|	" + ДопПоля, "") + "
		|ИЗ
		|	Справочник." + ИмяСправочника + " КАК С
		|ГДЕ
		|	" + СтрСоединить(Условия, "
		|	И ") + "
		|УПОРЯДОЧИТЬ ПО
		|	Наименование";

КонецФункции

Функция ДоговорИзДанных(Данные, Ключ, Покупатель)

	ИдДоговора = ЗначениеИзДанных(Данные, Ключ, Неопределено);
	Если Не ЗначениеЗаполнено(ИдДоговора) Тогда
		Возврат Арм_ОбщегоНазначенияАРМ.НайтиДоговор(Покупатель);
	КонецЕсли;
	Договор = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(УИД(Строка(ИдДоговора), Ключ));
	Если Не СсылкаСуществует(Договор) Тогда
		ВызватьОшибку(400, "bad_request", "Договор не найден", Ключ);
	КонецЕсли;
	Если Договор.Владелец <> Покупатель Тогда
		ВызватьОшибку(409, "contract_owner", "Договор не принадлежит заказчику", Ключ);
	КонецЕсли;
	Возврат Договор;

КонецФункции

#КонецОбласти

#Область Служебные

Функция СоответствиеСтатусов()

	С = Новый Соответствие;
	П = Перечисления.Арм_СтатусыАРМ;
	С.Вставить(П.Черновик, "new");
	С.Вставить(П.ВРаботе, "in_work");
	С.Вставить(П.ЧастичноЗаказано, "partially_ordered");
	С.Вставить(П.Заказано, "ordered");
	С.Вставить(П.Оплачено, "paid");
	С.Вставить(П.ТоварВПути, "in_transit");
	С.Вставить(П.ОжидаемПоступление, "awaiting_receipt");
	С.Вставить(П.Приходуется, "acceptance");
	С.Вставить(П.НаСкладе, "to_stock");
	С.Вставить(П.Резервирование, "reserve");
	С.Вставить(П.Комплектуется, "assembly");
	С.Вставить(П.Подготовлено, "ready_to_ship");
	С.Вставить(П.Собран, "ready_to_ship");
	С.Вставить(П.Отгружено, "shipped");
	С.Вставить(П.Возврат, "return");
	С.Вставить(П.Выполнено, "closed");
	С.Вставить(П.Завершено, "closed");
	С.Вставить(П.ЗаблокированоФоном, "locked_background");
	Возврат С;

КонецФункции

Функция КодСтатуса(Статус)

	Код = СоответствиеСтатусов().Получить(Статус);
	Возврат ?(Код = Неопределено, "new", Код);

КонецФункции

Функция ВидОперацииСписка(Вид)
	Возврат ?(Вид = "sales", Перечисления.Арм_ВидыОпераций.Продажа, Перечисления.Арм_ВидыОпераций.Закупка);
КонецФункции

Функция МаксимальныйПорядок()

	Запрос = Новый Запрос("ВЫБРАТЬ ЕСТЬNULL(МАКСИМУМ(Т.Порядок), 0) КАК Макс ИЗ РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т");
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Макс, 0);

КонецФункции

Функция ИдСсылки(Ссылка)
	Возврат ?(ЗначениеЗаполнено(Ссылка), Строка(Ссылка.УникальныйИдентификатор()), Неопределено);
КонецФункции

Функция ИменованнаяСсылка(Ссылка)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("id, name", ИдСсылки(Ссылка), Строка(Ссылка));
КонецФункции

Функция СсылкаДокумента(Ссылка, Вид, Номер, ДатаДокумента, Проведен)
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Новый Структура("id, kind, number, date, posted", ИдСсылки(Ссылка), Вид, СокрЛП(Номер), ДатаJSON(ДатаДокумента), Проведен = Истина);
КонецФункции

Функция СсылкаСуществует(Ссылка)

	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Ложь;
	КонецЕсли;
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Поле ИЗ " + Ссылка.Метаданные().ПолноеИмя() + " КАК Т ГДЕ Т.Ссылка = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Функция ДатаJSON(Значение)
	Если ТипЗнч(Значение) <> Тип("Дата") Или Значение = Дата(1, 1, 1) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Возврат Формат(Значение, "ДФ=yyyy-MM-dd");
КонецФункции

Функция ДатаИзJSON(Значение, Поле)

	Если Значение = Неопределено Или Значение = "" Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Текст = Строка(Значение);
	Попытка
		Возврат Дата(Число(Лев(Текст, 4)), Число(Сред(Текст, 6, 2)), Число(Сред(Текст, 9, 2)));
	Исключение
		ВызватьОшибку(400, "bad_request", "Ожидалась дата в формате YYYY-MM-DD", Поле);
	КонецПопытки;

КонецФункции

Функция УИД(Текст, Поле)
	Попытка
		Возврат Новый УникальныйИдентификатор(Текст);
	Исключение
		ВызватьОшибку(400, "bad_request", "Ожидался uuid", Поле);
	КонецПопытки;
КонецФункции

Функция ЧислоИзПараметра(Текст, ПоУмолчанию, Минимум, Максимум)
	Попытка
		Значение = Число(Текст);
	Исключение
		Возврат ПоУмолчанию;
	КонецПопытки;
	Возврат Макс(Минимум, Мин(Максимум, Цел(Значение)));
КонецФункции

Функция ПараметрЗапроса(Параметры, Имя, ПоУмолчанию)
	Значение = Параметры.Получить(Имя);
	Возврат ?(Значение = Неопределено, ПоУмолчанию, Строка(Значение));
КонецФункции

Функция Заголовок(Заголовки, Имя)
	Для Каждого КЗ Из Заголовки Цикл
		Если НРег(КЗ.Ключ) = НРег(Имя) Тогда
			Возврат Строка(КЗ.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат "";
КонецФункции

Функция ЗначениеИзДанных(Данные, Ключ, ПоУмолчанию)
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат ПоУмолчанию;
	КонецЕсли;
	Значение = Данные.Получить(Ключ);
	Возврат ?(Значение = Неопределено, ПоУмолчанию, Значение);
КонецФункции

Функция ЕстьКлюч(Данные, Ключ)
	Если ТипЗнч(Данные) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого КЗ Из Данные Цикл
		Если КЗ.Ключ = Ключ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ИзJSON(Текст)
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Попытка
		Данные = ПрочитатьJSON(Чтение, Истина);
	Исключение
		ВызватьОшибку(400, "bad_request", "Тело запроса — не JSON");
	КонецПопытки;
	Возврат Данные;
КонецФункции

Функция ВJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция РазделительОшибки()
	Возврат "§";
КонецФункции

Функция МаркерОшибки()
	Возврат "АРМ_API" + РазделительОшибки();
КонецФункции

// Ошибка API: HTTP-код, код проблемы из контракта, сообщение, поле, статус строки.
Процедура ВызватьОшибку(КодHTTP, Код, Сообщение, Поле = "", Статус = "")
	ВызватьИсключение МаркерОшибки() + Формат(КодHTTP, "ЧГ=0") + РазделительОшибки() + Код + РазделительОшибки()
		+ СтрЗаменить(Сообщение, РазделительОшибки(), " ") + РазделительОшибки() + Поле + РазделительОшибки() + Статус;
КонецПроцедуры

// Текст ошибки API после маркера или Неопределено, если ошибка не от ВызватьОшибку.
Функция ТекстОшибкиAPI(Информация)
	Текущая = Информация;
	Пока Текущая <> Неопределено Цикл
		Позиция = СтрНайти(Текущая.Описание, МаркерОшибки());
		Если Позиция > 0 Тогда
			Возврат Сред(Текущая.Описание, Позиция + СтрДлина(МаркерОшибки()));
		КонецЕсли;
		Текущая = Текущая.Причина;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

#КонецОбласти
