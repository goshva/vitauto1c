// HTTP API АРМ для PWA — контракт openapi/arm-pwa.openapi.yaml, корень /api/arm/v1.
//
// HTTP-сервис Арм_API передаёт сюда метод, путь, параметры, заголовки и тело запроса и возвращает ответ.
// Запросы выполняются под пользователем публикации (технический пользователь в default.vrd). Пользователь API
// определяется по токену сессии (POST /session) и на время запроса ставится в ПараметрыСеанса.ТекущийПользователь —
// поэтому отметки строк, «автор строки» и общие функции АРМ работают так же, как в форме.
// Права на поля — маска матрицы из модуля Арм_APIМатрица (генерируется из default-matrix.js).

#Область ПрограммныйИнтерфейс

// Обработать запрос API.
//   Метод     — HTTP-метод;
//   Путь      — путь после корня сервиса, с префиксом /arm/v1 или без него;
//   Параметры — Соответствие параметров строки запроса;
//   Заголовки — Соответствие заголовков;
//   ТекстТела — тело запроса строкой (JSON).
// Возвращает Структура: Код (Число), Тело (Строка JSON или Неопределено), Заголовки (Соответствие).
Функция ОбработатьЗапрос(Знач Метод, Знач Путь, Знач Параметры = Неопределено, Знач Заголовки = Неопределено, Знач ТекстТела = "") Экспорт

	Ответ = Новый Структура("Код, Тело, Заголовки", 200, Неопределено, Новый Соответствие);
	Если Параметры = Неопределено Тогда
		Параметры = Новый Соответствие;
	КонецЕсли;
	Если Заголовки = Неопределено Тогда
		Заголовки = Новый Соответствие;
	КонецЕсли;

	Попытка
		Маршрутизировать(Ответ, ВРег(Метод), НормализоватьПуть(Путь), Параметры, Заголовки, ТекстТела);
		Если Ответ.Тело <> Неопределено И ТипЗнч(Ответ.Тело) <> Тип("Строка") Тогда
			Ответ.Тело = ВJSON(Ответ.Тело);
		КонецЕсли;
	Исключение
		Информация = ИнформацияОбОшибке();
		Текст = ТекстОшибкиAPI(Информация);
		Если Текст <> Неопределено Тогда
			Части = СтрРазделить(Текст, РазделительОшибки(), Истина);
			Проблема = Новый Структура("code, message", Части[1], Части[2]);
			Если Части.Количество() > 3 И ЗначениеЗаполнено(Части[3]) Тогда
				Проблема.Вставить("field", Части[3]);
			КонецЕсли;
			Если Части.Количество() > 4 И ЗначениеЗаполнено(Части[4]) Тогда
				Проблема.Вставить("status", Части[4]);
			КонецЕсли;
			Ответ.Код = Число(Части[0]);
			Ответ.Тело = ВJSON(Проблема);
		Иначе
			ЗаписьЖурналаРегистрации("АРМ.API", УровеньЖурналаРегистрации.Ошибка,,,
				Метод + " " + Путь + ": " + ПодробноеПредставлениеОшибки(Информация));
			Ответ.Код = 500;
			Ответ.Тело = ВJSON(Новый Структура("code, message", "internal", КраткоеПредставлениеОшибки(Информация)));
		КонецЕсли;
	КонецПопытки;

	Возврат Ответ;

КонецФункции

// Фоновое задание «В работе»: вызывает задание формы и сохраняет его результат для GET /jobs/{id}.
Процедура ВыполнитьВРаботеФон(Знач ПараметрыAPI) Экспорт

	Результат = Неопределено;
	Попытка
		УстановитьТекущегоПользователя(ПараметрыAPI.ТекущийПользователь);
		Адрес = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
		ПараметрыПроцедуры = Новый Структура;
		ПараметрыПроцедуры.Вставить("ТекущийПользователь", ПараметрыAPI.ТекущийПользователь);
		ПараметрыПроцедуры.Вставить("МассивКлючей", ПараметрыAPI.МассивКлючей);
		ПараметрыПроцедуры.Вставить("МассивЗаказов", ПараметрыAPI.МассивЗаказов);
		ПараметрыПроцедуры.Вставить("АдресРезультата", Адрес);
		ПараметрыПроцедуры.Вставить("РазрешитьСплит", ПараметрыAPI.РазрешитьСплит);
		Арм_ДанныеЗакупокИПродажФон.СформироватьЗаказыФоновоеЗадание(ПараметрыПроцедуры);
		Результат = ПолучитьИзВременногоХранилища(Адрес);
	Исключение
		Результат = Новый Структура("Успешно, ТекстОшибки", Ложь, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если Результат = Неопределено Тогда
		Результат = Новый Структура("Успешно, ТекстОшибки", Ложь, "Задание не вернуло результат");
	КонецЕсли;
	ХранилищеОбщихНастроек.Сохранить("Арм_API_Задание", ПараметрыAPI.ИдентификаторЗадания, Результат);

КонецПроцедуры

#КонецОбласти

#Область Маршрутизация

Процедура Маршрутизировать(Ответ, Метод, Путь, Параметры, Заголовки, ТекстТела)

	С = СтрРазделить(Путь, "/", Ложь);
	Если С.Количество() = 0 Тогда
		ВызватьОшибку(404, "not_found", "Не указан ресурс");
	КонецЕсли;
	Ресурс = С[0];

	// Вход без сессии
	Если Ресурс = "session" И С.Количество() = 1 И Метод = "POST" Тогда
		Войти(Ответ, ИзJSON(ТекстТела));
		Возврат;
	КонецЕсли;

	Сессия = ТекущаяСессия(Заголовки);

	Если Ресурс = "session" И С.Количество() = 1 Тогда
		Если Метод = "GET" Тогда
			Ответ.Тело = ОписаниеСессии(Сессия);
		ИначеЕсли Метод = "DELETE" Тогда
			ХранилищеОбщихНастроек.Удалить("Арм_API_Сессия", Сессия.Токен, ИмяПользователя());
			Ответ.Код = 204;
		Иначе
			НеподдерживаемыйМетод();
		КонецЕсли;

	ИначеЕсли Ресурс = "matrix" И С.Количество() = 1 Тогда
		ПроверитьМетод(Метод, "GET");
		МатрицаДляРоли(Ответ, Сессия, Заголовки);

	ИначеЕсли Ресурс = "lines" И С.Количество() = 1 Тогда
		Если Метод = "GET" Тогда
			СписокСтрок(Ответ, Сессия, Параметры);
		ИначеЕсли Метод = "POST" Тогда
			ДобавитьСтроки(Ответ, Сессия, ИзJSON(ТекстТела));
		Иначе
			НеподдерживаемыйМетод();
		КонецЕсли;

	ИначеЕсли Ресурс = "lines" И С.Количество() = 2 Тогда
		Если Метод = "GET" Тогда
			Ответ.Тело = СтрокаПоИдентификатору(С[1], Истина);
		ИначеЕсли Метод = "PATCH" Тогда
			ЗаписатьПолеСтроки(Ответ, Сессия, С[1], ИзJSON(ТекстТела));
		ИначеЕсли Метод = "DELETE" Тогда
			ВычеркнутьСтроку(Ответ, Сессия, С[1]);
		Иначе
			НеподдерживаемыйМетод();
		КонецЕсли;

	ИначеЕсли Ресурс = "lines" И С.Количество() = 3 И С[2] = "mark" Тогда
		ПроверитьМетод(Метод, "POST");
		ПереключитьОтметку(Ответ, Сессия, С[1]);

	ИначеЕсли Ресурс = "selection" И С.Количество() = 1 Тогда
		Если Метод = "GET" Тогда
			ИтогиВыделения(Ответ, Сессия, Параметры);
		ИначеЕсли Метод = "POST" Тогда
			ОтметитьСтрокиЗаказа(Ответ, Сессия, ИзJSON(ТекстТела));
		Иначе
			НеподдерживаемыйМетод();
		КонецЕсли;

	ИначеЕсли Ресурс = "sales" И С.Количество() >= 2 Тогда
		ТребоватьЭкранПродаж(Сессия);
		Команда = С[1];
		Если Команда = "jobs" И С.Количество() = 2 Тогда
			ПроверитьМетод(Метод, "POST");
			ЗапуститьВРаботе(Ответ, Сессия, ИзJSON(ТекстТела));
		ИначеЕсли Команда = "prepared" И С.Количество() = 2 Тогда
			ПроверитьМетод(Метод, "POST");
			Подготовлено(Ответ, Сессия);
		ИначеЕсли Команда = "customer-orders" И С.Количество() = 2 Тогда
			ПроверитьМетод(Метод, "POST");
			СоздатьЗаказПокупателя(Ответ, Сессия, ИзJSON(ТекстТела));
		ИначеЕсли Команда = "customer-orders" И С.Количество() = 4 И С[3] = "post" Тогда
			ПроверитьМетод(Метод, "POST");
			ПровестиЗаказПокупателя(Ответ, Сессия, С[2]);
		ИначеЕсли Команда = "customer-orders" И С.Количество() = 3 Тогда
			ПроверитьМетод(Метод, "DELETE");
			УдалитьЗаказПокупателя(Ответ, Сессия, С[2]);
		ИначеЕсли Команда = "supplier-orders" И С.Количество() = 2 Тогда
			ПроверитьМетод(Метод, "POST");
			// В форме команда «Заказать» — заглушка (СоздатьЗаказПоставщикуНаСервере отбирает строки и ничего не создаёт).
			ВызватьОшибку(501, "not_implemented", "Создание заказа поставщику в АРМ не реализовано: команда формы — заглушка");
		ИначеЕсли Команда = "shipments" И С.Количество() = 2 Тогда
			ПроверитьМетод(Метод, "POST");
			ЗаполнитьОтгрузку(Ответ, Сессия, ИзJSON(ТекстТела));
		ИначеЕсли Команда = "imports" И С.Количество() = 2 Тогда
			ПроверитьМетод(Метод, "POST");
			ЗагрузитьЛистПокупателя(Ответ, Сессия, ИзJSON(ТекстТела));
		Иначе
			ВызватьОшибку(404, "not_found", "Нет такого ресурса: " + Путь);
		КонецЕсли;

	ИначеЕсли Ресурс = "supply" И С.Количество() = 2 И С[1] = "status" Тогда
		ПроверитьМетод(Метод, "POST");
		СтатусСнабжения(Ответ, Сессия, ИзJSON(ТекстТела));

	ИначеЕсли Ресурс = "jobs" И С.Количество() = 2 Тогда
		ПроверитьМетод(Метод, "GET");
		СостояниеЗадания(Ответ, С[1]);

	ИначеЕсли Ресурс = "documents" И С.Количество() = 3 Тогда
		ПроверитьМетод(Метод, "GET");
		КарточкаДокумента(Ответ, С[1], С[2]);

	ИначеЕсли Ресурс = "directories" И С.Количество() = 2 Тогда
		ПроверитьМетод(Метод, "GET");
		Справочник(Ответ, С[1], Параметры);

	Иначе
		ВызватьОшибку(404, "not_found", "Нет такого ресурса: " + Путь);
	КонецЕсли;

КонецПроцедуры

Функция НормализоватьПуть(Знач Путь)

	Путь = СокрЛП(Путь);
	Позиция = СтрНайти(Путь, "?");
	Если Позиция > 0 Тогда
		Путь = Лев(Путь, Позиция - 1);
	КонецЕсли;
	Если СтрНачинаетсяС(Путь, "/arm/v1") Тогда
		Путь = Сред(Путь, 8);
	КонецЕсли;
	Возврат Путь;

КонецФункции

Процедура ПроверитьМетод(Метод, Ожидаемый)
	Если Метод <> Ожидаемый Тогда
		НеподдерживаемыйМетод();
	КонецЕсли;
КонецПроцедуры

Процедура НеподдерживаемыйМетод()
	ВызватьОшибку(405, "method_not_allowed", "Метод не поддерживается");
КонецПроцедуры

#КонецОбласти

#Область Сессия

Процедура Войти(Ответ, Данные)

	Логин = СокрЛП(Строка(ЗначениеИзДанных(Данные, "login", "")));
	Пароль = Строка(ЗначениеИзДанных(Данные, "password", ""));
	Если Не ЗначениеЗаполнено(Логин) Тогда
		ВызватьОшибку(401, "unauthorized", "Не указан логин");
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Логин);
	Если ПользовательИБ = Неопределено Или Не ПарольВерен(ПользовательИБ, Пароль) Тогда
		ВызватьОшибку(401, "unauthorized", "Неверный логин или пароль");
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	П.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Пользователи КАК П
		|ГДЕ
		|	П.ИдентификаторПользователяИБ = &Ид
		|	И НЕ П.ПометкаУдаления");
	Запрос.УстановитьПараметр("Ид", ПользовательИБ.УникальныйИдентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		ВызватьОшибку(401, "unauthorized", "Пользователь ИБ «" + Логин + "» не сопоставлен справочнику Пользователи");
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

	Токен = СтрЗаменить(Строка(Новый УникальныйИдентификатор) + Строка(Новый УникальныйИдентификатор), "-", "");
	Сессия = Новый Структура("Токен, Логин, Пользователь, Истекает", Токен, Логин, Выборка.Ссылка, ТекущаяДатаСеанса() + 12 * 3600);
	ХранилищеОбщихНастроек.Сохранить("Арм_API_Сессия", Токен, Сессия);

	УстановитьТекущегоПользователя(Выборка.Ссылка);
	Ответ.Тело = ОписаниеСессии(Сессия);

КонецПроцедуры

// Пароль пользователя ИБ: СохраняемоеЗначениеПароля = Base64(SHA1(пароль)),Base64(SHA1(ВРег(пароль))).
Функция ПарольВерен(ПользовательИБ, Пароль)

	Сохраненное = ПользовательИБ.СохраняемоеЗначениеПароля;
	Если Не ЗначениеЗаполнено(Сохраненное) Тогда
		Возврат Пароль = "";
	КонецЕсли;
	Части = СтрРазделить(Сохраненное, ",", Ложь);
	Возврат Части.Найти(ХешПароля(Пароль)) <> Неопределено;

КонецФункции

Функция ХешПароля(Пароль)

	Хеширование = Новый ХешированиеДанных(ХешФункция.SHA1);
	Хеширование.Добавить(Пароль);
	Возврат Base64Строка(Хеширование.ХешСумма);

КонецФункции

Функция ТекущаяСессия(Заголовки)

	// Веб-расширение 1С само разбирает Authorization: Bearer как токен доступа 1С и отвечает 500,
	// поэтому веб-сервер переносит заголовок в X-Arm-Authorization (см. httpd-1c.conf).
	Авторизация = Заголовок(Заголовки, "X-Arm-Authorization");
	Если Не ЗначениеЗаполнено(Авторизация) Тогда
		Авторизация = Заголовок(Заголовки, "Authorization");
	КонецЕсли;
	Если Не СтрНачинаетсяС(НРег(Авторизация), "bearer ") Тогда
		ВызватьОшибку(401, "unauthorized", "Нужен заголовок Authorization: Bearer <токен из POST /session>");
	КонецЕсли;
	Токен = СокрЛП(Сред(Авторизация, 8));
	Сессия = ХранилищеОбщихНастроек.Загрузить("Арм_API_Сессия", Токен);
	Если ТипЗнч(Сессия) <> Тип("Структура") Или Сессия.Истекает < ТекущаяДатаСеанса() Тогда
		ВызватьОшибку(401, "unauthorized", "Сессия не найдена или истекла");
	КонецЕсли;
	УстановитьТекущегоПользователя(Сессия.Пользователь);
	Сессия.Вставить("Роль", КодРоли(Сессия.Пользователь));
	Возврат Сессия;

КонецФункции

Процедура УстановитьТекущегоПользователя(Пользователь)

	УстановитьПривилегированныйРежим(Истина);
	Если ПараметрыСеанса.ТекущийПользователь <> Пользователь Тогда
		ПараметрыСеанса.ТекущийПользователь = Пользователь;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция КодРоли(Пользователь)

	Роль = РегистрыСведений.Арм_ПраваПользователей.ПолучитьРольИнтерфейсаПользователя(Пользователь);
	Роли = Перечисления.Арм_РолиИнтерфейса;
	Если Роль = Роли.Снабжение Тогда
		Возврат "supply";
	ИначеЕсли Роль = Роли.Кладовщик Тогда
		Возврат "storekeeper";
	ИначеЕсли Роль = Роли.ГлавныйМеханик Тогда
		Возврат "chief_mechanic";
	ИначеЕсли Роль = Роли.Администратор Тогда
		Возврат "admin";
	ИначеЕсли Роль = Роли.Поставщик Тогда
		Возврат "supplier";
	ИначеЕсли Роль = Роли.Клиент Тогда
		Возврат "client";
	КонецЕсли;
	Возврат "manager";

КонецФункции

Функция ОписаниеСессии(Сессия)

	Роль = ?(Сессия.Свойство("Роль"), Сессия.Роль, КодРоли(Сессия.Пользователь));
	Возврат Новый Структура("token, userName, login, role, screen",
		Сессия.Токен, Строка(Сессия.Пользователь), Сессия.Логин, Роль, ?(Роль = "supply", "supply", "sales"));

КонецФункции

Процедура ТребоватьЭкранПродаж(Сессия)
	Если Сессия.Роль = "supply" Тогда
		ВызватьОшибку(403, "matrix_denied", "Команды продаж недоступны роли supply");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область Матрица

Функция Матрица()

	Статусы = СтрРазделить(Арм_APIМатрица.Статусы(), ",");
	Роли = СтрРазделить(Арм_APIМатрица.Роли(), ",");
	Колонки = Новый Массив;
	ПоПолю = Новый Соответствие;
	Для Каждого Строка Из СтрРазделить(Арм_APIМатрица.Колонки(), Символы.ПС, Ложь) Цикл
		Ч = СтрРазделить(СокрЛП(Строка), "|", Истина);
		Если Ч.Количество() < 7 + Роли.Количество() Тогда
			Продолжить;
		КонецЕсли;
		Маски = Новый Соответствие;
		Для Индекс = 0 По Роли.ВГраница() Цикл
			Маски.Вставить(Роли[Индекс], Ч[7 + Индекс]);
		КонецЦикла;
		Колонка = Новый Структура("Ид, Поле, Свойство, Код, Заголовок, Тип, Запись, Маски",
			Ч[0], Ч[1], Ч[2], Ч[3], Ч[4], Ч[5], Ч[6] = "1", Маски);
		Колонки.Добавить(Колонка);
		ПоПолю.Вставить(Колонка.Поле, Колонка);
	КонецЦикла;
	Возврат Новый Структура("Статусы, Роли, Колонки, ПоПолю", Статусы, Роли, Колонки, ПоПолю);

КонецФункции

Функция МаскаКолонки(Колонка, Роль, Количество)

	Маска = Колонка.Маски.Получить(Роль);
	Если Маска = Неопределено Тогда
		Маска = "";
		Для Индекс = 1 По Количество Цикл
			Маска = Маска + ".";
		КонецЦикла;
	КонецЕсли;
	Возврат Маска;

КонецФункции

Процедура МатрицаДляРоли(Ответ, Сессия, Заголовки)

	М = Матрица();
	Хеширование = Новый ХешированиеДанных(ХешФункция.CRC32);
	Хеширование.Добавить(Сессия.Роль + Арм_APIМатрица.Колонки());
	ETag = """" + Сессия.Роль + "-" + Формат(Хеширование.ХешСумма, "ЧГ=0") + """";
	Ответ.Заголовки.Вставить("ETag", ETag);
	Если Заголовок(Заголовки, "If-None-Match") = ETag Тогда
		Ответ.Код = 304;
		Возврат;
	КонецЕсли;

	Колонки = Новый Массив;
	Для Каждого К Из М.Колонки Цикл
		Колонки.Добавить(Новый Структура("id, field, code, title, dataType, writable, rights",
			К.Ид, К.Поле, К.Код, К.Заголовок, К.Тип, К.Запись, МаскаКолонки(К, Сессия.Роль, М.Статусы.Количество())));
	КонецЦикла;
	Ответ.Тело = Новый Структура("role, statuses, columns", Сессия.Роль, М.Статусы, Колонки);

