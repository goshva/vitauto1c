// Точка входа HTTP API АРМ: /<публикация>/hs/api/arm/v1/... — вся логика в общем модуле Арм_API.

Функция ЗапросGET(Запрос)
	Возврат Обработать(Запрос);
КонецФункции

Функция ЗапросPOST(Запрос)
	Возврат Обработать(Запрос);
КонецФункции

Функция ЗапросPATCH(Запрос)
	Возврат Обработать(Запрос);
КонецФункции

Функция ЗапросDELETE(Запрос)
	Возврат Обработать(Запрос);
КонецФункции

Функция Обработать(Запрос)

	Параметры = Новый Соответствие;
	Для Каждого КЗ Из Запрос.ПараметрыЗапроса Цикл
		Параметры.Вставить(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;
	Заголовки = Новый Соответствие;
	Для Каждого КЗ Из Запрос.Заголовки Цикл
		Заголовки.Вставить(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;
	Тело = "";
	Если Запрос.HTTPМетод = "POST" Или Запрос.HTTPМетод = "PATCH" Тогда
		Тело = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	КонецЕсли;

	Результат = Арм_API.ОбработатьЗапрос(Запрос.HTTPМетод, Запрос.ОтносительныйURL, Параметры, Заголовки, Тело);

	Ответ = Новый HTTPСервисОтвет(Результат.Код);
	Для Каждого КЗ Из Результат.Заголовки Цикл
		Ответ.Заголовки.Вставить(КЗ.Ключ, КЗ.Значение);
	КонецЦикла;
	Если Результат.Тело <> Неопределено Тогда
		Ответ.Заголовки.Вставить("Content-Type", ?(Результат.Код >= 400, "application/problem+json", "application/json") + "; charset=utf-8");
		Ответ.УстановитьТелоИзСтроки(Результат.Тело, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;
	Возврат Ответ;

КонецФункции
