
&НаКлиенте
Процедура КомандаОК(Команда)
	
	Результат = Новый Структура;
    Результат.Вставить("ДатаОтгрузки", ДатаОтгрузки);
    // Номер отгрузки не возвращается: только системно из РН (матрица RO).
    
    Закрыть(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаОтгрузки = ТекущаяДатаСеанса();
	
	// Ручной ввод номера отключен (v2.10): скрываем поле, если оно есть на форме.
	Попытка
		Элементы.НомерОтгрузки.Видимость = Ложь;
	Исключение
		Арм_Журнал.ЗаписатьИсключение("АС_АРМ2.ФормаВводаРеквизитовОтгрузки.ПриСозданииНаСервере", ИнформацияОбОшибке());
	КонецПопытки;
КонецПроцедуры
