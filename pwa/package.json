{
  "name": "vitauto-arm-pwa",
  "version": "0.1.0",
  "private": true,
  "description": "PWA АРМ закупок и продаж через стандартный интерфейс OData 1С (расширение АРМ_OData); операции — контракт openapi/arm-pwa.openapi.yaml",
  "type": "module",
  "scripts": {
    "api": "powershell -NoProfile -ExecutionPolicy Bypass -File ../odata/start-apache.ps1",
    "dev": "vite",
    "dev:test": "vite --mode test",
    "dev:main": "vite --mode main",
    "dev:prod": "vite --mode prod",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "vitest run -c vitest.e2e.config.js"
  },
  "dependencies": {
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.3"
  }
}
