node_modules/
.env
.env.local

# артефакты Playwright
e2e-report/
playwright-report/
test-results/

# артефакты прогонов
logs/baseline-*.json

# ОТЧЁТЫ ГЕЙТОВ — это РЕЗУЛЬТАТ этапов (доказательства приёмки), а не артефакт прогона.
# В корневом .gitignore есть правило `logs/`, и оно накрывало весь каталог: без этих
# строк восемь отчётов этапов и снимки экранов не попали бы в репозиторий вовсе.
!logs/
!logs/*.md
!logs/*.png

# временный каталог drizzle-kit
.tmp/

# РЕЗЕРВНЫЕ КОПИИ БАЗЫ — в репозиторий не попадают НИКОГДА.
#
# Дамп содержит себестоимость, цены закупки и данные клиентов: попади он в репозиторий,
# закрытые колонки (ФТ v2 п. 5) стали бы доступны любому, у кого есть доступ к коду.
# К тому же копии весят десятки мегабайт и меняются каждый раз — история репозитория
# распухла бы.
backups/
*.dump
