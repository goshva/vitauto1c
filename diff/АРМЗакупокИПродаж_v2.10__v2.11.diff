+// Арм_МатрицаПрав — ACL «роль x статус строки x колонка» по матрице прав (T-map + T01, v2.11).
+// СГЕНЕРИРОВАНО tools/generate_arm_matrix_rights.py из «column-matrix (2).json». Не править вручную.
+// Модуль чистый: не читает БД и сеанс — роль и статус строки передаёт вызывающий серверный код.
+//
+// Решения владельца (tasks/impl-plan-matrix-arm.md, принято 05.10.2026):
+//   D1  — права любой роли берутся по маскам вкладки manager (уровень order);
+//   D1b — роль не задана (нет записи в регистре прав) = запрет (fail-closed);
+//   D1c — бит creator пока игнорируется (отдельное поле «создатель строки» — позже);
+//   D1d — роль Снабжение = права storekeeper;
+//   D1e — администратор: whitelist полей без привязки к статусу, матрица ему не применяется;
+//   D2  — статус строки меняют менеджер (по полю СтатусСтроки) и администратор (в форме).
+// Статус ЗаблокированоФоном пары в матрице не имеет — правка запрещена всем.
+
+#Область ПрограммныйИнтерфейс
+
+// Текст отказа для правки поля строки либо пустая строка, если правка разрешена.
+//
+// Параметры:
+//  Роль            - ПеречислениеСсылка.Арм_РолиИнтерфейса - пустая ссылка = запрет (D1b)
+//  СтатусСтроки    - ПеречислениеСсылка.Арм_СтатусыАРМ
+//  ИмяПоляРегистра - Строка - имя поля Арм_ДанныеЗакупокИПродаж / колонки списка АРМ
+//
+// Возвращаемое значение:
+//  Строка
+Функция ОтказПоПолю(Знач Роль, Знач СтатусСтроки, Знач ИмяПоляРегистра) Экспорт
+
+	Бит = БитРоли(Роль);
+	Если Бит = 0 Тогда
+		Возврат "Для вашей учётной записи не задана роль в регистре «Права пользователей АРМ». Обратитесь к администратору.";
+	КонецЕсли;
+
+	Если СтатусСтроки = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.ЗаблокированоФоном") Тогда
+		Возврат "Строка обрабатывается фоновым заданием — правка недоступна. Повторите позже.";
+	КонецЕсли;
+
+	// D1e: администратор — whitelist полей без привязки к статусу.
+	Если Роль = ПредопределенноеЗначение("Перечисление.Арм_РолиИнтерфейса.Администратор") Тогда
+		Если СтрНайти("," + ПоляИзменяемыеАдминистратором() + ",", "," + ИмяПоляРегистра + ",") > 0 Тогда
+			Возврат "";
+		КонецЕсли;
+		Возврат ТекстОтказаПоПолю(Роль, СтатусСтроки, ИмяПоляРегистра);
+	КонецЕсли;
+
+	ИдСтатуса = МатричныйСтатусПоСтатусуАРМ(СтатусСтроки);
+	Если ПустаяСтрока(ИдСтатуса) Тогда
+		Возврат ТекстОтказаПоПолю(Роль, СтатусСтроки, ИмяПоляРегистра);
+	КонецЕсли;
+
+	ИдКолонки = КолонкаМатрицыПоПолюРегистра(ИмяПоляРегистра);
+	Если ПустаяСтрока(ИдКолонки) Тогда
+		Возврат ТекстОтказаПоПолю(Роль, СтатусСтроки, ИмяПоляРегистра);
+	КонецЕсли;
+
+	Если ПобитовоеИ(МаскаЯчейки(ИдСтатуса, ИдКолонки), Бит) = 0 Тогда
+		Возврат ТекстОтказаПоПолю(Роль, СтатусСтроки, ИмяПоляРегистра);
+	КонецЕсли;
+
+	Возврат "";
+
+КонецФункции
+
+// Можно ли роли править поле строки в данном статусе (Истина, если ОтказПоПолю вернул пустую строку).
+Функция МожноРедактироватьПоле(Знач Роль, Знач СтатусСтроки, Знач ИмяПоляРегистра) Экспорт
+
+	Возврат ПустаяСтрока(ОтказПоПолю(Роль, СтатусСтроки, ИмяПоляРегистра));
+
+КонецФункции
+
+// Поле входит в «общий ввод значения» (двойной щелчок): так правят поля без отдельного обработчика.
+Функция ПолеОбщегоВвода(Знач ИмяПоля) Экспорт
+
+	Возврат СтрНайти("," + ПоляОбщегоВвода() + ",", "," + ИмяПоля + ",") > 0;
+
+КонецФункции
+
+// Id статуса матрицы по статусу АРМ. Пустая строка — пары нет (ЗаблокированоФоном, пустая ссылка).
+Функция МатричныйСтатусПоСтатусуАРМ(Знач СтатусАРМ) Экспорт
+
+	Если СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Черновик") Тогда
+		Возврат "new";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.ВРаботе") Тогда
+		Возврат "in_work";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.ЧастичноЗаказано") Тогда
+		Возврат "partially_ordered";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Заказано") Тогда
+		Возврат "ordered";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Оплачено") Тогда
+		Возврат "paid";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.ТоварВПути") Тогда
+		Возврат "in_transit";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.ОжидаемПоступление") Тогда
+		Возврат "awaiting_receipt";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Приходуется") Тогда
+		Возврат "acceptance";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.НаСкладе") Тогда
+		Возврат "to_stock";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Резервирование") Тогда
+		Возврат "reserve";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Комплектуется") Тогда
+		Возврат "assembly";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Подготовлено") Или СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Собран") Тогда
+		Возврат "ready_to_ship";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Отгружено") Тогда
+		Возврат "shipped";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Возврат") Тогда
+		Возврат "return";
+	ИначеЕсли СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Выполнено") Или СтатусАРМ = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Завершено") Тогда
+		Возврат "closed";
+	КонецЕсли;
+
+	Возврат "";
+
+КонецФункции
+
+// Id колонки матрицы по имени поля регистра. Пустая строка — поля нет в матрице.
+Функция КолонкаМатрицыПоПолюРегистра(Знач ИмяПоляРегистра) Экспорт
+
+	Список = ";" + СписокПолейМатрицы();
+	Маркер = ";" + ИмяПоляРегистра + "=";
+	Позиция = СтрНайти(Список, Маркер);
+	Если ПустаяСтрока(ИмяПоляРегистра) Или Позиция = 0 Тогда
+		Возврат "";
+	КонецЕсли;
+	Хвост = Сред(Список, Позиция + СтрДлина(Маркер));
+	Возврат Лев(Хвост, СтрНайти(Хвост, ";") - 1);
+
+КонецФункции
+
+#КонецОбласти
+
+#Область СлужебныеПроцедурыИФункции
+
+Функция ТекстОтказаПоПолю(Знач Роль, Знач СтатусСтроки, Знач ИмяПоляРегистра)
+
+	Возврат СтрШаблон("Роль «%1» не может менять поле «%2» в статусе строки «%3» (матрица прав АРМ).",
+		Строка(Роль), ИмяПоляРегистра, Строка(СтатусСтроки));
+
+КонецФункции
+
+// Бит роли в маске ячейки (manager=1, storekeeper=2, chief_mechanic=4, admin=8, supplier=16, client=32).
+// Пустая роль — 0 (запрет).
+Функция БитРоли(Знач Роль)
+
+	Если Роль = ПредопределенноеЗначение("Перечисление.Арм_РолиИнтерфейса.Менеджер") Тогда
+		Возврат 1;
+	КонецЕсли;
+	Если Роль = ПредопределенноеЗначение("Перечисление.Арм_РолиИнтерфейса.Снабжение") Тогда
+		Возврат 2;
+	КонецЕсли;
+	Если Роль = ПредопределенноеЗначение("Перечисление.Арм_РолиИнтерфейса.Кладовщик") Тогда
+		Возврат 2;
+	КонецЕсли;
+	Если Роль = ПредопределенноеЗначение("Перечисление.Арм_РолиИнтерфейса.ГлавныйМеханик") Тогда
+		Возврат 4;
+	КонецЕсли;
+	Если Роль = ПредопределенноеЗначение("Перечисление.Арм_РолиИнтерфейса.Администратор") Тогда
+		Возврат 8;
+	КонецЕсли;
+	Если Роль = ПредопределенноеЗначение("Перечисление.Арм_РолиИнтерфейса.Поставщик") Тогда
+		Возврат 16;
+	КонецЕсли;
+	Если Роль = ПредопределенноеЗначение("Перечисление.Арм_РолиИнтерфейса.Клиент") Тогда
+		Возврат 32;
+	КонецЕсли;
+
+	Возврат 0;
+
+КонецФункции
+
+// Проверка бита: возвращает Бит, если он установлен в Маска, иначе 0 (Бит — степень двойки).
+Функция ПобитовоеИ(Знач Маска, Знач Бит)
+
+	Возврат ?(Цел(Маска / Бит) % 2 = 1, Бит, 0);
+
+КонецФункции
+
+// Маска ячейки (биты ролей) для пары «id статуса матрицы / id колонки матрицы»; 0, если ячейки нет.
+Функция МаскаЯчейки(Знач ИдСтатуса, Знач ИдКолонки)
+
+	Список = ";" + СписокМаскСтатуса(ИдСтатуса);
+	Маркер = ";" + ИдКолонки + "=";
+	Позиция = СтрНайти(Список, Маркер);
+	Если Позиция = 0 Тогда
+		Возврат 0;
+	КонецЕсли;
+	Хвост = Сред(Список, Позиция + СтрДлина(Маркер));
+	Возврат Число(Лев(Хвост, СтрНайти(Хвост, ";") - 1));
+
+КонецФункции
+
+// Поля регистра / колонки АРМ -> id колонки матрицы («Поле=колонка;»).
+Функция СписокПолейМатрицы()
+
+	Возврат "ОтметкаСтроки=cell_select;"
+		+ "Порядок=row_number;"
