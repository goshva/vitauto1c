+		+ "Коэффициент=coefficient;"
+		+ "Цена=extra_field_1;"
+		+ "Сумма=extra_field_2;"
+		+ "Поставщик=supplier;"
+		+ "ДатаПоступления=receipt_date;"
+		+ "ДатаУПД=upd_date;"
+		+ "НомерУПД=upd_number;"
+		+ "ТерриторияОтгрузкиПоставщиком=supplier_ship_territory;"
+		+ "КомментарийКСтроке=comment;";
+
+КонецФункции
+
+// Поля «общего ввода» администратора (= ПоляРедактируемыеАдминистратором() формы).
+Функция ПоляОбщегоВвода()
+
+	Возврат "ДокументПодписанОригинал,ДатаЗаказа,НомерЗаказаКлиента,Покупатель,Договор,"
+		+ "Марка,Модель,Агрегат,Госномер,VIN,Двигатель,"
+		+ "СрочностьКлиента,ГРЗКлиента,ТерриторияКлиента,НоменклатураКлиента,АртикулКлиента,КоличествоКлиента,ЕдиницаИзмеренияКлиента,"
+		+ "КоличествоНормаЧас,СебестоимостьЕдиницы,РРЦ,Оплачено,Поставщик,ТерриторияОтгрузкиПоставщиком";
+
+КонецФункции
+
+// Все поля, которые администратор вправе менять (= ПоляИзменяемыеАдминистратором() формы).
+Функция ПоляИзменяемыеАдминистратором()
+
+	Возврат ПоляОбщегоВвода() + ","
+		+ "ОтметкаСтроки,Номенклатура,Количество,Цена,Коэффициент,Партия,ВидУслуги,ФормаОплаты,"
+		+ "ДатаОтгрузки,КомментарийКСтроке";
+
+КонецФункции
+
+// T05 (D4): поля ручного ввода только по ACL, не входящие в whitelist администратора (= ПоляВводаПоACL() формы).
+Функция ПоляВводаПоACL()
+
+	Возврат "НомерШасси,КоличествоВРезерве,КоличествоВПути,ДатаУПД,НомерУПД";
+
+КонецФункции
+
+// Маски ячеек статуса матрицы («колонка=маска;»); нулевые маски опущены. Вкладка manager, уровень order.
