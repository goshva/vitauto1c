diff --git "a/C:\\Temp\\diff-cfe-empty.txt" "b/C:\\soft\\vitauto1c\\src\\АРМЗакупокИПродаж_v2.13\\CommonModule\\Арм_Журнал\\CommonModule.obj.bsl"
