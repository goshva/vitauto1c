@@ -0,0 +1,176 @@
+// Арм_Журнал — журналирование АРМ для анализа ошибок (v2.13).
+//
+// Все записи — в журнал регистрации, независимо от транзакции (откат не стирает запись):
+//   «АРМ.Ошибка»  — исключение: где, пользователь, роль АРМ, сеанс, контекст, подробное описание и стек вызовов;
+//   «АРМ.Отказ»   — отказ по правам (роль × статус × поле) и бизнес-проверкам;
+//   «АРМ.Правка»  — изменение значения поля строки (было → стало);
+//   «АРМ.Действие» — команды АРМ (например, отметка «Дата заказа поставщику»).
+// Комментарий записи — строки «Ключ: значение», первая строка — «Где: …»; разбор — tools/arm-log-report.ps1.
+// Процедуры модуля никогда не вызывают исключений: сбой журналирования не должен ломать работу АРМ.
+
+#Область ПрограммныйИнтерфейс
+
+// Исключение на сервере. Вызывать первой строкой блока «Исключение»:
+//   Арм_Журнал.ЗаписатьИсключение("Модуль.Процедура", ИнформацияОбОшибке(), Новый Структура("Поле", ИмяПоля));
+Процедура ЗаписатьИсключение(Знач Где, Знач Информация, Знач Контекст = Неопределено) Экспорт
+
+	Попытка
+		Подробно = ПодробноеПредставлениеОшибки(Информация);
+		Стек = СтекВызовов(Информация);
+	Исключение
+		Подробно = "(не удалось получить описание ошибки)";
+		Стек = "";
+	КонецПопытки;
+	ЗаписатьВЖурнал("АРМ.Ошибка", УровеньЖурналаРегистрации.Ошибка, Где, Подробно, Контекст, Стек);
+
+КонецПроцедуры
+
+// Исключение на клиенте: ИнформацияОбОшибке на сервер не передаётся, поэтому — её подробное представление.
+//   Арм_Журнал.ЗаписатьИсключениеКлиента("Форма.Команда", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
+Процедура ЗаписатьИсключениеКлиента(Знач Где, Знач ТекстОшибки, Знач Контекст = Неопределено) Экспорт
+
+	ЗаписатьВЖурнал("АРМ.Ошибка", УровеньЖурналаРегистрации.Ошибка, Где, "[клиент] " + Строка(ТекстОшибки), Контекст);
+
+КонецПроцедуры
+
+// Ошибка без исключения (проверка не прошла, документ не провёлся и т. п.).
+Процедура ЗаписатьОшибку(Знач Где, Знач Текст, Знач Контекст = Неопределено) Экспорт
+
+	ЗаписатьВЖурнал("АРМ.Ошибка", УровеньЖурналаРегистрации.Ошибка, Где, Текст, Контекст);
+
+КонецПроцедуры
+
+// Отказ по правам или бизнес-правилу — для анализа «кто что пытался сделать».
+Процедура ЗаписатьОтказ(Знач Где, Знач Текст, Знач Контекст = Неопределено) Экспорт
+
+	ЗаписатьВЖурнал("АРМ.Отказ", УровеньЖурналаРегистрации.Предупреждение, Где, Текст, Контекст);
+
+КонецПроцедуры
+
+// Изменение значения поля строки АРМ.
+Процедура ЗаписатьПравку(Знач Где, Знач ИдентификаторЗаписи, Знач ИмяПоля, Знач Было, Знач Стало, Знач Контекст = Неопределено) Экспорт
+
+	Если Контекст = Неопределено Тогда
+		Контекст = Новый Структура;
+	КонецЕсли;
+	Попытка
+		Контекст.Вставить("Строка", Строка(ИдентификаторЗаписи));
+		Контекст.Вставить("Поле", ИмяПоля);
+	Исключение
+		Возврат;
+	КонецПопытки;
+	ЗаписатьВЖурнал("АРМ.Правка", УровеньЖурналаРегистрации.Информация, Где,
+		СтрШаблон("%1: «%2» → «%3»", ИмяПоля, ПредставлениеЗначения(Было), ПредставлениеЗначения(Стало)), Контекст);
+
+КонецПроцедуры
+
+// Действие пользователя (команда АРМ) с результатом.
+Процедура ЗаписатьДействие(Знач Где, Знач Текст, Знач Контекст = Неопределено) Экспорт
+
+	ЗаписатьВЖурнал("АРМ.Действие", УровеньЖурналаРегистрации.Информация, Где, Текст, Контекст);
+
+КонецПроцедуры
+
+#КонецОбласти
+
+#Область СлужебныеПроцедурыИФункции
+
+Процедура ЗаписатьВЖурнал(Знач Событие, Знач Уровень, Знач Где, Знач Текст, Знач Контекст, Знач Стек = "")
+
+	Попытка
+		Строки = Новый Массив;
+		Строки.Добавить("Где: " + Строка(Где));
+		Строки.Добавить("Пользователь: " + ПредставлениеПользователя());
+		Если Контекст <> Неопределено Тогда
+			Строки.Добавить("Контекст: " + ТекстКонтекста(Контекст));
+		КонецЕсли;
+		Строки.Добавить("Описание: " + Строка(Текст));
+		Если ЗначениеЗаполнено(Стек) Тогда
+			Строки.Добавить("Стек:" + Символы.ПС + Стек);
+		КонецЕсли;
+		ЗаписьЖурналаРегистрации(Событие, Уровень, , , СтрСоединить(Строки, Символы.ПС),
+			РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
+	Исключение
+		// журналирование не должно ломать работу АРМ
+	КонецПопытки;
+
+КонецПроцедуры
+
+Функция ПредставлениеПользователя()
+
+	Части = Новый Массив;
+	Попытка
+		Пользователь = ПараметрыСеанса.ТекущийПользователь;
+		Части.Добавить(Строка(Пользователь));
+		Роль = РегистрыСведений.Арм_ПраваПользователей.ПолучитьРольИнтерфейсаСтрого(Пользователь);
+		Части.Добавить("роль АРМ «" + ?(ЗначениеЗаполнено(Роль), Строка(Роль), "не задана") + "»");
+	Исключение
+		Части.Добавить("(текущий пользователь не определён)");
+	КонецПопытки;
+	Попытка
+		Части.Добавить("ИБ «" + ИмяПользователя() + "»");
+		Части.Добавить("сеанс " + Формат(НомерСеансаИнформационнойБазы(), "ЧГ=0"));
+	Исключение
+		// не критично
+	КонецПопытки;
+	Возврат СтрСоединить(Части, ", ");
+
+КонецФункции
+
+// Стек вызовов по цепочке ИнформацияОбОшибке.Причина: модуль, строка, исходный текст строки.
+Функция СтекВызовов(Знач Информация)
+
+	Строки = Новый Массив;
+	Уровень = Информация;
+	Глубина = 0;
+	Пока Уровень <> Неопределено И Глубина < 20 Цикл
+		Если ЗначениеЗаполнено(Уровень.ИмяМодуля) Тогда
+			Строки.Добавить(СтрШаблон("  %1(%2): %3", Уровень.ИмяМодуля, Уровень.НомерСтроки, СокрЛП(Уровень.ИсходнаяСтрока)));
+		КонецЕсли;
+		Уровень = Уровень.Причина;
+		Глубина = Глубина + 1;
+	КонецЦикла;
+	Возврат СтрСоединить(Строки, Символы.ПС);
+
+КонецФункции
+
+Функция ТекстКонтекста(Знач Контекст)
+
+	Если ТипЗнч(Контекст) = Тип("Структура") Или ТипЗнч(Контекст) = Тип("Соответствие")
+		Или ТипЗнч(Контекст) = Тип("ФиксированнаяСтруктура") Тогда
+		Части = Новый Массив;
+		Для Каждого КЗ Из Контекст Цикл
+			Части.Добавить(Строка(КЗ.Ключ) + "=" + ПредставлениеЗначения(КЗ.Значение));
+		КонецЦикла;
+		Возврат СтрСоединить(Части, "; ");
+	КонецЕсли;
+	Возврат ПредставлениеЗначения(Контекст);
+
+КонецФункции
+
+Функция ПредставлениеЗначения(Знач Значение)
+
+	Попытка
+		Если Значение = Неопределено Тогда
+			Текст = "Неопределено";
+		ИначеЕсли ТипЗнч(Значение) = Тип("Массив") Тогда
+			Части = Новый Массив;
+			Для Каждого Элемент Из Значение Цикл
+				Части.Добавить(Строка(Элемент));
+				Если Части.Количество() >= 20 Тогда
+					Части.Добавить("… всего " + Формат(Значение.Количество(), "ЧГ=0"));
+					Прервать;
+				КонецЕсли;
+			КонецЦикла;
+			Текст = "[" + СтрСоединить(Части, ", ") + "]";
+		Иначе
+			Текст = Строка(Значение);
+		КонецЕсли;
+	Исключение
+		Текст = "(" + Строка(ТипЗнч(Значение)) + ")";
+	КонецПопытки;
+	Возврат ?(СтрДлина(Текст) > 300, Лев(Текст, 300) + "…", Текст);
+
+КонецФункции
+
+#КонецОбласти

