+// v2.10 (MVP): переходы статусов строк продаж Резервирование / ОжидаемПоступление / Возврат.
+// Только администратор АРМ; матрица ролей x статусов не реализуется.
+// Кнопки добавляются программно в группу ГруппаРаботаСоСтатусами (Form.elem.json не меняется).
+&НаСервере
+Процедура НастроитьКомандыСтатусовАдминистратора()
+
+	Если Не ЭтоАдминистраторАРМ() Тогда
+		Возврат;
+	КонецЕсли;
+
+	Группа = Элементы.Найти("ГруппаРаботаСоСтатусами");
+	Если Группа = Неопределено Тогда
+		Возврат;
+	КонецЕсли;
+
+	// Соответствие не подходит (порядок кнопок), "Возврат" - ключевое слово, поэтому массив пар.
+	Статусы = Новый Массив;
+	Статусы.Добавить(Новый Структура("Имя, Заголовок", "Резервирование", "Статус: резервирование"));
+	Статусы.Добавить(Новый Структура("Имя, Заголовок", "ОжидаемПоступление", "Статус: ожидаем поступление"));
+	Статусы.Добавить(Новый Структура("Имя, Заголовок", "Возврат", "Статус: возврат"));
+
+	Для Каждого Статус Из Статусы Цикл
+		ИмяКоманды = "УстановитьСтатус" + Статус.Имя;
+		Команда = Команды.Добавить(ИмяКоманды);
+		Команда.Действие = ИмяКоманды;
+		Команда.Заголовок = Статус.Заголовок;
+		Команда.Подсказка = "Администратор: установить статус отмеченных строк продаж (или текущей строки)";
+		
+		Кнопка = Элементы.Добавить("Кнопка" + ИмяКоманды, Тип("КнопкаФормы"), Группа);
+		Кнопка.Вид = ВидКнопкиФормы.ОбычнаяКнопка;
+		Кнопка.ИмяКоманды = ИмяКоманды;
+		Кнопка.Заголовок = Статус.Заголовок;
+	КонецЦикла;
+
+КонецПроцедуры
+
+&НаКлиенте
+Процедура УстановитьСтатусРезервирование(Команда)
+	УстановитьСтатусСтрокАдминистратором("Резервирование");
+КонецПроцедуры
+
+&НаКлиенте
+Процедура УстановитьСтатусОжидаемПоступление(Команда)
+	УстановитьСтатусСтрокАдминистратором("ОжидаемПоступление");
+КонецПроцедуры
+
+&НаКлиенте
+Процедура УстановитьСтатусВозврат(Команда)
+	УстановитьСтатусСтрокАдминистратором("Возврат");
+КонецПроцедуры
+
+&НаКлиенте
+Процедура УстановитьСтатусСтрокАдминистратором(Знач ИмяСтатуса)
+
+	Если РежимАдминистратораАРМ <> Истина Тогда
+		ПоказатьПредупреждение(, "Смена статуса доступна только администратору АРМ.");
+		Возврат;
+	КонецЕсли;
+
+	ИдентификаторТекущей = Неопределено;
+	ТекущиеДанные = Элементы.ДанныеАРМОтображение.ТекущиеДанные;
+	Если ТекущиеДанные <> Неопределено И ТекущиеДанные.Свойство("ИдентификаторЗаписи") Тогда
+		ИдентификаторТекущей = ТекущиеДанные.ИдентификаторЗаписи;
+	КонецЕсли;
+
+	Результат = УстановитьСтатусСтрокАдминистраторомНаСервере(ИмяСтатуса, ИдентификаторТекущей);
+	Если ЗначениеЗаполнено(Результат.Ошибка) Тогда
+		ПоказатьПредупреждение(, Результат.Ошибка);
+	ИначеЕсли Результат.Изменено = 0 Тогда
+		ПоказатьПредупреждение(, "Нет строк продаж для смены статуса: отметьте строки или выберите текущую.");
+	КонецЕсли;
+	ОбновитьСписокПоТаймеру();
+
+КонецПроцедуры
+
+// Ставит статус у отмеченных текущим пользователем строк продаж; если отметок нет - у текущей строки.
+// Строки в работе фоновой обработки (ЗаблокированоФоном) и удаленные пропускаются.
+&НаСервереБезКонтекста
+Функция УстановитьСтатусСтрокАдминистраторомНаСервере(Знач ИмяСтатуса, Знач ИдентификаторТекущей)
+
+	Результат = Новый Структура("Изменено, Ошибка", 0, "");
+
+	Если Не ЭтоАдминистраторАРМ() Тогда
+		Результат.Ошибка = "Смена статуса доступна только администратору АРМ.";
+		Возврат Результат;
+	КонецЕсли;
+
+	Если ИмяСтатуса = "Резервирование" Тогда
+		НовыйСтатус = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Резервирование");
+	ИначеЕсли ИмяСтатуса = "ОжидаемПоступление" Тогда
+		НовыйСтатус = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.ОжидаемПоступление");
+	ИначеЕсли ИмяСтатуса = "Возврат" Тогда
+		// "Возврат" - ключевое слово BSL, поэтому значение берется через строку.
+		НовыйСтатус = ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Возврат");
+	Иначе
+		Результат.Ошибка = СтрШаблон("Статус ""%1"" не поддерживается.", ИмяСтатуса);
+		Возврат Результат;
+	КонецЕсли;
+
+	Запрос = Новый Запрос;
+	Запрос.Текст =
+		"ВЫБРАТЬ
+		|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи
+		|ИЗ
+		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
+		|ГДЕ
+		|	Т.ОтметкаСтроки
+		|	И Т.АвторСтроки = &АвторСтроки
+		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
+		|	И НЕ Т.Удаление";
+	Запрос.УстановитьПараметр("АвторСтроки", ПараметрыСеанса.ТекущийПользователь);
+	Идентификаторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторЗаписи");
+
+	Если Идентификаторы.Количество() = 0 И ЗначениеЗаполнено(ИдентификаторТекущей) Тогда
+		Идентификаторы.Добавить(ИдентификаторТекущей);
+	КонецЕсли;
+
+	Для Каждого Идентификатор Из Идентификаторы Цикл
+		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
+		Набор.Отбор.ИдентификаторЗаписи.Установить(Идентификатор);
+		Набор.Прочитать();
+		Если Набор.Количество() = 0 Тогда
+			Продолжить;
+		КонецЕсли;
+
+		Запись = Набор[0];
+		Если Запись.Удаление
+			Или Запись.ВидОперации <> Перечисления.Арм_ВидыОпераций.Продажа
+			Или Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном Тогда
+			Продолжить;
+		КонецЕсли;
+
+		Запись.СтатусСтроки = НовыйСтатус;
+		Запись.ОтметкаСтроки = Ложь;
+		Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
+
+		Попытка
+			Набор.Записать();
+			Результат.Изменено = Результат.Изменено + 1;
+		Исключение
+			ЗаписьЖурналаРегистрации("АРМ.ОшибкаСменыСтатуса", УровеньЖурналаРегистрации.Ошибка,,,
+				СтрШаблон("Строка %1, статус %2: %3", Строка(Идентификатор), ИмяСтатуса,
+					ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
+			Результат.Ошибка = "Часть строк не удалось сохранить: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
+		КонецПопытки;
+	КонецЦикла;
+
+	Возврат Результат;
+
+КонецФункции
+
