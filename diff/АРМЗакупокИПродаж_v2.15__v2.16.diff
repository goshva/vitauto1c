@@ -1403,6 +1403,30 @@
 
 КонецПроцедуры
 
+// Ставка НДС строки документа — как в типовом заполнении УНФ: по виду ставки номенклатуры,
+// иначе по виду ставки организации по умолчанию, иначе СтавкаПоУмолчанию (НайтиСтавкуНДС).
+// Ставка на дату берётся из конфигурации (Справочники.СтавкиНДС.СтавкаНДС), а не из кода АРМ (v2.16).
+Функция СтавкаНДСНоменклатуры(Номенклатура, Организация, Период, СтавкаПоУмолчанию = Неопределено) Экспорт
+
+	ВидСтавки = Неопределено;
+	Если ЗначениеЗаполнено(Номенклатура) Тогда
+		ВидСтавки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ВидСтавкиНДС");
+	КонецЕсли;
+	Если Не ЗначениеЗаполнено(ВидСтавки) И ЗначениеЗаполнено(Организация) Тогда
+		ВидСтавки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВидСтавкиНДСПоУмолчанию");
+	КонецЕсли;
+
+	Если ЗначениеЗаполнено(ВидСтавки) Тогда
+		Ставка = Справочники.СтавкиНДС.СтавкаНДС(ВидСтавки, ?(ЗначениеЗаполнено(Период), Период, ТекущаяДатаСеанса()));
+		Если ЗначениеЗаполнено(Ставка) Тогда
+			Возврат Ставка;
+		КонецЕсли;
+	КонецЕсли;
+
+	Возврат ?(СтавкаПоУмолчанию = Неопределено, НайтиСтавкуНДС(), СтавкаПоУмолчанию);
+
+КонецФункции
+
 Функция НайтиСтавкуНДС() Экспорт
 
 	Запрос = Новый Запрос;

