+&НаКлиенте
+Процедура ПослеВводаЗначенияАдминистратором(Результат, ДопПараметры) Экспорт
+
+	Если Результат = Неопределено Тогда
+		Возврат;
+	КонецЕсли;
+
+	ТекстОшибки = ЗаписатьПолеСтрокиАРМ(ДопПараметры.ИдентификаторЗаписи, ДопПараметры.ИмяПоля, Результат);
+	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
+		ПоказатьПредупреждение(, ТекстОшибки);
+		Возврат;
+	КонецЕсли;
+	ОбновитьСписокПоТаймеру();
