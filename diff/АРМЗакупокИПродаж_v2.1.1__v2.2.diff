+		Исключение
+			ЗаписьЖурналаРегистрации("АРМ.СхлопываениеСтрокПартий", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки(), РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
+
+
+
+
+
+
+
+			ВызватьИсключение "Ошибка записи строк АРМ регистра при схлопывании строк партий";
+		КонецПопытки;
+
+	КонецЦикла;
+
+КонецПроцедуры
+
+
+Процедура УправлятьСтрокойЗакупки(ДанныеПродажи, НужноеКоличество, РучнаяПравка = Ложь)
+
+	ЧистаяПотребность = НужноеКоличество;
+
+	Если Не РучнаяПравка Тогда
+
+		ЗапросРучных = Новый Запрос;
+		ЗапросРучных.Текст = "ВЫБРАТЬ
+		|	ЕСТЬNULL(СУММА(Т.Количество), 0) КАК РучноеКоличество
+		|ИЗ
+		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
+		|ГДЕ
+		|	Т.Номенклатура = &Номенклатура
+		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
+		|	И Т.РучнаяПравка = ИСТИНА
+		|	И НЕ Т.Удаление
+		|	И Т.ДокументЗаказПокупателя = &ТекущийЗаказ
+		|	И Т.КлючСвязиСтрок = &КлючСвязиСтрок";
+
+
+		ЗапросРучных.УстановитьПараметр("Номенклатура", ДанныеПродажи.Номенклатура);
+
+		ЗапросРучных.УстановитьПараметр("ТекущийЗаказ", ДанныеПродажи.ДокументЗаказПокупателя);
+		ЗапросРучных.УстановитьПараметр("КлючСвязиСтрок", ДанныеПродажи.КлючСвязиСтрок);
+
+		ВыборкаРучных = ЗапросРучных.Выполнить().Выбрать();
+		Если ВыборкаРучных.Следующий() Тогда
+
+			ЧистаяПотребность = ЧистаяПотребность - ВыборкаРучных.РучноеКоличество;
+		КонецЕсли;
+
+	КонецЕсли;
+
+
+	Если ЧистаяПотребность <= 0 Тогда
+		Возврат;
+	КонецЕсли;
+
+
+
+	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
+
+
+	Набор.Отбор.КлючСвязиСтрок.Установить(ДанныеПродажи.КлючСвязиСтрок);
+	Набор.Отбор.ВидОперации.Установить(Перечисления.Арм_ВидыОпераций.Закупка);
+	Набор.Отбор.РучнаяПравка.Установить(РучнаяПравка);
+	Набор.Прочитать();
+
+	Если Набор.Количество() = 0 Тогда
+		Запись = Набор.Добавить();
+		ЗаполнитьЗначенияСвойств(Запись, ДанныеПродажи);
+		Запись.Договор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
+		Запись.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
+		Запись.КлючСвязиСтрок = ДанныеПродажи.КлючСвязиСтрок;
+		Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка;
+		Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик;
+	Иначе
+		Запись = Набор[0];
+	КонецЕсли;
+
+	Приоритет = ПолучитьПриоритет(ДанныеПродажи.Номенклатура);
+
+
+	Запись.Количество = ЧистаяПотребность;
+	Запись.Порядок = Приоритет + 0.1;
+	Запись.Цена = 0;
+
+	Попытка
+		Набор.Записать();
+	Исключение
+		ЗаписьЖурналаРегистрации("АРМ.ОбновлениеСтрокЗакупок", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки(), РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
+
+
+
+
+
+
+		ВызватьИсключение "Ошибка при создании строк закупок";
+	КонецПопытки;
+
+КонецПроцедуры
+
+Процедура УдалитьСтрокуЗакупки(КлючСвязи, ВидОперацииЗакупка, РучнаяПравка = Ложь) Экспорт
+	Перем Набор;
+
+	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
+
+	Набор.Отбор.КлючСвязиСтрок.Установить(КлючСвязи);
+	Набор.Отбор.ВидОперации.Установить(ВидОперацииЗакупка);
+	Набор.Отбор.РучнаяПравка.Установить(РучнаяПравка);
+
+
+	Попытка
+		Набор.Записать();
+	Исключение
+		ЗаписьЖурналаРегистрации("АРМ.Удаление", УровеньЖурналаРегистрации.Ошибка, , , ОписаниеОшибки());
+	КонецПопытки;
+
+КонецПроцедуры
+
+
+Функция ПолучитьПриоритет(Номенклатура) Экспорт
+
+	ЗапросПриоритета = Новый Запрос;
+	ЗапросПриоритета.Текст = "ВЫБРАТЬ
+	|	МАКСИМУМ(ЕСТЬNULL(Арм_ДанныеЗакупокИПродаж.Порядок, 0)) КАК МаксимальныйПорядок
+	|ИЗ
+	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
+	|ГДЕ
+	|	Арм_ДанныеЗакупокИПродаж.Номенклатура = &Номенклатура";
+
+	ЗапросПриоритета.УстановитьПараметр("Номенклатура", Номенклатура);
+	Результат = ЗапросПриоритета.Выполнить().Выбрать();
+
+	НовыйПриоритет = 0;
+	Если Результат.Следующий() И Результат.МаксимальныйПорядок <> Null Тогда
+		НовыйПриоритет = Результат.МаксимальныйПорядок + 1;
+	Иначе
+		НовыйПриоритет = 1000;
+	КонецЕсли;
+
+	Возврат НовыйПриоритет;
+
+КонецФункции
+
+
+Процедура ЗаписатьСтрокуАРМ(ИдентификаторЗаписи, ПартияЗначение, КоличествоЗначение, СамаяРанняяПартия = 1)
+
+	Себестоимость = 0;
+	Поставщик = Справочники.Контрагенты.ПустаяСсылка();
+	Если ЗначениеЗаполнено(ПартияЗначение) Тогда
+		ЗапросЦены = Новый Запрос;
+		ЗапросЦены.Текст = "ВЫБРАТЬ
+		|	ВЫБОР
+		|		КОГДА ЗапасыОстатки.КоличествоОстаток <> 0
+		|			ТОГДА ЗапасыОстатки.СуммаОстаток / ЗапасыОстатки.КоличествоОстаток
+		|		ИНАЧЕ 0
+		|	КОНЕЦ КАК Цена,
+		|	ПартииНоменклатуры.ВладелецПартии КАК Поставщик
+		|ИЗ
+		|	РегистрНакопления.Запасы.Остатки(, Партия = &Партия) КАК ЗапасыОстатки
+		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПартииНоменклатуры КАК ПартииНоменклатуры
+		|		ПО ЗапасыОстатки.Партия = ПартииНоменклатуры.Ссылка";
+
+
+		ЗапросЦены.УстановитьПараметр("Партия", ПартияЗначение);
+		ВыборкаЦены = ЗапросЦены.Выполнить().Выбрать();
+
+		Если ВыборкаЦены.Следующий() Тогда
+			Себестоимость = ВыборкаЦены.Цена;
+			Поставщик = ВыборкаЦены.Поставщик;
+		КонецЕсли;
+	КонецЕсли;
+
+	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
+	Набор.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
+	Набор.Прочитать();
+
+	Если Набор.Количество() > 0 Тогда
+
+		Попытка
+			Запись = Набор[0];
+			Запись.Партия = ?(ПартияЗначение = Неопределено, Справочники.ПартииНоменклатуры.ПустаяСсылка(), ПартияЗначение);
+			Запись.Поставщик = Поставщик;
+			Запись.Себестоимость = Себестоимость;
+			Запись.Количество = ?(СамаяРанняяПартия, КоличествоЗначение, КоличествоЗначение / СамаяРанняяПартия);
+
+			Набор.Записать();
+		Исключение
+			Набор.Очистить();
+			Набор.Записать();
+			ЗаписьЖурналаРегистрации("АРМ.ОбновлениеСтроки", УровеньЖурналаРегистрации.Ошибка);
+		КонецПопытки;
+
+	КонецЕсли;
+
+КонецПроцедуры
+
+
+Процедура СоздатьНовуюСтрокуПродажи(ДанныеСтроки, ПартияЗначение, КоличествоЗначение, СамаяРанняяПартия = 1)
+
+	Себестоимость = 0;
+	Поставщик = Справочники.Контрагенты.ПустаяСсылка();
+	Если ЗначениеЗаполнено(ПартияЗначение) Тогда
+		ЗапросЦены = Новый Запрос;
+		ЗапросЦены.Текст = "ВЫБРАТЬ
+		|	ВЫБОР
+		|		КОГДА ЗапасыОстатки.КоличествоОстаток <> 0
+		|			ТОГДА ЗапасыОстатки.СуммаОстаток / ЗапасыОстатки.КоличествоОстаток
+		|		ИНАЧЕ 0
+		|	КОНЕЦ КАК Цена,
+		|	ПартииНоменклатуры.ВладелецПартии КАК Поставщик
+		|ИЗ
+		|	РегистрНакопления.Запасы.Остатки(, Партия = &Партия) КАК ЗапасыОстатки
+		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПартииНоменклатуры КАК ПартииНоменклатуры
+		|		ПО ЗапасыОстатки.Партия = ПартииНоменклатуры.Ссылка";
+
+
+		ЗапросЦены.УстановитьПараметр("Партия", ПартияЗначение);
+		ВыборкаЦены = ЗапросЦены.Выполнить().Выбрать();
+
+		Если ВыборкаЦены.Следующий() Тогда
+			Себестоимость = ВыборкаЦены.Цена;
+			Поставщик = ВыборкаЦены.Поставщик;
+		КонецЕсли;
+	КонецЕсли;
+
+	НовыйПриоритет = Арм_ОбщегоНазначенияАРМ.ПолучитьПриоритет(ДанныеСтроки.Номенклатура);
+
+	Попытка
+		Менеджер = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьМенеджерЗаписи();
+		ЗаполнитьЗначенияСвойств(Менеджер, ДанныеСтроки);
+		Менеджер.ИдентификаторЗаписи = Строка(Новый УникальныйИдентификатор);
+		Менеджер.Поставщик = Поставщик;
+		Менеджер.Себестоимость = Себестоимость;
+		Менеджер.Цена = 0;
+
+		Менеджер.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа;
+		Менеджер.Партия = ?(ПартияЗначение = Неопределено, Справочники.ПартииНоменклатуры.ПустаяСсылка(), ПартияЗначение);
+		Менеджер.Количество = ?(СамаяРанняяПартия, КоличествоЗначение, КоличествоЗначение / СамаяРанняяПартия);
+		Менеджер.Порядок = НовыйПриоритет + 0.01;
+		Менеджер.Записать();
+	Исключение
+		ЗаписьЖурналаРегистрации("АРМ.СозданиеСтрокиПартии", УровеньЖурналаРегистрации.Ошибка);
+	КонецПопытки;
+
+КонецПроцедуры
+
+Функция НайтиДоговор(Контрагент) Экспорт
+	Перем ДоговорКонтрагента;
+
+	ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
+
+	Если ЗначениеЗаполнено(Контрагент) Тогда
+
+		Запрос = Новый Запрос;
+		Запрос.Текст = "ВЫБРАТЬ
+		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
+		|ИЗ
+		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
+		|ГДЕ
+		|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
+		|	И ДоговорыКонтрагентов.Владелец.Ссылка = &Ссылка
+		|	И НЕ ДоговорыКонтрагентов.Владелец.Недействителен
+		|	И ДоговорыКонтрагентов.ДатаДоговора <= &ТекущаяДата
+		|	И ДоговорыКонтрагентов.СрокДействия >= &ТекущаяДата
+		|
+		|ОБЪЕДИНИТЬ ВСЕ
+		|
+		|ВЫБРАТЬ
+		|	ДоговорыКонтрагентов.Ссылка
+		|ИЗ
+		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
+		|ГДЕ
+		|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
+		|	И ДоговорыКонтрагентов.Владелец.Ссылка = &Ссылка
+		|	И НЕ ДоговорыКонтрагентов.Владелец.Недействителен
+		|	И ДоговорыКонтрагентов.СрокДействия = ДАТАВРЕМЯ(1, 1, 1)";
+
+
+		Запрос.УстановитьПараметр("Ссылка", Контрагент);
+		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
+		РезультатЗапроса = Запрос.Выполнить();
+		ВыборкаДоговор = РезультатЗапроса.Выбрать();
+
+		Если ВыборкаДоговор.Следующий() Тогда
+			ДоговорКонтрагента = ВыборкаДоговор.Ссылка;
+		КонецЕсли;
+
+	КонецЕсли;
+
+	Возврат ДоговорКонтрагента;
+
+КонецФункции
+
+Функция ПолучитьМассивОтмеченныхКлючейСвязи(Знач МассивВалидныхСтатусов = Неопределено) Экспорт
+	Перем ЕстьФильтрСтатусов;
+
+	ЕстьФильтрСтатусов = МассивВалидныхСтатусов <> Неопределено И МассивВалидныхСтатусов.Количество() > 0;
+	ВалидныеСтатусы = ?(ЕстьФильтрСтатусов, МассивВалидныхСтатусов, Новый Массив);
+
+	МассивКлючей = Новый Массив;
+
+	Запрос = Новый Запрос;
+	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
+	|	Т.КлючСвязиСтрок КАК КлючСвязиСтрок
+	|ИЗ
+	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
+	|ГДЕ
+	|	НЕ Т.Удаление
+	|	И Т.ОтметкаСтроки = ИСТИНА
+	|	И Т.АвторСтроки = &Автор
+	|	И НЕ &ЕстьФильтрСтатусов
+	|
+	|ОБЪЕДИНИТЬ ВСЕ
+	|
+	|ВЫБРАТЬ РАЗЛИЧНЫЕ
+	|	Т.КлючСвязиСтрок
+	|ИЗ
+	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
+	|ГДЕ
+	|	НЕ Т.Удаление
+	|	И Т.ОтметкаСтроки = ИСТИНА
+	|	И Т.АвторСтроки = &Автор
+	|	И &ЕстьФильтрСтатусов
+	|	И Т.СтатусСтроки В(&ВалидныеСтатусы)";
+
+
+	Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);
+	Запрос.УстановитьПараметр("ЕстьФильтрСтатусов", ЕстьФильтрСтатусов);
+	Запрос.УстановитьПараметр("ВалидныеСтатусы", ВалидныеСтатусы);
+
+	Результат = Запрос.Выполнить();
+
+	Если Не Результат.Пустой() Тогда
+		МассивКлючей = Результат.Выгрузить().ВыгрузитьКолонку("КлючСвязиСтрок");
+	КонецЕсли;
+
+	Возврат МассивКлючей;
+
+КонецФункции
+
+
+Функция ПолучитьМассивОтмеченныхИдентификаторов(ВидОперации) Экспорт
+
+	Запрос = Новый Запрос;
+	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
+	|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи
+	|ИЗ
+	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
+	|ГДЕ
+	|	НЕ Т.Удаление
+	|	И Т.ВидОперации = &ВидОперации
+	|	И Т.ОтметкаСтроки = ИСТИНА
+	|	И Т.АвторСтроки = &Автор";
+
+
+	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
+	Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);
+
+	Результат = Запрос.Выполнить();
+
+	Если Не Результат.Пустой() Тогда
+		МассивИдентификаторов = Результат.Выгрузить().ВыгрузитьКолонку("ИдентификаторЗаписи");
+	КонецЕсли;
+
+	Возврат МассивИдентификаторов;
+
+КонецФункции
+
+
+
+Функция ПроверитьНеобходимостьСплитаНаСервере_ТЗ_Часть2() Экспорт
+
+	ТЗ_Результаты = Новый ТаблицаЗначений;
+	ТЗ_Результаты.Колонки.Добавить("ДокументЗаказПокупателя");
+	ТЗ_Результаты.Колонки.Добавить("ТребуетсяРазделение", Новый ОписаниеТипов("Булево"));
+	ТЗ_Результаты.Колонки.Добавить("КолВоВыбранных", Новый ОписаниеТипов("Число"));
+	ТЗ_Результаты.Колонки.Добавить("ОбщееКолВо", Новый ОписаниеТипов("Число"));
+
+	Запрос = Новый Запрос;
+	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
+	|	Внутр.ДокументЗаказПокупателя КАК Заказ
+	|ПОМЕСТИТЬ втЗадействованныеЗаказы
+	|ИЗ
+	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Внутр
+	|ГДЕ
+	|	Внутр.ОтметкаСтроки = ИСТИНА
+	|	И НЕ Внутр.Удаление
+	|;
+	|
+	|////////////////////////////////////////////////////////////////////////////////
+	|ВЫБРАТЬ
+	|	Т.ДокументЗаказПокупателя КАК ДокументЗаказПокупателя,
+	|	СУММА(Т.Количество) КАК ВсегоШтукВЗаказе,
+	|	СУММА(ВЫБОР
+	|			КОГДА Т.ОтметкаСтроки = ИСТИНА
+	|				ТОГДА Т.Количество
+	|			ИНАЧЕ 0
+	|		КОНЕЦ) КАК ОтмеченоШтукНаЭкране,
+	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
+	|			КОГДА Т.ОтметкаСтроки = ИСТИНА
+	|				ТОГДА Т.ИдентификаторЗаписи
+	|		КОНЕЦ) КАК КолВоВыбранных
+	|ИЗ
+	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
+	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗадействованныеЗаказы КАК ВТ_Заказы
+	|		ПО Т.ДокументЗаказПокупателя = ВТ_Заказы.Заказ
+	|ГДЕ
+	|	НЕ Т.Удаление
+	|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
+	|
+	|СГРУППИРОВАТЬ ПО
+	|	Т.ДокументЗаказПокупателя";
+
+
+	Выборка = Запрос.Выполнить().Выбрать();
+
+	Пока Выборка.Следующий() Цикл
+
+		ВсегоШтукВЗаказе = ?(Выборка.ВсегоШтукВЗаказе = Null, 0, Выборка.ВсегоШтукВЗаказе);
+		ОтмеченоШтукНаЭкране = ?(Выборка.ОтмеченоШтукНаЭкране = Null, 0, Выборка.ОтмеченоШтукНаЭкране);
+
+		СплитДляТекущегоЗаказа = ВсегоШтукВЗаказе > ОтмеченоШтукНаЭкране И ОтмеченоШтукНаЭкране > 0;
+
+		НоваяСтрока = ТЗ_Результаты.Добавить();
+		НоваяСтрока.ДокументЗаказПокупателя = Выборка.ДокументЗаказПокупателя;
+		НоваяСтрока.ТребуетсяРазделение = СплитДляТекущегоЗаказа;
+		НоваяСтрока.КолВоВыбранных = Выборка.КолВоВыбранных;
+		НоваяСтрока.ОбщееКолВо = ВсегоШтукВЗаказе;
+
+	КонецЦикла;
+
+	Возврат ТЗ_Результаты;
+
+КонецФункции
+
+
+Функция ПроверитьНеобходимостьСплитаНаСервере() Экспорт
+
+	СтатусыДляМенеджера = Новый Массив;
+	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.ВРаботе"));
+	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Черновик"));
+	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Собран"));
+	МассивКлючей = ПолучитьМассивОтмеченныхКлючейСвязи(СтатусыДляМенеджера);
+
+	ТЗ_Ключи = Новый ТаблицаЗначений;
+	КвалификаторыСтроки = Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная);
+	МассивТиповСтроки = Новый Массив;
+	МассивТиповСтроки.Добавить(Тип("Строка"));
+	ОписаниеТипаСтрока = Новый ОписаниеТипов(МассивТиповСтроки, Неопределено, КвалификаторыСтроки);
+
+	ТЗ_Ключи.Колонки.Добавить("КлючСвязиСтрок", ОписаниеТипаСтрока);
+
+	Для каждого Ключ Из МассивКлючей Цикл
+		ТЗ_Ключи.Добавить().КлючСвязиСтрок = Ключ;
+	КонецЦикла;
+
+	Запрос = Новый Запрос;
+	МенеджерВТ = Новый МенеджерВременныхТаблиц;
+	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;
+
+	Запрос.Текст = "ВЫБРАТЬ
+	|	Т.КлючСвязиСтрок КАК КлючСвязи
+	|ПОМЕСТИТЬ втОтмеченныеКлючи
+	|ИЗ
+	|	&МассивКлючей КАК Т
+	|;
+	|
+	|////////////////////////////////////////////////////////////////////////////////
+	|ВЫБРАТЬ РАЗЛИЧНЫЕ
+	|	Рег.ДокументЗаказПокупателя КАК Заказ
+	|ПОМЕСТИТЬ втЗадействованныеЗаказы
+	|ИЗ
+	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
+	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОтмеченныеКлючи КАК вт
+	|		ПО Рег.КлючСвязиСтрок = вт.КлючСвязи
+	|ГДЕ
+	|	НЕ Рег.Удаление
+	|;
+	|
+	|////////////////////////////////////////////////////////////////////////////////
+	|ВЫБРАТЬ
+	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Рег.КлючСвязиСтрок) КАК ВсегоВЗаказах
+	|ИЗ
+	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
+	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗадействованныеЗаказы КАК вт
+	|		ПО Рег.ДокументЗаказПокупателя = вт.Заказ
+	|ГДЕ
+	|	НЕ Рег.Удаление";
+
+
+	Запрос.УстановитьПараметр("МассивКлючей", ТЗ_Ключи);
+
+	Выборка = Запрос.Выполнить().Выбрать();
+
+	ОбщееКолВо = 0;
+	Если Выборка.Следующий() Тогда
+		ОбщееКолВо = Выборка.ВсегоВЗаказах;
+	КонецЕсли;
+
+	Результат = Новый Структура;
+	Результат.Вставить("ТребуетсяРазделение", ОбщееКолВо > МассивКлючей.Количество());
+	Результат.Вставить("КолВоВыбранных", МассивКлючей.Количество());
+	Результат.Вставить("ОбщееКолВо", ОбщееКолВо);
+
+	Возврат Результат;
+
+КонецФункции
+
+
+Функция ИзменитьСтатусыВРегистреСнабжения(Знач МассивИдентификаторов, Знач ЦелевойСтатус) Экспорт
+
+	Итог = Новый Структура("Успешно, КоличествоОбработанных, ТекстОшибки", Ложь, 0, "");
+
+	ПредыдущийСтатус = Неопределено;
+
+	Если ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Оплачено Тогда
+		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.Заказано;
+
+	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.ТоварВПути Тогда
+		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.Оплачено;
+
+	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Приходуется Тогда
+		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.ТоварВПути;
+
+	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.НаСкладе Тогда
+		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.Приходуется;
+
+	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Комплектуется Тогда
+		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.НаСкладе;
+
+	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Собран Тогда
+		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.Комплектуется;
+	КонецЕсли;
+
+	ЗапросЗаказы = Новый Запрос;
+	ЗапросЗаказы.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
+	|	Т.ДокументЗаказПокупателя КАК Заказ
+	|ИЗ
+	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
+	|ГДЕ
+	|	Т.ИдентификаторЗаписи В(&МассивИдентификаторов)
+	|	И НЕ Т.Удаление";
+
+	ЗапросЗаказы.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
+	ВыгрузкаЗаказов = ЗапросЗаказы.Выполнить().Выгрузить().ВыгрузитьКолонку("Заказ");
+
+	МассивЗаказовПоставщиков = Новый Массив;
+	КоличествоИзмененных = 0;
+
+	Для каждого ТекущийЗаказ Из ВыгрузкаЗаказов Цикл
+
+		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
+		Набор.Отбор.ДокументЗаказПокупателя.Установить(ТекущийЗаказ);
+		Набор.Прочитать();
+
+		Изменено = Ложь;
+		ПарыЗакупокДляСинхронизации = Новый Соответствие;
+
+		Для каждого Запись Из Набор Цикл
