+        ГруппировкаПоЗаказу = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
+        
+        ПолеГрупп = ГруппировкаПоЗаказу.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
+        ПолеГрупп.Поле = Новый ПолеКомпоновкиДанных("СтатусСтроки");
+        ПолеГрупп.Использование = Истина;
+        
+        Детальные = ГруппировкаПоЗаказу.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
+    Иначе
+        Детальные = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
+    КонецЕсли;
+    
+    Детальные.Использование = Истина;
+    Детальные.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
+    
+    ДанныеАРМОтображениеСнабжение.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
+	ХранилищеОбщихНастроек.Сохранить("АРМ_НастройкаГруппировкиСтатус", "ФлагГруппировкиСтатус", ГруппироватьСтрокиПоСтатусам);
+	
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ГруппироватьСтрокиПоСтатусамПриИзменении(Элемент)
+	УстановитьГруппировкуСнабженияНаСервере();
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ДанныеАРМОтображениеСнабжениеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
+	
+	СтандартнаяОбработка = Ложь;
+	
+	 ДанныеСтроки = Элемент.ТекущиеДанные;
+	Если ДанныеСтроки = Неопределено Тогда 
+		Возврат; 
+	КонецЕсли;
+	
+	Если Поле.Имя = "ДанныеАРМОтображениеСнабжениеДатаОтгрузки" Тогда
+		
+		Возврат;
+		
+		Если Не ДанныеСтроки.Свойство("ДатаПоступления") Тогда
+			Возврат;
+		КонецЕсли;
+		ДатаДляВвода = ?(ЗначениеЗаполнено(ДанныеСтроки.ДатаПоступления), ДанныеСтроки.ДатаПоступления, ТекущаяДата());
+		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаДатыПоступления", ЭтотОбъект, ДанныеСтроки);
+		ПоказатьВводДаты(ОписаниеОповещения, ДатаДляВвода, "Укажите дату поступления:", ЧастиДаты.Дата);
+		
+	КонецЕсли;
+	
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ПослеВводаДатыПоступления(Результат, ДанныеСтроки) Экспорт
+	Если Результат <> Неопределено Тогда
+        ДанныеСтроки.ДатаПоступления = Результат; 
+        ИзменитьДатуПоступленияНаСервере(ДанныеСтроки); 
+        ОбновитьСписокПоТаймеру();
+    КонецЕсли;
+КонецПроцедуры
+
+&НаСервере
+Процедура ИзменитьДатуПоступленияНаСервере(ДанныеСтроки)
+    
+	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
+    Набор.Отбор.ИдентификаторЗаписи.Установить(ДанныеСтроки.ИдентификаторЗаписи);
+    Набор.Прочитать();
+    
+    Если Набор.Количество() > 0 Тогда
+        
+        Запись = Набор[0];
+        Запись.ДатаПоступления = ДанныеСтроки.ДатаПоступления;
+        
+        Попытка
+            Набор.Записать();
+        Исключение
+            ЗаписьЖурналаРегистрации("АРМ.ОшибкаЗаписиДатаОтгрузки", 
+                УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
+        КонецПопытки;
+        
+    КонецЕсли;
+    
+КонецПроцедуры

