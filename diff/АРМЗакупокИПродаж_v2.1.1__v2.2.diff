+&НаСервере
+Процедура УстановитьПериодНаСервере()
+	
+	ПараметрыСписка = ДанныеАРМОтображениеСнабжение.КомпоновщикНастроек.Настройки.ПараметрыДанных;
+	
+	ПараметрНачало = ПараметрыСписка.Элементы.Найти("ДатаНачала");
+	Если ПараметрНачало <> Неопределено Тогда
+		ПараметрНачало.Значение      = Период.ДатаНачала;
+		ПараметрНачало.Использование = ЗначениеЗаполнено(Период.ДатаНачала);
+	КонецЕсли;
+	
+	ПараметрКонец = ПараметрыСписка.Элементы.Найти("ДатаОкончания");
+	Если ПараметрКонец <> Неопределено Тогда
+		ПараметрКонец.Значение      = КонецДня(Период.ДатаОкончания);
+		ПараметрКонец.Использование = ЗначениеЗаполнено(Период.ДатаОкончания);
+	КонецЕсли;	
+	
+КонецПроцедуры
+
+&НаСервере
+Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
+	
+	Попытка
+		МассивСтатусыСтрок = Новый Массив;
+		МассивСтатусыСтрок.Добавить(Перечисления.Арм_СтатусыАРМ.Заказано);
+		МассивСтатусыСтрок.Добавить(Перечисления.Арм_СтатусыАРМ.Оплачено);
+		МассивСтатусыСтрок.Добавить(Перечисления.Арм_СтатусыАРМ.ТоварВПути);
+		МассивСтатусыСтрок.Добавить(Перечисления.Арм_СтатусыАРМ.Приходуется);
+		МассивСтатусыСтрок.Добавить(Перечисления.Арм_СтатусыАРМ.НаСкладе);
+		МассивСтатусыСтрок.Добавить(Перечисления.Арм_СтатусыАРМ.Комплектуется);
+		МассивСтатусыСтрок.Добавить(Перечисления.Арм_СтатусыАРМ.Собран);
