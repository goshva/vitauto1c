+				СоздатьДопСтрокуПродажи(ВыборкаПродаж, Справочники.ПартииНоменклатуры.ПустаяСсылка(), Справочники.Контрагенты.ПустаяСсылка(), НужноеКоличество, 0, 0, 0);
