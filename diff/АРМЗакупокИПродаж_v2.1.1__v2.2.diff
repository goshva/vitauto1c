+
+&НаСервере
+Процедура СкрытьПоказатьВычеркнутыеПозицииНаСервере()
+	
+	ХранилищеОбщихНастроек.Сохранить("АРМ_НастройкиДанных", "НеПоказыватьВычеркнутые", НеПоказыватьВычеркнутыеПозиции);
+    ПолеОтбора = Новый ПолеКомпоновкиДанных("Удаление");
+    
+    Для Каждого ЭлементОтбора Из ДанныеАРМОтображение.Отбор.Элементы Цикл
+        Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") 
+            И ЭлементОтбора.ЛевоеЗначение = ПолеОтбора Тогда
+            ДанныеАРМОтображение.Отбор.Элементы.Удалить(ЭлементОтбора);
+        КонецЕсли;
+    КонецЦикла;
+
+    Если НеПоказыватьВычеркнутыеПозиции Тогда
+        НовыйОтбор = ДанныеАРМОтображение.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
+        НовыйОтбор.ЛевоеЗначение  = ПолеОтбора;
+        НовыйОтбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
+        НовыйОтбор.ПравоеЗначение = Ложь;
+        НовыйОтбор.Использование  = Истина;
+        НовыйОтбор.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
+    КонецЕсли;
+
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ОчиститьПериод(Команда)
+	
+	Период = Неопределено;
+	УстановитьПериодНаСервере();
+	
+КонецПроцедуры
+
+&НаСервереБезКонтекста
+Процедура СброситьФлагиНаСервере()
+	Пользователь = ПараметрыСеанса.ТекущийПользователь;
+	РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СброситьФлагиПользователя(Пользователь);
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ДанныеАРМОтображениеЗакупкиПриАктивизацииСтроки(Элемент)
+	
+	ОтображениеКнопокДокументов(Элемент);
+	
+	ТекущиеДанные = Элемент.ТекущиеДанные;
+	Если ТекущиеДанные = Неопределено Тогда
+		Возврат;
+	КонецЕсли;
+	
+	Если ТекущиеДанные.Свойство("ОтметкаСтроки") И ТекущиеДанные.ОтметкаСтроки Тогда
+		Элементы.ВыделитьВсеСтрокиЗаказаЗакупки.Заголовок = "Отменить выделение всех";
+		Элементы.ВыделитьВсеСтрокиЗаказаЗакупки.Картинка = БиблиотекаКартинок.СнятьФлажки; 
+	КонецЕсли;
+	Если ТекущиеДанные.Свойство("ОтметкаСтроки") И Не ТекущиеДанные.ОтметкаСтроки Тогда 
+		Элементы.ВыделитьВсеСтрокиЗаказаЗакупки.Заголовок = "Выделить все";
+		Элементы.ВыделитьВсеСтрокиЗаказаЗакупки.Картинка = БиблиотекаКартинок.УстановитьФлажки;
+	КонецЕсли;
+	
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ОтображениеКнопокДокументов(Элемент)
+	
+	ТекущиеДанные = Элемент.ТекущиеДанные;
+	Если ТекущиеДанные = Неопределено Тогда
+		Элементы.ПоказатьДокументЗаказПоставщику.Доступность = Ложь;
+		Элементы.Заказать.Доступность = Ложь;
+		Возврат;
+	КонецЕсли;
+	
+	ДокументЕсть = Ложь;
+	Если ТекущиеДанные.Свойство("ДокументЗаказПоставщика") Тогда
+		ДокументЕсть = ЗначениеЗаполнено(ТекущиеДанные.ДокументЗаказПоставщика);
+	КонецЕсли;
+	
+	ЭтоЗакупка = Ложь;
+	Если ТекущиеДанные.Свойство("ВидОперации") Тогда
+		ЭтоЗакупка = (ТекущиеДанные.ВидОперации = ПредопределенноеЗначение("Перечисление.Арм_ВидыОпераций.Закупка"));
+	КонецЕсли;
+	
+	Элементы.ПоказатьДокументЗаказПоставщику.Доступность = ДокументЕсть;
+	Элементы.Заказать.Доступность = Не ДокументЕсть И ЭтоЗакупка;
+	
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
+	Попытка
+		СброситьФлагиНаСервере();
+	Исключение
+	КонецПопытки;
+КонецПроцедуры
+
+&НаКлиенте
+Процедура УдалитьТекущуюСтроку(Команда)
+	УдалитьТекущуюСтрокуНаСервере();
+	ОбновитьСписокПоТаймеру();
+КонецПроцедуры
+ 
+&НаСервереБезКонтекста
+Процедура УдалитьТекущуюСтрокуНаСервере()
+	
+	Запрос = Новый Запрос;
+	Запрос.Текст = 
+		"ВЫБРАТЬ
+		|	Арм_ДанныеЗакупокИПродаж.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
+		|	Арм_ДанныеЗакупокИПродаж.Номенклатура КАК Номенклатура,
+		|	Арм_ДанныеЗакупокИПродаж.ДокументЗаказПокупателя КАК ДокументЗаказПокупателя
+		|ИЗ
+		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
+		|ГДЕ
+		|	Арм_ДанныеЗакупокИПродаж.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
+		|	И Арм_ДанныеЗакупокИПродаж.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.ВРаботе)
+		|	И Арм_ДанныеЗакупокИПродаж.ОтметкаСтроки
+		|	И Арм_ДанныеЗакупокИПродаж.АвторСтроки = &АвторСтроки
+		|
+		|ОБЪЕДИНИТЬ ВСЕ
+		|
+		|ВЫБРАТЬ
+		|	Арм_ДанныеЗакупокИПродаж.ИдентификаторЗаписи,
+		|	Арм_ДанныеЗакупокИПродаж.Номенклатура,
+		|	Арм_ДанныеЗакупокИПродаж.ДокументЗаказПокупателя
+		|ИЗ
+		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
+		|ГДЕ
+		|	Арм_ДанныеЗакупокИПродаж.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
+		|	И Арм_ДанныеЗакупокИПродаж.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.ВРаботе)
+		|	И Арм_ДанныеЗакупокИПродаж.ОтметкаСтроки
+		|	И Арм_ДанныеЗакупокИПродаж.АвторСтроки = &АвторСтроки
+		|	И Арм_ДанныеЗакупокИПродаж.РучнаяПравка
+		|
+		|ОБЪЕДИНИТЬ ВСЕ
+		|
+		|ВЫБРАТЬ
+		|	Арм_ДанныеЗакупокИПродаж.ИдентификаторЗаписи,
+		|	Арм_ДанныеЗакупокИПродаж.Номенклатура,
+		|	Арм_ДанныеЗакупокИПродаж.ДокументЗаказПокупателя
+		|ИЗ
+		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
+		|ГДЕ
+		|	Арм_ДанныеЗакупокИПродаж.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
+		|	И Арм_ДанныеЗакупокИПродаж.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Черновик)
+		|	И Арм_ДанныеЗакупокИПродаж.ОтметкаСтроки
+		|	И Арм_ДанныеЗакупокИПродаж.АвторСтроки = &АвторСтроки
+		|
+		|ОБЪЕДИНИТЬ ВСЕ
+		|
+		|ВЫБРАТЬ
+		|	Арм_ДанныеЗакупокИПродаж.ИдентификаторЗаписи,
+		|	Арм_ДанныеЗакупокИПродаж.Номенклатура,
+		|	Арм_ДанныеЗакупокИПродаж.ДокументЗаказПокупателя
+		|ИЗ
+		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
+		|ГДЕ
+		|	Арм_ДанныеЗакупокИПродаж.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
+		|	И Арм_ДанныеЗакупокИПродаж.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Черновик)
+		|	И Арм_ДанныеЗакупокИПродаж.ОтметкаСтроки
+		|	И Арм_ДанныеЗакупокИПродаж.АвторСтроки = &АвторСтроки
+		|	И Арм_ДанныеЗакупокИПродаж.РучнаяПравка";
+	
+	Запрос.УстановитьПараметр("АвторСтроки", ПараметрыСеанса.ТекущийПользователь);
+	РезультатЗапроса = Запрос.Выполнить();
+	Выборка = РезультатЗапроса.Выбрать();
+	
+	ЗапросПроверки = Новый Запрос;
+	ЗапросПроверки.Текст = 
+		"ВЫБРАТЬ ПЕРВЫЕ 2
+		|	Арм_ДанныеЗакупокИПродаж.ИдентификаторЗаписи КАК ИдентификаторЗаписи
+		|ИЗ
+		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
+		|ГДЕ
+		|	Арм_ДанныеЗакупокИПродаж.ДокументЗаказПокупателя = &ДокументЗаказПокупателя";
+	
+	Пока Выборка.Следующий() Цикл
+		
+		ЗапросПроверки.УстановитьПараметр("ДокументЗаказПокупателя", Выборка.ДокументЗаказПокупателя);
+		Если ЗапросПроверки.Выполнить().Выгрузить().Количество() <= 1 Тогда
+			Продолжить;
+		КонецЕсли;
+	
+		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
+		Набор.Отбор.ИдентификаторЗаписи.Установить(Выборка.ИдентификаторЗаписи);
+		Набор.Прочитать();
+		Набор.Очистить();
+		Попытка
+			Набор.Записать();
+		Исключение
+			ЗаписьЖурналаРегистрации(
+				"АРМ.УдалениеСтроки", 
+				УровеньЖурналаРегистрации.Ошибка, 
+				, 
+				, 
+				ОписаниеОшибки()
+			);
+		КонецПопытки;
+		
+		Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(Выборка.Номенклатура, Выборка.ДокументЗаказПокупателя);
+	
+	КонецЦикла;
+	
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ТолькоСЗакупкамиПриИзменении(Элемент)
+	
+	УстановитьОтборПоЗакупкам();
+	
+КонецПроцедуры
+
+&НаСервере
+Процедура УстановитьОтборПоЗакупкам()
+	
+	ОтборСписка = ДанныеАРМОтображение.Отбор; 
+	
+	ГруппаОтбора = Неопределено;
+	Для Каждого ЭлементОтбора Из ОтборСписка.Элементы Цикл
+		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") 
+			И ЭлементОтбора.Представление = "ГруппаТолькоЗакупки" Тогда
+			ГруппаОтбора = ЭлементОтбора;
+			Прервать;
+		КонецЕсли;
+	КонецЦикла;
+	
+	Если ГруппаОтбора = Неопределено Тогда
+		ГруппаОтбора = ОтборСписка.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
+		ГруппаОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
+		ГруппаОтбора.Представление = "ГруппаТолькоЗакупки";
+	КонецЕсли;
+	
+	ГруппаОтбора.Использование = ТолькоСЗакупками;
+	
+	Если ГруппаОтбора.Элементы.Количество() = 0 Тогда
+		
+		Элемент = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
+		Элемент.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ЕстьДефицит");
+		Элемент.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
+		Элемент.ПравоеЗначение = Истина;
+		
+		Элемент = ГруппаОтбора.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
+		Элемент.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Партия");
+		Элемент.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеЗаполнено;
+		
+	КонецЕсли;
+	
+	ХранилищеОбщихНастроек.Сохранить("АС_АРМ_Снабжение", "ТолькоСЗакупками", ТолькоСЗакупками);
+	
+КонецПроцедуры
+
+&НаКлиенте
+Процедура УдалитьЗаказПокупателя(Команда)
+	Оповещение = Новый ОписаниеОповещения("ПослеВопросаОбУдаленииЗаказа", ЭтотОбъект);
+	
+	ПоказатьВопрос(
+		Оповещение, 
+		"Вы уверены, что хотите полностью удалить выбранные заказы покупателей?", 
+		РежимДиалогаВопрос.ДаНет, 
+		, 
+		КодВозвратаДиалога.Нет,
+		"Опасная операция: Удаление заказов"
+	);
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ПослеВопросаОбУдаленииЗаказа(РезультатВопроса, ДополнительныеПараметры) Экспорт
+	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
+		УдалитьВыбранныеЗаказыНаСервере();
+		ОповеститьОбИзменении(Тип("РегистрСведенийКлючЗаписи.Арм_ДанныеЗакупокИПродаж"));
+	КонецЕсли;
+КонецПроцедуры
+
+&НаСервереБезКонтекста
+Процедура УдалитьВыбранныеЗаказыНаСервере()
+	
+	ЗапросСписокЗаказов = Новый Запрос;
+	ЗапросСписокЗаказов.Текст = 
+		"ВЫБРАТЬ РАЗЛИЧНЫЕ
+		|	Т.ДокументЗаказПокупателя КАК Заказ
+		|ИЗ
+		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
+		|ГДЕ
+		|	Т.ОтметкаСтроки = ИСТИНА
+		|	И Т.АвторСтроки = &Автор
+		|	И Т.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Черновик)
+		|
+		|ОБЪЕДИНИТЬ ВСЕ
+		|
+		|ВЫБРАТЬ РАЗЛИЧНЫЕ
+		|	Т.ДокументЗаказПокупателя
+		|ИЗ
+		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
+		|ГДЕ
+		|	Т.ОтметкаСтроки = ИСТИНА
+		|	И Т.АвторСтроки = &Автор
+		|	И Т.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.ВРаботе)";
+	
+	ЗапросСписокЗаказов.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);
+	ВыборкаЗаказов = ЗапросСписокЗаказов.Выполнить().Выбрать();
+	
+	Пока ВыборкаЗаказов.Следующий() Цикл
+		
+		ТекущийЗаказ = ВыборкаЗаказов.Заказ;
+		
+		ЗапросСвязи = Новый Запрос;
+		ЗапросСвязи.Текст = 
+			"ВЫБРАТЬ ПЕРВЫЕ 1
+			|	ЗаказПоставщику.Ссылка КАК Ссылка
+			|ИЗ
+			|	Документ.ЗаказПоставщику КАК ЗаказПоставщику
+			|ГДЕ
+			|	ЗаказПоставщику.ЗаказПокупателя = &Заказ
+			|	И ЗаказПоставщику.ПометкаУдаления = ЛОЖЬ";
+		ЗапросСвязи.УстановитьПараметр("Заказ", ТекущийЗаказ);
+		
+		Если Не ЗапросСвязи.Выполнить().Пустой() Тогда
+			ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Заказ %1 пропущен: по нему есть активные закупки!", ТекущийЗаказ));
+			Продолжить;
+		КонецЕсли;
+
+		СписокНоменклатуры = Новый Соответствие;
+		ЗапросНоменклатура = Новый Запрос;
+		ЗапросНоменклатура.Текст =
+			"ВЫБРАТЬ РАЗЛИЧНЫЕ
+			|	Арм_ДанныеЗакупокИПродаж.Номенклатура КАК Номенклатура
+			|ИЗ
+			|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
+			|ГДЕ
+			|	Арм_ДанныеЗакупокИПродаж.ДокументЗаказПокупателя = &Заказ";
+		ЗапросНоменклатура.УстановитьПараметр("Заказ", ТекущийЗаказ);
+		ВыборкаНоменклатура = ЗапросНоменклатура.Выполнить().Выбрать();
+		Пока ВыборкаНоменклатура.Следующий() Цикл
+			Если ЗначениеЗаполнено(ВыборкаНоменклатура.Номенклатура) Тогда 
+				СписокНоменклатуры.Вставить(ВыборкаНоменклатура.Номенклатура, Истина); 
+			КонецЕсли;
+		КонецЦикла;
+
+		ОбъектЗаказа = ТекущийЗаказ.ПолучитьОбъект();
+		Если ОбъектЗаказа <> Неопределено И Не ОбъектЗаказа.ПометкаУдаления Тогда
+			Попытка
+				ОбъектЗаказа.УстановитьПометкуУдаления(Истина);
+			Исключение
+				ТекстСообщения = СтрШаблон(
+					"Не удалось удалить заказ %1 по причине: %2",
+					Строка(ТекущийЗаказ),
+					ОписаниеОшибки()
+				);
+				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
+				Возврат;
+			КонецПопытки;
+		КонецЕсли;
+
+		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
+		Набор.Отбор.ДокументЗаказПокупателя.Установить(ТекущийЗаказ);
+		Попытка
+			Набор.Записать();
+		Исключение
+			ЗаписьЖурналаРегистрации("АРМ.УдалениеЗаказа", УровеньЖурналаРегистрации.Ошибка,,, ОписаниеОшибки());
+		КонецПопытки;
+
+		Для Каждого КлючИЗначение Из СписокНоменклатуры Цикл
+			Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(КлючИЗначение.Ключ, Документы.ЗаказПокупателя.ПустаяСсылка());
+		КонецЦикла;
+		
+	КонецЦикла;
+	
+КонецПроцедуры
+
+&НаКлиенте
+Процедура СкрытьОтгруженныеПриИзменении(Элемент)
+	СкрытьОтгруженныеНаСервере()
+КонецПроцедуры
+
+&НаСервере
+Процедура СкрытьОтгруженныеНаСервере()
+	
+	Отбор = ДанныеАРМОтображение.Отбор.Элементы;
+	
+	ПолеОтбора = Новый ПолеКомпоновкиДанных("СтатусСтроки");
+	НужныйЭлемент = Неопределено;
+	
+	Для Каждого ЭлементОтбора Из Отбор Цикл
+		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") 
+			И ЭлементОтбора.ЛевоеЗначение = ПолеОтбора Тогда
+			НужныйЭлемент = ЭлементОтбора;
+			Прервать;
+		КонецЕсли;
+	КонецЦикла;
+	
+	Если НужныйЭлемент = Неопределено Тогда
+		НужныйЭлемент = Отбор.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
+		НужныйЭлемент.ЛевоеЗначение = ПолеОтбора;
+	КонецЕсли;
+	
+	НужныйЭлемент.Использование  = СкрытьОтгруженные;
+	НужныйЭлемент.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеРавно;
+	НужныйЭлемент.ПравоеЗначение = Перечисления.Арм_СтатусыАРМ.Отгружено;
+	
+	ХранилищеОбщихНастроек.Сохранить("АРМ_Автосервис_Настройки", "СкрытьОтгруженные", СкрытьОтгруженные);
+
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ВыделитьВсеСтрокиЗаказа(Команда)
+	ДанныеСтроки = Элементы.ДанныеАРМОтображение.ТекущиеДанные;
+	Если ДанныеСтроки = Неопределено Тогда
+		Возврат;
+	КонецЕсли;
+	ОбработатьНажатиеФлагиВыделения(ДанныеСтроки);
+	Если ДанныеСтроки.Свойство("ОтметкаСтроки") И ДанныеСтроки.ОтметкаСтроки Тогда
+		Элементы.ВыделитьВсеСтрокиЗаказа.Заголовок = "Отменить выделение всех";
+		Элементы.ВыделитьВсеСтрокиЗаказа.Картинка = БиблиотекаКартинок.СнятьФлажки; 
+	КонецЕсли;
+	Если ДанныеСтроки.Свойство("ОтметкаСтроки") И Не ДанныеСтроки.ОтметкаСтроки Тогда 
+		Элементы.ВыделитьВсеСтрокиЗаказа.Заголовок = "Выделить все";
+		Элементы.ВыделитьВсеСтрокиЗаказа.Картинка = БиблиотекаКартинок.УстановитьФлажки;
+	КонецЕсли;
+	ОбновитьСписокПоТаймеру();
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ВыделитьВсеСтрокиЗаказаЗакупки(Команда)
+	ДанныеСтроки = Элементы.ДанныеАРМОтображениеЗакупки.ТекущиеДанные;
+	Если ДанныеСтроки = Неопределено Тогда
+		Возврат;
+	КонецЕсли;
+	ОбработатьНажатиеФлагиВыделения(ДанныеСтроки);
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ОбработатьНажатиеФлагиВыделения(ДанныеСтроки)
+
+	Если Не ДанныеСтроки.Свойство("ДокументЗаказПокупателя") И Не ЗначениеЗаполнено(ДанныеСтроки.ДокументЗаказПокупателя)
+		Или ДанныеСтроки.Свойство("ГруппировкаСтроки") Тогда
+		ТекстСообщения = "Для того, чтобы отметить все галки встаньте на строку, а не на группировку";
+		ПоказатьОповещениеПользователя("Внимание!", , ТекстСообщения);
+		Возврат;
+	КонецЕсли;
+	НовоеЗначениеФлага = Не ДанныеСтроки.ОтметкаСтроки;
+	ВыделитьВсеСтрокиЗаказаНаСервере(ДанныеСтроки.ДокументЗаказПокупателя, ДанныеСтроки.ВидОперации, НовоеЗначениеФлага);
+	//ОбновитьСписокПоТаймеру();
+	
+КонецПроцедуры
+
+&НаСервереБезКонтекста
+Процедура ВыделитьВсеСтрокиЗаказаНаСервере(ДокЗаказПокупателя, ВидОперации, НовоеЗначениеФлага)
+	
+	АвторДляЗаписи = ?(НовоеЗначениеФлага, ПараметрыСеанса.ТекущийПользователь, Справочники.Пользователи.ПустаяСсылка());
+	
+	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
+	Набор.Отбор.ДокументЗаказПокупателя.Установить(ДокЗаказПокупателя);
+	Набор.Прочитать();
+	
+	Изменено = Ложь;
+	Автор = ПараметрыСеанса.ТекущийПользователь;
+	
+	Для Каждого Запись Из Набор Цикл
+		
+		СтрокаСвободна = Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка() Или Запись.АвторСтроки = Автор; 
+		Если (Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ВРаботе
+			Или Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик)
+			И Не Запись.Удаление И СтрокаСвободна Тогда
+			
+			Если Запись.ВидОперации = ВидОперации Тогда
+				Запись.ОтметкаСтроки = НовоеЗначениеФлага;
+				Запись.АвторСтроки   = АвторДляЗаписи;
+				Изменено = Истина;
+			КонецЕсли;
+			
+		КонецЕсли;
+	КонецЦикла;
+	
+	Если Не Изменено Тогда Возврат КонецЕсли;
+	
+	Попытка
+		Набор.Записать();
+	Исключение
+		ТекстОшибки = СтрШаблон(
+			"Ошибка записи в АРМ-регистр. Выделение всех строк пользователем %1, подробно: %2", 
+			ПараметрыСеанса.ТекущийПользователь, 
+			КраткоеПредставлениеОшибки(ИнформацияОбОшибке())
+		);
+		ЗаписьЖурналаРегистрации(
+			"АРМ.ВыделениеВсехСтрок", 
+			УровеньЖурналаРегистрации.Ошибка, 
+			, 
+			, 
+			ТекстОшибки
+		);
+	КонецПопытки;
+	
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ЗаполнитьДатуИНомерОтгрузкиДляЗаказа(Команда)
+	
+	ДанныеСтроки = Элементы.ДанныеАРМОтображение.ТекущиеДанные;
+    
+    Если ДанныеСтроки = Неопределено Тогда
+        Возврат;
+    КонецЕсли;
+    
+    ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВводаРеквизитовОтгрузки", ЭтотОбъект, ДанныеСтроки.ДокументЗаказПокупателя);
+    ОткрытьФорму(
+		"Обработка.АС_АРМ2.Форма.ФормаВводаРеквизитовОтгрузки", 
+		, ЭтотОбъект, 
+		, 
+		, 
+		, 
+		ОписаниеОповещения, 
+		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца
+	);
+	
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ПослеВводаРеквизитовОтгрузки(РезультатВвода, ДополнительныеПараметры) Экспорт
+    
+    Если РезультатВвода = Неопределено Тогда
+        Возврат;
+    КонецЕсли;
+    
+    ДокументЗаказ = ДополнительныеПараметры;
+    
+    ОбновитьДанныеОтгрузкиВРегистреНаСервере(ДокументЗаказ, РезультатВвода.ДатаОтгрузки, РезультатВвода.НомерОтгрузки);
+    ОбновитьСписокПоТаймеру();
+    
+КонецПроцедуры
+
+&НаСервереБезКонтекста
+Процедура ОбновитьДанныеОтгрузкиВРегистреНаСервере(Знач ДокументЗаказ, Знач НоваяДата, Знач НовыйНомер)
+    
+    Если Не ЗначениеЗаполнено(ДокументЗаказ) Тогда
+        Возврат;
+    КонецЕсли;
+    
+    Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
+    Набор.Отбор.ДокументЗаказПокупателя.Установить(ДокументЗаказ);
+    Набор.Прочитать();
+    
+    Если Набор.Количество() > 0 Тогда
+		
+		Автор = ПараметрыСеанса.ТекущийПользователь;
+		Изменено = Ложь;
+        Для Каждого Запись Из Набор Цикл
+			
+			Если ЗначениеЗаполнено(Запись.Партия) Тогда
+				СтрокаСвободна = Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка() Или Запись.АвторСтроки = Автор; 
+				Если (Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ВРаботе
+					Или Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик)
+					И Не Запись.Удаление И СтрокаСвободна Тогда
+					
+		            Запись.ДатаОтгрузки = НоваяДата;
+		            Запись.НомерОтгрузки = НовыйНомер;
+					Изменено = Истина;
+					
+				КонецЕсли;
+			КонецЕсли;
+            
+        КонецЦикла;
+		
+		Если Не Изменено Тогда Возврат КонецЕсли;
+		
+		Попытка
+            Набор.Записать(); 
+        Исключение
+            ЗаписьЖурналаРегистрации(
+				"АРМ.ОшибкаМассовойЗаписиНабораОтгрузки", 
+                УровеньЖурналаРегистрации.Ошибка, 
+				, 
+				, 
+				ОписаниеОшибки()
+			);
+        КонецПопытки;
+        
+    КонецЕсли;
+    
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ДанныеАРМОтображениеОтметкаСтрокиПриИзменении(Элемент)
+	//ТекущиеДанные = Элементы.ДанныеАРМОтображение.ТекущиеДанные;
+	//Если ТекущиеДанные = Неопределено Тогда 
+	//	Возврат; 
+	//КонецЕсли;
+	//Если Не ТекущиеДанные.Свойство("ИдентификаторЗаписи") Или Не ТекущиеДанные.Свойство("ОтметкаСтроки") Тогда
+	//	Возврат;
+	//КонецЕсли;
+	//ИнвертироватьФлагНаСервере(ТекущиеДанные.ИдентификаторЗаписи, ТекущиеДанные.ОтметкаСтроки);
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ПоказатьДокументРасходнаяНакладная(Команда)
+	СписокДокументов = ПолучитьСписокНужныхДокументовДляОткрытия("РасходнаяНакладная");
+    Для Каждого ДокументСсылка Из СписокДокументов Цикл
+        ПоказатьЗначение(, ДокументСсылка);
+	КонецЦикла;
+	Если СписокДокументов.Количество() = 0 Тогда
+		ТекстСообщения = "Для выделенных строк отсутствует документ расходная накладная";
+		ПоказатьОповещениеПользователя("Не данных для отображения", , ТекстСообщения);
+	КонецЕсли;
+КонецПроцедуры
+
+&НаКлиенте
+Процедура ГруппироватьПоНомеруЗаказаКлиентаПриИзменении(Элемент)
+	
+	Если ГруппироватьПоНомеруЗаказаКлиента Тогда
+		СгруппироватьПоЗаказуПокупателя = Ложь;
+	КонецЕсли;
+	
+	УстановитьГруппировкуАРМНаСервере();
+	
+КонецПроцедуры
+
+&НаСервере
+Процедура УстановитьГруппировкуАРМНаСервере()
+    
+    Настройки = ДанныеАРМОтображение.КомпоновщикНастроек.Настройки;
+    Настройки.Структура.Очистить();
+    
+    Если СгруппироватьПоЗаказуПокупателя Тогда
+		
+        ГруппировкаПоЗаказу = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
+        ПолеГрупп = ГруппировкаПоЗаказу.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
+        ПолеГрупп.Поле = Новый ПолеКомпоновкиДанных("ДокументЗаказПокупателя");
+        ПолеГрупп.Использование = Истина;
+        
+        Детальные = ГруппировкаПоЗаказу.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
+		
+    ИначеЕсли ГруппироватьПоНомеруЗаказаКлиента Тогда
+		
+		ГруппировкаПоНомера = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
+        ПолеГрупп = ГруппировкаПоНомера.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
+        ПолеГрупп.Поле = Новый ПолеКомпоновкиДанных("НомерЗаказаКлиента");
+        ПолеГрупп.Использование = Истина;
+        
+        Детальные = ГруппировкаПоНомера.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
+		
+    Иначе
+		
+        Детальные = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
+		
+    КонецЕсли;
+    
+    Детальные.Использование = Истина;
+    Детальные.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
+    
+    ДанныеАРМОтображение.КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
+	
+	ХранилищеОбщихНастроек.Сохранить("АРМ_НастройкаГруппировки", "ФлагГруппировкиЗаказ1С", СгруппироватьПоЗаказуПокупателя);
+	ХранилищеОбщихНастроек.Сохранить("АРМ_НастройкаГруппировки", "ФлагГруппировкиЗаказКлиента", ГруппироватьПоНомеруЗаказаКлиента);
+
+КонецПроцедуры
+
+#КонецОбласти
\ No newline at end of file

