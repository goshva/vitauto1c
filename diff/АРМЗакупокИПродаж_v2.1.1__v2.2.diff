+		
+		ДокОбъект = ВыборкаЗаказов.Заказ.ПолучитьОбъект();
+		Если ДокОбъект <> Неопределено Тогда
+			Если НЕ ДокОбъект.Записать(РежимЗаписиДокумента.Проведение) Тогда
+				ПолныйТекстОшибки = СтрШаблон("Заказ %1 не провелся! Список ошибки ниже ", Строка(ВыборкаЗаказов.Заказ));
+				ОбщегоНазначения.СообщитьПользователю(ПолныйТекстОшибки);
+				Возврат Ложь;
+			КонецЕсли;
+		КонецЕсли;
+	КонецЦикла;
+
+	Возврат Истина;
+	
+КонецФункции
+
+&НаКлиенте
+Процедура ДанныеАРМОтображениеПриАктивизацииЯчейки(Элемент)
+	
+	//Если Элемент.ТекущийЭлемент = Неопределено Тогда
+	//	Возврат;
+	//КонецЕсли;
+
+	ТекущиеДанные = Элемент.ТекущиеДанные;
+	Если ТекущиеДанные = Неопределено Тогда 
+		Возврат; 
+	КонецЕсли;
+	
+	Если ТекущиеДанные.Свойство("СтрокаЗаблокирована") И ТекущиеДанные.СтрокаЗаблокирована Тогда 
+		Возврат; 
+	КонецЕсли;	
+	
+	Если Не ТекущиеДанные.Свойство("ИдентификаторЗаписи") Или Не ТекущиеДанные.Свойство("ОтметкаСтроки") Тогда
+		Возврат;
+	КонецЕсли;
+	Если Элемент.ТекущийЭлемент.Имя = "ДанныеАРМОтображениеОтметкаСтроки" 
+		Или Элемент.ТекущийЭлемент.Имя = "ДанныеАРМОтображениеЗакупкиОтметкаСтроки" Тогда
+		ИнвертироватьФлагНаСервере(ТекущиеДанные.ИдентификаторЗаписи, ТекущиеДанные.ОтметкаСтроки);
+		ОбновитьСписокПоТаймеру();
+		Если Элемент.ТекущийЭлемент.Имя = "ДанныеАРМОтображениеОтметкаСтроки" Тогда
+			Элементы.ДанныеАРМОтображение.ТекущийЭлемент = Элементы.ДанныеАРМОтображениеНоменклатураКлиента;
+		ИначеЕсли Элемент.ТекущийЭлемент.Имя = "ДанныеАРМОтображениеЗакупкиОтметкаСтроки" Тогда
+			Элементы.ДанныеАРМОтображениеЗакупки.ТекущийЭлемент = Элементы.ДанныеАРМОтображениеЗакупкиНоменклатураКлиента;	
+		КонецЕсли;
+	КонецЕсли;
+	
+КонецПроцедуры
+
+&НаСервере
+Процедура НастроитьОформлениеБлокировкиФоном()
+	
+	МассивСписков = Новый Массив;
+	МассивСписков.Добавить(ДанныеАРМОтображение);
+	МассивСписков.Добавить(ДанныеАРМОтображениеЗакупки);
+	
+	Для Каждого ТекущийСписок Из МассивСписков Цикл
+		
+		УсловноеОформлениеСписок = ТекущийСписок.УсловноеОформление;
+		
+		ЭлементОформления = УсловноеОформлениеСписок.Элементы.Добавить();
+		
+		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ЦветФона",    WebЦвета.Серый);
+		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Доступность", Ложь);
+		ЭлементУсловия = ЭлементОформления.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
+		ЭлементУсловия.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("СтрокаЗаблокирована");
+		ЭлементУсловия.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
+		ЭлементУсловия.ПравоеЗначение = Истина; 
+		ЭлементУсловия.Использование  = Истина;
+		
+	КонецЦикла;
+	
+КонецПроцедуры
+
+// Колонки таблицы продаж по канону матрицы прав (index.html, column-matrix.json).
+// Формат строки: ИмяПоляСписка|Заголовок|Вид
+//   Вид: пусто — существующая колонка формы (только заголовок и порядок);
+//        Р — поле регистра Арм_ДанныеЗакупокИПродаж, добавляется в запрос списка и в форму;
+//        П — поле регистра, уже выбранное запросом списка, добавляется только колонка формы;
+//        С — заглушка-строка; Б — заглушка-флажок (данных пока нет, только вид формы).
+&НаСервере
+Функция ОписаниеКолонокПоМатрице()
+
+	Возврат
+	"ОтметкаСтроки||
+	|Порядок|№ п/п|П
+	|ДокументПодписанОригинал|Документ подписан оригинал|Р
+	|ДатаОтгрузки|Дата отгрузки|
+	|НомерОтгрузки|Номер отгрузки|
+	|ДатаЗаказа|Дата заказа|
+	|НомерЗаказа|№ заказ внутренний наш|
+	|НомерЗаказаКлиента|№ заказ клиент|
+	|Покупатель|Заказчик|
+	|Договор|Договор с заказчиком|Р
+	|ВидУслуги|Вид услуги|
+	|Марка|Марка|Р
+	|Модель|Модель|Р
+	|Агрегат|Агрегат|Р
+	|Госномер|Госномер|Р
+	|ЗаглушкаНомерШасси|№ Шасии|С
+	|VIN|VIN (ХТС)|Р
+	|Двигатель|Двигатель|Р
+	|СрочностьКлиента|Срочность (ФАКТ) / комментарий заказчика|
+	|ГРЗКлиента|Машина ГРЗ (ФАКТ)|
+	|ТерриторияКлиента|Территория (ФАКТ)|
+	|НоменклатураКлиента|Наименование (ФАКТ)|
+	|АртикулКлиента|Артикул (ФАКТ)|
+	|КоличествоКлиента|Кол-во (ФАКТ)|
+	|ЕдиницаИзмеренияКлиента|Ед. изм. (ФАКТ)|
+	|Номенклатура|Наименование|
+	|НоменклатураАртикул|Артикул|
+	|НоменклатураАС_КодАвтоАльянс|Код А-А / код поставщика|
+	|НоменклатураЕдиницаИзмерения|Ед. изм.|
+	|Количество|Кол-во|
+	|КоличествоНормаЧас|Кол-во норма час товар для клиента|Р
+	|ОстатокДляСтроки|Кол-во в наличии на складе|
+	|ЗаглушкаКолВРезерве|Кол-во в резерве|С
+	|ЗаглушкаКолВПути|Кол-во заказанного в пути / свободное|С
+	|Партия|№ партии ФИФО / выбор партии|
+	|СтатусСтроки|Статус заявки|
+	|СебестоимостьЕдиницы|Цена (себес.)|
+	|Себестоимость|Сумма (себес.)|
+	|ФормаОплаты|Форма оплаты|
+	|РРЦ|РРЦ|Р
+	|Оплачено|Оплачено (счёт, оплата, постоплата)|Р
+	|Коэффициент|Коэфф|
+	|Цена|Цена продажи|
+	|Сумма|Сумма продажи|
+	|Поставщик|Поставщик|
+	|ДатаПоступления|Дата получения|Р
+	|ЗаглушкаДатаУПД|Дата УПД|С
+	|ЗаглушкаНомерУПД|№ УПД|С
+	|ТерриторияОтгрузкиПоставщиком|Территория отгрузки поставщиком|Р
+	|КомментарийКСтроке|Комментарий|";
+
+КонецФункции
+
+// Таблица продаж по матрице: заголовки и порядок колонок, поля регистра и заглушки.
+// Имена существующих элементов не меняются (на них завязан код формы).
+// Технические колонки АРМ, которых нет в матрице, уходят в конец с прежней видимостью.
+&НаСервере
+Процедура ПрименитьКолонкиПоМатрице()
+
+	Префикс = "ДанныеАРМОтображение";
+	Таблица = Элементы.ДанныеАРМОтображение;
+	РежимАдминистратора = ЭтоАдминистраторАРМ();
+	Редактируемые = "," + ПоляРедактируемыеАдминистратором() + ",";
+
+	Колонки = Новый Массив;
+	Для Каждого Строка Из СтрРазделить(ОписаниеКолонокПоМатрице(), Символы.ПС, Ложь) Цикл
+		Части = СтрРазделить(СокрЛП(Строка), "|", Истина);
+		Колонки.Добавить(Новый Структура("Поле, Заголовок, Вид", Части[0], Части[1], Части[2]));
+	КонецЦикла;
+
+	// 1. Поля регистра и заглушки — в запрос динамического списка (сразу после внешнего ВЫБРАТЬ,
+	//    внешний запрос выбирает из регистра под псевдонимом ОсновнаяТаблица).
+	ДопПоля = "";
+	Для Каждого Колонка Из Колонки Цикл
+		Если Колонка.Вид = "Р" Тогда
+			ДопПоля = ДопПоля + Символы.ПС + Символы.Таб + "ОсновнаяТаблица." + Колонка.Поле + " КАК " + Колонка.Поле + ",";
+		ИначеЕсли Колонка.Вид = "С" Тогда
+			ДопПоля = ДопПоля + Символы.ПС + Символы.Таб + """"" КАК " + Колонка.Поле + ",";
+		ИначеЕсли Колонка.Вид = "Б" Тогда
+			ДопПоля = ДопПоля + Символы.ПС + Символы.Таб + "ЛОЖЬ КАК " + Колонка.Поле + ",";
+		КонецЕсли;
+	КонецЦикла;
+
+	ПоляДобавлены = Ложь;
+	Если ЗначениеЗаполнено(ДопПоля) Тогда
+		ТекстЗапроса = ДанныеАРМОтображение.ТекстЗапроса;
+		Позиция = СтрНайти(ТекстЗапроса, "ВЫБРАТЬ");
+		Если Позиция > 0 Тогда
+			ДанныеАРМОтображение.ТекстЗапроса = Лев(ТекстЗапроса, Позиция + 6) + ДопПоля + Сред(ТекстЗапроса, Позиция + 7);
+			ПоляДобавлены = Истина;
+		Иначе
+			ЗаписьЖурналаРегистрации("АРМ.КолонкиПоМатрице", УровеньЖурналаРегистрации.Предупреждение,,,
+				"В запросе списка не найден ВЫБРАТЬ — поля регистра и заглушки не добавлены");
+		КонецЕсли;
+	КонецЕсли;
+
+	// 2. Технические колонки (не из матрицы) — запомнить в исходном порядке.
+	ИменаМатрицы = Новый Соответствие;
+	Для Каждого Колонка Из Колонки Цикл
+		ИменаМатрицы.Вставить(Префикс + Колонка.Поле, Истина);
+	КонецЦикла;
+	Технические = Новый Массив;
+	Для Каждого Элемент Из Таблица.ПодчиненныеЭлементы Цикл
+		Если ИменаМатрицы.Получить(Элемент.Имя) = Неопределено Тогда
+			Технические.Добавить(Элемент);
+		КонецЕсли;
+	КонецЦикла;
+
+	// 3. Колонки матрицы: создать недостающие, выставить заголовки, переставить по порядку.
+	Для Каждого Колонка Из Колонки Цикл
+		ИмяЭлемента = Префикс + Колонка.Поле;
+		Элемент = Элементы.Найти(ИмяЭлемента);
+
+		Если Элемент = Неопределено Тогда
+			Если Не ЗначениеЗаполнено(Колонка.Вид) Тогда
+				Продолжить; // существующей колонки нет в форме — пропускаем
+			КонецЕсли;
+			Если Колонка.Вид <> "П" И Не ПоляДобавлены Тогда
+				Продолжить; // поля нет в запросе — колонку не создаём
+			КонецЕсли;
+			Элемент = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), Таблица);
+			Флажок = Колонка.Вид = "Б" Или (Колонка.Вид = "Р" И ЭтоБулевоПолеАРМ(Колонка.Поле));
+			Элемент.Вид = ?(Флажок, ВидПоляФормы.ПолеФлажка, ВидПоляФормы.ПолеВвода);
+			Элемент.ПутьКДанным = "ДанныеАРМОтображение." + Колонка.Поле;
+			Элемент.ТолькоПросмотр = Истина;
+			Если Колонка.Вид = "С" Или Колонка.Вид = "Б" Тогда
+				Элемент.Подсказка = "Заглушка: колонка из матрицы прав, данные пока не заполняются";
+			КонецЕсли;
+		КонецЕсли;
+
+		Если РежимАдминистратора И СтрНайти(Редактируемые, "," + Колонка.Поле + ",") > 0 Тогда
+			Элемент.Подсказка = "Администратор: изменить значение — двойной щелчок по ячейке";
+		КонецЕсли;
+
+		Если ЗначениеЗаполнено(Колонка.Заголовок) Тогда
+			Элемент.Заголовок = Колонка.Заголовок;
+		КонецЕсли;
+		Элементы.Переместить(Элемент, Таблица);
+	КонецЦикла;
+
+	Для Каждого Элемент Из Технические Цикл
+		Элементы.Переместить(Элемент, Таблица);
+	КонецЦикла;
+
+КонецПроцедуры
+
+#Область РедактированиеАдминистратором
+
+// Роль интерфейса текущего пользователя — «Администратор».
+&НаСервереБезКонтекста
+Функция ЭтоАдминистраторАРМ()
+
+	Возврат РегистрыСведений.Арм_ПраваПользователей.ПолучитьРольИнтерфейсаПользователя(ПараметрыСеанса.ТекущийПользователь)
+		= Перечисления.Арм_РолиИнтерфейса.Администратор;
+
+КонецФункции
+
+// Поля строки продаж, которые администратор меняет двойным щелчком через общий ввод значения.
+// По матрице column-matrix.json администратор может менять их хотя бы в одном статусе. Колонки,
+// у которых уже есть свой обработчик (номенклатура, количество, цена, коэффициент, партия,
+// вид услуги, форма оплаты, дата и номер отгрузки, комментарий), работают как раньше.
+// Реквизиты номенклатуры (артикул, код, ед. изм.) здесь не меняются — это данные справочника.
+&НаКлиентеНаСервереБезКонтекста
+Функция ПоляРедактируемыеАдминистратором()
+
+	Возврат "ДокументПодписанОригинал,ДатаЗаказа,НомерЗаказаКлиента,Покупатель,Договор,"
+		+ "Марка,Модель,Агрегат,Госномер,VIN,Двигатель,"
+		+ "СрочностьКлиента,ГРЗКлиента,ТерриторияКлиента,НоменклатураКлиента,АртикулКлиента,КоличествоКлиента,ЕдиницаИзмеренияКлиента,"
+		+ "КоличествоНормаЧас,СебестоимостьЕдиницы,РРЦ,Оплачено,Поставщик,ТерриторияОтгрузкиПоставщиком";
+
+КонецФункции
+
+// Метаданные поля регистра Арм_ДанныеЗакупокИПродаж (ресурс, измерение или реквизит).
+&НаСервереБезКонтекста
+Функция МетаданныеПоляАРМ(Знач ИмяПоля)
+
+	МД = Метаданные.РегистрыСведений.Арм_ДанныеЗакупокИПродаж;
+	Поле = МД.Ресурсы.Найти(ИмяПоля);
+	Если Поле = Неопределено Тогда
+		Поле = МД.Измерения.Найти(ИмяПоля);
+	КонецЕсли;
+	Если Поле = Неопределено Тогда
+		Поле = МД.Реквизиты.Найти(ИмяПоля);
+	КонецЕсли;
+	Возврат Поле;
+
+КонецФункции
+
+&НаСервереБезКонтекста
+Функция ОписаниеТипаПоляАРМ(Знач ИмяПоля)
+
+	Поле = МетаданныеПоляАРМ(ИмяПоля);
+	Возврат ?(Поле = Неопределено, Новый ОписаниеТипов("Строка"), Поле.Тип);
+
+КонецФункции
+
+&НаСервереБезКонтекста
+Функция ЭтоБулевоПолеАРМ(Знач ИмяПоля)
+
+	ОписаниеТипа = ОписаниеТипаПоляАРМ(ИмяПоля);
+	Возврат ОписаниеТипа.Типы().Количество() = 1 И ОписаниеТипа.СодержитТип(Тип("Булево"));
+
+КонецФункции
+
+// Двойной щелчок администратора по колонке из ПоляРедактируемыеАдминистратором().
+// Возвращает Истина, если щелчок обработан здесь.
+&НаКлиенте
+Функция ОбработатьВыборАдминистратора(Поле, ДанныеСтроки)
+
+	Префикс = "ДанныеАРМОтображение";
+	Если Не СтрНачинаетсяС(Поле.Имя, Префикс) Тогда
+		Возврат Ложь;
+	КонецЕсли;
+	ИмяПоля = Сред(Поле.Имя, СтрДлина(Префикс) + 1);
+	Если СтрНайти("," + ПоляРедактируемыеАдминистратором() + ",", "," + ИмяПоля + ",") = 0 Тогда
+		Возврат Ложь;
+	КонецЕсли;
+
+	ТекущееЗначение = Неопределено;
+	Если Не ДанныеСтроки.Свойство(ИмяПоля, ТекущееЗначение) Тогда
+		Возврат Ложь;
+	КонецЕсли;
+
+	ДопПараметры = Новый Структура("ИдентификаторЗаписи, ИмяПоля", ДанныеСтроки.ИдентификаторЗаписи, ИмяПоля);
+	ОписаниеТипа = ОписаниеТипаПоляАРМ(ИмяПоля);
+
+	Если ИмяПоля = "Договор" Тогда
+		ПокупательСтроки = Неопределено;
+		ДанныеСтроки.Свойство("Покупатель", ПокупательСтроки);
+		Если Не ЗначениеЗаполнено(ПокупательСтроки) Тогда
+			ПоказатьПредупреждение(, "Сначала выберите Заказчика в этой строке");
+			Возврат Истина;
+		КонецЕсли;
+		Оповещение = Новый ОписаниеОповещения("ПослеВводаЗначенияАдминистратором", ЭтотОбъект, ДопПараметры);
+		ПараметрыОткрытия = Новый Структура;
