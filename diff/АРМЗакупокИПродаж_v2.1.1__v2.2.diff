+КонецПроцедуры
+
+// Запись одного поля строки продаж в регистр. Только для администратора и только для полей
+// из ПоляРедактируемыеАдминистратором(). Возвращает текст ошибки или пустую строку.
+&НаСервереБезКонтекста
+Функция ЗаписатьПолеСтрокиАРМ(Знач ИдентификаторЗаписи, Знач ИмяПоля, Знач Значение)
+
+	Если Не ЭтоАдминистраторАРМ() Тогда
+		Возврат "Изменение этого поля доступно только администратору АРМ.";
+	КонецЕсли;
+	Если СтрНайти("," + ПоляРедактируемыеАдминистратором() + ",", "," + ИмяПоля + ",") = 0
+		Или МетаданныеПоляАРМ(ИмяПоля) = Неопределено Тогда
+		Возврат СтрШаблон("Поле ""%1"" нельзя изменить из АРМ.", ИмяПоля);
+	КонецЕсли;
+
+	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
+	Набор.Отбор.ИдентификаторЗаписи.Установить(ИдентификаторЗаписи);
+	Набор.Прочитать();
+	Если Набор.Количество() = 0 Тогда
+		Возврат "Строка не найдена — возможно, её уже удалили. Обновите список.";
+	КонецЕсли;
+
+	Если ИмяПоля = "Договор" И ЗначениеЗаполнено(Значение) Тогда
+		ПокупательЗаписи = Набор[0].Покупатель;
+		Если Значение.Владелец <> ПокупательЗаписи Тогда
+			Возврат СтрШаблон("Договор «%1» не принадлежит заказчику «%2»",
+				Строка(Значение), Строка(ПокупательЗаписи));
+		КонецЕсли;
+	КонецЕсли;
+
+	Для Каждого Запись Из Набор Цикл
+		Запись[ИмяПоля] = Значение;
+	КонецЦикла;
+
+	Попытка
+		Набор.Записать();
+	Исключение
+		ЗаписьЖурналаРегистрации("АРМ.ОшибкаЗаписиПоля", УровеньЖурналаРегистрации.Ошибка,,,
+			СтрШаблон("Поле %1: %2", ИмяПоля, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
+		Возврат "Не удалось сохранить значение: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
+	КонецПопытки;
+
+	Возврат "";
+
+КонецФункции
