+&НаСервере
+Функция ПодготовитьИПровестиЗаказыНаСервере(МассивКлючейСвязи) /// удалить
+	
+	Пользователь = ПараметрыСеанса.ТекущийПользователь;
+	
+	ЗапросВалидация = Новый Запрос;
+	ЗапросВалидация.Текст = 
