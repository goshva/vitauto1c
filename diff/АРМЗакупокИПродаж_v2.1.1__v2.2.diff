+
+&НаСервере
+Процедура Арм_ПриСозданииНаСервереПосле(Отказ, СтандартнаяОбработка)
+	
+	ДобавитьНаФормуНовыеРеквизиты();
+	
+	ЗапретитьПроводитьДокумент(); 
+	
+	АРМ_ИнициализироватьТабличныйДокументЗагрузки();
+	
+КонецПроцедуры
+
+&НаКлиенте
+Процедура АРМ_ЗагрузитьДанные(Команда)
+	
+	АРМ_ЗагрузитьДанныеНаСервере();
+	Модифицированность = Истина;
+	
+КонецПроцедуры
+
+&НаСервере
+Процедура АРМ_ЗагрузитьДанныеНаСервере()
+	
+	Объект.Запасы.Очистить();
+	
+	ВысотаДокумента = ЭтотОбъект.АРМ_ДанныеЗагрузки.ВысотаТаблицы;
+	
+	Для НомерСтроки = 2 По ВысотаДокумента Цикл
+		
+		Артикул = СокрЛП(ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(НомерСтроки, 6).Текст);
+		Наименование = СокрЛП(ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(НомерСтроки, 7).Текст);
+		
+		Если ПустаяСтрока(Артикул) И ПустаяСтрока(Наименование) Тогда
+			Продолжить;
+		КонецЕсли;
+		
+		НоваяСтрока = Объект.Запасы.Добавить();
+		
+		НоваяСтрока.НомерКлиента = СокрЛП(ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(НомерСтроки, 1).Текст);
+		НоваяСтрока.СрочностьКлиента = СокрЛП(ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(НомерСтроки, 3).Текст);
+		НоваяСтрока.ГРЗКлиента = СокрЛП(ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(НомерСтроки, 4).Текст);
+		
+		
+		НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
+		
+		ТекстТерритория = СокрЛП(ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(НомерСтроки, 5).Текст);
+		Если НЕ ПустаяСтрока(ТекстТерритория) Тогда
+			НоваяСтрока.ТерриторияКлиента = ТекстТерритория;
+		КонецЕсли;
+		
+		НоваяСтрока.АртикулКлиента = Артикул;
+		НоваяСтрока.НоменклатураКлиента = Наименование;
+		
+		ТекстКоличество = СокрЛП(ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(НомерСтроки, 9).Текст);
+		Если НЕ ПустаяСтрока(ТекстКоличество) Тогда
+			
+			НоваяСтрока.КоличествоКлиента = ТекстКоличество;
+			
+		КонецЕсли;
+		
+	КонецЦикла;
+	
+КонецПроцедуры
+
+&НаСервере
+Процедура ЗапретитьПроводитьДокумент()
+	
+	Если РольДоступна("Арм_Администратор") Тогда
+		Возврат;
+	КонецЕсли;
+	
+	СписокЭлементов = "ФормаПровести,ФормаПровестиИЗакрыть,ФормаЗаписатьИПровести";
+	Для Каждого ИмяЭлемента Из СтрРазделить(СписокЭлементов, ",") Цикл
+		Элемент = Элементы.Найти(ИмяЭлемента);
+		Если Элемент <> Неопределено Тогда
+			Элемент.Видимость = Ложь;
+		КонецЕсли;
+	КонецЦикла;
+	
+Конецпроцедуры
+
+
+&НаСервере
+Процедура ДобавитьНаФормуНовыеРеквизиты()
+	
+	Если ЭтотОбъект.Элементы.Найти("НомерЗаказаКлиента") = Неопределено Тогда
+		
+		РодительЭлемента = ЭтотОбъект.Элементы.Найти("ШапкаПраво");
+		Если РодительЭлемента = Неопределено Тогда
+			РодительЭлемента = ЭтотОбъект.Элементы.Найти("ГруппаНомерДата");
+		КонецЕсли;
+		
+		НовыйЭлемент = ЭтотОбъект.Элементы.Добавить("НомерЗаказаКлиента", Тип("ПолеФормы"), РодительЭлемента);
+		НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
+		
+		НовыйЭлемент.ПутьКДанным = "Объект.НомерЗаказаКлиента";
+		
+		НовыйЭлемент.Заголовок = "Номер заказа клиента";
+		НовыйЭлемент.РастягиватьПоГоризонтали = Истина;
+		
+		ЦелевойСосед = ЭтотОбъект.Элементы.Найти("ГруппаНомерДата");
+		Если ЦелевойСосед <> Неопределено Тогда
+			ЭтотОбъект.Элементы.Переместить(НовыйЭлемент, РодительЭлемента, ЦелевойСосед);
+		КонецЕсли;
+		
+	КонецЕсли;
+	
+	ТаблицаЗапасы = Элементы.Запасы;
+	
+	Якорь = Элементы.ЗапасыНоменклатура.Родитель; 
+	
+	ИмяКолонки1 = "НоменклатураКлиента";
+	Если Элементы.Найти(ИмяКолонки1) = Неопределено Тогда
+		
+		КолонкаНом = Элементы.Вставить(ИмяКолонки1, Тип("ПолеФормы"), ТаблицаЗапасы, Якорь);
+		КолонкаНом.Вид = ВидПоляФормы.ПолеВвода;
+		КолонкаНом.ПутьКДанным = "Объект.Запасы.НоменклатураКлиента";
+		КолонкаНом.Заголовок = "Номенклатура (клиент)";
+		КолонкаНом.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
+		
+	КонецЕсли;
+	
+	ИмяКолонки2 = "АртикулКлиента";
+	Если Элементы.Найти(ИмяКолонки2) = Неопределено Тогда
+		
+		КолонкаАрт = Элементы.Вставить(ИмяКолонки2, Тип("ПолеФормы"), ТаблицаЗапасы, Якорь);
+		КолонкаАрт.Вид = ВидПоляФормы.ПолеВвода;
+		КолонкаАрт.ПутьКДанным = "Объект.Запасы.АртикулКлиента";
+		КолонкаАрт.Заголовок = "Артикул (клиент)";
+		КолонкаАрт.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
+	КонецЕсли;
+	
+	ИмяКолонки3 = "НомерКлиента";
+	Если Элементы.Найти(ИмяКолонки3) = Неопределено Тогда
+		
+		КолонкаНмр = Элементы.Вставить(ИмяКолонки3, Тип("ПолеФормы"), ТаблицаЗапасы, Якорь);
+		КолонкаНмр.Вид = ВидПоляФормы.ПолеВвода;
+		КолонкаНмр.ПутьКДанным = "Объект.Запасы.НомерКлиента";
+		КолонкаНмр.Заголовок = "Номер (клиент)";
+		КолонкаНмр.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
+	КонецЕсли;
+	
+	ИмяКолонки4 = "КоличествоКлиента";
+	Если Элементы.Найти(ИмяКолонки4) = Неопределено Тогда
+		
+		КолонкаКол = Элементы.Вставить(ИмяКолонки4, Тип("ПолеФормы"), ТаблицаЗапасы, Якорь);
+		КолонкаКол.Вид = ВидПоляФормы.ПолеВвода;
+		КолонкаКол.ПутьКДанным = "Объект.Запасы.КоличествоКлиента";
+		КолонкаКол.Заголовок = "Количество (клиент)";
+		КолонкаКол.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
+	КонецЕсли;
+	
+	ИмяКолонки5 = "ГРЗКлиента";
+	Если Элементы.Найти(ИмяКолонки5) = Неопределено Тогда
+		
+		КолонкаГРЗ = Элементы.Вставить(ИмяКолонки5, Тип("ПолеФормы"), ТаблицаЗапасы, Якорь);
+		КолонкаГРЗ.Вид = ВидПоляФормы.ПолеВвода;
+		КолонкаГРЗ.ПутьКДанным = "Объект.Запасы.ГРЗКлиента";
+		КолонкаГРЗ.Заголовок = "ГРЗ (клиент)";
+		КолонкаГРЗ.ФиксацияВТаблице = ФиксацияВТаблице.Лево;
+	КонецЕсли;
+	
+	МассивРеквизитов = Новый Массив;
+	МассивРеквизитов.Добавить(Новый РеквизитФормы("АРМ_ДанныеЗагрузки", Новый ОписаниеТипов("ТабличныйДокумент")));
+	ИзменитьРеквизиты(МассивРеквизитов);
+	
+	СоздатьВкладкуЗагрузки();
+	
+КонецПроцедуры
+
+&НаСервере
+Процедура СоздатьВкладкуЗагрузки()
+	
+	// Находим родительский элемент Страницы
+	РодительСтраниц = Элементы.Найти("Страницы");
+	Если РодительСтраниц = Неопределено Тогда
+		Возврат;
+	КонецЕсли;
+	
+	// Создаем новую вкладку "Загрузка"
+	НоваяВкладка = ЭтаФорма.Элементы.Добавить("АРМ_СтраницаЗагрузка", Тип("ГруппаФормы"), РодительСтраниц);
+	НоваяВкладка.Вид = ВидГруппыФормы.Страница;
+	НоваяВкладка.Заголовок = "Загрузка";
+	
+	// Создаем группу для командной панели на вкладке
+	ГруппаКоманднаяПанель = ЭтаФорма.Элементы.Добавить("АРМ_КоманднаяПанельЗагрузка", Тип("ГруппаФормы"), НоваяВкладка);
+	ГруппаКоманднаяПанель.Вид = ВидГруппыФормы.КоманднаяПанель;
+	
+	// Создаем команду "Загрузить"
+	НоваяКоманда = ЭтаФорма.Команды.Добавить("АРМ_ЗагрузитьДанные");
+	НоваяКоманда.Заголовок = "Загрузить";
+	НоваяКоманда.Действие = "АРМ_ЗагрузитьДанные";
+	
+	// Создаем кнопку для команды
+	КнопкаЗагрузить = ЭтаФорма.Элементы.Добавить("АРМ_КнопкаЗагрузить", Тип("КнопкаФормы"), ГруппаКоманднаяПанель);
+	КнопкаЗагрузить.ИмяКоманды = "АРМ_ЗагрузитьДанные";
+	
+	// Создаем поле табличного документа с возможностью редактирования
+	ПолеТабличногоДокумента = ЭтаФорма.Элементы.Добавить("АРМ_ПолеДанныеЗагрузки", Тип("ПолеФормы"), НоваяВкладка);
+	ПолеТабличногоДокумента.Вид = ВидПоляФормы.ПолеТабличногоДокумента;
+	ПолеТабличногоДокумента.ПутьКДанным = "АРМ_ДанныеЗагрузки";
+	ПолеТабличногоДокумента.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
+	ПолеТабличногоДокумента.Редактирование = Истина;
+	ПолеТабличногоДокумента.УстановитьДействие("ПриИзменении", "АРМ_ДанныеЗагрузкиПриИзменении");
+	
+КонецПроцедуры
+
+&НаСервере
+Процедура АРМ_ИнициализироватьТабличныйДокументЗагрузки()
+	
+	ЭтотОбъект.АРМ_ДанныеЗагрузки = Новый ТабличныйДокумент;
+	
+	// Устанавливаем заголовки колонок
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 1).Текст = "Номер";
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 2).Текст = "Дата заказа";
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 3).Текст = "Срочность";
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 4).Текст = "ГРЗ";
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 5).Текст = "Территория";
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 6).Текст = "Артикул";
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 7).Текст = "Наименование";
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 8).Текст = "Единица измерения";
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 9).Текст = "Количество";
+	
+	// Создаём линию для рамки ячеек
+	ЛинияРамки = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
+	
+	// Форматируем шапку и устанавливаем защиту от редактирования
+	Для НомерКолонки = 1 По 9 Цикл
+		
+		ОбластьЯчейки = ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, НомерКолонки);
+		ОбластьЯчейки.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
+		ОбластьЯчейки.ЦветФона = WebЦвета.СеребристоСерый;
+		ОбластьЯчейки.Защита = Истина;
+		ОбластьЯчейки.Обвести(ЛинияРамки, ЛинияРамки, ЛинияРамки, ЛинияРамки);
+		
+	КонецЦикла;
+	
+	// Фиксируем шапку
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.ФиксацияСверху = 1;
+	
+	// Устанавливаем ширину колонок
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 1).ШиринаКолонки = 12;  // Номер
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 2).ШиринаКолонки = 12;  // Дата заказа
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 3).ШиринаКолонки = 12;  // Срочность
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 4).ШиринаКолонки = 12;  // ГРЗ
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 5).ШиринаКолонки = 15;  // Территория
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 6).ШиринаКолонки = 15;  // Артикул
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 7).ШиринаКолонки = 60;  // Наименование
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 8).ШиринаКолонки = 15;  // Единица измерения
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.Область(1, 9).ШиринаКолонки = 12;  // Количество
+	
+	// Отключаем режим просмотра - это позволит редактировать ячейки без защиты
+	ЭтотОбъект.АРМ_ДанныеЗагрузки.ТолькоПросмотр = ЛОЖЬ;
+
+КонецПроцедуры
