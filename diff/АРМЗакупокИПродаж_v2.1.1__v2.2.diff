diff --git "a/C:\\Users\\Pavel\\AppData\\Local\\Temp\\diff-cfe-empty.txt" "b/C:\\Users\\Pavel\\Desktop\\vitauto1c\\src\\АРМЗакупокИПродаж_v2.2\\InformationRegister\\Арм_ДанныеЗакупокИПродаж\\InformationRegister.mgr.bsl"
