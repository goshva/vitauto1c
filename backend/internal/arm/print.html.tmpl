<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><title>{{.Title}}</title>
<style>
  body { font-family: Arial, sans-serif; font-size: 10pt; margin: 12mm; color: #000; }
  .page { page-break-after: always; }
  .page:last-child { page-break-after: auto; }
  h1 { font-size: 14pt; margin: 0 0 4mm; }
  p { margin: 0 0 1.5mm; }
  table { width: 100%; border-collapse: collapse; margin: 4mm 0 2mm; font-size: 9pt; }
  th, td { border: 1px solid #000; padding: 1mm 1.5mm; vertical-align: top; }
  th { font-weight: bold; text-align: center; }
  td.n { text-align: right; white-space: nowrap; }
  td.c { text-align: center; }
  .total { font-weight: bold; margin-bottom: 6mm; }
  .sign { margin-bottom: 6mm; }
  .batch { color: #333; font-size: 8pt; }
</style></head><body>
{{range .Orders}}<div class="page">
  <h1>{{.Title}}</h1>
  {{range .Lines}}<p>{{.}}</p>{{end}}
  <table>
  {{if .Assembly}}
    <tr><th style="width:5%">№</th><th style="width:12%">Ячейка</th><th style="width:16%">Артикул</th><th>Наименование</th><th style="width:8%">Кол-во</th><th style="width:9%">Собрано</th><th style="width:22%">Дефект / недостача</th></tr>
    {{range .Rows}}<tr><td class="n">{{.No}}</td><td>{{.Cell}}</td><td>{{.Article}}</td><td>{{.Name}}{{if .Batch}}<br><span class="batch">партия: {{.Batch}}</span>{{end}}</td><td class="n">{{qty .Qty}}</td><td class="c">☐</td><td></td></tr>{{end}}
  {{else}}
    <tr><th style="width:5%">№</th><th style="width:16%">Артикул</th><th>Наименование</th><th style="width:7%">Ед.</th><th style="width:9%">Кол-во</th><th style="width:12%">Цена</th><th style="width:13%">Сумма</th></tr>
    {{range .Rows}}<tr><td class="n">{{.No}}</td><td>{{.Article}}</td><td>{{.Name}}</td><td>{{.Unit}}</td><td class="n">{{qty .Qty}}</td><td class="n">{{money .Price}}</td><td class="n">{{money .Sum}}</td></tr>{{end}}
  {{end}}
  </table>
  <p class="total">Позиций: {{.Count}}, количество: {{qty .QtyTotal}}{{if .Prices}}, сумма: {{money .Total}}{{end}}</p>
  {{range .Signs}}<p class="sign">{{.}}</p>{{end}}
</div>{{end}}
</body></html>
