<!doctype html>
<html lang="ru"><head><meta charset="utf-8"><title>Заказ-наряд</title>
<style>
  body { font-family: Arial, sans-serif; font-size: 10pt; margin: 12mm; color: #000; }
  .page { page-break-after: always; }
  .page:last-child { page-break-after: auto; }
  h1 { font-size: 14pt; margin: 0 0 4mm; }
  p { margin: 0 0 1.5mm; }
  table { width: 100%; border-collapse: collapse; margin: 4mm 0 2mm; font-size: 9pt; }
  th, td { border: 1px solid #000; padding: 1mm 1.5mm; vertical-align: top; }
  th { font-weight: bold; text-align: center; }
  td.n { text-align: right; white-space: nowrap; }
  h2 { font-size: 11pt; margin: 4mm 0 1mm; }
  .total { font-weight: bold; margin-bottom: 2mm; }
  .grand { font-weight: bold; font-size: 11pt; margin-bottom: 6mm; }
  .sign { margin-bottom: 6mm; }
</style></head><body>
{{range .Orders}}<div class="page">
  <h1>Заказ-наряд № {{.Number}} от {{.Date}}</h1>
  {{range .Lines}}<p>{{.}}</p>{{end}}
  <h2>Работы (нормо-часы)</h2>
  <table>
    <tr><th style="width:5%">№</th><th>Наименование работ / услуг</th><th style="width:12%">Нормо-часы</th><th style="width:13%">Ставка</th><th style="width:14%">Сумма</th></tr>
    {{range .Labor}}<tr><td class="n">{{.No}}</td><td>{{.Name}}</td><td class="n">{{qty .Qty}}</td><td class="n">{{money .Price}}</td><td class="n">{{money .Sum}}</td></tr>{{end}}
    {{if not .Labor}}<tr><td colspan="5">—</td></tr>{{end}}
  </table>
  <p class="total">Работы: {{qty .NormHoursTotal}} н/ч{{if gt .LaborSum 0.0}}, сумма: {{money .LaborSum}}{{end}}</p>
  <h2>Запчасти и материалы</h2>
  <table>
    <tr><th style="width:5%">№</th><th style="width:16%">Артикул</th><th>Наименование</th><th style="width:7%">Ед.</th><th style="width:9%">Кол-во</th><th style="width:22%">Статус обеспечения</th></tr>
    {{range .Parts}}<tr><td class="n">{{.No}}</td><td>{{.Article}}</td><td>{{.Name}}</td><td>{{.Unit}}</td><td class="n">{{qty .Qty}}</td><td>{{.Status}}</td></tr>{{end}}
    {{if not .Parts}}<tr><td colspan="6">—</td></tr>{{end}}
  </table>
  <p class="total">Позиций: {{.PartsCount}}, количество: {{qty .PartsQtyTotal}}{{if gt .PartsSum 0.0}}, сумма: {{money .PartsSum}}{{end}}</p>
  {{if gt .GrandTotal 0.0}}<p class="grand">Итого: {{money .GrandTotal}}</p>{{end}}
  {{if .Comment}}<p>Примечание: {{.Comment}}</p>{{end}}
  <p class="sign">Принял в ремонт ____________________ / ____________________</p>
  <p class="sign">Выполнил ____________________ / ____________________</p>
  <p class="sign">Авто выдал ____________________ / ____________________ &nbsp;&nbsp; Клиент получил ____________________ / ____________________ &nbsp; дата ____________</p>
</div>{{end}}
</body></html>
