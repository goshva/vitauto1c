// Внешняя печатная форма «Заказ-наряд (ВИТ)» для документа «Заказ-наряд» (Документ.асЗаказНаряд).
// Отличия от типового заказ-наряда — по пометкам заказчика (октябрь 2026):
//  - шапка: год выпуска без дня и месяца, без пробега; «Вид ремонта» → «Заявка», «Диспетчер» → «Дата окончания»,
//    без «в валюте / руб.»;
//  - работы: «Наименование работ» без артикула, колонки «Ед. изм.» и «Кол-во», «Цена»; без «Итого/НДС» по работам;
//  - товары: отдельная колонка «Артикул», «Ед. изм.» перед «Кол-во»; без «Итого/НДС» по товарам;
//  - без колонок скидки, без строки «Плательщик», без «Причины обращения», гарантий и рекомендаций;
//  - внизу — текст о стоимости и подписи исполнителя и заказчика (как в шаблоне акта заказчика).

#Область ПрограммныйИнтерфейс

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = ДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке("2.2.2.1");
	ПараметрыРегистрации.Вид    = ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиПечатнаяФорма();
	ПараметрыРегистрации.Версия = "1.0";
	ПараметрыРегистрации.Назначение.Добавить("Документ.асЗаказНаряд");

	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление        = НСтр("ru = 'Заказ-наряд (ВИТ)'");
	НоваяКоманда.Идентификатор        = "ЗаказНарядВИТ";
	НоваяКоманда.Использование        = ДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыВызовСерверногоМетода();
	НоваяКоманда.ПоказыватьОповещение = Ложь;
	НоваяКоманда.Модификатор          = "ПечатьMXL";

	Возврат ПараметрыРегистрации;

КонецФункции

Процедура Печать(МассивОбъектов, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ЗаказНарядВИТ") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ЗаказНарядВИТ",
			НСтр("ru = 'Заказ-наряд (ВИТ)'"), СформироватьЗаказНаряд(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;

КонецПроцедуры

// Табличный документ заказ-наряда; можно вызывать и без БСП (для проверки).
Функция СформироватьЗаказНаряд(МассивОбъектов, ОбъектыПечати = Неопределено) Экспорт

	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ЗаказНарядВИТ";
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ПолеСлева = 10;
	ТабДок.ПолеСправа = 10;
	ТабДок.ПолеСверху = 10;
	ТабДок.ПолеСнизу = 10;

	Макет = ПолучитьМакет("ПФ_MXL_ЗаказНарядВИТ");

	ПервыйДокумент = Истина;
	Для Каждого Ссылка Из МассивОбъектов Цикл

		Если Не ПервыйДокумент Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабДок.ВысотаТаблицы + 1;

		ВывестиДокумент(ТабДок, Макет, Ссылка);

		Если ОбъектыПечати <> Неопределено Тогда
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДок, НомерСтрокиНачало, ОбъектыПечати, Ссылка);
		КонецЕсли;

	КонецЦикла;

	Возврат ТабДок;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВывестиДокумент(ТабДок, Макет, Ссылка)

	Шапка = ДанныеШапки(Ссылка);
	Валюта = Шапка.ВалютаДокумента;

	НомерДок = ПечатьДокументовУНФ.ПолучитьНомерНаПечатьСУчетомДатыДокумента(Шапка.Дата, Шапка.Номер, Шапка.Префикс);
	ДатаДокКратко = Формат(Шапка.Дата, "ДФ=dd.MM.yyyy");

	СведенияОбОрганизации = ПечатьДокументовУНФ.СведенияОЮрФизЛице(Шапка.Организация, Шапка.Дата);
	СведенияОЗаказчике    = ПечатьДокументовУНФ.СведенияОЮрФизЛице(Шапка.Заказчик, Шапка.Дата);
	СведенияОбАвтомобиле  = асАвтосервисСервер.ПолучитьСведенияОбАвтомобиле(Шапка.Автомобиль, Шапка.Дата, Истина);

	// Заголовок
	Область = Макет.ПолучитьОбласть("Заголовок");
	Область.Параметры.Заполнить(Новый Структура("ФирмаПолноеНаименование, НомерДок, ДатаДок",
		ПечатьДокументовУНФ.ОписаниеОрганизации(СведенияОбОрганизации, "ПолноеНаименование,ИНН,КПП,ЮридическийАдрес,Телефоны,"),
		НомерДок,
		Формат(Шапка.Дата, "ДЛФ=DD")));
	ТабДок.Вывести(Область);

	// Шапка
	Область = Макет.ПолучитьОбласть("Шапка");
	ЗначенияШапки = Новый Структура;
	ЗначенияШапки.Вставить("ЗаказчикПолноеНаименование", СведенияОЗаказчике.ПолноеНаименование);
	ЗначенияШапки.Вставить("ЗаказчикАдрес", ПечатьДокументовУНФ.КонтактнаяИнформация(Шапка.Заказчик,
		Справочники.ВидыКонтактнойИнформации.ФактАдресКонтрагента));
	ЗначенияШапки.Вставить("ЗаказчикТелефоны", СведенияОЗаказчике.Телефоны);
	ЗначенияШапки.Вставить("АвтомобильМодель", СведенияОбАвтомобиле.Модель);
	ЗначенияШапки.Вставить("АвтомобильГосНомер", СведенияОбАвтомобиле.ГосНомер);
	ЗначенияШапки.Вставить("АвтомобильVIN", СведенияОбАвтомобиле.VIN);
	ЗначенияШапки.Вставить("АвтомобильГод", ГодВыпуска(СведенияОбАвтомобиле.ГодВыпуска));
	ЗначенияШапки.Вставить("Принят", Формат(?(ЗначениеЗаполнено(Шапка.ДатаСоздания), Шапка.ДатаСоздания, Шапка.Дата), "ДФ=dd.MM.yyyy"));
	ЗначенияШапки.Вставить("Заявка", ПредставлениеЗаявки(Шапка, НомерДок));
	ЗначенияШапки.Вставить("ДатаОкончания", Формат(Шапка.ДатаОкончания, "ДФ=dd.MM.yyyy"));
	ЗначенияШапки.Вставить("Мастер", ?(ЗначениеЗаполнено(Шапка.Мастер), Строка(Шапка.Мастер), ""));
	Область.Параметры.Заполнить(ЗначенияШапки);
	ТабДок.Вывести(Область);

	ИтогоВсего = 0;
	ИтогоНДС   = 0;
	СтавкиНДС  = Новый Соответствие;

	// Работы
	Работы = ДанныеРабот(Ссылка);
	Если Работы.Количество() > 0 Тогда

		Область = Макет.ПолучитьОбласть("ШапкаРабот");
		Область.Параметры.Заполнить(Новый Структура("НомерДок, ДатаДокКратко", НомерДок, ДатаДокКратко));
		ТабДок.Вывести(Область);

		ВсегоРабот = 0;
		ОбластьСтроки = Макет.ПолучитьОбласть("СтрокаРабот");
		Для Каждого СтрокаТЧ Из Работы Цикл
			Количество = СтрокаТЧ.Количество * ?(СтрокаТЧ.Коэффициент = 0, 1, СтрокаТЧ.Коэффициент);
			Цена = ?(СтрокаТЧ.Цена = 0 И Количество <> 0, СтрокаТЧ.Сумма / Количество, СтрокаТЧ.Цена);
			ОбластьСтроки.Параметры.Заполнить(Новый Структура(
				"НомСтр, Наименование, ЕдиницаИзмерения, Количество, Нормочас, Цена, Сумма",
				СтрокаТЧ.НомерСтроки,
				?(ЗначениеЗаполнено(СтрокаТЧ.Содержание), СтрокаТЧ.Содержание, СтрокаТЧ.НаименованиеНоменклатуры),
				"шт.", // по пометке заказчика: работы — в штуках (единица нормы времени — в колонке «н/ч»)
				Формат(Количество, "ЧДЦ=3; ЧН=0,000"),
				?(ЗначениеЗаполнено(СтрокаТЧ.Нормочас), Строка(СтрокаТЧ.Нормочас), ""),
				ПечатьДокументовУНФ.ФорматСумм(Цена),
				ПечатьДокументовУНФ.ФорматСумм(СтрокаТЧ.Сумма)));
			ТабДок.Вывести(ОбластьСтроки);
			ВсегоРабот = ВсегоРабот + СтрокаТЧ.Всего;
			ИтогоНДС   = ИтогоНДС + СтрокаТЧ.СуммаНДС;
			УчестьСтавку(СтавкиНДС, СтрокаТЧ.СтавкаНДС, СтрокаТЧ.СуммаНДС);
		КонецЦикла;

		Область = Макет.ПолучитьОбласть("ВсегоРабот");
		Область.Параметры.Всего = ПечатьДокументовУНФ.ФорматСумм(ВсегоРабот);
		ТабДок.Вывести(Область);

		Область = Макет.ПолучитьОбласть("ПодвалРабот");
		Область.Параметры.Заполнить(Новый Структура("Сумма, СуммаПрописью",
			ПечатьДокументовУНФ.ФорматСумм(ВсегоРабот),
			РаботаСКурсамиВалют.СформироватьСуммуПрописью(ВсегоРабот, Валюта)));
		ТабДок.Вывести(Область);

		ИтогоВсего = ИтогоВсего + ВсегоРабот;

	КонецЕсли;

	// Товары
	Товары = ДанныеТоваров(Ссылка);
	Если Товары.Количество() > 0 Тогда

		Область = Макет.ПолучитьОбласть("ШапкаТоваров");
		Область.Параметры.Заполнить(Новый Структура("НомерДок, ДатаДокКратко", НомерДок, ДатаДокКратко));
		ТабДок.Вывести(Область);

		ВсегоТоваров = 0;
		ОбластьСтроки = Макет.ПолучитьОбласть("СтрокаТоваров");
		Для Каждого СтрокаТЧ Из Товары Цикл
			Наименование = ?(ЗначениеЗаполнено(СтрокаТЧ.Содержание), СтрокаТЧ.Содержание, СтрокаТЧ.НаименованиеНоменклатуры);
			Если ЗначениеЗаполнено(СтрокаТЧ.Характеристика) Тогда
				Наименование = Наименование + " (" + Строка(СтрокаТЧ.Характеристика) + ")";
			КонецЕсли;
			ПараметрыКода = Новый Структура("Код, Артикул", СтрокаТЧ.Код, СтрокаТЧ.Артикул);
			ОбластьСтроки.Параметры.Заполнить(Новый Структура(
				"НомСтр, Наименование, Артикул, ЕдиницаИзмерения, Количество, Цена, Сумма",
				СтрокаТЧ.НомерСтроки,
				Наименование,
				ПечатьДокументовУНФ.ПредставлениеКодаНоменклатуры(ПараметрыКода),
				?(ЗначениеЗаполнено(СтрокаТЧ.ЕдиницаИзмерения), Строка(СтрокаТЧ.ЕдиницаИзмерения), ""),
				Формат(СтрокаТЧ.Количество, "ЧДЦ=3; ЧН=0,000"),
				ПечатьДокументовУНФ.ФорматСумм(СтрокаТЧ.Цена),
				ПечатьДокументовУНФ.ФорматСумм(СтрокаТЧ.Сумма)));
			ТабДок.Вывести(ОбластьСтроки);
			ВсегоТоваров = ВсегоТоваров + СтрокаТЧ.Всего;
			ИтогоНДС     = ИтогоНДС + СтрокаТЧ.СуммаНДС;
			УчестьСтавку(СтавкиНДС, СтрокаТЧ.СтавкаНДС, СтрокаТЧ.СуммаНДС);
		КонецЦикла;

		Область = Макет.ПолучитьОбласть("ВсегоТоваров");
		Область.Параметры.Всего = ПечатьДокументовУНФ.ФорматСумм(ВсегоТоваров);
		ТабДок.Вывести(Область);

		Область = Макет.ПолучитьОбласть("ПодвалТоваров");
		Область.Параметры.Заполнить(Новый Структура("Сумма, СуммаПрописью",
			ПечатьДокументовУНФ.ФорматСумм(ВсегоТоваров),
			РаботаСКурсамиВалют.СформироватьСуммуПрописью(ВсегоТоваров, Валюта)));
		ТабДок.Вывести(Область);

		ИтогоВсего = ИтогоВсего + ВсегоТоваров;

	КонецЕсли;

	// Итого по заказ-наряду
	Область = Макет.ПолучитьОбласть("Итого");
	Область.Параметры.Заполнить(Новый Структура("Всего, ВсегоНДС",
		ПечатьДокументовУНФ.ФорматСумм(ИтогоВсего),
		?(ИтогоНДС = 0, "-", ПечатьДокументовУНФ.ФорматСумм(ИтогоНДС))));
	ТабДок.Вывести(Область);

	// Подвал: текст о стоимости и подписи
	ТекстСтоимости = СтрШаблон(
		НСтр("ru = 'Стоимость выполненных работ, включая стоимость запасных частей и расходных материалов, составляет %1 руб. (%2)'"),
		ПечатьДокументовУНФ.ФорматСумм(ИтогоВсего),
		РаботаСКурсамиВалют.СформироватьСуммуПрописью(ИтогоВсего, Валюта));
	Если ИтогоНДС <> 0 Тогда
		ТекстСтоимости = ТекстСтоимости + СтрШаблон(НСтр("ru = ', в т.ч. %1 %2 руб. (%3)'"),
			ЗаголовокНДС(СтавкиНДС),
			ПечатьДокументовУНФ.ФорматСумм(ИтогоНДС),
			РаботаСКурсамиВалют.СформироватьСуммуПрописью(ИтогоНДС, Валюта));
	Иначе
		ТекстСтоимости = ТекстСтоимости + НСтр("ru = ', без НДС'");
	КонецЕсли;
	ТекстСтоимости = ТекстСтоимости + ".";

	Должность = "";
	ФИО = "";
	Если ЗначениеЗаполнено(Шапка.РасшифровкаПодписиРуководителя) Тогда
		Должность = Строка(Шапка.ДолжностьРуководителя);
		ФИО = Шапка.РасшифровкаПодписиРуководителя;
	ИначеЕсли ЗначениеЗаполнено(Шапка.РасшифровкаПодписиРуководителяОрганизации) Тогда
		Должность = Строка(Шапка.ДолжностьРуководителяОрганизации);
		ФИО = Шапка.РасшифровкаПодписиРуководителяОрганизации;
	КонецЕсли;
	Если ПустаяСтрока(ФИО) Тогда
		ФИО = "_______________";
	КонецЕсли;

	Область = Макет.ПолучитьОбласть("Подвал");
	ЗначенияПодвала = Новый Структура;
	ЗначенияПодвала.Вставить("ТекстСтоимости", ТекстСтоимости);
	ЗначенияПодвала.Вставить("ИсполнительНаименование", ?(ЗначениеЗаполнено(Шапка.ОрганизацияСокращенно),
		Шапка.ОрганизацияСокращенно, СведенияОбОрганизации.ПолноеНаименование));
	ЗначенияПодвала.Вставить("ДолжностьРуководителя", Должность);
	ЗначенияПодвала.Вставить("РуководительФИО", ФИО);
	ЗначенияПодвала.Вставить("ЗаказчикНаименование", СведенияОЗаказчике.ПолноеНаименование);
	ЗначенияПодвала.Вставить("ДатаПодписи", ДатаДокКратко + " г.");
	Область.Параметры.Заполнить(ЗначенияПодвала);
	ТабДок.Вывести(Область);

	ТабДок.ВерхнийКолонтитул.Выводить = Истина;
	ТабДок.ВерхнийКолонтитул.ТекстСправа = "Заказ-наряд № " + НомерДок + " от " + ДатаДокКратко + " г.";

КонецПроцедуры

Функция ДанныеШапки(Ссылка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Д.Номер КАК Номер,
	|	Д.Дата КАК Дата,
	|	Д.Организация КАК Организация,
	|	Д.Организация.Префикс КАК Префикс,
	|	Д.Организация.НаименованиеСокращенное КАК ОрганизацияСокращенно,
	|	Д.Заказчик КАК Заказчик,
	|	Д.Автомобиль КАК Автомобиль,
	|	Д.ДатаСоздания КАК ДатаСоздания,
	|	Д.ДатаНачала КАК ДатаНачала,
	|	Д.ДатаОкончания КАК ДатаОкончания,
	|	Д.Мастер КАК Мастер,
	|	Д.ДокументОснование КАК ДокументОснование,
	|	Д.ВалютаДокумента КАК ВалютаДокумента,
	|	Д.ПодписьРуководителя.Должность КАК ДолжностьРуководителя,
	|	Д.ПодписьРуководителя.РасшифровкаПодписи КАК РасшифровкаПодписиРуководителя,
	|	Д.Организация.ПодписьРуководителя.Должность КАК ДолжностьРуководителяОрганизации,
	|	Д.Организация.ПодписьРуководителя.РасшифровкаПодписи КАК РасшифровкаПодписиРуководителяОрганизации
	|ИЗ
	|	Документ.асЗаказНаряд КАК Д
	|ГДЕ
	|	Д.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка;

КонецФункции

Функция ДанныеРабот(Ссылка)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Р.НомерСтроки КАК НомерСтроки,
	|	Р.Номенклатура КАК Номенклатура,
	|	ВЫРАЗИТЬ(Р.Содержание КАК СТРОКА(1000)) КАК Содержание,
	|	ВЫРАЗИТЬ(Р.Номенклатура.НаименованиеПолное КАК СТРОКА(1000)) КАК НаименованиеНоменклатуры,
	|	Р.Номенклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Р.Нормочас КАК Нормочас,
	|	Р.Количество КАК Количество,
	|	Р.Коэффициент КАК Коэффициент,
	|	Р.Цена КАК Цена,
	|	Р.Сумма КАК Сумма,
	|	Р.СуммаНДС КАК СуммаНДС,
	|	Р.Всего КАК Всего,
	|	Р.СтавкаНДС КАК СтавкаНДС
	|ИЗ
	|	Документ.асЗаказНаряд.Работы КАК Р
	|ГДЕ
	|	Р.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Возврат Запрос.Выполнить().Выгрузить();

