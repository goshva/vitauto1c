// «Заявка»: номер и дата документа-основания, если он есть, иначе номер заказ-наряда и дата начала работ.
Функция ПредставлениеЗаявки(Шапка, НомерДок)

	Если ЗначениеЗаполнено(Шапка.ДокументОснование) Тогда
		Попытка
			Возврат СтрШаблон("№ %1 от %2",
				ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(Шапка.ДокументОснование.Номер, Истина, Истина),
				Формат(Шапка.ДокументОснование.Дата, "ДФ=dd.MM.yyyy"));
		Исключение
			Возврат Строка(Шапка.ДокументОснование);
		КонецПопытки;
	КонецЕсли;

	ДатаЗаявки = ?(ЗначениеЗаполнено(Шапка.ДатаНачала), Шапка.ДатаНачала, Шапка.Дата);
	Возврат СтрШаблон("№ %1 от %2", НомерДок, Формат(ДатаЗаявки, "ДФ=dd.MM.yyyy"));

КонецФункции

Функция ГодВыпуска(Значение)

	Если ТипЗнч(Значение) = Тип("Дата") Тогда
		Возврат ?(ЗначениеЗаполнено(Значение), Формат(Значение, "ДФ=yyyy") + " г.", "");
	ИначеЕсли ЗначениеЗаполнено(Значение) Тогда
		Возврат Строка(Значение) + " г.";
	КонецЕсли;
	Возврат "";

КонецФункции

Процедура УчестьСтавку(СтавкиНДС, СтавкаНДС, СуммаНДС)

	Если ЗначениеЗаполнено(СтавкаНДС) И СуммаНДС <> 0 Тогда
		СтавкиНДС.Вставить(СтавкаНДС, Истина);
	КонецЕсли;

КонецПроцедуры

// «НДС 22%», если ставка одна; «НДС», если ставок несколько.
Функция ЗаголовокНДС(СтавкиНДС)

	Если СтавкиНДС.Количество() = 1 Тогда
		Для Каждого КлючИЗначение Из СтавкиНДС Цикл
			Возврат "НДС " + Строка(КлючИЗначение.Ключ);
		КонецЦикла;
	КонецЕсли;
	Возврат "НДС";

КонецФункции

