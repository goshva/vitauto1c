// Регистр АрмOData_КомандыPWA: команда АРМ, записанная через OData, выполняется здесь, при записи (см. АрмOData_Команды).
// POST InformationRegister_АрмOData_КомандыPWA {Ид, Команда, Параметры} -> запись с Результат (JSON) и Успешно;
// отказ команды — ошибка OData с текстом «АРМODATA{status, code, message}» (запись не сохраняется).

Процедура ПередЗаписью(Отказ, Замещение)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Запись Из ЭтотОбъект Цикл
		Если ЗначениеЗаполнено(Запись.Команда) И Не ЗначениеЗаполнено(Запись.ДатаВыполнения) Тогда
			Запись.Результат = АрмOData_Команды.ВыполнитьДляЗаписи(Запись.Команда, Запись.Параметры);
			Запись.Успешно = Истина;
			Запись.Пользователь = Строка(ПараметрыСеанса.ТекущийПользователь);
			Запись.ДатаВыполнения = ТекущаяДатаСеанса();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
