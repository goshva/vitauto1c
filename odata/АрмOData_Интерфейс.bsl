// Расширение АРМ_OData: полный состав стандартного интерфейса OData.
// Включает в интерфейс все объекты конфигурации и подключённых расширений (в т.ч. Арм_* из АРМЗакупокИПродаж),
// которые OData поддерживает: константы, справочники, документы, журналы документов, перечисления,
// планы видов характеристик, планы счетов, планы видов расчёта, регистры сведений, накопления, бухгалтерии,
// расчёта, бизнес-процессы, задачи, планы обмена.
// Вызов: из 1С (Администратор) или через COM — tools\enable-odata.ps1. Состав хранится в ИБ, повторять нужно
// только после изменения конфигурации или расширений (новые объекты).

// Включает полный состав. Объект, который платформа не принимает, пропускается (в отчёт).
// Возврат: Структура — Включено (число), Пропущено (Массив строк «ПолноеИмя: причина»), ПоВидам (Соответствие вид -> число).
Функция ВключитьПолныйСоставOData() Экспорт

	Кандидаты = ОбъектыДляOData();
	Состав = Новый Массив;
	Пропущено = Новый Массив;

	// быстрый путь: весь список сразу
	Попытка
		УстановитьСоставСтандартногоИнтерфейсаOData(Кандидаты);
		Состав = Кандидаты;
	Исключение
		// по одному: накапливаем принятые объекты, отвергнутые — в отчёт
		Для Каждого Объект Из Кандидаты Цикл
			Проба = Новый Массив;
			Для Каждого Принятый Из Состав Цикл
				Проба.Добавить(Принятый);
			КонецЦикла;
			Проба.Добавить(Объект);
			Попытка
				УстановитьСоставСтандартногоИнтерфейсаOData(Проба);
				Состав = Проба;
			Исключение
				Пропущено.Добавить(Объект.ПолноеИмя() + ": " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
		УстановитьСоставСтандартногоИнтерфейсаOData(Состав);
	КонецПопытки;

	ПоВидам = Новый Соответствие;
	Для Каждого Объект Из Состав Цикл
		Вид = СтрРазделить(Объект.ПолноеИмя(), ".")[0];
		ПоВидам.Вставить(Вид, ?(ПоВидам[Вид] = Неопределено, 0, ПоВидам[Вид]) + 1);
	КонецЦикла;

	Результат = Новый Структура("Включено, Пропущено, ПоВидам", Состав.Количество(), Пропущено, ПоВидам);
	Возврат Результат;

КонецФункции

// Текущий состав: строки «ПолноеИмя» через перевод строки (для отчёта и проверки).
Функция ТекущийСоставOData() Экспорт

	Имена = Новый Массив;
	Для Каждого Объект Из ПолучитьСоставСтандартногоИнтерфейсаOData() Цикл
		Имена.Добавить(Объект.ПолноеИмя());
	КонецЦикла;
	Возврат СтрСоединить(Имена, Символы.ПС);

КонецФункции

// Сколько объектов могло бы быть в интерфейсе (кандидаты) — для сверки покрытия.
Функция КоличествоКандидатовOData() Экспорт

	Возврат ОбъектыДляOData().Количество();

КонецФункции

Функция ОбъектыДляOData()

	Коллекции = Новый Массив;
	Коллекции.Добавить(Метаданные.Константы);
	Коллекции.Добавить(Метаданные.Справочники);
	Коллекции.Добавить(Метаданные.Документы);
	Коллекции.Добавить(Метаданные.ЖурналыДокументов);
	Коллекции.Добавить(Метаданные.Перечисления);
	Коллекции.Добавить(Метаданные.ПланыВидовХарактеристик);
	Коллекции.Добавить(Метаданные.ПланыСчетов);
	Коллекции.Добавить(Метаданные.ПланыВидовРасчета);
	Коллекции.Добавить(Метаданные.РегистрыСведений);
	Коллекции.Добавить(Метаданные.РегистрыНакопления);
	Коллекции.Добавить(Метаданные.РегистрыБухгалтерии);
	Коллекции.Добавить(Метаданные.РегистрыРасчета);
	Коллекции.Добавить(Метаданные.БизнесПроцессы);
	Коллекции.Добавить(Метаданные.Задачи);
	Коллекции.Добавить(Метаданные.ПланыОбмена);

	Объекты = Новый Массив;
	Для Каждого Коллекция Из Коллекции Цикл
		Для Каждого Объект Из Коллекция Цикл
			Объекты.Добавить(Объект);
		КонецЦикла;
	КонецЦикла;
	Возврат Объекты;

КонецФункции
