// Расширение АРМ_OData: команды АРМ через стандартный интерфейс OData.
// Стандартный OData умеет только читать и писать данные. Команды с логикой АРМ (заказы поставщику, приход,
// отгрузка, проведение, новый заказ с заполнением по умолчанию) PWA выполняет записью в регистр
// АрмOData_КомандыPWA: POST InformationRegister_АрмOData_КомандыPWA {Ид, Команда, Параметры (JSON)} — обработчик
// ПередЗаписью набора выполняет команду в сеансе OData (пользователь PWA, его отметки) внутри транзакции записи:
//   успех        -> запись сохраняется с Результат (JSON), Успешно = Истина; ответ POST — эта запись;
//   отказ, сплит -> исключение «АРМODATA{json}», запись не сохраняется; ответ POST — ошибка OData с этим текстом.
// Отказ нельзя сохранить: процедуры АРМ откатывают свои (вложенные) транзакции, и после этого запись в той же
// транзакции невозможна. Фоновые задания не годятся: в файловой базе сеанс пула OData, запустивший задание,
// теряет типы расширений («Тип не определен …») и портит последующие запросы.
// Объекты АРМЗакупокИПродаж (другое расширение) — через коллекции по имени и Вычислить/Выполнить.
//
// Команды (Параметры — JSON, Результат — JSON):
//   ВРаботе           {allowSplit}                        -> {state: done|need_split|failed, message}
//   СтатусСнабжения   {status, partialReceipt, receiptDate} -> {processed, total}
//   ПровестиЗаказ     {id}                                -> {processed, total}
//   СоздатьЗаказ      {customerId, contractId, clientOrderNumber, date, rows[]} -> {id, kind, number, date, posted}
//   v1.2 (АРМ 2.22):
//   Вычеркнуть          {id}                    -> {processed}            строка продажи + незаказанные закупки, строка заказа покупателя
//   СменитьНоменклатуру {id, nomenclatureId}    -> {changed, warning}     новый ключ связи, незаказанные закупки старой номенклатуры удаляются
//   ПересчитатьСтроку   {id}                    -> {recalculated}         остатки по партиям и авто-закупка при нехватке (как в форме АРМ)
//   Печать              {kind, customerOrderIds[]} -> {html}      v1.3: печатная форма АРМ (Арм_ПечатьСервер)
//   v1.3 (АРМ 2.23): команда выполняется в привилегированном режиме — прямые записи регистра АРМ через OData сервер
//   проверяет по матрице (Арм_ОбщегоНазначенияАРМ.ОтказЗаписиOData), записи из команд — нет; роль и данные команды
//   проверяют сами (ВРаботе — ТекстОтказаПоРоли и т. д.). Роль АрмOData_Пользователь — запись команд без ПолныеПрава.
//   Расширение подключается без безопасного режима (как и АРМ).
// Ошибка команды: {status, code, message}.

#Область ПрограммныйИнтерфейс

// Выполнить команду записи регистра команд: Результат при успехе, иначе исключение «АРМODATA{json}».
Функция ВыполнитьДляЗаписи(Знач Команда, Знач ПараметрыJSON) Экспорт

	// v1.3 (АРМ 2.23, п. 1.10): записи регистра АРМ из команды проверяет команда и код АРМ, а не матрица прямых
	// записей OData (Арм_ОбщегоНазначенияАРМ.ОтказЗаписиOData пропускает привилегированный режим).
	// ВыполнитьКоманду исключения перехватывает — режим снимается всегда.
	УстановитьПривилегированныйРежим(Истина);
	Ответ = ВыполнитьКоманду(Команда, ПараметрыJSON);
	УстановитьПривилегированныйРежим(Ложь);
	Если Не Ответ.Успешно Тогда
		ВызватьИсключение "АРМODATA" + Ответ.Результат;
	ИначеЕсли Команда = "ВРаботе" И Ответ.Данные.state <> "done" Тогда
		ВызватьИсключение "АРМODATA" + Ответ.Результат;   // сплит или отказ задания АРМ (транзакция АРМ уже отменена)
	КонецЕсли;
	Возврат Ответ.Результат;

КонецФункции

// v1.3 (АРМ 2.23, блок 3): печатная форма АРМ по заказам покупателя — HTML табличного документа
// (Арм_ПечатьСервер): {kind: Ведомость | СборочныйЛист | Корректировка, customerOrderIds[]} -> {html}.
Функция Печать(П)

	Вид = Значение(П, "kind", "");
	Заказы = Новый Массив;
	Для Каждого Ид Из Значение(П, "customerOrderIds", Новый Массив) Цикл
		Заказы.Добавить(Документы.ЗаказПокупателя.ПолучитьСсылку(УИД(Ид)));
	КонецЦикла;
	Сформировано = Вычислить("Арм_ПечатьСервер.СформироватьПоЗаказам(Вид, Заказы)");
	Если Сформировано.ТабличныйДокумент = Неопределено Тогда
		ВызватьОшибку(409, "nothing_to_print", Сформировано.Сообщение);
	КонецЕсли;
	ТабличныйДокумент = Сформировано.ТабличныйДокумент;
	Возврат Новый Структура("html", Вычислить("Арм_ПечатьСервер.ВHTML(ТабличныйДокумент)"));

КонецФункции

// Выполнить команду в текущем сеансе. Возврат: Структура Успешно, Результат (JSON).
Функция ВыполнитьКоманду(Знач Команда, Знач ПараметрыJSON) Экспорт

	Попытка
		П = ИзJSON(ПараметрыJSON);
		Если Команда = "ВРаботе" Тогда
			Результат = ВРаботе(П);
		ИначеЕсли Команда = "СтатусСнабжения" Тогда
			Результат = СтатусСнабжения(П);
		ИначеЕсли Команда = "ПровестиЗаказ" Тогда
			Результат = ПровестиЗаказ(П);
		ИначеЕсли Команда = "СоздатьЗаказ" Тогда
			Результат = СоздатьЗаказ(П);
		ИначеЕсли Команда = "СоздатьНоменклатуру" Тогда
			Результат = СоздатьНоменклатуру(П);
		ИначеЕсли Команда = "ЗаполнитьАРМ" Тогда
			Результат = ЗаполнитьАРМ(П);
		ИначеЕсли Команда = "ЦеныАвторабот" Тогда
			Результат = ЦеныАвторабот(П);
		ИначеЕсли Команда = "ЦенаНоменклатуры" Тогда
			Результат = ЦенаНоменклатуры(П);
		ИначеЕсли Команда = "ДанныеАвтомобиля" Тогда
			Результат = ДанныеАвтомобиля(П);
		ИначеЕсли Команда = "Вычеркнуть" Тогда
			Результат = Вычеркнуть(П);
		ИначеЕсли Команда = "СменитьНоменклатуру" Тогда
			Результат = СменитьНоменклатуру(П);
		ИначеЕсли Команда = "ПересчитатьСтроку" Тогда
			Результат = ПересчитатьСтроку(П);
		ИначеЕсли Команда = "Печать" Тогда
			Результат = Печать(П);
		Иначе
			ВызватьОшибку(400, "bad_request", "Команда: ВРаботе, СтатусСнабжения, ПровестиЗаказ, СоздатьЗаказ, СоздатьНоменклатуру, ЦенаНоменклатуры, ДанныеАвтомобиля, Вычеркнуть, СменитьНоменклатуру, ПересчитатьСтроку, Печать");
		КонецЕсли;
		Ответ = Новый Структура("Успешно, Результат, Данные", Истина, ВJSON(Результат), Результат);
	Исключение
		Текст = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		Части = СтрРазделить(Текст, "|");
		Если Части.Количество() >= 4 И СтрНайти(Части[0], "АРМODATA") > 0 Тогда
			Ответ = Новый Структура("Успешно, Результат", Ложь, ВJSON(Проблема(Число(Части[1]), Части[2], Части[3])));
		Иначе
			ЗаписьЖурналаРегистрации("АРМ.OData.Команда", УровеньЖурналаРегистрации.Ошибка, , ,
				Команда + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Ответ = Новый Структура("Успешно, Результат", Ложь, ВJSON(Проблема(409, "command_failed", Текст)));
		КонецЕсли;
	КонецПопытки;
	Возврат Ответ;

КонецФункции

#КонецОбласти

#Область Команды

// «В работе» (узлы M4, K5): отмеченные пользователем ключи связи в статусах «Черновик», «В работе», «Собран» ->
// задание формы АРМ: заказы поставщику по закупкам, расходные накладные по собранным продажам, сплит заказа.
Функция ВРаботе(П)

	// v1.2 (АРМ 2.22, BUG-6): «Заказать» / «Провести заказ» — только менеджер и администратор АРМ.
	ТекущийПользователь = ПараметрыСеанса.ТекущийПользователь;
	ТекстОтказа = Вычислить("Арм_ДанныеЗакупокИПродажФон.ТекстОтказаПоРоли(ТекущийПользователь)");
	Если ЗначениеЗаполнено(ТекстОтказа) Тогда
		ВызватьОшибку(403, "forbidden", ТекстОтказа);
	КонецЕсли;

	Статусы = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Черновик,ВРаботе,Собран", ",") Цикл
		Статусы.Добавить(Статус(Имя));
	КонецЦикла;
	Ключи = Вычислить("Арм_ОбщегоНазначенияАРМ.ПолучитьМассивОтмеченныхКлючейСвязи(Статусы)");
	Если Ключи.Количество() = 0 Тогда
		ВызватьОшибку(409, "nothing_marked", "Нет отмеченных строк в статусах «Черновик», «В работе», «Собран»");
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Рег.ДокументЗаказПокупателя КАК Заказ
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
		|ГДЕ
		|	Рег.КлючСвязиСтрок В (&МассивКлючей)
		|	И НЕ Рег.Удаление");
	Запрос.УстановитьПараметр("МассивКлючей", Ключи);
	Заказы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Заказ");

	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, Новый УникальныйИдентификатор);
	ПП = Новый Структура("ТекущийПользователь, МассивКлючей, МассивЗаказов, АдресРезультата, РазрешитьСплит",
		ПараметрыСеанса.ТекущийПользователь, Ключи, Заказы, АдресРезультата, Значение(П, "allowSplit", Ложь) = Истина);
	Выполнить("Арм_ДанныеЗакупокИПродажФон.СформироватьЗаказыФоновоеЗадание(ПП)");
	Итог = ПолучитьИзВременногоХранилища(АдресРезультата);

	Если ТипЗнч(Итог) <> Тип("Структура") Тогда
		Возврат Новый Структура("state, message", "failed", "Задание не вернуло результат");
	КонецЕсли;
	Если Итог.Свойство("СтатусВалидации") И Итог.СтатусВалидации = "ТребуетсяПодтверждениеМенеджера" Тогда
		Возврат Новый Структура("state, message", "need_split", СтрШаблон(
			"Выбраны не все позиции по заказам (отмечено %1 из %2). Повторите с allowSplit=true", Итог.ВсегоВыбраноШтук, Итог.ВсегоВБазеШтук));
	КонецЕсли;
	Если Итог.Свойство("Успешно") И Итог.Успешно = Истина Тогда
		Сообщение = "Все документы оформлены";
		Если Итог.Свойство("Сообщение") И ЗначениеЗаполнено(Итог.Сообщение) Тогда
			Сообщение = Итог.Сообщение; // v1.2: что оформлено — заказы поставщикам или заказ покупателя и РН
		КонецЕсли;
		Возврат Новый Структура("state, message, processed", "done", Сообщение, Ключи.Количество());
	КонецЕсли;
	Возврат Новый Структура("state, message", "failed", Строка(Итог.ТекстОшибки));

КонецФункции

// Канбан снабжения (M7, P2, K1, K2, M9, K3): статус отмеченных закупок и связанных продаж — штатной функцией АРМ
// ИзменитьСтатусыВРегистреСнабжения (на «Собран» — приходная накладная). Частичный приход — need_split.
Функция СтатусСнабжения(П)

	Цели = Новый Соответствие;
	Цели.Вставить("paid", "Оплачено");
	Цели.Вставить("in_transit", "ТоварВПути");
	Цели.Вставить("acceptance", "Приходуется");
	Цели.Вставить("to_stock", "НаСкладе");
	Цели.Вставить("assembly", "Комплектуется");
	Цели.Вставить("assembled", "Собран");
	КодЦели = Строка(Значение(П, "status", ""));
	ИмяСтатуса = Цели.Получить(КодЦели);
	Если ИмяСтатуса = Неопределено Тогда
		ВызватьОшибку(400, "bad_request", "status: paid, in_transit, acceptance, to_stock, assembly, assembled");
	КонецЕсли;
	Цель = Статус(ИмяСтатуса);
	ВидЗакупка = Перечисления["Арм_ВидыОпераций"]["Закупка"];
	Идентификаторы = Вычислить("Арм_ОбщегоНазначенияАРМ.ПолучитьМассивОтмеченныхИдентификаторов(ВидЗакупка)");
	Если ТипЗнч(Идентификаторы) <> Тип("Массив") Или Идентификаторы.Количество() = 0 Тогда
		ВызватьОшибку(409, "nothing_marked", "Нет отмеченных закупок");
	КонецЕсли;

	ДатаПрихода = Дата(1, 1, 1);
	Если КодЦели = "assembled" И ЧастичныйПриход(Идентификаторы) Тогда
		Если Значение(П, "partialReceipt", Ложь) <> Истина Тогда
			ВызватьОшибку(409, "need_split", "Частичный приход по заказу поставщику: повторите с partialReceipt=true и receiptDate");
		КонецЕсли;
		ДатаПрихода = ДатаИзJSON(Значение(П, "receiptDate", ""));
		Если Не ЗначениеЗаполнено(ДатаПрихода) Тогда
			ВызватьОшибку(400, "bad_request", "При частичном приходе нужна receiptDate");
		КонецЕсли;
	КонецЕсли;

	Итог = Вычислить("Арм_ОбщегоНазначенияАРМ.ИзменитьСтатусыВРегистреСнабжения(Идентификаторы, Цель)");
	Если Не Итог.Успешно Тогда
		ВызватьОшибку(409, "row_locked", Итог.ТекстОшибки);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДатаПрихода) Тогда
		Для Каждого Ид Из Идентификаторы Цикл
			Набор = РегистрыСведений["Арм_ДанныеЗакупокИПродаж"].СоздатьНаборЗаписей();
			Набор.Отбор.ИдентификаторЗаписи.Установить(Ид);
			Набор.Прочитать();
			Если Набор.Количество() > 0 Тогда
				Набор[0].ДатаПоступления = ДатаПрихода;
				Набор.Записать();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Новый Структура("processed, total", Итог.КоличествоОбработанных, Идентификаторы.Количество());

КонецФункции

// Провести заказ покупателя: отмеченные строки «Подготовлено» с номенклатурой, количеством и ценой -> табличная
// часть «Запасы», пустые реквизиты шапки — по умолчанию, проведение; строки АРМ -> «Завершено».
Функция ПровестиЗаказ(П)

	Заказ = Документы.ЗаказПокупателя.ПолучитьСсылку(УИД(Значение(П, "id", "")));
	Если Заказ.ПолучитьОбъект() = Неопределено Тогда
		ВызватьОшибку(404, "not_found", "Заказ покупателя не найден");
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи,
		|	Т.Номенклатура КАК Номенклатура,
		|	Т.Количество КАК Количество,
		|	Т.Цена КАК Цена,
		|	Т.КлючСвязиСтрок КАК КлючСвязиСтрок,
		|	Т.Покупатель КАК Покупатель,
		|	Т.Договор КАК Договор
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.ДокументЗаказПокупателя = &Заказ
		|	И Т.ОтметкаСтроки = ИСТИНА
		|	И Т.АвторСтроки = &АвторСтроки
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|	И Т.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|	И Т.Количество <> 0
		|	И Т.Цена <> 0
		|	И Т.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Подготовлено)
		|	И НЕ Т.Удаление");
	Запрос.УстановитьПараметр("Заказ", Заказ);
	Запрос.УстановитьПараметр("АвторСтроки", ПараметрыСеанса.ТекущийПользователь);
	Таблица = Запрос.Выполнить().Выгрузить();
	Если Таблица.Количество() = 0 Тогда
		ВызватьОшибку(409, "nothing_marked", "Нет отмеченных строк заказа в статусе «Подготовлено» с номенклатурой, количеством и ценой");
	КонецЕсли;
	Покупатель = Таблица[0].Покупатель;
	Если Не ЗначениеЗаполнено(Покупатель) Тогда
		ВызватьОшибку(409, "contract_owner", "В заказе не заполнен покупатель");
	КонецЕсли;
	Договор = Таблица[0].Договор;
	Если Не ЗначениеЗаполнено(Договор) Тогда
		Договор = Вычислить("Арм_ОбщегоНазначенияАРМ.НайтиДоговор(Покупатель)");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Договор) Тогда
		ВызватьОшибку(409, "contract_owner", "В заказе не заполнен договор");
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Объект = Заказ.ПолучитьОбъект();
		Объект.Контрагент = Покупатель;
		Объект.Договор = Договор;
		ЗаполнитьПустыеРеквизитыЗаказа(Объект);
	ЗаполнитьСостояниеЗаказа(Объект);
		Объект.Запасы.Очистить();
		Для Каждого Стр Из Таблица Цикл
			НоваяСтрока = Объект.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Стр);
			НоваяСтрока.Сумма = Стр.Количество * Стр.Цена;
			НоваяСтрока.Всего = НоваяСтрока.Сумма;
			НоваяСтрока.ЕдиницаИзмерения = Стр.Номенклатура.ЕдиницаИзмерения;
			НоваяСтрока.ДатаОтгрузки = ?(ЗначениеЗаполнено(Объект.ДатаОтгрузки), Объект.ДатаОтгрузки, Объект.Дата);
			Набор = РегистрыСведений["Арм_ДанныеЗакупокИПродаж"].СоздатьНаборЗаписей();
			Набор.Отбор.ИдентификаторЗаписи.Установить(Стр.ИдентификаторЗаписи);
			Набор.Прочитать();
			Если Набор.Количество() > 0 Тогда
				Набор[0].СтатусСтроки = Статус("Завершено");
				Набор[0].ОтметкаСтроки = Ложь;
				Набор[0].АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
				Набор.Записать();
			КонецЕсли;
		КонецЦикла;
		Объект.Записать(РежимЗаписиДокумента.Проведение);
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		ВызватьОшибку(409, "post_failed", "Не удалось провести заказ: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Возврат Новый Структура("processed, total", Таблица.Количество(), Таблица.Количество());

КонецФункции

// Новый заказ покупателя: заполнение по умолчанию (организация, склад, валюта …), заказчик, договор, номер клиента,
// строки листа клиента (rows). Строки АРМ создаёт обработчик расширения АРМ при записи; если он не сработал
// (безопасный режим) — штатная процедура регистра.
Функция СоздатьЗаказ(П)

	Покупатель = Справочники.Контрагенты.ПолучитьСсылку(УИД(Значение(П, "customerId", "")));
	Если Покупатель.ПолучитьОбъект() = Неопределено Тогда
		ВызватьОшибку(400, "bad_request", "Заказчик не найден");
	КонецЕсли;
	ИдДоговора = Значение(П, "contractId", "");
	Если ЗначениеЗаполнено(ИдДоговора) Тогда
		Договор = Справочники.ДоговорыКонтрагентов.ПолучитьСсылку(УИД(ИдДоговора));
		Если Договор.Владелец <> Покупатель Тогда
			ВызватьОшибку(409, "contract_owner", "Договор не принадлежит заказчику");
		КонецЕсли;
	Иначе
		Договор = Вычислить("Арм_ОбщегоНазначенияАРМ.НайтиДоговор(Покупатель)");
	КонецЕсли;

	Документ = Документы.ЗаказПокупателя.СоздатьДокумент();
	Документ.Заполнить(Неопределено);
	ЗаполнитьСостояниеЗаказа(Документ);
	ДатаЗаказа = ДатаИзJSON(Значение(П, "date", ""));
	Документ.Дата = ?(ЗначениеЗаполнено(ДатаЗаказа), ДатаЗаказа, ТекущаяДатаСеанса());
	Документ.Контрагент = Покупатель;
	Документ.Договор = Договор;
	Документ.НомерЗаказаКлиента = Строка(Значение(П, "clientOrderNumber", ""));
	Строки = Значение(П, "rows", Неопределено);
	Если ТипЗнч(Строки) = Тип("Массив") Тогда
		Для Каждого С Из Строки Цикл
			Наименование = СокрЛП(Строка(Значение(С, "name", "")));
			Артикул = СокрЛП(Строка(Значение(С, "article", "")));
			Если Не ЗначениеЗаполнено(Наименование) И Не ЗначениеЗаполнено(Артикул) Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = Документ.Запасы.Добавить();
			НоваяСтрока.НомерКлиента = Строка(Значение(С, "clientNumber", Документ.НомерЗаказаКлиента));
			НоваяСтрока.СрочностьКлиента = Строка(Значение(С, "urgency", ""));
			НоваяСтрока.ГРЗКлиента = Строка(Значение(С, "plate", ""));
			НоваяСтрока.ТерриторияКлиента = Строка(Значение(С, "territory", ""));
			НоваяСтрока.АртикулКлиента = Артикул;
			НоваяСтрока.НоменклатураКлиента = Наименование;
			НоваяСтрока.КоличествоКлиента = Строка(Значение(С, "quantity", ""));
		КонецЦикла;
		Если Документ.Запасы.Количество() = 0 Тогда
			ВызватьОшибку(400, "bad_request", "В листе нет строк с наименованием или артикулом");
		КонецЕсли;
	КонецЕсли;
	Документ.Записать(РежимЗаписиДокумента.Запись);

	Если Документ.Запасы.Количество() > 0 Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1 1 КАК Поле ИЗ РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т ГДЕ Т.ДокументЗаказПокупателя = &Заказ");
		Запрос.УстановитьПараметр("Заказ", Документ.Ссылка);
		Если Запрос.Выполнить().Пустой() Тогда
			Для Каждого Стр Из Документ.Запасы Цикл
				Если Не ЗначениеЗаполнено(Стр.КлючСвязиСтрок) Тогда
					Стр.КлючСвязиСтрок = Строка(Новый УникальныйИдентификатор);
				КонецЕсли;
			КонецЦикла;
			Документ.ДополнительныеСвойства.Вставить("Арм_ПрограммнаяЗапись", Истина);
			Документ.Записать(РежимЗаписиДокумента.Запись);
			Ссылка = Документ.Ссылка;
			Запасы = Документ.Запасы.Выгрузить();
			Выполнить("РегистрыСведений.Арм_ДанныеЗакупокИПродаж.ОбновитьДанныеПоОбъекту(Ссылка, Запасы, Истина)");
		КонецЕсли;
	КонецЕсли;
	Возврат Новый Структура("id, kind, number, date, posted", Строка(Документ.Ссылка.УникальныйИдентификатор()), "customer_order",
		Документ.Номер, Формат(Документ.Дата, "ДФ=yyyy-MM-dd"), Документ.Проведен);

КонецФункции

// v1.2 (АРМ 2.22, F-1): вычеркнуть строку продажи (по Ид любой записи ключа связи) — общая процедура АРМ:
// продажа и незаказанные закупки ключа -> Удаление, отметки сняты, строка убрана из заказа покупателя.
Функция Вычеркнуть(П)

	Запись = ЗаписьАРМ(Значение(П, "id", ""));
	Ключи = Новый Массив;
	Ключи.Добавить(Запись.КлючСвязиСтрок);
	Итог = Вычислить("Арм_ОбщегоНазначенияАРМ.ВычеркнутьСтрокиПоКлючам(Ключи, Истина)");
	Если ЗначениеЗаполнено(Итог.Пропущено) Тогда
		ВызватьОшибку(409, "row_locked", "Вычеркнуть можно только строку в статусе «Черновик» или «В работе»: " + СокрЛП(Итог.Пропущено));
	КонецЕсли;
	Возврат Новый Структура("processed", Итог.Обработано);

КонецФункции

// v1.2 (АРМ 2.22, F-2): смена номенклатуры строки — общая процедура АРМ (как выбор номенклатуры в форме).
Функция СменитьНоменклатуру(П)

	Запись = ЗаписьАРМ(Значение(П, "id", ""));
	ИдНоменклатуры = Значение(П, "nomenclatureId", "");
	Номенклатура = ?(ЗначениеЗаполнено(ИдНоменклатуры), Справочники.Номенклатура.ПолучитьСсылку(УИД(ИдНоменклатуры)), Справочники.Номенклатура.ПустаяСсылка());
	Если ЗначениеЗаполнено(Номенклатура) И Номенклатура.ПолучитьОбъект() = Неопределено Тогда
		ВызватьОшибку(400, "bad_request", "Номенклатура не найдена");
	КонецЕсли;
	Идентификатор = Запись.ИдентификаторЗаписи;
	Итог = Вычислить("Арм_ОбщегоНазначенияАРМ.СменитьНоменклатуруСтроки(Идентификатор, Номенклатура)");
	Возврат Новый Структура("changed, warning", Итог.Изменено, Итог.Предупреждение);

КонецФункции

// v1.2 (АРМ 2.22, F-4): пересчёт остатков по номенклатуре строки (деление по партиям, авто-закупка при нехватке) —
// то же, что форма АРМ делает после изменения количества. PWA вызывает после PATCH количества продажи.
Функция ПересчитатьСтроку(П)

	Запись = ЗаписьАРМ(Значение(П, "id", ""));
	Если Не ЗначениеЗаполнено(Запись.Номенклатура) Тогда
		Возврат Новый Структура("recalculated", Ложь);
	КонецЕсли;
	Номенклатура = Запись.Номенклатура;
	Заказ = Запись.ДокументЗаказПокупателя;
	Выполнить("Арм_ОбщегоНазначенияАРМ.ПолучитьОстаткиПоСтрокам(Номенклатура, Заказ)");
	Возврат Новый Структура("recalculated", Истина);

КонецФункции

// Запись регистра АРМ по ИдентификаторЗаписи (строка uuid) или ошибка 404.
Функция ЗаписьАРМ(Знач Ид)

	Если Не ЗначениеЗаполнено(Ид) Тогда
		ВызватьОшибку(400, "bad_request", "id: ИдентификаторЗаписи строки АРМ");
	КонецЕсли;
	Набор = РегистрыСведений["Арм_ДанныеЗакупокИПродаж"].СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(Строка(Ид));
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		ВызватьОшибку(404, "not_found", "Строка АРМ не найдена: " + Строка(Ид));
	КонецЕсли;
	Возврат Набор[0];

КонецФункции

#КонецОбласти

#Область ЗаполнениеАРМ

// Строки АРМ по заказам покупателей, записанным до включения АРМ (подписка АРМ «ПриЗаписи» их не видела).
// Пустой КлючСвязиСтрок в «Запасах» заполняется (запись без обработчиков и без перепроведения), затем штатная
// РегистрыСведений.Арм_ДанныеЗакупокИПродаж.ОбновитьДанныеПоОбъекту. Заказы, у которых строки АРМ уже есть, пропускаются.
// {from, to} (даты заказов, по умолчанию — последний год) -> {orders, lines, skipped}
Функция ЗаполнитьАРМ(П)

	ДатаС = ДатаИзJSON(Значение(П, "from", ""));
	ДатаПо = ДатаИзJSON(Значение(П, "to", ""));
	Если Не ЗначениеЗаполнено(ДатаПо) Тогда
		ДатаПо = КонецДня(ТекущаяДатаСеанса());
	Иначе
		ДатаПо = КонецДня(ДатаПо);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ДатаС) Тогда
		ДатаС = ДобавитьМесяц(НачалоДня(ДатаПо), -12);
	КонецЕсли;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	З.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказПокупателя КАК З
		|ГДЕ
		|	З.Дата МЕЖДУ &С И &По
		|	И НЕ З.ПометкаУдаления
		|	И НЕ З.Ссылка В
		|			(ВЫБРАТЬ РАЗЛИЧНЫЕ А.ДокументЗаказПокупателя ИЗ РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК А)
		|УПОРЯДОЧИТЬ ПО
		|	З.Дата");
	Запрос.УстановитьПараметр("С", ДатаС);
	Запрос.УстановитьПараметр("По", ДатаПо);
	Заказы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Строк = 0;
	Для Каждого Заказ Из Заказы Цикл
		Объект = Заказ.ПолучитьОбъект();
		Изменен = Ложь;
		Для Каждого Стр Из Объект.Запасы Цикл
			Если Не ЗначениеЗаполнено(Стр.КлючСвязиСтрок) Тогда
				Стр.КлючСвязиСтрок = Строка(Новый УникальныйИдентификатор);
				Изменен = Истина;
			КонецЕсли;
		КонецЦикла;
		Если Изменен Тогда
			Объект.ОбменДанными.Загрузка = Истина;   // только ключи строк: без обработчиков и перепроведения
			Объект.Записать();
		КонецЕсли;
		Выполнить("РегистрыСведений.Арм_ДанныеЗакупокИПродаж.ОбновитьДанныеПоОбъекту(Заказ, Объект.Запасы.Выгрузить(), Ложь)");
		Строк = Строк + Объект.Запасы.Количество();
	КонецЦикла;
	Возврат Новый Структура("orders, lines, from, to", Заказы.Количество(), Строк, Формат(ДатаС, "ДФ=yyyy-MM-dd"), Формат(ДатаПо, "ДФ=yyyy-MM-dd"));

КонецФункции

#КонецОбласти

#Область Справочники

// Новая номенклатура с заполнением УНФ по типу (как из формы: счета учёта, ставка НДС, метод оценки, склад …).
// {type: Запас|Услуга|Работа, name, fullName, article, unitId, comment} -> {id}
Функция СоздатьНоменклатуру(П)

	Тип = Строка(Значение(П, "type", "Запас"));
	Если Метаданные.Перечисления.ТипыНоменклатуры.ЗначенияПеречисления.Найти(Тип) = Неопределено Тогда
		ВызватьОшибку(400, "bad_request", "type: Запас, Услуга, Работа");
	КонецЕсли;
	Наименование = СокрЛП(Строка(Значение(П, "name", "")));
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		ВызватьОшибку(400, "bad_request", "Наименование не заполнено");
	КонецЕсли;
	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.Заполнить(Новый Структура("ТипНоменклатуры", Перечисления.ТипыНоменклатуры[Тип]));
	Объект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры[Тип];
	Объект.Наименование = Лев(Наименование, 100);
	Объект.НаименованиеПолное = СокрЛП(Строка(Значение(П, "fullName", Наименование)));
	Объект.Артикул = СокрЛП(Строка(Значение(П, "article", "")));
	Объект.Комментарий = Строка(Значение(П, "comment", ""));
	ИдЕдиницы = Строка(Значение(П, "unitId", ""));
	Если ЗначениеЗаполнено(ИдЕдиницы) Тогда
		Объект.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПолучитьСсылку(УИД(ИдЕдиницы));
	КонецЕсли;
	// умолчания формы элемента (ОбработкаЗаполнения их не ставит) — только пустые
	УмолчаниеПеречисления(Объект, "ВидСтавкиНДС", "ВидыСтавокНДС", "Общая");
	УмолчаниеПеречисления(Объект, "ТипСрокаДействия", "СрокДействияПодарочныхСертификатов", "БезОграниченияСрока");
	Если Не ЗначениеЗаполнено(Объект.Склад) Тогда
		Объект.Склад = Справочники.СтруктурныеЕдиницы.ОсновнойСклад;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.СчетУчетаНДСПоПриобретеннымЦенностям) Тогда
		Объект.СчетУчетаНДСПоПриобретеннымЦенностям = ПланыСчетов.Управленческий.НДСПоПриобретеннымЦенностям;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.СчетУчетаНДСПоРеализации) Тогда
		Объект.СчетУчетаНДСПоРеализации = ПланыСчетов.Управленческий.Продажи_НДС;
	КонецЕсли;
	УмолчаниеПеречисления(Объект, "ВидМаркировки", "ВидыМаркировки", "НеМаркируется");
	УмолчаниеПеречисления(Объект, "МетодОценки", "МетодОценкиЗапасов", "ПоСредней");
	УмолчаниеПеречисления(Объект, "СпособПополнения", "СпособыПополненияЗапасов", "Закупка");
	Если Не ЗначениеЗаполнено(Объект.Числитель) Тогда
		Объект.Числитель = 1;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.Знаменатель) Тогда
		Объект.Знаменатель = 1;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.СрокИсполненияЗаказа) Тогда
		Объект.СрокИсполненияЗаказа = 1;
	КонецЕсли;
	Объект.Записать();
	Возврат Новый Структура("id", Строка(Объект.Ссылка.УникальныйИдентификатор()));

КонецФункции

Процедура УмолчаниеПеречисления(Объект, Реквизит, Перечисление, Имя)

	Если ЗначениеЗаполнено(Объект[Реквизит]) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		Объект[Реквизит] = Перечисления[Перечисление][Имя];
	Исключение
		// другой набор значений в этой версии УНФ — оставляем пустым
	КонецПопытки;

КонецПроцедуры

// Цена номенклатуры (регистр ЦеныНоменклатуры: через OData не записывается — 500 без подробностей).
// {id, price, priceKind = "Розничная цена", date} -> {id, price, priceKind, date}
Функция ЦенаНоменклатуры(П)

	Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(УИД(Значение(П, "id", "")));
	Если Номенклатура.ПолучитьОбъект() = Неопределено Тогда
		ВызватьОшибку(404, "not_found", "Номенклатура не найдена");
	КонецЕсли;
	ИмяВида = Строка(Значение(П, "priceKind", "Розничная цена"));
	ВидЦен = Справочники.ВидыЦен.НайтиПоНаименованию(ИмяВида, Истина);
	Если Не ЗначениеЗаполнено(ВидЦен) Тогда
		ВызватьОшибку(400, "bad_request", "Вид цен не найден: " + ИмяВида);
	КонецЕсли;
	Цена = Число(Значение(П, "price", 0));
	ДатаЦены = ДатаИзJSON(Значение(П, "date", ""));
	Запись = РегистрыСведений.ЦеныНоменклатуры.СоздатьМенеджерЗаписи();
	Запись.Период = ?(ЗначениеЗаполнено(ДатаЦены), ДатаЦены, НачалоДня(ТекущаяДатаСеанса()));
	Запись.ВидЦен = ВидЦен;
	Запись.Номенклатура = Номенклатура;
	Запись.Цена = Цена;
	Запись.Актуальность = Истина;
	Запись.ЕдиницаИзмерения = Номенклатура.ЕдиницаИзмерения;
	Запись.ВалютаЦены = Константы.НациональнаяВалюта.Получить();
	Запись.Автор = ПараметрыСеанса.ТекущийПользователь;
	Запись.Записать(Истина);
	Возврат Новый Структура("id, price, priceKind, date", Строка(Номенклатура.УникальныйИдентификатор()), Цена, ИмяВида,
		Формат(Запись.Период, "ДФ=yyyy-MM-dd"));

КонецФункции

// Цены авторабот по моделям (штатный механизм «Автосервиса»): проведённый документ асУстановкаЦенАвторабот ->
// регистр асЦеныАвторабот. {priceKind = "Розничная цена", date, comment, rows: [{id, modelId, price}]} -> {id, number, rows}
Функция ЦеныАвторабот(П)

	Строки = Значение(П, "rows", Неопределено);
	Если ТипЗнч(Строки) <> Тип("Массив") Или Строки.Количество() = 0 Тогда
		ВызватьОшибку(400, "bad_request", "rows: непустой массив {id, modelId, price}");
	КонецЕсли;
	ИмяВида = Строка(Значение(П, "priceKind", "Розничная цена"));
	ВидЦен = Справочники.ВидыЦен.НайтиПоНаименованию(ИмяВида, Истина);
	Если Не ЗначениеЗаполнено(ВидЦен) Тогда
		ВызватьОшибку(400, "bad_request", "Вид цен не найден: " + ИмяВида);
	КонецЕсли;
	ДатаЦен = ДатаИзJSON(Значение(П, "date", ""));
	Документ = Документы.асУстановкаЦенАвторабот.СоздатьДокумент();
	Документ.Заполнить(Неопределено);
	Документ.Дата = ТекущаяДатаСеанса();
	Документ.ДатаНачалаДействия = ?(ЗначениеЗаполнено(ДатаЦен), ДатаЦен, НачалоДня(ТекущаяДатаСеанса()));
	Документ.ВидЦен = ВидЦен;
	Если Не ЗначениеЗаполнено(Документ.ВалютаДокумента) Тогда
		Документ.ВалютаДокумента = Константы.НациональнаяВалюта.Получить();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Документ.Курс) Тогда
		Документ.Курс = 1;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Документ.Кратность) Тогда
		Документ.Кратность = 1;
	КонецЕсли;
	Документ.Комментарий = Строка(Значение(П, "comment", "АРМ PWA: цены авторабот"));
	Для Каждого С Из Строки Цикл
		НоваяСтрока = Документ.Работы.Добавить();
		НоваяСтрока.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(УИД(Значение(С, "id", "")));
		ИдМодели = Строка(Значение(С, "modelId", ""));
		Если ЗначениеЗаполнено(ИдМодели) Тогда
			НоваяСтрока.Модель = Справочники.асМодели.ПолучитьСсылку(УИД(ИдМодели));
		КонецЕсли;
		НоваяСтрока.Нормочас = Справочники.асНормочасы.Рубль;
		НоваяСтрока.Цена = Число(Значение(С, "price", 0));
	КонецЦикла;
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	Возврат Новый Структура("id, number, rows", Строка(Документ.Ссылка.УникальныйИдентификатор()), Документ.Номер, Документ.Работы.Количество());

КонецФункции

// Сведения автомобиля (периодический регистр асАвтомобили): {id, plate, owner, mileage, date} -> {id, plate, owner, mileage}
// owner — uuid контрагента; пустая строка — не менять.
Функция ДанныеАвтомобиля(П)

	Автомобиль = Справочники.асАвтомобили.ПолучитьСсылку(УИД(Значение(П, "id", "")));
	Если Автомобиль.ПолучитьОбъект() = Неопределено Тогда
		ВызватьОшибку(404, "not_found", "Автомобиль не найден");
	КонецЕсли;
	ДатаСведений = ДатаИзJSON(Значение(П, "date", ""));
	Период = ?(ЗначениеЗаполнено(ДатаСведений), ДатаСведений, НачалоДня(ТекущаяДатаСеанса()));
	Виды = Перечисления.асДополнительнаяИнформацияАвтомобилей;
	Значения = Новый Соответствие;
	Если Значение(П, "plate", Неопределено) <> Неопределено Тогда
		Значения.Вставить(Виды.ГосНомер, СокрЛП(Строка(Значение(П, "plate", ""))));
	КонецЕсли;
	Если Значение(П, "mileage", Неопределено) <> Неопределено Тогда
		Значения.Вставить(Виды.Пробег, Число(Значение(П, "mileage", 0)));
	КонецЕсли;
	ИдХозяина = Строка(Значение(П, "owner", ""));
	Если ЗначениеЗаполнено(ИдХозяина) Тогда
		Значения.Вставить(Виды.Хозяин, Справочники.Контрагенты.ПолучитьСсылку(УИД(ИдХозяина)));
	КонецЕсли;
	Для Каждого КЗ Из Значения Цикл
		Запись = РегистрыСведений.асАвтомобили.СоздатьМенеджерЗаписи();
		Запись.Период = Период;
		Запись.Автомобиль = Автомобиль;
		Запись.ВидЗначения = КЗ.Ключ;
		Запись.Значение = КЗ.Значение;
		Запись.Записать(Истина);
	КонецЦикла;
	Возврат Новый Структура("id, updated", Строка(Автомобиль.УникальныйИдентификатор()), Значения.Количество());

КонецФункции

#КонецОбласти

#Область Служебные

Функция ЧастичныйПриход(Идентификаторы)

	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Внутр.ДокументЗаказПоставщика КАК ЗаказПоставщика
		|ПОМЕСТИТЬ втВыбранныеЗаказы
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Внутр
		|ГДЕ
		|	Внутр.ИдентификаторЗаписи В (&МассивИдентификаторов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	1 КАК Поле
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втВыбранныеЗаказы КАК ВТ_Заказы
		|		ПО Т.ДокументЗаказПоставщика = ВТ_Заказы.ЗаказПоставщика
		|ГДЕ
		|	НЕ Т.ИдентификаторЗаписи В (&МассивИдентификаторов)
		|	И НЕ Т.Удаление
		|	И Т.СтатусСтроки В (&МассивСтатусов)
		|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)");
	Запрос.УстановитьПараметр("МассивИдентификаторов", Идентификаторы);
	Статусы = Новый Массив;
	Для Каждого Имя Из СтрРазделить("Оплачено,ТоварВПути,Приходуется,НаСкладе,Комплектуется", ",") Цикл
		Статусы.Добавить(Статус(Имя));
	КонецЦикла;
	Запрос.УстановитьПараметр("МассивСтатусов", Статусы);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

// Пустые реквизиты шапки — значениями нового документа после Заполнить(Неопределено).
Процедура ЗаполнитьПустыеРеквизитыЗаказа(Объект)

	Образец = Документы.ЗаказПокупателя.СоздатьДокумент();
	Образец.Заполнить(Неопределено);
	Для Каждого Реквизит Из Метаданные.Документы.ЗаказПокупателя.Реквизиты Цикл
		Имя = Реквизит.Имя;
		Если Не ЗначениеЗаполнено(Объект[Имя]) И ЗначениеЗаполнено(Образец[Имя]) Тогда
			Объект[Имя] = Образец[Имя];
		КонецЕсли;
	КонецЦикла;
	Если Не ЗначениеЗаполнено(Объект.ДатаОтгрузки) Тогда
		Объект.ДатаОтгрузки = Объект.Дата;
	КонецЕсли;

КонецПроцедуры

// Состояние нового заказа — первое по порядку состояний вида заказа (форма УНФ ставит его при создании,
// программное Заполнить() — нет; без состояния АРМ не проводит заказ: «состояние "" не принадлежит виду заказа»).
Процедура ЗаполнитьСостояниеЗаказа(Объект)

	Если ЗначениеЗаполнено(Объект.СостояниеЗаказа) Или Не ЗначениеЗаполнено(Объект.ВидЗаказа) Тогда
		Возврат;
	КонецЕсли;
	Порядок = Объект.ВидЗаказа.ПорядокСостояний;
	Если Порядок.Количество() > 0 Тогда
		Объект.СостояниеЗаказа = Порядок[0].Состояние;
	КонецЕсли;

КонецПроцедуры

Функция Статус(Имя)
	Возврат Перечисления["Арм_СтатусыАРМ"][Имя];
КонецФункции

Процедура ВызватьОшибку(Код, КодОшибки, Сообщение)
	ВызватьИсключение СтрШаблон("АРМODATA|%1|%2|%3", Формат(Код, "ЧГ=0"), КодОшибки, Сообщение);
КонецПроцедуры

Функция Проблема(Код, КодОшибки, Сообщение)
	Возврат Новый Структура("status, code, message", Код, КодОшибки, Сообщение);
КонецФункции

Функция Значение(Данные, Ключ, ПоУмолчанию)
	Если ТипЗнч(Данные) = Тип("Структура") И Данные.Свойство(Ключ) Тогда
		Возврат Данные[Ключ];
	ИначеЕсли ТипЗнч(Данные) = Тип("Соответствие") И Данные.Получить(Ключ) <> Неопределено Тогда
		Возврат Данные.Получить(Ключ);
	КонецЕсли;
	Возврат ПоУмолчанию;
КонецФункции

Функция УИД(Знач Текст)
	Попытка
		Возврат Новый УникальныйИдентификатор(Строка(Текст));
	Исключение
		ВызватьОшибку(400, "bad_request", "Не uuid: " + Строка(Текст));
	КонецПопытки;
КонецФункции

Функция ДатаИзJSON(Знач Текст)
	Цифры = СтрЗаменить(Лев(Строка(Текст), 10), "-", "");
	Если СтрДлина(Цифры) <> 8 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(Цифры);
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
КонецФункции

Функция ИзJSON(Текст)
	Если Не ЗначениеЗаполнено(Текст) Тогда
		Возврат Новый Соответствие;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

Функция ВJSON(Данные)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Данные);
	Возврат Запись.Закрыть();
КонецФункции

#КонецОбласти
