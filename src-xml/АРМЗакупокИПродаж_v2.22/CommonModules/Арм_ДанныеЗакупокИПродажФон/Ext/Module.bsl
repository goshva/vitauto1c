
Процедура СформироватьЗаказыФоновоеЗадание(ПараметрыПроцедуры) Экспорт

	СтруктураИтога = Новый Структура("Успешно, ТекстОшибки, СтатусВалидации, ВсегоВыбраноШтук, ВсегоВБазеШтук, Сообщение", Ложь, "", "", 0, 0, "");








	Если Не (ТипЗнч(ПараметрыПроцедуры) = Тип("Структура")) Тогда
		ЗаписьЖурналаРегистрации("АРМ.КритическийСбойПараметров", УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецЕсли;

	Если Не ПараметрыПроцедуры.Свойство("ТекущийПользователь") Или Не ПараметрыПроцедуры.Свойство("МассивКлючей") Или Не ПараметрыПроцедуры.Свойство("АдресРезультата") Или Не ПараметрыПроцедуры.Свойство("МассивЗаказов") Тогда



		ЗаписьЖурналаРегистрации("АРМ.КритическийСбойПараметров", УровеньЖурналаРегистрации.Ошибка);
		Возврат;
	КонецЕсли;

	МассивКлючей = ПараметрыПроцедуры.МассивКлючей;
	АдресРезультата = ПараметрыПроцедуры.АдресРезультата;
	МассивЗаказов = ПараметрыПроцедуры.МассивЗаказов;

	ТекстОтказаРоли = ТекстОтказаПоРоли(ПараметрыПроцедуры.ТекущийПользователь);
	Если ЗначениеЗаполнено(ТекстОтказаРоли) Тогда
		ЗаписьЖурналаРегистрации("АРМ.ОтказПрав", УровеньЖурналаРегистрации.Предупреждение, , ,
			СтрШаблон("СформироватьЗаказыФоновоеЗадание (%1): %2", ПараметрыПроцедуры.ТекущийПользователь, ТекстОтказаРоли));
		СтруктураИтога.ТекстОшибки = ТекстОтказаРоли;
		ПоместитьВоВременноеХранилище(СтруктураИтога, АдресРезультата);
		Возврат;
	КонецЕсли;

	ФлагРазрешитьСплит = Ложь;
	Если ПараметрыПроцедуры.Свойство("РазрешитьСплит") Тогда
		ФлагРазрешитьСплит = ПараметрыПроцедуры.РазрешитьСплит;
	КонецЕсли;

	Если МассивКлючей.Количество() = 0 Тогда
		СтруктураИтога.ТекстОшибки = "Нет строк для обработки";
		ПоместитьВоВременноеХранилище(СтруктураИтога, АдресРезультата);
		Возврат;
	КонецЕсли;

	ТребуетсяПодтверждение = Ложь;
	ТотальноВыбраноШтук = 0;
	ТотальноВБазеШтук = 0;

	НачатьТранзакцию();


	Попытка
		Если МассивЗаказов.Количество() > 0 Тогда
			Блокировка = Новый БлокировкаДанных;
			Для каждого ТекущийЗаказ Из МассивЗаказов Цикл
				ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.Арм_ДанныеЗакупокИПродаж");
				ЭлементБлокировки.УстановитьЗначение("ДокументЗаказПокупателя", ТекущийЗаказ);
				ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			КонецЦикла;
			Блокировка.Заблокировать();
		Иначе
			ВызватьИсключение "Отсутствуют документы для обработки";
		КонецЕсли;


		ЗапросСплита = Новый Запрос;
		ЗапросСплита.Текст = "ВЫБРАТЬ
		|	Т.ДокументЗаказПокупателя КАК ДокументЗаказПокупателя,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка) И Т.ОтметкаСтроки = ИСТИНА
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК КнопкуНажалСнабженец,
		|	СУММА(ВЫБОР
		|			КОГДА Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
		|				ТОГДА Т.Количество
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ВсегоЗакупокВБазе,
		|	СУММА(ВЫБОР
		|			КОГДА Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
		|				ТОГДА Т.Количество
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ВсегоПродажВБазе,
		|	СУММА(ВЫБОР
		|			КОГДА Т.ОтметкаСтроки = ИСТИНА
		|				ТОГДА Т.Количество
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ОтмеченоШтукНаЭкране,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка) И Т.ОтметкаСтроки = ИСТИНА
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ОтмеченыЗакупки,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР 
		|			КОГДА Т.ОтметкаСтроки = ИСТИНА ТОГДА Т.ИдентификаторЗаписи КОНЕЦ) КАК КолВоВыбранных
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	НЕ Т.Удаление
		|	И Т.ДокументЗаказПокупателя В (&МассивЗаказов)
		|	И Т.СтатусСтроки <> ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.Отгружено)
		|
		|СГРУППИРОВАТЬ ПО
		|	Т.ДокументЗаказПокупателя";


		ЗапросСплита.УстановитьПараметр("МассивКлючей", МассивКлючей);
		ЗапросСплита.УстановитьПараметр("МассивЗаказов", МассивЗаказов);

		ВыборкаСплита = ЗапросСплита.Выполнить().Выбрать();

		АнализЗаказовПамять = Новый Соответствие;
		ГлобальноТребуетсяСплит = Ложь;
		ТотальноВыбраноШтук = 0;
		ТотальноВБазеШтук = 0;

		Пока ВыборкаСплита.Следующий() Цикл

			КнопкуНажалСнабженец = ВыборкаСплита.КнопкуНажалСнабженец;
			ТекущийВсегоШтук = 0;

			Если КнопкуНажалСнабженец Тогда
				ТекущийВсегоШтук = ВыборкаСплита.ВсегоЗакупокВБазе;
			Иначе
				ТекущийВсегоШтук = ВыборкаСплита.ВсегоПродажВБазе;
			КонецЕсли;

			ТекущийОтмеченоШтук = ?(ВыборкаСплита.ОтмеченоШтукНаЭкране = Null, 0, ВыборкаСплита.ОтмеченоШтукНаЭкране);
			ТекущийОтмеченыЗакупки = ВыборкаСплита.ОтмеченыЗакупки;

			ТекущийСплитНужен = ТекущийВсегоШтук > ТекущийОтмеченоШтук И ТекущийОтмеченоШтук > 0;

			ТотальноВыбраноШтук = ТотальноВыбраноШтук + ТекущийОтмеченоШтук;
			ТотальноВБазеШтук = ТотальноВБазеШтук + ТекущийВсегоШтук;
			Если ТекущийСплитНужен Тогда
				ГлобальноТребуетсяСплит = Истина;
			КонецЕсли;

			ДанныеДокумента = Новый Структура;
			ДанныеДокумента.Вставить("ТребуетсяСплит", ТекущийСплитНужен);
			ДанныеДокумента.Вставить("ОтмеченыЗакупки", ТекущийОтмеченыЗакупки);
			ДанныеДокумента.Вставить("КолВоВыбранных", ВыборкаСплита.КолВоВыбранных);

			АнализЗаказовПамять.Вставить(ВыборкаСплита.ДокументЗаказПокупателя, ДанныеДокумента);

		КонецЦикла;

		// v2.19: подтверждение сплита — без записи данных; строки блокируются и обрабатываются только без него
		ТребуетсяПодтверждение = ГлобальноТребуетсяСплит И Не ФлагРазрешитьСплит;
		Если Не ТребуетсяПодтверждение Тогда
			ОбработатьОтмеченныеЗаказы(МассивЗаказов, МассивКлючей, АнализЗаказовПамять);
			СтруктураИтога.Сообщение = ОписаниеВыполненного(АнализЗаказовПамять);
		КонецЕсли;

		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Арм_Журнал.ЗаписатьИсключение("Арм_ДанныеЗакупокИПродажФон.СформироватьЗаказыФоновоеЗадание", ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("АРМ.ОшибкаОбработки", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		СтруктураИтога.Успешно = Ложь;
		СтруктураИтога.ТекстОшибки = СтрШаблон("Процесс прерван: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ПоместитьВоВременноеХранилище(СтруктураИтога, АдресРезультата);
		Возврат;
	КонецПопытки;

	Если ТребуетсяПодтверждение Тогда
		СтруктураИтога.Успешно = Ложь;
		СтруктураИтога.СтатусВалидации = "ТребуетсяПодтверждениеМенеджера";
		СтруктураИтога.ВсегоВыбраноШтук = ТотальноВыбраноШтук;
		СтруктураИтога.ВсегоВБазеШтук = ТотальноВБазеШтук;
	Иначе
		СтруктураИтога.Успешно = Истина;
	КонецЕсли;
	ПоместитьВоВременноеХранилище(СтруктураИтога, АдресРезультата);

КонецПроцедуры


// v2.19: проверка и обработка отмеченных строк — выделено из СформироватьЗаказыФоновоеЗадание,
// выполняется внутри его транзакции (фиксация и откат — там).
Процедура ОбработатьОтмеченныеЗаказы(МассивЗаказов, МассивКлючей, АнализЗаказовПамять)

	ИсходныеСтатусыСтрок = Новый Соответствие;
	ЗаблокироватьСтроки(МассивЗаказов, МассивКлючей, ИсходныеСтатусыСтрок);

	ТекстВсехОшибокВалидации = "";
	ДанныеПрошлиВалидацию = Истина;

	Для каждого ТекущийЗаказ Из МассивЗаказов Цикл

		МассивКлючейТекущегоЗаказа = ПолучитьКлючиОтмеченныхСтрокЗаказа(ТекущийЗаказ, МассивКлючей);
		Если МассивКлючейТекущегоЗаказа.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

		МетрикиЗаказа = АнализЗаказовПамять.Получить(ТекущийЗаказ);

		Если МетрикиЗаказа <> Неопределено Тогда

			ТекущийТекстОшибки = "";
			ТекущийЗаказПрошелПроверку = Истина;

			Если МетрикиЗаказа.ОтмеченыЗакупки Тогда
				ТекущийЗаказПрошелПроверку = ВалидацияСтрокЗакупок(МассивКлючейТекущегоЗаказа, ТекущийТекстОшибки);
			Иначе
				ТекущийЗаказПрошелПроверку = ВалидацияСтрокПродаж(МассивКлючейТекущегоЗаказа, ТекущийТекстОшибки);
			КонецЕсли;

			Если Не ТекущийЗаказПрошелПроверку Тогда
				ДанныеПрошлиВалидацию = Ложь;
				ТекстВсехОшибокВалидации = СтрШаблон("%1 %2• По заказу %3: %4", ТекстВсехОшибокВалидации, Символы.ПС, ТекущийЗаказ, ТекущийТекстОшибки);






			КонецЕсли;

		КонецЕсли;
	КонецЦикла;

	Если Не ДанныеПрошлиВалидацию Тогда
		ВызватьИсключение "Данные не прошли предварительную проверку:" + ТекстВсехОшибокВалидации;
	КонецЕсли;

	Для каждого ТекущийЗаказ Из МассивЗаказов Цикл

		МассивКлючейТекущегоЗаказа = ПолучитьКлючиОтмеченныхСтрокЗаказа(ТекущийЗаказ, МассивКлючей);
		Если МассивКлючейТекущегоЗаказа.Количество() = 0 Тогда Продолжить; КонецЕсли;

		МетрикиЗаказа = АнализЗаказовПамять.Получить(ТекущийЗаказ);

		ТекущийЗаказОтмеченыЗакупки = Ложь;
		Если МетрикиЗаказа <> Неопределено Тогда
			ТекущийЗаказОтмеченыЗакупки = МетрикиЗаказа.ОтмеченыЗакупки;
		Иначе
			Продолжить;
		КонецЕсли;

		Если ТекущийЗаказОтмеченыЗакупки Тогда
			Если Не ОбработатьЗаказыПокупателей(МассивКлючейТекущегоЗаказа) Тогда
				ВызватьИсключение СтрШаблон("Ошибка при обработке снабжения по заказу %1", ТекущийЗаказ);
			КонецЕсли;
			СоздатьЗаказыПоставщикамНаСервере(МассивКлючейТекущегоЗаказа, ИсходныеСтатусыСтрок);
		Иначе
			ОбработатьЧистыеПродажиВФоне(ТекущийЗаказ, МассивКлючейТекущегоЗаказа, ИсходныеСтатусыСтрок);
		КонецЕсли;

	КонецЦикла;

	РазблокироватьОставшиесяСтроки(МассивЗаказов, ИсходныеСтатусыСтрок);

КонецПроцедуры

Процедура ЗаблокироватьСтроки(МассивЗаказовДляБлокировки, МассивКлючей, ИсходныеСтатусы)

	Для каждого ТекущийЗаказ Из МассивЗаказовДляБлокировки Цикл
		НаборБлок = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
		НаборБлок.Отбор.ДокументЗаказПокупателя.Установить(ТекущийЗаказ);
		НаборБлок.Прочитать();
		ИзмененоБлок = Ложь;
		Для каждого ЗаписьБлок Из НаборБлок Цикл
			Если Не ЗаписьБлок.Удаление И (ЗаписьБлок.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ВРаботе Или ЗаписьБлок.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик) Тогда


				ИсходныеСтатусы.Вставить(ЗаписьБлок.ИдентификаторЗаписи, ЗаписьБлок.СтатусСтроки);
				ЗаписьБлок.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном;
				ИзмененоБлок = Истина;
			КонецЕсли;
		КонецЦикла;
		Если ИзмененоБлок Тогда
			Попытка
				НаборБлок.Записать();
			Исключение
				Арм_Журнал.ЗаписатьИсключение("Арм_ДанныеЗакупокИПродажФон.ЗаблокироватьСтроки", ИнформацияОбОшибке());
				ВызватьИсключение СтрШаблон("Не удалось установить статус блокировки для заказа %1: %2", ТекущийЗаказ, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));



			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ОбработатьЧистыеПродажиВФоне(СсылкаНаЗаказ, МассивКлючей, ИсходныеСтатусыСтрок)

	// v2.18: состояние заказа покупателя — из его вида заказа (Арм_ОбщегоНазначенияАРМ.СостояниеЗаказаПокупателяВРаботе);
	// раньше присваивалось состояние заказа поставщику, значение становилось пустым и проведение падало (K5 e2e).
	СтавкаНДСПоУмолчанию = Арм_ОбщегоНазначенияАРМ.НайтиСтавкуНДС();

	ЗапросСтрок = Новый Запрос;
	ЗапросСтрок.Текст = "ВЫБРАТЬ
	|	Т.*
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.ДокументЗаказПокупателя = &СсылкаНаЗаказ
	|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|	И НЕ Т.Удаление";


	ЗапросСтрок.УстановитьПараметр("СсылкаНаЗаказ", СсылкаНаЗаказ);
	СтрокиЭтогоЗаказа = ЗапросСтрок.Выполнить().Выгрузить();

	ВсегоСтрокПродаж = СтрокиЭтогоЗаказа.Количество();
	ОтмеченоСтрок = 0;
	ЕстьСтрокиСобрано = Ложь;

	Для каждого Стр Из СтрокиЭтогоЗаказа Цикл
		Если Стр.ОтметкаСтроки = Истина Тогда
			ОтмеченоСтрок = ОтмеченоСтрок + 1;

			РоднойСтатус = ИсходныеСтатусыСтрок.Получить(Стр.ИдентификаторЗаписи);
			Если РоднойСтатус = Неопределено Тогда
				РоднойСтатус = Стр.СтатусСтроки;
			КонецЕсли;

			Если РоднойСтатус = Перечисления.Арм_СтатусыАРМ.Собран Или Стр.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Собран Тогда
				ЕстьСтрокиСобрано = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	НуженСплит = ВсегоСтрокПродаж > ОтмеченоСтрок И ОтмеченоСтрок > 0;

	ДокОбъект = СсылкаНаЗаказ.ПолучитьОбъект();
	ДокОбъект.Заполнить(Неопределено);
	ДокОбъект.ДополнительныеСвойства.Вставить("Арм_ПрограммнаяЗапись", Истина);
	ПараметрыРасчета = Новый Структура("СуммаВключаетНДС", ДокОбъект.СуммаВключаетНДС);
	ДокОбъект.Курс = 1;
	ДокОбъект.Кратность = 1;
	БазоваяДатаШапки = ТекущаяДатаСеанса();
	Если ВсегоСтрокПродаж > 0 И ЗначениеЗаполнено(СтрокиЭтогоЗаказа[0].ДатаОтгрузки) Тогда
		БазоваяДатаШапки = СтрокиЭтогоЗаказа[0].ДатаОтгрузки;
	КонецЕсли;
	ДокОбъект.ДатаОтгрузки = БазоваяДатаШапки;

	Если НуженСплит Тогда

		НовыйДокОбъект = ДокОбъект.Скопировать();
		НовыйДокОбъект.Заполнить(Неопределено);
		НовыйДокОбъект.ДополнительныеСвойства.Вставить("Арм_ПрограммнаяЗапись", Истина);
		НовыйДокОбъект.Дата = ТекущаяДатаСеанса();
		НовыйДокОбъект.ДатаОтгрузки = ДокОбъект.ДатаОтгрузки; // v2.19: Заполнить() очищает дату отгрузки, без неё заказ не проводится
		НовыйДокОбъект.Курс = 1;
		НовыйДокОбъект.Кратность = 1;
		ДокОбъект.Запасы.Очистить();
		НовыйДокОбъект.Запасы.Очистить();

		МассивЛишнихКлючей = Новый Массив;

		Для каждого Стр Из СтрокиЭтогоЗаказа Цикл
			Если Стр.ОтметкаСтроки = Истина Тогда
				НоваяСтр = ДокОбъект.Запасы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтр, Стр);
				НоваяСтр.СтавкаНДС = Арм_ОбщегоНазначенияАРМ.СтавкаНДСНоменклатуры(НоваяСтр.Номенклатура, ДокОбъект.Организация, ДокОбъект.Дата, СтавкаНДСПоУмолчанию);
				НоваяСтр.Сумма = НоваяСтр.Количество * НоваяСтр.Цена;
				ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммуНДСИВсего(НоваяСтр, ПараметрыРасчета);
			Иначе
				НоваяСтр = НовыйДокОбъект.Запасы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтр, Стр);
				НоваяСтр.СтавкаНДС = Арм_ОбщегоНазначенияАРМ.СтавкаНДСНоменклатуры(НоваяСтр.Номенклатура, НовыйДокОбъект.Организация, НовыйДокОбъект.Дата, СтавкаНДСПоУмолчанию);
				НоваяСтр.Сумма = НоваяСтр.Количество * НоваяСтр.Цена;
				МассивЛишнихКлючей.Добавить(Стр.КлючСвязиСтрок);
				ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммуНДСИВсего(НоваяСтр, ПараметрыРасчета);
			КонецЕсли;
		КонецЦикла;

		ДокОбъект.СостояниеЗаказа = Арм_ОбщегоНазначенияАРМ.СостояниеЗаказаПокупателяВРаботе(ДокОбъект);
		НовыйДокОбъект.СостояниеЗаказа = Арм_ОбщегоНазначенияАРМ.СостояниеЗаказаПокупателяВРаботе(НовыйДокОбъект);

		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			НовыйДокОбъект.Записать(РежимЗаписиОстаткаСплита(НовыйДокОбъект)); // v2.19: строки, оставшиеся после сплита, тоже в учёте
		Исключение
			Арм_Журнал.ЗаписатьИсключение("Арм_ДанныеЗакупокИПродажФон.ОбработатьЧистыеПродажиВФоне", ИнформацияОбОшибке());
			ВызватьИсключение СтрШаблон("Ошибка проведения сплит-заказов покупателей: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

		ОбновитьСсылкуЗПВРегистре(МассивЛишнихКлючей, НовыйДокОбъект.Ссылка, СсылкаНаЗаказ);
	Иначе


		ДокОбъект.Запасы.Очистить();
		Для каждого Стр Из СтрокиЭтогоЗаказа Цикл
			Если Стр.ОтметкаСтроки = Истина Тогда
				НоваяСтр = ДокОбъект.Запасы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтр, Стр);
				НоваяСтр.СтавкаНДС = Арм_ОбщегоНазначенияАРМ.СтавкаНДСНоменклатуры(НоваяСтр.Номенклатура, ДокОбъект.Организация, ДокОбъект.Дата, СтавкаНДСПоУмолчанию);
				НоваяСтр.Сумма = НоваяСтр.Количество * НоваяСтр.Цена;
				ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммуНДСИВсего(НоваяСтр, ПараметрыРасчета);
			КонецЕсли;
		КонецЦикла;

		ДокОбъект.СостояниеЗаказа = Арм_ОбщегоНазначенияАРМ.СостояниеЗаказаПокупателяВРаботе(ДокОбъект);

		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Арм_Журнал.ЗаписатьИсключение("Арм_ДанныеЗакупокИПродажФон.ОбработатьЧистыеПродажиВФоне", ИнформацияОбОшибке());
			ВызватьИсключение СтрШаблон("Ошибка проведения Заказа Покупателя %1: %2", СсылкаНаЗаказ, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;

	КонецЕсли;

	НакладнаяОбъект = Документы.РасходнаяНакладная.СоздатьДокумент();
	НакладнаяОбъект.Дата = ТекущаяДатаСеанса();
	НакладнаяОбъект.ДополнительныеСвойства.Вставить("Арм_ПрограммнаяЗапись", Истина);

	Если ЕстьСтрокиСобрано Тогда

		НакладнаяОбъект.Заполнить(СсылкаНаЗаказ);
	Иначе


		НакладнаяОбъект.Заполнить(СсылкаНаЗаказ);
		ИндексТЧ = НакладнаяОбъект.Запасы.Количество() - 1;
		Пока ИндексТЧ >= 0 Цикл

			ТекущаяСтрокаТЧ = НакладнаяОбъект.Запасы[ИндексТЧ];

			ПараметрыПоиска = Новый Структура;
			ПараметрыПоиска.Вставить("Номенклатура", ТекущаяСтрокаТЧ.Номенклатура);
			ПараметрыПоиска.Вставить("Партия", ТекущаяСтрокаТЧ.Партия);

			НайденныеСтрокиРегистра = СтрокиЭтогоЗаказа.НайтиСтроки(ПараметрыПоиска);

			УдалитьСтроку = Истина;
			Для каждого СтрРег Из НайденныеСтрокиРегистра Цикл
				Если СтрРег.ОтметкаСтроки = Истина Тогда
					УдалитьСтроку = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;

			Если УдалитьСтроку Тогда
				НакладнаяОбъект.Запасы.Удалить(ИндексТЧ);
			КонецЕсли;

			ИндексТЧ = ИндексТЧ - 1;
		КонецЦикла;

		ПараметрыРасчетаНакладная = Новый Структура("СуммаВключаетНДС", НакладнаяОбъект.СуммаВключаетНДС);
		Для каждого СтрЗапасов Из НакладнаяОбъект.Запасы Цикл
			СтрЗапасов.Сумма = СтрЗапасов.Количество * СтрЗапасов.Цена;
			ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммуНДСИВсего(СтрЗапасов, ПараметрыРасчетаНакладная);
		КонецЦикла;

	КонецЕсли;

	Попытка
		НакладнаяОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		Арм_Журнал.ЗаписатьИсключение("Арм_ДанныеЗакупокИПродажФон.ОбработатьЧистыеПродажиВФоне", ИнформацияОбОшибке());
		ВызватьИсключение СтрШаблон("Ошибка проведения Расходной накладной по заказу %1: %2", СсылкаНаЗаказ, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

	НаборРег = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	НаборРег.Отбор.ДокументЗаказПокупателя.Установить(СсылкаНаЗаказ);
	НаборРег.Прочитать();

	ИзмененоРег = Ложь;
	Для каждого ЗаписьРег Из НаборРег Цикл
		Если Не ЗаписьРег.Удаление И ЗаписьРег.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда
			Если ЗаписьРег.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном Или ЗаписьРег.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Собран Тогда


				РоднойСтатус = ИсходныеСтатусыСтрок.Получить(ЗаписьРег.ИдентификаторЗаписи);
				Если РоднойСтатус = Неопределено Тогда
					РоднойСтатус = Перечисления.Арм_СтатусыАРМ.ВРаботе;
				КонецЕсли;

				Если ЗаписьРег.ОтметкаСтроки = Истина Тогда
					ЗаписьРег.РасходнаяНакладная = НакладнаяОбъект.Ссылка;
					// Номер отгрузки только системно из РН (матрица RO).
					ЗаписьРег.НомерОтгрузки = СокрЛП(НакладнаяОбъект.Номер);
					ЗаписьРег.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Отгружено;
					ЗаписьРег.ОтметкаСтроки = Ложь;
					ЗаписьРег.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
					ИзмененоРег = Истина;
				Иначе
					ЗаписьРег.СтатусСтроки = РоднойСтатус;
					ЗаписьРег.ОтметкаСтроки = Ложь;
					ЗаписьРег.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
					ИзмененоРег = Истина;
				КонецЕсли;

			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ИзмененоРег Тогда
		НаборРег.Записать();
	КонецЕсли;

КонецПроцедуры


Функция ПолучитьКлючиОтмеченныхСтрокЗаказа(Знач ТекущийЗаказ, Знач ОбщийМассивКлючей)

	Результат = Новый Массив;

	ЗапросКлючей = Новый Запрос;
	ЗапросКлючей.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Рег.КлючСвязиСтрок КАК КлючСвязиСтрок
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|ГДЕ
	|	Рег.ДокументЗаказПокупателя = &ТекущийЗаказ
	|	И Рег.КлючСвязиСтрок В(&ОбщийМассивКлючей)
	|	И НЕ Рег.Удаление";


	ЗапросКлючей.УстановитьПараметр("ТекущийЗаказ", ТекущийЗаказ);
	ЗапросКлючей.УстановитьПараметр("ОбщийМассивКлючей", ОбщийМассивКлючей);

	Выгрузка = ЗапросКлючей.Выполнить().Выгрузить();
	Результат = Выгрузка.ВыгрузитьКолонку("КлючСвязиСтрок");

	Возврат Результат;

КонецФункции


Функция ВалидацияСтрокЗакупок(МассивКлючей, ТекстОшибок)

	Запрос = Новый Запрос;

	Запрос.Текст = "ВЫБРАТЬ
	|	Рег.Номенклатура,
	|	Рег.НоменклатураКлиента КАК НоменклатураКлиента,
	|	""Пустой договор поставщика"" КАК ОписаниеОшибки
	|поМЕСТИТЬ втВсеОшибки
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|ГДЕ
	|	Рег.КлючСвязиСтрок В(&МассивКлючей)
	|	И Рег.Договор = ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|	И Рег.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
	|	И НЕ Рег.Удаление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Рег.Номенклатура,
	|	Рег.НоменклатураКлиента КАК НоменклатураКлиента,
	|	""Нулевая цена""
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|ГДЕ
	|	Рег.КлючСвязиСтрок В(&МассивКлючей)
	|	И Рег.Цена <= 0
	|	И НЕ Рег.Удаление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Рег.Номенклатура,
	|	Рег.НоменклатураКлиента КАК НоменклатураКлиента,
	|	""Нулевое количество""
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|ГДЕ
	|	Рег.КлючСвязиСтрок В(&МассивКлючей)
	|	И Рег.Количество <= 0
	|	И НЕ Рег.Удаление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Рег.Номенклатура,
	|	Рег.НоменклатураКлиента КАК НоменклатураКлиента,
	|	""Проверьте сопоставление (пустая номенклатура)""
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|ГДЕ
	|	Рег.КлючСвязиСтрок В(&МассивКлючей)
	|	И Рег.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И НЕ Рег.Удаление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Рег.Номенклатура,
	|	Рег.НоменклатураКлиента КАК НоменклатураКлиента,
	|	""Не указан поставщик для закупки""
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|ГДЕ
	|	Рег.КлючСвязиСтрок В(&МассивКлючей)
	|	И Рег.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
	|	И Рег.Поставщик = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	И НЕ Рег.Удаление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.НоменклатураКлиента КАК НоменклатураКлиента,
	|	Т.ОписаниеОшибки КАК ОписаниеОшибки
	|ИЗ
	|	втВсеОшибки КАК Т";


	Запрос.УстановитьПараметр("МассивКлючей", МассивКлючей);
	Результат = Запрос.Выполнить();

	Если Результат.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;

	Выборка = Результат.Выбрать();
	ТекстОшибок = СтрШаблон("Невозможно выполнить операцию! Исправьте ошибки: %1", Символы.ПС);

	Пока Выборка.Следующий() Цикл
		ПредставлениеТовара = ?(ЗначениеЗаполнено(Выборка.Номенклатура), Строка(Выборка.Номенклатура), "Товар не сопоставлен" + ?(ЗначениеЗаполнено(Выборка.НоменклатураКлиента), " («" + СокрЛП(Выборка.НоменклатураКлиента) + "»)", "")); // v2.22 (F-5)
		ТекстОшибок = ТекстОшибок + СтрШаблон("- %1: %2", ПредставлениеТовара, Выборка.ОписаниеОшибки) + Символы.ПС;
	КонецЦикла;

	Возврат Ложь;

КонецФункции


Функция ВалидацияСтрокПродаж(МассивКлючей, ТекстОшибок)

	// v2.10: проверки "номер отгрузки не заполнен" нет - номер ставится из РН при проведении.
	Запрос = Новый Запрос;

	Запрос.Текст = "ВЫБРАТЬ
	|	Рег.Номенклатура КАК Номенклатура,
	|	Рег.НоменклатураКлиента КАК НоменклатураКлиента,
	|	""Пустая дата отгрузки"" КАК ОписаниеОшибки
	|ПОМЕСТИТЬ втВсеОшибки
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|ГДЕ
	|	Рег.КлючСвязиСтрок В(&МассивКлючей)
	|	И Рег.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|	И НЕ Рег.Партия = ЗНАЧЕНИЕ(Справочник.ПартииНоменклатуры.ПустаяСсылка)  
	|	И Рег.ДатаОтгрузки = ДАТАВРЕМЯ(1, 1, 1)
	|	И НЕ Рег.Удаление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Рег.Номенклатура,
	|	Рег.НоменклатураКлиента КАК НоменклатураКлиента,
	|	""Нулевая цена""
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|ГДЕ
	|	Рег.КлючСвязиСтрок В(&МассивКлючей)
	|	И Рег.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа) 
	|	И Рег.Цена <= 0
	|	И НЕ Рег.Удаление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Рег.Номенклатура,
	|	Рег.НоменклатураКлиента КАК НоменклатураКлиента,
	|	""Нулевое количество""
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|ГДЕ
	|	Рег.КлючСвязиСтрок В(&МассивКлючей)
	|	И Рег.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|	И Рег.Количество <= 0
	|	И НЕ Рег.Удаление
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Рег.Номенклатура,
	|	Рег.НоменклатураКлиента КАК НоменклатураКлиента,
	|	""Проверьте сопоставление (пустая номенклатура)""
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|ГДЕ
	|	Рег.КлючСвязиСтрок В(&МассивКлючей)
	|	И Рег.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|	И Рег.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|	И НЕ Рег.Удаление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.НоменклатураКлиента КАК НоменклатураКлиента,
	|	Т.ОписаниеОшибки КАК ОписаниеОшибки
	|ИЗ
	|	втВсеОшибки КАК Т";


	Запрос.УстановитьПараметр("МассивКлючей", МассивКлючей);
	Результат = Запрос.Выполнить();

	Если Результат.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;

	Выборка = Результат.Выбрать();
	ТекстОшибок = СтрШаблон("Невозможно выполнить операцию! Исправьте ошибки: %1", Символы.ПС);

	Пока Выборка.Следующий() Цикл
		ПредставлениеТовара = ?(ЗначениеЗаполнено(Выборка.Номенклатура), Строка(Выборка.Номенклатура), "Товар не сопоставлен" + ?(ЗначениеЗаполнено(Выборка.НоменклатураКлиента), " («" + СокрЛП(Выборка.НоменклатураКлиента) + "»)", "")); // v2.22 (F-5)
		ТекстОшибок = ТекстОшибок + СтрШаблон("- %1: %2", ПредставлениеТовара, Выборка.ОписаниеОшибки) + Символы.ПС;
	КонецЦикла;

	Возврат Ложь;

КонецФункции

Функция ОбработатьЗаказыПокупателей(МассивКлючей)

	// v2.18: состояние заказа покупателя — СостояниеЗаказаПокупателяВРаботе (было — состояние заказа поставщику)
	СтавкаНДСПоУмолчанию = Арм_ОбщегоНазначенияАРМ.НайтиСтавкуНДС();

	Запрос = Новый Запрос;
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;

	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Рег.ДокументЗаказПокупателя КАК Заказ
	|ПОМЕСТИТЬ втЗадействованныеЗаказы
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|ГДЕ
	|	Рег.КлючСвязиСтрок В(&МассивКлючей)
	|	И НЕ Рег.Удаление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Рег.*,
	|	ВЫБОР
	|		КОГДА Рег.КлючСвязиСтрок В (&МассивКлючей)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ОтмеченаВРаботу
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗадействованныеЗаказы КАК втЗаказы
	|		ПО Рег.ДокументЗаказПокупателя = втЗаказы.Заказ
	|ГДЕ
	|	Рег.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|	И НЕ Рег.Удаление";


	Запрос.УстановитьПараметр("МассивКлючей", МассивКлючей);
	ТЗ_ДанныеАРМ = Запрос.Выполнить().Выгрузить();

	ТЗ_Заказы = ТЗ_ДанныеАРМ.Скопировать(, "ДокументЗаказПокупателя");
	ТЗ_Заказы.Свернуть("ДокументЗаказПокупателя");

	Для каждого СтрЗаказ Из ТЗ_Заказы Цикл

		Если Не ЗначениеЗаполнено(СтрЗаказ.ДокументЗаказПокупателя) Тогда
			Продолжить;
		КонецЕсли;

		СтрокиЭтогоЗаказа = ТЗ_ДанныеАРМ.НайтиСтроки(Новый Структура("ДокументЗаказПокупателя", СтрЗаказ.ДокументЗаказПокупателя));




		ВсегоСтрокПродаж = СтрокиЭтогоЗаказа.Количество();
		ОтмеченоСтрок = 0;
		Для каждого Стр Из СтрокиЭтогоЗаказа Цикл
			ОтмеченоСтрок = ОтмеченоСтрок + Стр.ОтмеченаВРаботу;
		КонецЦикла;

		НуженСплит = ВсегоСтрокПродаж > ОтмеченоСтрок;

		ДокОбъект = СтрЗаказ.ДокументЗаказПокупателя.ПолучитьОбъект();
		ДокОбъект.Запасы.Очистить();
		Если Не ЗначениеЗаполнено(ДокОбъект.Контрагент) Тогда
			ВызватьИсключение "В заказе покупателя не заполено контрагент";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДокОбъект.Договор) Тогда
			ДокОбъект.Договор = Арм_ОбщегоНазначенияАРМ.НайтиДоговор(ДокОбъект.Контрагент);
		КонецЕсли;
		ДокОбъект.Заполнить(Неопределено);
		ДокОбъект.СостояниеЗаказа = Арм_ОбщегоНазначенияАРМ.СостояниеЗаказаПокупателяВРаботе(ДокОбъект);
		ДокОбъект.ДополнительныеСвойства.Вставить("Арм_ПрограммнаяЗапись", Истина);

		БазоваяДатаШапки = ТекущаяДатаСеанса();
		Если СтрокиЭтогоЗаказа.Количество() > 0 Тогда
			Если ЗначениеЗаполнено(СтрокиЭтогоЗаказа[0].ДатаОтгрузки) Тогда
				БазоваяДатаШапки = СтрокиЭтогоЗаказа[0].ДатаОтгрузки;
			КонецЕсли;
		КонецЕсли;
		ДокОбъект.ДатаОтгрузки = БазоваяДатаШапки;

		Если НуженСплит Тогда

			НовыйДокОбъект = ДокОбъект.Скопировать();
			НовыйДокОбъект.Заполнить(Неопределено);
			// v2.22 (BUG-10): без признака подписка АРМ «ПриЗаписи» создавала для нового заказа свои строки АРМ, а затем
			// ОбновитьСсылкуЗПВРегистре переносила туда же исходные — строки задваивались (как в ветке отгрузки — признак есть)
			НовыйДокОбъект.ДополнительныеСвойства.Вставить("Арм_ПрограммнаяЗапись", Истина);
			НовыйДокОбъект.Контрагент = ДокОбъект.Контрагент;
			НовыйДокОбъект.Договор = ДокОбъект.Договор;
			НовыйДокОбъект.СостояниеЗаказа = Арм_ОбщегоНазначенияАРМ.СостояниеЗаказаПокупателяВРаботе(НовыйДокОбъект);
			НовыйДокОбъект.Дата = ТекущаяДатаСеанса();
			НовыйДокОбъект.ДатаОтгрузки = ДокОбъект.ДатаОтгрузки; // v2.19: Заполнить() очищает дату отгрузки, без неё заказ не проводится
			НовыйДокОбъект.Запасы.Очистить();

			МассивЛишнихКлючей = Новый Массив;

			Для каждого Стр Из СтрокиЭтогоЗаказа Цикл

				ПараметрыРасчета = Новый Структура;
				ПараметрыРасчета.Вставить("СуммаВключаетНДС", ДокОбъект.СуммаВключаетНДС);

				Если Стр.ОтмеченаВРаботу = 1 Тогда
					НоваяСтр = ДокОбъект.Запасы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтр, Стр);
					НоваяСтр.СтавкаНДС = Арм_ОбщегоНазначенияАРМ.СтавкаНДСНоменклатуры(НоваяСтр.Номенклатура, ДокОбъект.Организация, ДокОбъект.Дата, СтавкаНДСПоУмолчанию);
					НоваяСтр.Сумма = НоваяСтр.Количество * НоваяСтр.Цена; // v2.21: без суммы заказ покупателя писался с Сумма = 0
					ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммуНДСИВсего(НоваяСтр, ПараметрыРасчета);
				Иначе
					НоваяСтр = НовыйДокОбъект.Запасы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтр, Стр);
					НоваяСтр.СтавкаНДС = Арм_ОбщегоНазначенияАРМ.СтавкаНДСНоменклатуры(НоваяСтр.Номенклатура, НовыйДокОбъект.Организация, НовыйДокОбъект.Дата, СтавкаНДСПоУмолчанию);
					МассивЛишнихКлючей.Добавить(Стр.КлючСвязиСтрок);
					НоваяСтр.Сумма = НоваяСтр.Количество * НоваяСтр.Цена; // v2.21: без суммы заказ покупателя писался с Сумма = 0
					ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммуНДСИВсего(НоваяСтр, ПараметрыРасчета);
				КонецЕсли;
			КонецЦикла;

			НовыйДокОбъект.Записать(РежимЗаписиОстаткаСплита(НовыйДокОбъект)); // v2.19: строки, оставшиеся после сплита, тоже в учёте

			ОбновитьСсылкуЗПВРегистре(МассивЛишнихКлючей, НовыйДокОбъект.Ссылка, ДокОбъект.Ссылка);

			ТекстЛога = СтрШаблон("Заказ %1 разделен. Остаток перенесен в %2", ДокОбъект.Ссылка, НовыйДокОбъект.Ссылка);
			ЗаписьЖурналаРегистрации("АРМ.СплитЗаказа", УровеньЖурналаРегистрации.Информация, , , ТекстЛога);
		Иначе
			Для каждого Стр Из СтрокиЭтогоЗаказа Цикл
				НоваяСтр = ДокОбъект.Запасы.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтр, Стр);
				НоваяСтр.СтавкаНДС = Арм_ОбщегоНазначенияАРМ.СтавкаНДСНоменклатуры(НоваяСтр.Номенклатура, ДокОбъект.Организация, ДокОбъект.Дата, СтавкаНДСПоУмолчанию);
				ПараметрыРасчета = Новый Структура;
				ПараметрыРасчета.Вставить("СуммаВключаетНДС", ДокОбъект.СуммаВключаетНДС);
				НоваяСтр.Сумма = НоваяСтр.Количество * НоваяСтр.Цена; // v2.21: без суммы заказ покупателя писался с Сумма = 0
				ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммуНДСИВсего(НоваяСтр, ПараметрыРасчета);
			КонецЦикла;
		КонецЕсли;

		Попытка
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Арм_Журнал.ЗаписатьИсключение("Арм_ДанныеЗакупокИПродажФон.ОбработатьЗаказыПокупателей", ИнформацияОбОшибке());
			ТекстОшибки = СтрШаблон("Ошибка проведения %1: %2", ДокОбъект.Ссылка, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));




			ВызватьИсключение ТекстОшибки;
		КонецПопытки;

	КонецЦикла;

	Возврат Истина;

КонецФункции

Процедура СоздатьЗаказыПоставщикамНаСервере(МассивКлючей, ИсходныеСтатусыСтрок)
	Перем СостояниеВРаботе;


	СостояниеВРаботе = Справочники.СостоянияЗаказовПоставщикам.НайтиПоНаименованию("В работе");
	Если Не ЗначениеЗаполнено(СостояниеВРаботе) Тогда
		СостояниеЗаказа = Справочники.СостоянияЗаказовПоставщикам.СоздатьЭлемент();
		СостояниеЗаказа.Наименование = "В работе";
		СостояниеЗаказа.Записать();
		СостояниеВРаботе = СостояниеЗаказа.Ссылка;
	КонецЕсли;

	СтавкаНДСПоУмолчанию = Арм_ОбщегоНазначенияАРМ.НайтиСтавкуНДС();

	Запрос = Новый Запрос;
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;

	Запрос.Текст = "ВЫБРАТЬ
	|	Т.*
	|ПОМЕСТИТЬ втДанныеДляЗаказа
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.КлючСвязиСтрок В(&МассивКлючей)
	|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
	|	И Т.СтатусСтроки = ЗНАЧЕНИЕ(Перечисление.Арм_СтатусыАРМ.ЗаблокированоФоном)
	|	И НЕ Т.Удаление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.Поставщик КАК Поставщик,
	|	Т.Договор КАК Договор,
	|	Т.ДокументЗаказПокупателя КАК ДокументЗаказПокупателя
	|ИЗ
	|	втДанныеДляЗаказа КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.*
	|ИЗ
	|	втДанныеДляЗаказа КАК Т";


	Запрос.УстановитьПараметр("МассивКлючей", МассивКлючей);
	МассивРезультатов = Запрос.ВыполнитьПакет();
	ТЗ_ШапкиЗаказов = МассивРезультатов[1].Выгрузить();
	ТЗ_ВсеСтроки = МассивРезультатов[2].Выгрузить();

	ДатаПоступления = ТекущаяДатаСеанса() + 4 * 86400;
	Если ТЗ_ВсеСтроки.Количество() > 0 Тогда
		Если ЗначениеЗаполнено(ТЗ_ВсеСтроки[0].ДатаПоступления) Тогда
			ДатаПоступления = ТЗ_ВсеСтроки[0].ДатаПоступления;
		КонецЕсли;
	КонецЕсли;

	Для каждого СтрШапка Из ТЗ_ШапкиЗаказов Цикл

		ЗаказОбъект = Документы.ЗаказПоставщику.СоздатьДокумент();
		ЗаказОбъект.Дата = ТекущаяДатаСеанса();
		ЗаказОбъект.Заполнить(Неопределено);


		ЗаказОбъект.Контрагент = СтрШапка.Поставщик;
		ЗаказОбъект.Договор = Арм_ОбщегоНазначенияАРМ.НайтиДоговор(СтрШапка.Поставщик);
		ЗаказОбъект.СостояниеЗаказа = СостояниеВРаботе;
		ЗаказОбъект.ЗаказПокупателя = СтрШапка.ДокументЗаказПокупателя;
		ЗаказОбъект.ДокументОснование = СтрШапка.ДокументЗаказПокупателя;
		ЗаказОбъект.ДатаПоступления = ДатаПоступления;

		Отбор = Новый Структура("Поставщик, Договор, ДокументЗаказПокупателя", СтрШапка.Поставщик, СтрШапка.Договор, СтрШапка.ДокументЗаказПокупателя);

		СтрокиТоваров = ТЗ_ВсеСтроки.НайтиСтроки(Отбор);

		Для каждого СтрТовар Из СтрокиТоваров Цикл

			НоваяСтр = ЗаказОбъект.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтр, СтрТовар);
			НоваяСтр.ЗаказПокупателя = СтрШапка.ДокументЗаказПокупателя;
			Если Не ЗначениеЗаполнено(НоваяСтр.ДатаПоступления) Тогда
				НоваяСтр.ДатаПоступления = ДатаПоступления;
			КонецЕсли;
			Если Не ЗначениеЗаполнено(НоваяСтр.ЕдиницаИзмерения) Тогда
				НоваяСтр.ЕдиницаИзмерения = СтрТовар.Номенклатура.ЕдиницаИзмерения;
			КонецЕсли;

			НоваяСтр.СтавкаНДС = Арм_ОбщегоНазначенияАРМ.СтавкаНДСНоменклатуры(НоваяСтр.Номенклатура, ЗаказОбъект.Организация, ЗаказОбъект.Дата, СтавкаНДСПоУмолчанию);
			НоваяСтр.Сумма = СтрТовар.Количество * СтрТовар.Цена;

			ПараметрыРасчета = Новый Структура("СуммаВключаетНДС", ЗаказОбъект.СуммаВключаетНДС);
			ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммуНДСИВсего(НоваяСтр, ПараметрыРасчета);

		КонецЦикла;

		Попытка
			ЗаказОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Арм_Журнал.ЗаписатьИсключение("Арм_ДанныеЗакупокИПродажФон.СоздатьЗаказыПоставщикамНаСервере", ИнформацияОбОшибке());
			ТекстОшибки = СтрШаблон("Ошибка при проведении заказа поставщику для %1: %2", СтрШапка.Поставщик, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

			ВызватьИсключение ТекстОшибки;
		КонецПопытки;

		МассивИдентификаторов = Новый Массив;
		Для каждого СтрТЗ Из СтрокиТоваров Цикл
			МассивИдентификаторов.Добавить(СтрТЗ.ИдентификаторЗаписи);
		КонецЦикла;

		ОбновитьДанныеЗакупокВРегистре(СтрШапка, ЗаказОбъект.Ссылка, МассивИдентификаторов, ИсходныеСтатусыСтрок);

	КонецЦикла;

КонецПроцедуры

Процедура ОбновитьДанныеЗакупокВРегистре(СтрШапка, СсылкаНаЗаказ, МассивИдентификаторов, ИсходныеСтатусыСтрок)
	Перем Набор;

	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ДокументЗаказПокупателя.Установить(СтрШапка.ДокументЗаказПокупателя);
	Набор.Прочитать();

	МассивКлючейДляОбновления = Новый Массив;
	ПарыЗакупокДляСинхронизации = Новый Соответствие;
	Изменено = Ложь;

	Для каждого Запись Из Набор Цикл

		Если Не Запись.Удаление И Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка Тогда

			Если Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном И МассивИдентификаторов.Найти(Запись.ИдентификаторЗаписи) <> Неопределено Тогда


				Запись.ДокументЗаказПоставщика = СсылкаНаЗаказ;
				Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Заказано;
				// v2.13: С6 «Дата заказа поставщику», если не отмечена кнопкой «Создать заказ поставщику»
				Если Не ЗначениеЗаполнено(Запись.ДатаЗаказаПоставщику) Тогда
					Запись.ДатаЗаказаПоставщику = ТекущаяДатаСеанса();
				КонецЕсли;
				Запись.ОтметкаСтроки = Ложь;
				Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();

				МассивКлючейДляОбновления.Добавить(Запись.КлючСвязиСтрок);
				ПарыЗакупокДляСинхронизации.Вставить(Запись.КлючСвязиСтрок, Запись.Количество);
				Изменено = Истина;

			ИначеЕсли Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном И МассивИдентификаторов.Найти(Запись.ИдентификаторЗаписи) = Неопределено Тогда


				РоднойСтатус = ИсходныеСтатусыСтрок.Получить(Запись.ИдентификаторЗаписи);
				Если РоднойСтатус = Неопределено Тогда
					РоднойСтатус = Перечисления.Арм_СтатусыАРМ.ВРаботе;
				КонецЕсли;

				Запись.СтатусСтроки = РоднойСтатус;
				Запись.ОтметкаСтроки = Ложь;
				Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
				Изменено = Истина;
			КонецЕсли;

		КонецЕсли;

	КонецЦикла;

	Если ПарыЗакупокДляСинхронизации.Количество() > 0 Тогда

		Для каждого Запись Из Набор Цикл

			Если Не Запись.Удаление И Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда
				Если Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном Тогда

					РоднойСтатус = ИсходныеСтатусыСтрок.Получить(Запись.ИдентификаторЗаписи);
					Если РоднойСтатус = Неопределено Тогда
						РоднойСтатус = ?(ЗначениеЗаполнено(Запись.ДокументЗаказПоставщика), Перечисления.Арм_СтатусыАРМ.Заказано, Перечисления.Арм_СтатусыАРМ.ВРаботе);

					КонецЕсли;

					ЦелевоеКоличествоЗакупки = ПарыЗакупокДляСинхронизации.Получить(Запись.КлючСвязиСтрок);

					Если МассивКлючейДляОбновления.Найти(Запись.КлючСвязиСтрок) <> Неопределено Тогда
						Запись.ДокументЗаказПоставщика = СсылкаНаЗаказ;
						Если Не ЗначениеЗаполнено(Запись.ДатаЗаказаПоставщику) Тогда
							Запись.ДатаЗаказаПоставщику = ТекущаяДатаСеанса();
						КонецЕсли;
					КонецЕсли;

					Если ЦелевоеКоличествоЗакупки <> Неопределено И Запись.Количество = ЦелевоеКоличествоЗакупки И Не ЗначениеЗаполнено(Запись.Партия) Тогда


						Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Заказано;
						ПарыЗакупокДляСинхронизации.Удалить(Запись.КлючСвязиСтрок);
					Иначе
						Запись.СтатусСтроки = РоднойСтатус;
					КонецЕсли;

					Запись.ОтметкаСтроки = Ложь;
					Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
					Изменено = Истина;

				КонецЕсли;
			КонецЕсли;

		КонецЦикла;

	КонецЕсли;

	Если Изменено Тогда
		Попытка
			Набор.Записать();
		Исключение
			Арм_Журнал.ЗаписатьИсключение("Арм_ДанныеЗакупокИПродажФон.ОбновитьДанныеЗакупокВРегистре", ИнформацияОбОшибке());
			ТекстОшибки = СтрШаблон("Ошибка при изменении статуса строк. Подробности: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));



			ВызватьИсключение ТекстОшибки;
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры


Процедура ОбновитьСсылкуЗПВРегистре(МассивЛишнихКлючей, НоваяСсылкаЗП, СтараяСсылкаЗП) Экспорт

	Если МассивЛишнихКлючей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ЗапросGUID = Новый Запрос;
	ЗапросGUID.Текст = "ВЫБРАТЬ
	|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.ДокументЗаказПокупателя = &СтараяСсылкаЗП
	|	И Т.КлючСвязиСтрок В (&МассивЛишнихКлючей)
	|	И Т.ОтметкаСтроки = ЛОЖЬ
	|	И NOT Т.Удаление";


	ЗапросGUID.УстановитьПараметр("СтараяСсылкаЗП", СтараяСсылкаЗП);
	ЗапросGUID.УстановитьПараметр("МассивЛишнихКлючей", МассивЛишнихКлючей);

	ТаблицаGUID = ЗапросGUID.Выполнить().Выгрузить();
	МассивЛишнихGUID = ТаблицаGUID.ВыгрузитьКолонку("ИдентификаторЗаписи");

	Если МассивЛишнихGUID.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	НаборСтарый = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	НаборСтарый.Отбор.ДокументЗаказПокупателя.Установить(СтараяСсылкаЗП);
	НаборСтарый.Прочитать();

	ТЗ_ПереносимыеСтроки = НаборСтарый.ВыгрузитьКолонки();

	Индекс = НаборСтарый.Количество() - 1;
	Пока Индекс >= 0 Цикл

		ЗаписьСтарая = НаборСтарый[Индекс];

		Если МассивЛишнихGUID.Найти(ЗаписьСтарая.ИдентификаторЗаписи) <> Неопределено Тогда

			ЗаполнитьЗначенияСвойств(ТЗ_ПереносимыеСтроки.Добавить(), ЗаписьСтарая);
			НаборСтарый.Удалить(Индекс);

		КонецЕсли;

		Индекс = Индекс - 1;
	КонецЦикла;

	НаборСтарый.Записать();

	НаборНовый = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	НаборНовый.Отбор.ДокументЗаказПокупателя.Установить(НоваяСсылкаЗП);
	НаборНовый.Прочитать();
	// v2.22 (BUG-9): ключ связи строки сохраняется. Раньше всем перенесённым строкам давался один новый ключ: закупки
	// одной строки «прилипали» ко всем, строки одной номенклатуры схлопывались в одну, а строки нового заказа
	// покупателя (скопированы со старыми ключами) переставали совпадать со строками АРМ.
	// v2.22 (BUG-1): строки, перенесённые в новый заказ, получают его номер и дату (раньше оставались от старого)
	РеквизитыНовогоЗаказа = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоваяСсылкаЗП, "Номер, Дата");

	Для каждого СтрИзПамяти Из ТЗ_ПереносимыеСтроки Цикл
		НоваяЗаписьРег = НаборНовый.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗаписьРег, СтрИзПамяти);
		НоваяЗаписьРег.ДокументЗаказПокупателя = НоваяСсылкаЗП;
		НоваяЗаписьРег.НомерЗаказа = РеквизитыНовогоЗаказа.Номер;
		НоваяЗаписьРег.ДатаЗаказа = РеквизитыНовогоЗаказа.Дата;
	КонецЦикла;

	НаборНовый.Записать();

	НаборРазблок = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	НаборРазблок.Отбор.ДокументЗаказПокупателя.Установить(НоваяСсылкаЗП);
	НаборРазблок.Прочитать();

	ИзмененоРазблок = Ложь;
	Для каждого ЗаписьРазблок Из НаборРазблок Цикл
		Если Не ЗаписьРазблок.Удаление Тогда
			Если ЗаписьРазблок.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном Тогда

				Если ЗаписьРазблок.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда
					ЗаписьРазблок.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ВРаботе;
				ИначеЕсли ЗаписьРазблок.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка Тогда
					ЗаписьРазблок.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик;
				КонецЕсли;

				ЗаписьРазблок.ОтметкаСтроки = Ложь;
				ЗаписьРазблок.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
				ИзмененоРазблок = Истина;

			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ИзмененоРазблок Тогда
		НаборРазблок.Записать();
	КонецЕсли;

КонецПроцедуры




// v2.22 (BUG-4): заказ-остаток после сплита проводится, только если во всех строках заполнена номенклатура;
// строки без подбора (номенклатура не выбрана) проведение не пропускают — такой заказ только записывается.
Функция РежимЗаписиОстаткаСплита(ДокОбъект)

	Для Каждого СтрокаЗапасов Из ДокОбъект.Запасы Цикл
		Если Не ЗначениеЗаполнено(СтрокаЗапасов.Номенклатура) Тогда
			Если ДокОбъект.Проведен Тогда
				Возврат РежимЗаписиДокумента.ОтменаПроведения;
			КонецЕсли;
			Возврат РежимЗаписиДокумента.Запись;
		КонецЕсли;
	КонецЦикла;
	Возврат РежимЗаписиДокумента.Проведение;

КонецФункции

// v2.22 (BUG-6): «Заказать» / «Провести заказ» — только менеджер и администратор АРМ. Проверка здесь, а не только
// в форме: процедуру вызывают и форма (фоновое задание), и команда АРМ_OData «ВРаботе» (PWA).
Функция ТекстОтказаПоРоли(Пользователь) Экспорт

	Роль = РегистрыСведений.Арм_ПраваПользователей.ПолучитьРольИнтерфейсаСтрого(Пользователь);
	Если Роль = Перечисления.Арм_РолиИнтерфейса.Администратор Или Роль = Перечисления.Арм_РолиИнтерфейса.Менеджер Тогда
		Возврат "";
	КонецЕсли;
	Возврат "Действие доступно менеджеру и администратору АРМ.";

КонецФункции

// v2.22 (UX-3): что сделала команда — «Заказать» (закупки -> заказы поставщикам) и «Провести заказ» (продажи ->
// заказ покупателя и расходная накладная) вызывают одно задание; сообщение говорит, что именно оформлено.
Функция ОписаниеВыполненного(АнализЗаказовПамять)

	ПоЗакупкам = 0;
	ПоПродажам = 0;
	Для Каждого КлючИЗначение Из АнализЗаказовПамять Цикл
		Если КлючИЗначение.Значение.ОтмеченыЗакупки Тогда
			ПоЗакупкам = ПоЗакупкам + 1;
		ИначеЕсли КлючИЗначение.Значение.КолВоВыбранных > 0 Тогда
			ПоПродажам = ПоПродажам + 1;
		КонецЕсли;
	КонецЦикла;
	Части = Новый Массив;
	Если ПоЗакупкам > 0 Тогда
		Части.Добавить(СтрШаблон("Заказы поставщикам оформлены (заказов покупателей: %1)", ПоЗакупкам));
	КонецЕсли;
	Если ПоПродажам > 0 Тогда
		Части.Добавить(СтрШаблон("Заказы покупателей проведены, расходные накладные оформлены: %1", ПоПродажам));
	КонецЕсли;
	Возврат ?(Части.Количество() = 0, "Все документы оформлены", СтрСоединить(Части, ". ") + ".");

КонецФункции

// v2.22 (BUG-8): ЗаблокироватьСтроки ставит «ЗаблокированоФоном» всем строкам заказа в «Черновик»/«В работе», а ветки
// обработки возвращают статус только своим строкам (отгрузка — продажам). Остальные (например, авто-закупка при отгрузке
// продажи со склада) оставались «ЗаблокированоФоном» навсегда. Возвращаем им исходный статус.
Процедура РазблокироватьОставшиесяСтроки(МассивЗаказов, ИсходныеСтатусыСтрок)

	Для Каждого ТекущийЗаказ Из МассивЗаказов Цикл
		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
		Набор.Отбор.ДокументЗаказПокупателя.Установить(ТекущийЗаказ);
		Набор.Прочитать();
		Изменено = Ложь;
		Для Каждого Запись Из Набор Цикл
			Если Запись.СтатусСтроки <> Перечисления.Арм_СтатусыАРМ.ЗаблокированоФоном Тогда
				Продолжить;
			КонецЕсли;
			Исходный = ИсходныеСтатусыСтрок.Получить(Запись.ИдентификаторЗаписи);
			Если Исходный = Неопределено Тогда
				Исходный = ?(Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка,
					Перечисления.Арм_СтатусыАРМ.Черновик, Перечисления.Арм_СтатусыАРМ.ВРаботе);
			КонецЕсли;
			Запись.СтатусСтроки = Исходный;
			Изменено = Истина;
		КонецЦикла;
		Если Изменено Тогда
			Набор.Записать();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры
