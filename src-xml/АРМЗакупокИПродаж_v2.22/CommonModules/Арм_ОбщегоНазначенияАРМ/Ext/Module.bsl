Функция ПолучитьПриоритет(Номенклатура) Экспорт

	ЗапросПриоритета = Новый Запрос;
	ЗапросПриоритета.Текст = "ВЫБРАТЬ
	|	МАКСИМУМ(ЕСТЬNULL(Арм_ДанныеЗакупокИПродаж.Порядок, 0)) КАК МаксимальныйПорядок
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Арм_ДанныеЗакупокИПродаж
	|ГДЕ
	|	Арм_ДанныеЗакупокИПродаж.Номенклатура = &Номенклатура";

	ЗапросПриоритета.УстановитьПараметр("Номенклатура", Номенклатура);
	Результат = ЗапросПриоритета.Выполнить().Выбрать();

	НовыйПриоритет = 0;
	Если Результат.Следующий() И Результат.МаксимальныйПорядок <> Null Тогда
		НовыйПриоритет = Результат.МаксимальныйПорядок + 1;
	Иначе
		НовыйПриоритет = 1000;
	КонецЕсли;

	Возврат НовыйПриоритет;

КонецФункции





Функция НайтиДоговор(Контрагент) Экспорт
	Перем ДоговорКонтрагента;

	ДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();

	Если ЗначениеЗаполнено(Контрагент) Тогда

		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
		|	И ДоговорыКонтрагентов.Владелец.Ссылка = &Ссылка
		|	И НЕ ДоговорыКонтрагентов.Владелец.Недействителен
		|	И ДоговорыКонтрагентов.ДатаДоговора <= &ТекущаяДата
		|	И ДоговорыКонтрагентов.СрокДействия >= &ТекущаяДата
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ДоговорыКонтрагентов.Ссылка
		|ИЗ
		|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
		|ГДЕ
		|	НЕ ДоговорыКонтрагентов.ПометкаУдаления
		|	И ДоговорыКонтрагентов.Владелец.Ссылка = &Ссылка
		|	И НЕ ДоговорыКонтрагентов.Владелец.Недействителен
		|	И ДоговорыКонтрагентов.СрокДействия = ДАТАВРЕМЯ(1, 1, 1)";


		Запрос.УстановитьПараметр("Ссылка", Контрагент);
		Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДатаСеанса());
		РезультатЗапроса = Запрос.Выполнить();
		ВыборкаДоговор = РезультатЗапроса.Выбрать();

		Если ВыборкаДоговор.Следующий() Тогда
			ДоговорКонтрагента = ВыборкаДоговор.Ссылка;
		КонецЕсли;

	КонецЕсли;

	Возврат ДоговорКонтрагента;

КонецФункции

// v2.22 (BUG-2): Период (СтандартныйПериод формы АРМ) — учитывать только продажи заказов этого периода (то, что видно
// в верхней таблице); отметки продаж вне периода не обрабатываются. Без периода — как раньше (PWA, OData).
Функция ПолучитьМассивОтмеченныхКлючейСвязи(Знач МассивВалидныхСтатусов = Неопределено, Знач Период = Неопределено) Экспорт
	Перем ЕстьФильтрСтатусов;

	ЕстьФильтрСтатусов = МассивВалидныхСтатусов <> Неопределено И МассивВалидныхСтатусов.Количество() > 0;
	ВалидныеСтатусы = ?(ЕстьФильтрСтатусов, МассивВалидныхСтатусов, Новый Массив);

	МассивКлючей = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.КлючСвязиСтрок КАК КлючСвязиСтрок
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	НЕ Т.Удаление
	|	И Т.ОтметкаСтроки = ИСТИНА
	|	И Т.АвторСтроки = &Автор
	|	И НЕ &ЕстьФильтрСтатусов
	|	И (НЕ &ЕстьПериод
	|			ИЛИ Т.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|			ИЛИ Т.ДокументЗаказПокупателя.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.КлючСвязиСтрок
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	НЕ Т.Удаление
	|	И Т.ОтметкаСтроки = ИСТИНА
	|	И Т.АвторСтроки = &Автор
	|	И &ЕстьФильтрСтатусов
	|	И Т.СтатусСтроки В(&ВалидныеСтатусы)
	|	И (НЕ &ЕстьПериод
	|			ИЛИ Т.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|			ИЛИ Т.ДокументЗаказПокупателя.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания)";


	Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("ЕстьФильтрСтатусов", ЕстьФильтрСтатусов);
	Запрос.УстановитьПараметр("ВалидныеСтатусы", ВалидныеСтатусы);
	ГраницыПериода = ГраницыПериодаФормы(Период);
	Запрос.УстановитьПараметр("ЕстьПериод", ГраницыПериода.ЕстьПериод);
	Запрос.УстановитьПараметр("ДатаНачала", ГраницыПериода.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ГраницыПериода.ДатаОкончания);

	Результат = Запрос.Выполнить();

	Если Не Результат.Пустой() Тогда
		МассивКлючей = Результат.Выгрузить().ВыгрузитьКолонку("КлючСвязиСтрок");
	КонецЕсли;

	Возврат МассивКлючей;

КонецФункции


Функция ПолучитьМассивОтмеченныхИдентификаторов(ВидОперации) Экспорт

	// v2.12.1 (audit F-17): при отсутствии отметок возвращаем пустой массив, а не Неопределено.
	МассивИдентификаторов = Новый Массив;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	НЕ Т.Удаление
	|	И Т.ВидОперации = &ВидОперации
	|	И Т.ОтметкаСтроки = ИСТИНА
	|	И Т.АвторСтроки = &Автор";


	Запрос.УстановитьПараметр("ВидОперации", ВидОперации);
	Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);

	Результат = Запрос.Выполнить();

	Если Не Результат.Пустой() Тогда
		МассивИдентификаторов = Результат.Выгрузить().ВыгрузитьКолонку("ИдентификаторЗаписи");
	КонецЕсли;

	Возврат МассивИдентификаторов;

КонецФункции



Функция ПроверитьНеобходимостьСплитаНаСервере_ТЗ_Часть2() Экспорт

	ТЗ_Результаты = Новый ТаблицаЗначений;
	ТЗ_Результаты.Колонки.Добавить("ДокументЗаказПокупателя");
	ТЗ_Результаты.Колонки.Добавить("ТребуетсяРазделение", Новый ОписаниеТипов("Булево"));
	ТЗ_Результаты.Колонки.Добавить("КолВоВыбранных", Новый ОписаниеТипов("Число"));
	ТЗ_Результаты.Колонки.Добавить("ОбщееКолВо", Новый ОписаниеТипов("Число"));

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Внутр.ДокументЗаказПокупателя КАК Заказ
	|ПОМЕСТИТЬ втЗадействованныеЗаказы
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Внутр
	|ГДЕ
	|	Внутр.ОтметкаСтроки = ИСТИНА
	|	И НЕ Внутр.Удаление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Т.ДокументЗаказПокупателя КАК ДокументЗаказПокупателя,
	|	СУММА(Т.Количество) КАК ВсегоШтукВЗаказе,
	|	СУММА(ВЫБОР
	|			КОГДА Т.ОтметкаСтроки = ИСТИНА
	|				ТОГДА Т.Количество
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОтмеченоШтукНаЭкране,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВЫБОР
	|			КОГДА Т.ОтметкаСтроки = ИСТИНА
	|				ТОГДА Т.ИдентификаторЗаписи
	|		КОНЕЦ) КАК КолВоВыбранных
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗадействованныеЗаказы КАК ВТ_Заказы
	|		ПО Т.ДокументЗаказПокупателя = ВТ_Заказы.Заказ
	|ГДЕ
	|	НЕ Т.Удаление
	|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|
	|СГРУППИРОВАТЬ ПО
	|	Т.ДокументЗаказПокупателя";


	Выборка = Запрос.Выполнить().Выбрать();

	Пока Выборка.Следующий() Цикл

		ВсегоШтукВЗаказе = ?(Выборка.ВсегоШтукВЗаказе = Null, 0, Выборка.ВсегоШтукВЗаказе);
		ОтмеченоШтукНаЭкране = ?(Выборка.ОтмеченоШтукНаЭкране = Null, 0, Выборка.ОтмеченоШтукНаЭкране);

		СплитДляТекущегоЗаказа = ВсегоШтукВЗаказе > ОтмеченоШтукНаЭкране И ОтмеченоШтукНаЭкране > 0;

		НоваяСтрока = ТЗ_Результаты.Добавить();
		НоваяСтрока.ДокументЗаказПокупателя = Выборка.ДокументЗаказПокупателя;
		НоваяСтрока.ТребуетсяРазделение = СплитДляТекущегоЗаказа;
		НоваяСтрока.КолВоВыбранных = Выборка.КолВоВыбранных;
		НоваяСтрока.ОбщееКолВо = ВсегоШтукВЗаказе;

	КонецЦикла;

	Возврат ТЗ_Результаты;

КонецФункции


Функция ПроверитьНеобходимостьСплитаНаСервере() Экспорт

	СтатусыДляМенеджера = Новый Массив;
	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.ВРаботе"));
	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Черновик"));
	СтатусыДляМенеджера.Добавить(ПредопределенноеЗначение("Перечисление.Арм_СтатусыАРМ.Собран"));
	МассивКлючей = ПолучитьМассивОтмеченныхКлючейСвязи(СтатусыДляМенеджера);

	ТЗ_Ключи = Новый ТаблицаЗначений;
	КвалификаторыСтроки = Новый КвалификаторыСтроки(100, ДопустимаяДлина.Переменная);
	МассивТиповСтроки = Новый Массив;
	МассивТиповСтроки.Добавить(Тип("Строка"));
	ОписаниеТипаСтрока = Новый ОписаниеТипов(МассивТиповСтроки, Неопределено, КвалификаторыСтроки);

	ТЗ_Ключи.Колонки.Добавить("КлючСвязиСтрок", ОписаниеТипаСтрока);

	Для каждого Ключ Из МассивКлючей Цикл
		ТЗ_Ключи.Добавить().КлючСвязиСтрок = Ключ;
	КонецЦикла;

	Запрос = Новый Запрос;
	МенеджерВТ = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МенеджерВТ;

	Запрос.Текст = "ВЫБРАТЬ
	|	Т.КлючСвязиСтрок КАК КлючСвязи
	|ПОМЕСТИТЬ втОтмеченныеКлючи
	|ИЗ
	|	&МассивКлючей КАК Т
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Рег.ДокументЗаказПокупателя КАК Заказ
	|ПОМЕСТИТЬ втЗадействованныеЗаказы
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втОтмеченныеКлючи КАК вт
	|		ПО Рег.КлючСвязиСтрок = вт.КлючСвязи
	|ГДЕ
	|	НЕ Рег.Удаление
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Рег.КлючСвязиСтрок) КАК ВсегоВЗаказах
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Рег
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ втЗадействованныеЗаказы КАК вт
	|		ПО Рег.ДокументЗаказПокупателя = вт.Заказ
	|ГДЕ
	|	НЕ Рег.Удаление";


	Запрос.УстановитьПараметр("МассивКлючей", ТЗ_Ключи);

	Выборка = Запрос.Выполнить().Выбрать();

	ОбщееКолВо = 0;
	Если Выборка.Следующий() Тогда
		ОбщееКолВо = Выборка.ВсегоВЗаказах;
	КонецЕсли;

	Результат = Новый Структура;
	Результат.Вставить("ТребуетсяРазделение", ОбщееКолВо > МассивКлючей.Количество());
	Результат.Вставить("КолВоВыбранных", МассивКлючей.Количество());
	Результат.Вставить("ОбщееКолВо", ОбщееКолВо);

	Возврат Результат;

КонецФункции


// v2.11 (T07, D1b/D3) / v2.12 (H03, D10=A): гейт ролей для записи на форме снабжения
// (смена статусов цепочки закупки, отметки строк). Ролевой whitelist без матрицы line_status:
// Менеджер, Снабжение, Кладовщик, Администратор; роль строго из Арм_ПраваПользователей
// (нет записи / Клиент / Поставщик / ГлавныйМеханик - отказ). Возвращает "" - можно, иначе текст отказа.
Функция ОтказРолиСнабжения() Экспорт

	Роль = РегистрыСведений.Арм_ПраваПользователей.ПолучитьРольИнтерфейсаСтрого(ПараметрыСеанса.ТекущийПользователь);
	Если Роль <> Перечисления.Арм_РолиИнтерфейса.Менеджер
		И Роль <> Перечисления.Арм_РолиИнтерфейса.Снабжение
		И Роль <> Перечисления.Арм_РолиИнтерфейса.Кладовщик
		И Роль <> Перечисления.Арм_РолиИнтерфейса.Администратор Тогда
		Возврат "Действие на форме снабжения доступно ролям Менеджер, Снабжение, Кладовщик и Администратор. "
			+ "Проверьте роль в регистре «Права пользователей АРМ».";
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ИзменитьСтатусыВРегистреСнабжения(Знач МассивИдентификаторов, Знач ЦелевойСтатус) Экспорт

	Итог = Новый Структура("Успешно, КоличествоОбработанных, ТекстОшибки", Ложь, 0, "");

	// v2.12 (H03, D10=A): цепочка закупки (Заказано→Оплачено→…→Собран) — ролевой whitelist + жёсткий from→to
	// (ПредыдущийСтатус ниже). Матрицу line_status к цепочке не применяем (см. storekeeper-vs-supply.md).
	ТекстОтказаРоли = ОтказРолиСнабжения();
	Если ЗначениеЗаполнено(ТекстОтказаРоли) Тогда
		Итог.ТекстОшибки = ТекстОтказаРоли;
		Возврат Итог;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЦелевойСтатус) Тогда
		Итог.ТекстОшибки = "Не указан целевой статус цепочки снабжения.";
		Возврат Итог;
	КонецЕсли;

	ПредыдущийСтатус = Неопределено;

	Если ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Оплачено Тогда
		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.Заказано;

	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.ТоварВПути Тогда
		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.Оплачено;

	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Приходуется Тогда
		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.ТоварВПути;

	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.НаСкладе Тогда
		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.Приходуется;

	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Комплектуется Тогда
		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.НаСкладе;

	ИначеЕсли ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Собран Тогда
		ПредыдущийСтатус = Перечисления.Арм_СтатусыАРМ.Комплектуется;
	КонецЕсли;

	// v2.12.1 (audit F-06): целевой статус вне цепочки - не пускаем без проверки предыдущего.
	Если ПредыдущийСтатус = Неопределено Тогда
		Итог.ТекстОшибки = "Недопустимый целевой статус цепочки снабжения.";
		Возврат Итог;
	КонецЕсли;

	ЗапросЗаказы = Новый Запрос;
	ЗапросЗаказы.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.ДокументЗаказПокупателя КАК Заказ
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.ИдентификаторЗаписи В(&МассивИдентификаторов)
	|	И НЕ Т.Удаление";

	ЗапросЗаказы.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
	ВыгрузкаЗаказов = ЗапросЗаказы.Выполнить().Выгрузить().ВыгрузитьКолонку("Заказ");

	МассивЗаказовПоставщиков = Новый Массив;
	КоличествоИзмененных = 0;

	Для каждого ТекущийЗаказ Из ВыгрузкаЗаказов Цикл

		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
		Набор.Отбор.ДокументЗаказПокупателя.Установить(ТекущийЗаказ);
		Набор.Прочитать();

		Изменено = Ложь;
		ПарыЗакупокДляСинхронизации = Новый Соответствие;

		Для каждого Запись Из Набор Цикл

			Если Не Запись.Удаление И Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка И МассивИдентификаторов.Найти(Запись.ИдентификаторЗаписи) <> Неопределено Тогда



				Если ПредыдущийСтатус <> Неопределено И Запись.СтатусСтроки <> ПредыдущийСтатус Тогда
					Продолжить;
				КонецЕсли;

				Запись.СтатусСтроки = ЦелевойСтатус;
				ОтметитьДатуОтправкиНаСборку(Запись, ЦелевойСтатус);
				Запись.ОтметкаСтроки = Ложь;
				Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();

				КоличествоИзмененных = КоличествоИзмененных + 1;
				Изменено = Истина;
				ПарыЗакупокДляСинхронизации.Вставить(Запись.КлючСвязиСтрок, Запись.Количество);

				Если ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Собран И ЗначениеЗаполнено(Запись.ДокументЗаказПоставщика) И МассивЗаказовПоставщиков.Найти(Запись.ДокументЗаказПоставщика) = Неопределено Тогда


					МассивЗаказовПоставщиков.Добавить(Запись.ДокументЗаказПоставщика);
				КонецЕсли;

			КонецЕсли;
		КонецЦикла;

		Если ПарыЗакупокДляСинхронизации.Количество() > 0 Тогда

			Для каждого Запись Из Набор Цикл

				Если Не Запись.Удаление И Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда

					ЦелевоеКоличествоЗакупки = ПарыЗакупокДляСинхронизации.Получить(Запись.КлючСвязиСтрок);

					Если ЦелевоеКоличествоЗакупки <> Неопределено И Запись.Количество = ЦелевоеКоличествоЗакупки И Не ЗначениеЗаполнено(Запись.Партия) Тогда



						Запись.СтатусСтроки = ЦелевойСтатус;
						ОтметитьДатуОтправкиНаСборку(Запись, ЦелевойСтатус);
						Запись.ОтметкаСтроки = Ложь;
						Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
						Изменено = Истина;
						ПарыЗакупокДляСинхронизации.Удалить(Запись.КлючСвязиСтрок);

					КонецЕсли;

				КонецЕсли;
			КонецЦикла;

		КонецЕсли;

		Если Изменено Тогда
			Попытка
				Набор.Записать();
			Исключение
				Арм_Журнал.ЗаписатьИсключение("Арм_ОбщегоНазначенияАРМ.ИзменитьСтатусыВРегистреСнабжения", ИнформацияОбОшибке());
				ЗаписьЖурналаРегистрации("АРМ.ЗаписьСтатусовСнабжение", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));






			КонецПопытки;
		КонецЕсли;

	КонецЦикла;

	Если ЦелевойСтатус = Перечисления.Арм_СтатусыАРМ.Собран И МассивЗаказовПоставщиков.Количество() > 0 Тогда

		НачатьТранзакцию();


		Попытка
			СтавкаНДСПоУмолчанию = НайтиСтавкуНДС();
			СоответствиеДокументовПН = Новый Соответствие;

			// v2.17: строки прихода по всем заказам поставщику одним запросом (было — запрос на каждый заказ)
			ЗапросСтрокПрихода = Новый Запрос;
			ЗапросСтрокПрихода.Текст = "ВЫБРАТЬ
			|	Т.*
			|ИЗ
			|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
			|ГДЕ
			|	Т.ИдентификаторЗаписи В (&МассивИдентификаторов)
			|	И Т.ДокументЗаказПоставщика В (&МассивЗаказовПоставщиков)
			|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Закупка)
			|	И НЕ Т.Удаление";
			ЗапросСтрокПрихода.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
			ЗапросСтрокПрихода.УстановитьПараметр("МассивЗаказовПоставщиков", МассивЗаказовПоставщиков);
			ВсеСтрокиПрихода = ЗапросСтрокПрихода.Выполнить().Выгрузить();

			Для каждого ЗаказПост Из МассивЗаказовПоставщиков Цикл

				ПН_Объект = Документы.ПриходнаяНакладная.СоздатьДокумент();
				ПН_Объект.Дата = ТекущаяДатаСеанса();
				ПН_Объект.Заполнить(Неопределено);
				ПН_Объект.Запасы.Очистить();
				ЗаказПостОбъект = ЗаказПост.ПолучитьОбъект();
				ЗаполнитьЗначенияСвойств(ПН_Объект, ЗаказПостОбъект, "Организация, Контрагент, Договор, ВалютаДокумента, Кратность, Курс, СуммаВключаетНДС, НалогообложениеНДС");
				ПН_Объект.Заказ = ЗаказПост;
				ПН_Объект.ДокументОснование = ЗаказПост;
				ПН_Объект.ДополнительныеСвойства.Вставить("Арм_ПрограммнаяЗапись", Истина);

				ПараметрыРасчетаПН = Новый Структура("СуммаВключаетНДС", ПН_Объект.СуммаВключаетНДС);

				ТаблицаСтрокПрихода = ВсеСтрокиПрихода.НайтиСтроки(Новый Структура("ДокументЗаказПоставщика", ЗаказПост));

				Для каждого СтрРег Из ТаблицаСтрокПрихода Цикл

					НоваяСтрПН = ПН_Объект.Запасы.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрПН, СтрРег);

					НоваяПартияСсылка = Справочники.ПартииНоменклатуры.ПустаяСсылка();
					Если Не ЗначениеЗаполнено(СтрРег.Партия) Тогда
						ПартияОбъект = Справочники.ПартииНоменклатуры.СоздатьЭлемент();
						ПартияОбъект.ВладелецПартии = СтрРег.Поставщик;
						ПартияОбъект.Владелец = СтрРег.Номенклатура;
						ПартияОбъект.Наименование = СтрШаблон("АРМ Поставка (%1) от %2", ЗаказПостОбъект.Контрагент, Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy"));




						ПартияОбъект.Статус = Перечисления.СтатусыПартий.СобственныеЗапасы;
						Попытка
							ПартияОбъект.Записать();
							НоваяПартияСсылка = ПартияОбъект.Ссылка;
						Исключение
							Арм_Журнал.ЗаписатьИсключение("Арм_ОбщегоНазначенияАРМ.ИзменитьСтатусыВРегистреСнабжения", ИнформацияОбОшибке());
							ВызватьИсключение "Ошибка при создании партии " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						КонецПопытки;
					КонецЕсли;

					НоваяСтрПН.Партия = НоваяПартияСсылка;

					НоваяСтрПН.ЗаказПокупателя = СтрРег.ДокументЗаказПокупателя;

					Если Не ЗначениеЗаполнено(НоваяСтрПН.ЕдиницаИзмерения) Тогда
						НоваяСтрПН.ЕдиницаИзмерения = СтрРег.Номенклатура.ЕдиницаИзмерения;
					КонецЕсли;

					ПН_Объект.Заказ = ЗаказПост;
					НоваяСтрПН.Цена = СтрРег.Цена;
					НоваяСтрПН.Сумма = НоваяСтрПН.Количество * НоваяСтрПН.Цена;
					НоваяСтрПН.СтавкаНДС = Арм_ОбщегоНазначенияАРМ.СтавкаНДСНоменклатуры(НоваяСтрПН.Номенклатура, ПН_Объект.Организация, ПН_Объект.Дата, СтавкаНДСПоУмолчанию);
					ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммуНДСИВсего(НоваяСтрПН, ПараметрыРасчетаПН);

				КонецЦикла;

				ПН_Объект.Записать(РежимЗаписиДокумента.Проведение);
				СоответствиеДокументовПН.Вставить(ЗаказПост, ПН_Объект.Ссылка);

			КонецЦикла;

			ЗафиксироватьТранзакцию();
		Исключение
			Если ТранзакцияАктивна() Тогда
				ОтменитьТранзакцию();
			КонецЕсли;
			Арм_Журнал.ЗаписатьИсключение("Арм_ОбщегоНазначенияАРМ.ИзменитьСтатусыВРегистреСнабжения", ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("АРМ.ОшибкаКанбанСнабжения", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);







			Итог.ТекстОшибки = СтрШаблон("Сбой базы данных: %1", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат Итог;
		КонецПопытки;

		ЗапросНоменклатуры = Новый Запрос;
		ЗапросНоменклатуры.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Т.Номенклатура КАК Номенклатура,
		|	Т.ДокументЗаказПокупателя КАК Заказ
		|ИЗ
		|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
		|ГДЕ
		|	Т.ИдентификаторЗаписи В(&МассивИдентификаторов)
		|	И НЕ Т.Удаление";

		ЗапросНоменклатуры.УстановитьПараметр("МассивИдентификаторов", МассивИдентификаторов);
		ТаблицаНоменклатуры = ЗапросНоменклатуры.Выполнить().Выгрузить();

		Для каждого ТекущийЗаказ Из ВыгрузкаЗаказов Цикл

			НаборПН = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
			НаборПН.Отбор.ДокументЗаказПокупателя.Установить(ТекущийЗаказ);
			НаборПН.Прочитать();

			ИзмененоПН = Ложь;
			КуцыеЗакупки = Новый Соответствие;

			Для каждого ЗаписьПН Из НаборПН Цикл
				// v2.12.1 (audit F-05): ПН привязываем только к строкам закупки из текущей выборки.
				Если Не ЗаписьПН.Удаление И ЗаписьПН.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка
					И МассивИдентификаторов.Найти(ЗаписьПН.ИдентификаторЗаписи) <> Неопределено Тогда
					СсылкаНаПН = СоответствиеДокументовПН.Получить(ЗаписьПН.ДокументЗаказПоставщика);
					Если СсылкаНаПН <> Неопределено Тогда

						ЗаписьПН.ДокументПриходнаяНакладная = СсылкаНаПН;
						ЗаполнитьУПДИзПриходнойЕслиЕсть(ЗаписьПН); // v2.11 (T05)
						КуцыеЗакупки.Вставить(ЗаписьПН.КлючСвязиСтрок, ЗаписьПН.Количество);
						ИзмененоПН = Истина;

					КонецЕсли;
				КонецЕсли;
			КонецЦикла;

			Для каждого ЗаписьПН Из НаборПН Цикл
				Если Не ЗаписьПН.Удаление И ЗаписьПН.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда

					ЦелевоеКоличество = КуцыеЗакупки.Получить(ЗаписьПН.КлючСвязиСтрок);

					Если ЦелевоеКоличество <> Неопределено И ЗаписьПН.Количество = ЦелевоеКоличество И Не ЗначениеЗаполнено(ЗаписьПН.Партия) Тогда



						СсылкаНаПН = СоответствиеДокументовПН.Получить(ЗаписьПН.ДокументЗаказПоставщика);
						Если СсылкаНаПН <> Неопределено Тогда

							ЗаписьПН.ДокументПриходнаяНакладная = СсылкаНаПН;
							ЗаполнитьУПДИзПриходнойЕслиЕсть(ЗаписьПН); // v2.11 (T05)
							КуцыеЗакупки.Удалить(ЗаписьПН.КлючСвязиСтрок);
							ИзмененоПН = Истина;

						КонецЕсли;
					КонецЕсли;

				КонецЕсли;
			КонецЦикла;

			Если ИзмененоПН Тогда
				Попытка
					НаборПН.Записать();
				Исключение
					Арм_Журнал.ЗаписатьИсключение("Арм_ОбщегоНазначенияАРМ.ИзменитьСтатусыВРегистреСнабжения", ИнформацияОбОшибке());
					ЗаписьЖурналаРегистрации("АРМ.ЗаписьПНВРегистр", УровеньЖурналаРегистрации.Ошибка, , , ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), );






				КонецПопытки;
			КонецЕсли;
		КонецЦикла;

		Для каждого СтрНом Из ТаблицаНоменклатуры Цикл
			ПолучитьОстаткиПоСтрокам(СтрНом.Номенклатура, СтрНом.Заказ);
		КонецЦикла;
































	КонецЕсли;

	Итог.Успешно = Истина;
	Итог.КоличествоОбработанных = КоличествоИзмененных;

	Возврат Итог;

КонецФункции


// v2.11 (T05, D4) / v2.12 (H04, D13=A): one-shot при связывании строки с ПН.
// ДатаУПД / НомерУПД — только если в ПН есть подходящие реквизиты (разведка метаданных в рантайме) и в строке
// соответствующее поле ещё пусто (ручные значения не затираем). Повторной синхронизации при проведении ПН нет.
// Нет реквизитов — noop; остаётся ручной ввод по ACL. Н2/Н3 не трогаем (D14=A). Запись набора — у вызывающего.
Процедура ЗаполнитьУПДИзПриходнойЕслиЕсть(ЗаписьРегистра)

	Если ЗначениеЗаполнено(ЗаписьРегистра.ДатаУПД) И ЗначениеЗаполнено(ЗаписьРегистра.НомерУПД) Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ЗаписьРегистра.ДокументПриходнаяНакладная) Тогда
		Возврат;
	КонецЕсли;

	Реквизиты = Метаданные.Документы.ПриходнаяНакладная.Реквизиты;
	ИмяДаты = "";
	Для Каждого Кандидат Из СтрРазделить("ДатаВходящегоДокумента,ДатаУПД,ДатаДокументаПоставщика", ",") Цикл
		Если Реквизиты.Найти(Кандидат) <> Неопределено Тогда
			ИмяДаты = Кандидат;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	ИмяНомера = "";
	Для Каждого Кандидат Из СтрРазделить("НомерВходящегоДокумента,НомерУПД,НомерДокументаПоставщика", ",") Цикл
		Если Реквизиты.Найти(Кандидат) <> Неопределено Тогда
			ИмяНомера = Кандидат;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если ПустаяСтрока(ИмяДаты) И ПустаяСтрока(ИмяНомера) Тогда
		Возврат;
	КонецЕсли;

	СписокРеквизитов = ?(ПустаяСтрока(ИмяДаты), "", ИмяДаты) + ?(ПустаяСтрока(ИмяДаты) Или ПустаяСтрока(ИмяНомера), "", ",")
		+ ?(ПустаяСтрока(ИмяНомера), "", ИмяНомера);
	Значения = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗаписьРегистра.ДокументПриходнаяНакладная, СписокРеквизитов);

	Если Не ПустаяСтрока(ИмяДаты) И Не ЗначениеЗаполнено(ЗаписьРегистра.ДатаУПД)
		И ТипЗнч(Значения[ИмяДаты]) = Тип("Дата") И ЗначениеЗаполнено(Значения[ИмяДаты]) Тогда
		ЗаписьРегистра.ДатаУПД = Значения[ИмяДаты];
	КонецЕсли;
	Если Не ПустаяСтрока(ИмяНомера) И Не ЗначениеЗаполнено(ЗаписьРегистра.НомерУПД) Тогда
		ЗаписьРегистра.НомерУПД = Лев(СокрЛП(Строка(Значения[ИмяНомера])), 50);
	КонецЕсли;

КонецПроцедуры

// Ставка НДС строки документа — как в типовом заполнении УНФ: по виду ставки номенклатуры,
// иначе по виду ставки организации по умолчанию, иначе СтавкаПоУмолчанию (НайтиСтавкуНДС).
// Ставка на дату берётся из конфигурации (Справочники.СтавкиНДС.СтавкаНДС), а не из кода АРМ (v2.16).
// v2.20: общая ставка с 01.01.2026 — 22%, зашита в АРМ (СтавкаНДС22): конфигурация «Автосервис» 3.0.11.169
// ставки 22% не знает и для вида «Общая» возвращает 20%. Пониженная, «Без НДС» и прочие — как в конфигурации.
Функция СтавкаНДСНоменклатуры(Номенклатура, Организация, Период, СтавкаПоУмолчанию = Неопределено) Экспорт

	ВидСтавки = Неопределено;
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		ВидСтавки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ВидСтавкиНДС");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ВидСтавки) И ЗначениеЗаполнено(Организация) Тогда
		ВидСтавки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "ВидСтавкиНДСПоУмолчанию");
	КонецЕсли;

	ДатаСтавки = ?(ЗначениеЗаполнено(Период), Период, ТекущаяДатаСеанса());
	Если (ВидСтавки = Перечисления.ВидыСтавокНДС.Общая Или Не ЗначениеЗаполнено(ВидСтавки)) И ДатаСтавки >= ДатаНДС22() Тогда
		Возврат СтавкаНДС22();
	КонецЕсли;

	Если ЗначениеЗаполнено(ВидСтавки) Тогда
		Ставка = Справочники.СтавкиНДС.СтавкаНДС(ВидСтавки, ДатаСтавки);
		Если ЗначениеЗаполнено(Ставка) Тогда
			Возврат Ставка;
		КонецЕсли;
	КонецЕсли;

	Возврат ?(СтавкаПоУмолчанию = Неопределено, НайтиСтавкуНДС(), СтавкаПоУмолчанию);

КонецФункции

// v2.18: состояние «В работе» для заказа покупателя при проведении из АРМ (команда «В работу»).
// Реквизит ЗаказПокупателя.СостояниеЗаказа — СправочникСсылка.СостоянияЗаказовПокупателей; до v2.18 туда
// присваивалось состояние заказа ПОСТАВЩИКУ, значение становилось пустым и проведение падало:
// «новое состояние заказа "" не принадлежит виду заказа "Основной"».
// Порядок: «В работе» из порядка состояний вида заказа → текущее состояние → первое состояние вида заказа
// → элемент «В работе» справочника состояний заказов покупателей.
Функция СостояниеЗаказаПокупателяВРаботе(ЗаказОбъект) Экспорт

	ПорядокСостояний = Неопределено;
	Если ЗначениеЗаполнено(ЗаказОбъект.ВидЗаказа) Тогда
		ПорядокСостояний = ЗаказОбъект.ВидЗаказа.ПорядокСостояний;
		Для Каждого СтрокаПорядка Из ПорядокСостояний Цикл
			Если СокрЛП(Строка(СтрокаПорядка.Состояние)) = "В работе" Тогда
				Возврат СтрокаПорядка.Состояние;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если ЗначениеЗаполнено(ЗаказОбъект.СостояниеЗаказа) Тогда
		Возврат ЗаказОбъект.СостояниеЗаказа;
	КонецЕсли;

	Если ПорядокСостояний <> Неопределено И ПорядокСостояний.Количество() > 0 Тогда
		Возврат ПорядокСостояний[0].Состояние;
	КонецЕсли;

	Возврат Справочники.СостоянияЗаказовПокупателей.НайтиПоНаименованию("В работе");

КонецФункции

// Дата перехода на общую ставку НДС 22%.
Функция ДатаНДС22() Экспорт
	Возврат Дата(2026, 1, 1);
КонецФункции

// v2.20: элемент «22%» справочника «Ставки НДС» (вид «Общая», не расчётная). Если его нет — создаётся
// в привилегированном режиме: в «Автосервис» 3.0.11.169 ставки 22% нет, перечисления НДС22 тоже
// (реквизит ПеречислениеСтавкаНДС остаётся пустым).
Функция СтавкаНДС22() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	СтавкиНДС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|ГДЕ
	|	СтавкиНДС.Ставка = 22
	|	И НЕ СтавкиНДС.Расчетная
	|	И НЕ СтавкиНДС.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВЫБОР
	|		КОГДА СтавкиНДС.Наименование = ""22%""
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Элемент = Справочники.СтавкиНДС.СоздатьЭлемент();
		Элемент.Наименование = "22%";
		Элемент.Ставка = 22;
		Элемент.ВидСтавкиНДС = Перечисления.ВидыСтавокНДС.Общая;
		Элемент.Расчетная = Ложь;
		Элемент.НеОблагается = Ложь;
		Элемент.Записать();
	Исключение
		Арм_Журнал.ЗаписатьИсключение("Арм_ОбщегоНазначенияАРМ.СтавкаНДС22", ИнформацияОбОшибке());
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Элемент.Ссылка;

КонецФункции

// Ставка по умолчанию, если у номенклатуры и организации вид ставки не определён:
// с 01.01.2026 — 22% (v2.20), раньше — 20%.
Функция НайтиСтавкуНДС() Экспорт

	Если ТекущаяДатаСеанса() >= ДатаНДС22() Тогда
		Возврат СтавкаНДС22();
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтавкиНДС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|ГДЕ
	|	СтавкиНДС.Наименование = &Наименование
	|	И НЕ СтавкиНДС.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СтавкиНДС.Ссылка
	|ИЗ
	|	Справочник.СтавкиНДС КАК СтавкиНДС
	|ГДЕ
	|	СтавкиНДС.Ставка = &РазмерСтавки
	|	И НЕ СтавкиНДС.ПометкаУдаления";


	Запрос.УстановитьПараметр("Наименование", "20%");
	Запрос.УстановитьПараметр("РазмерСтавки", 20);
	РезультатЗапросаСтавка = Запрос.Выполнить();
	ВыборкаСтавкаНДС = РезультатЗапросаСтавка.Выбрать();

	Если ВыборкаСтавкаНДС.Следующий() Тогда
		Возврат ВыборкаСтавкаНДС.Ссылка;
	КонецЕсли;

	Возврат Справочники.СтавкиНДС.ПустаяСсылка();

КонецФункции

// v2.14: колонка В9 «Дата отправки на сборку» — дата перевода строки в «Комплектуется», если ещё не заполнена.
// Вызывается при смене статуса цепочкой снабжения (закупка и связанная продажа) и при ручной смене статуса в АРМ.
Процедура ОтметитьДатуОтправкиНаСборку(Запись, Знач Статус) Экспорт

	Если Статус = Перечисления.Арм_СтатусыАРМ.Комплектуется И Не ЗначениеЗаполнено(Запись.ДатаОтправкиНаСборку) Тогда
		Запись.ДатаОтправкиНаСборку = ТекущаяДатаСеанса();
	КонецЕсли;

КонецПроцедуры

#Область v2_22

// v2.22 (BUG-2): границы стандартного периода формы АРМ для отбора отмеченных строк.
// Возврат: Структура ЕстьПериод, ДатаНачала, ДатаОкончания (пустая граница — без ограничения с этой стороны).
Функция ГраницыПериодаФормы(Знач Период) Экспорт

	Итог = Новый Структура("ЕстьПериод, ДатаНачала, ДатаОкончания", Ложь, Дата(1, 1, 1), Дата(3999, 12, 31, 23, 59, 59));
	Если ТипЗнч(Период) <> Тип("СтандартныйПериод") Тогда
		Возврат Итог;
	КонецЕсли;
	Если ЗначениеЗаполнено(Период.ДатаНачала) Тогда
		Итог.ДатаНачала = Период.ДатаНачала;
		Итог.ЕстьПериод = Истина;
	КонецЕсли;
	Если ЗначениеЗаполнено(Период.ДатаОкончания) Тогда
		Итог.ДатаОкончания = КонецДня(Период.ДатаОкончания);
		Итог.ЕстьПериод = Истина;
	КонецЕсли;
	Возврат Итог;

КонецФункции

// v2.22 (BUG-2): отмеченные текущим пользователем продажи заказов вне периода формы (в верхней таблице не видны).
// Возврат: Структура Количество, Описание (до 5 строк «номер заказа — номенклатура»).
Функция ОтмеченныеПродажиВнеПериода(Знач Период) Экспорт

	Итог = Новый Структура("Количество, Описание", 0, "");
	ГраницыПериода = ГраницыПериодаФормы(Период);
	Если Не ГраницыПериода.ЕстьПериод Тогда
		Возврат Итог;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Т.НомерЗаказа КАК НомерЗаказа,
	|	Т.Номенклатура КАК Номенклатура,
	|	Т.НоменклатураКлиента КАК НоменклатураКлиента
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	НЕ Т.Удаление
	|	И Т.ОтметкаСтроки = ИСТИНА
	|	И Т.АвторСтроки = &Автор
	|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|	И НЕ (ЕСТЬNULL(Т.ДокументЗаказПокупателя.Дата, ДАТАВРЕМЯ(1, 1, 1)) МЕЖДУ &ДатаНачала И &ДатаОкончания)";
	Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("ДатаНачала", ГраницыПериода.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ГраницыПериода.ДатаОкончания);
	Выборка = Запрос.Выполнить().Выбрать();

	Строки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Итог.Количество = Итог.Количество + 1;
		Если Строки.Количество() < 5 Тогда
			Товар = ?(ЗначениеЗаполнено(Выборка.Номенклатура), Строка(Выборка.Номенклатура), СокрЛП(Выборка.НоменклатураКлиента));
			Строки.Добавить(СтрШаблон("заказ %1 — %2", СокрЛП(Выборка.НомерЗаказа), Товар));
		КонецЕсли;
	КонецЦикла;
	Итог.Описание = СтрСоединить(Строки, Символы.ПС);
	Если Итог.Количество > Строки.Количество() Тогда
		Итог.Описание = Итог.Описание + Символы.ПС + СтрШаблон("… и ещё %1", Итог.Количество - Строки.Количество());
	КонецЕсли;
	Возврат Итог;

КонецФункции

// v2.22 (BUG-2): снять отметки текущего пользователя с продаж заказов вне периода формы. Возврат: число строк.
Функция СнятьОтметкиПродажВнеПериода(Знач Период) Экспорт

	ГраницыПериода = ГраницыПериодаФормы(Период);
	Если Не ГраницыПериода.ЕстьПериод Тогда
		Возврат 0;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Т.ИдентификаторЗаписи КАК ИдентификаторЗаписи
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.ОтметкаСтроки = ИСТИНА
	|	И Т.АвторСтроки = &Автор
	|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|	И НЕ (ЕСТЬNULL(Т.ДокументЗаказПокупателя.Дата, ДАТАВРЕМЯ(1, 1, 1)) МЕЖДУ &ДатаНачала И &ДатаОкончания)";
	Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("ДатаНачала", ГраницыПериода.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", ГраницыПериода.ДатаОкончания);
	Идентификаторы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИдентификаторЗаписи");

	Снято = 0;
	Для Каждого Идентификатор Из Идентификаторы Цикл
		Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
		Набор.Отбор.ИдентификаторЗаписи.Установить(Идентификатор);
		Набор.Прочитать();
		Для Каждого Запись Из Набор Цикл
			Запись.ОтметкаСтроки = Ложь;
			Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
		КонецЦикла;
		Если Набор.Количество() > 0 Тогда
			Набор.Записать();
			Снято = Снято + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Снято;

КонецФункции

// v2.22 (F-1): «Запасы» заказа покупателя ↔ строки продаж АРМ: строки документа, все записи АРМ которых вычеркнуты,
// удаляются; невычеркнутые продажи, которых нет в документе (вернули вычеркнутую), добавляются. Проведённый заказ
// перепроводится, непроведённый записывается. Записи АРМ не перестраиваются (Арм_ПрограммнаяЗапись).
Процедура СинхронизироватьЗапасыЗаказаСАРМ(Знач Заказ) Экспорт

	Если Не ЗначениеЗаполнено(Заказ) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Т.*
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.ДокументЗаказПокупателя = &Заказ
	|	И Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Порядок";
	Запрос.УстановитьПараметр("Заказ", Заказ);
	ЗаписиАРМ = Запрос.Выполнить().Выгрузить();

	АктивныеКлючи = Новый Соответствие; // ключ -> Истина (есть невычеркнутая запись) / Ложь (все вычеркнуты)
	Для Каждого ЗаписьАРМ Из ЗаписиАРМ Цикл
		Если Не ЗаписьАРМ.Удаление Тогда
			АктивныеКлючи.Вставить(ЗаписьАРМ.КлючСвязиСтрок, Истина);
		ИначеЕсли АктивныеКлючи.Получить(ЗаписьАРМ.КлючСвязиСтрок) = Неопределено Тогда
			АктивныеКлючи.Вставить(ЗаписьАРМ.КлючСвязиСтрок, Ложь);
		КонецЕсли;
	КонецЦикла;

	ДокОбъект = Заказ.ПолучитьОбъект();
	Если ДокОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Изменено = Ложь;
	КлючиДокумента = Новый Соответствие;
	Индекс = ДокОбъект.Запасы.Количество() - 1;
	Пока Индекс >= 0 Цикл
		СтрокаЗапасов = ДокОбъект.Запасы[Индекс];
		Если АктивныеКлючи.Получить(СтрокаЗапасов.КлючСвязиСтрок) = Ложь Тогда
			ДокОбъект.Запасы.Удалить(СтрокаЗапасов);
			Изменено = Истина;
		Иначе
			КлючиДокумента.Вставить(СтрокаЗапасов.КлючСвязиСтрок, СтрокаЗапасов);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;

	СтавкаНДСПоУмолчанию = НайтиСтавкуНДС();
	ПараметрыРасчета = Новый Структура("СуммаВключаетНДС", ДокОбъект.СуммаВключаетНДС);
	Добавленные = Новый Соответствие;
	Для Каждого ЗаписьАРМ Из ЗаписиАРМ Цикл
		Если ЗаписьАРМ.Удаление Или КлючиДокумента.Получить(ЗаписьАРМ.КлючСвязиСтрок) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		НоваяСтр = Добавленные.Получить(ЗаписьАРМ.КлючСвязиСтрок);
		Если НоваяСтр = Неопределено Тогда
			НоваяСтр = ДокОбъект.Запасы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтр, ЗаписьАРМ);
			Если ЗначениеЗаполнено(НоваяСтр.Номенклатура) И Не ЗначениеЗаполнено(НоваяСтр.ЕдиницаИзмерения) Тогда
				НоваяСтр.ЕдиницаИзмерения = НоваяСтр.Номенклатура.ЕдиницаИзмерения;
			КонецЕсли;
			НоваяСтр.СтавкаНДС = СтавкаНДСНоменклатуры(НоваяСтр.Номенклатура, ДокОбъект.Организация, ДокОбъект.Дата, СтавкаНДСПоУмолчанию);
			Добавленные.Вставить(ЗаписьАРМ.КлючСвязиСтрок, НоваяСтр);
		Иначе
			НоваяСтр.Количество = НоваяСтр.Количество + ЗаписьАРМ.Количество;
		КонецЕсли;
		НоваяСтр.Сумма = НоваяСтр.Количество * НоваяСтр.Цена;
		ТабличныеЧастиУНФКлиентСервер.РассчитатьСуммуНДСИВсего(НоваяСтр, ПараметрыРасчета);
		Изменено = Истина;
	КонецЦикла;

	Если Не Изменено Тогда
		Возврат;
	КонецЕсли;
	ДокОбъект.ДополнительныеСвойства.Вставить("Арм_ПрограммнаяЗапись", Истина);
	Попытка
		ДокОбъект.Записать(?(ДокОбъект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись));
	Исключение
		Арм_Журнал.ЗаписатьИсключение("Арм_ОбщегоНазначенияАРМ.СинхронизироватьЗапасыЗаказаСАРМ", ИнформацияОбОшибке());
		ВызватьИсключение СтрШаблон("Не удалось обновить строки заказа покупателя %1: %2", Заказ, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

// v2.22 (F-1): «Вычеркнуть товар» (форма АРМ и команда АРМ_OData «Вычеркнуть»). Для каждого ключа связи: продажа и
// закупки без заказа поставщику вычеркиваются (Вычеркнуть = Неопределено — переключение, как кнопка формы:
// повторное нажатие возвращает строку), отметки снимаются; затем пересчёт остатков и строки заказа покупателя.
// Строки дальше «В работе» не трогаются. Возврат: Структура Обработано, Пропущено (текст).
Функция ВычеркнутьСтрокиПоКлючам(Знач МассивКлючей, Знач Вычеркнуть = Неопределено) Экспорт

	Итог = Новый Структура("Обработано, Пропущено", 0, "");
	ДопустимыеСтатусы = Новый Массив;
	ДопустимыеСтатусы.Добавить(Перечисления.Арм_СтатусыАРМ.Черновик);
	ДопустимыеСтатусы.Добавить(Перечисления.Арм_СтатусыАРМ.ВРаботе);

	СписокДляПересчета = Новый Соответствие;
	Заказы = Новый Соответствие;

	НачатьТранзакцию();
	Попытка
		Для Каждого Ключ Из МассивКлючей Цикл
			Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
			Набор.Отбор.КлючСвязиСтрок.Установить(Ключ);
			Набор.Прочитать();
			Продажа = Неопределено;
			Для Каждого Запись Из Набор Цикл
				Если Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда
					Продажа = Запись;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Продажа = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			Если ДопустимыеСтатусы.Найти(Продажа.СтатусСтроки) = Неопределено Тогда
				Итог.Пропущено = Итог.Пропущено + СтрШаблон("%1: статус «%2»%3", Продажа.Номенклатура, Продажа.СтатусСтроки, Символы.ПС);
				Продолжить;
			КонецЕсли;
			НовоеСостояниеУдаления = ?(Вычеркнуть = Неопределено, Не Продажа.Удаление, Вычеркнуть = Истина);

			Для Каждого Запись Из Набор Цикл
				Если Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка
					И (ЗначениеЗаполнено(Запись.ДокументЗаказПоставщика) Или ДопустимыеСтатусы.Найти(Запись.СтатусСтроки) = Неопределено) Тогда
					Продолжить; // заказанная закупка остаётся (её отменяют в заказе поставщику)
				КонецЕсли;
				Запись.Удаление = НовоеСостояниеУдаления;
				Запись.ОтметкаСтроки = Ложь;
				Запись.АвторСтроки = Справочники.Пользователи.ПустаяСсылка();
				Если Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа И Не НовоеСостояниеУдаления Тогда
					Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.ВРаботе;
				ИначеЕсли Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда
					Запись.СтатусСтроки = Перечисления.Арм_СтатусыАРМ.Черновик;
				КонецЕсли;
				Если ЗначениеЗаполнено(Запись.Номенклатура) Тогда
					СписокДляПересчета.Вставить(Новый Структура("Номенклатура, Заказ", Запись.Номенклатура, Запись.ДокументЗаказПокупателя), Истина);
				КонецЕсли;
			КонецЦикла;
			Набор.Записать();
			Заказы.Вставить(Продажа.ДокументЗаказПокупателя, Истина);
			Итог.Обработано = Итог.Обработано + 1;
		КонецЦикла;

		Для Каждого КлючИЗначение Из СписокДляПересчета Цикл
			ПолучитьОстаткиПоСтрокам(КлючИЗначение.Ключ.Номенклатура, КлючИЗначение.Ключ.Заказ);
		КонецЦикла;
		Для Каждого КлючИЗначение Из Заказы Цикл
			СинхронизироватьЗапасыЗаказаСАРМ(КлючИЗначение.Ключ);
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Арм_Журнал.ЗаписатьИсключение("Арм_ОбщегоНазначенияАРМ.ВычеркнутьСтрокиПоКлючам", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	Возврат Итог;

КонецФункции

// v2.22 (F-2): смена номенклатуры строки (форма АРМ и команда АРМ_OData «СменитьНоменклатуру»). Для продажи —
// новый ключ связи; закупки старого ключа без заказа поставщику (ручные и авто) удаляются, заказанные — в
// предупреждение; строка заказа покупателя получает новый ключ и номенклатуру; пересчёт остатков старой и новой.
// Возврат: Структура Изменено, Предупреждение.
Функция СменитьНоменклатуруСтроки(Знач Идентификатор, Знач НоменклатураНовоеЗначение) Экспорт

	Итог = Новый Структура("Изменено, Предупреждение", Ложь, "");
	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.ИдентификаторЗаписи.Установить(Идентификатор);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		Возврат Итог;
	КонецЕсли;
	Запись = Набор[0];
	СтараяНоменклатура = Запись.Номенклатура;
	СсылкаНаЗаказ = Запись.ДокументЗаказПокупателя;
	Если СтараяНоменклатура = НоменклатураНовоеЗначение Тогда
		Возврат Итог;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Если Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа Тогда
			СтарыйКлюч = Запись.КлючСвязиСтрок;
			НовыйКлюч = Строка(Новый УникальныйИдентификатор());
			Итог.Предупреждение = УдалитьНезаказанныеЗакупкиКлюча(СтарыйКлюч);
			Запись.КлючСвязиСтрок = НовыйКлюч;
			Запись.Партия = Справочники.ПартииНоменклатуры.ПустаяСсылка();
		КонецЕсли;
		Запись.Номенклатура = НоменклатураНовоеЗначение;
		Запись.Порядок = ПолучитьПриоритет(НоменклатураНовоеЗначение);
		Запись.ОстатокДляСтроки = 0;
		Набор.Записать();

		Если Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Продажа И ЗначениеЗаполнено(СсылкаНаЗаказ) Тогда
			ДокОбъект = СсылкаНаЗаказ.ПолучитьОбъект();
			СтрокаЗапасов = ДокОбъект.Запасы.Найти(СтарыйКлюч, "КлючСвязиСтрок");
			Если СтрокаЗапасов <> Неопределено Тогда
				СтрокаЗапасов.КлючСвязиСтрок = НовыйКлюч;
				СтрокаЗапасов.Номенклатура = НоменклатураНовоеЗначение;
				Если ЗначениеЗаполнено(НоменклатураНовоеЗначение) Тогда
					СтрокаЗапасов.ЕдиницаИзмерения = НоменклатураНовоеЗначение.ЕдиницаИзмерения;
				КонецЕсли;
				ДокОбъект.ДополнительныеСвойства.Вставить("Арм_ПрограммнаяЗапись", Истина);
				ДокОбъект.Записать(?(ДокОбъект.Проведен И ЗначениеЗаполнено(НоменклатураНовоеЗначение),
					РежимЗаписиДокумента.Проведение, ?(ДокОбъект.Проведен, РежимЗаписиДокумента.ОтменаПроведения, РежимЗаписиДокумента.Запись)));
			КонецЕсли;
		КонецЕсли;

		Если ЗначениеЗаполнено(СтараяНоменклатура) Тогда
			ПолучитьОстаткиПоСтрокам(СтараяНоменклатура, СсылкаНаЗаказ);
		КонецЕсли;
		Если ЗначениеЗаполнено(НоменклатураНовоеЗначение) Тогда
			ПолучитьОстаткиПоСтрокам(НоменклатураНовоеЗначение, СсылкаНаЗаказ);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		Арм_Журнал.ЗаписатьИсключение("Арм_ОбщегоНазначенияАРМ.СменитьНоменклатуруСтроки", ИнформацияОбОшибке());
		ВызватьИсключение;
	КонецПопытки;
	Итог.Изменено = Истина;
	Возврат Итог;

КонецФункции

// v2.22 (F-2): закупки ключа связи без заказа поставщику удаляются; по заказанным — текст предупреждения.
Функция УдалитьНезаказанныеЗакупкиКлюча(Знач Ключ)

	Предупреждение = "";
	Набор = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	Набор.Отбор.КлючСвязиСтрок.Установить(Ключ);
	Набор.Отбор.ВидОперации.Установить(Перечисления.Арм_ВидыОпераций.Закупка);
	Набор.Прочитать();
	Если Набор.Количество() = 0 Тогда
		Возврат Предупреждение;
	КонецЕсли;
	Индекс = Набор.Количество() - 1;
	Пока Индекс >= 0 Цикл
		Закупка = Набор[Индекс];
		Если ЗначениеЗаполнено(Закупка.ДокументЗаказПоставщика) Тогда
			Предупреждение = Предупреждение + СтрШаблон("Закупка «%1» уже заказана (%2) — отмените её в заказе поставщику.%3",
				Закупка.Номенклатура, Закупка.ДокументЗаказПоставщика, Символы.ПС);
		Иначе
			Набор.Удалить(Закупка);
		КонецЕсли;
		Индекс = Индекс - 1;
	КонецЦикла;
	Набор.Записать();
	Возврат СокрЛП(Предупреждение);

КонецФункции

#КонецОбласти

// v2.22: статусы продаж, которые не участвуют в распределении склада ФИФО (строка уже отгружена или закрыта).
Функция ЗакрытыеСтатусыПродаж() Экспорт

	Статусы = Новый Массив;
	Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Отгружено);
	Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Выполнено);
	Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Завершено);
	Возврат Статусы;

КонецФункции
