// v2.23 (1.10): прямые записи регистра через стандартный OData (PATCH / POST / DELETE) — по матрице прав АРМ.
// Форма, фоновые задания и команды АРМ_OData проверяют права сами (см. Арм_ОбщегоНазначенияАРМ.ОтказЗаписиOData).
// v2.23 (блок 2): уведомления по смене статуса строки — Арм_УведомленияСервер (статусы до записи — здесь, в ПередЗаписью).
Процедура ПередЗаписью(Отказ, Замещение)

	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	ТекстОтказа = Арм_ОбщегоНазначенияАРМ.ОтказЗаписиOData(ЭтотОбъект);
	Если ЗначениеЗаполнено(ТекстОтказа) Тогда
		ВызватьИсключение ТекстОтказа;
	КонецЕсли;
	ДополнительныеСвойства.Вставить("Арм_СтатусыДоЗаписи", Арм_УведомленияСервер.СтатусыДоЗаписи(ЭтотОбъект));

КонецПроцедуры

Процедура ПриЗаписи(Отказ, Замещение)

	Если ОбменДанными.Загрузка Или Не ДополнительныеСвойства.Свойство("Арм_СтатусыДоЗаписи") Тогда
		Возврат;
	КонецЕсли;
	Арм_УведомленияСервер.ПослеЗаписиДанныхАРМ(ЭтотОбъект, ДополнительныеСвойства.Арм_СтатусыДоЗаписи);

КонецПроцедуры
