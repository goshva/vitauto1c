// v2.23 (блок 3 плана): печатные формы АРМ по заказам покупателя — табличный документ строится кодом (без макетов).
//   Ведомость      M12  отгрузочная ведомость: продажи «Собран» / «Подготовлено» / «Отгружено»
//   СборочныйЛист  K3   сборочный лист: продажи «Комплектуется» / «Резервирование» — ячейка склада, графы «собрано»,
//                       «дефект / недостача» (их кладовщик заполняет на бумаге; отклонение — M10)
//   Корректировка  M19  корректировка отгрузочной ведомости: продажи «Возврат»
// Заказы — по отмеченным строкам продаж текущего пользователя, иначе по текущей строке формы. Каждый заказ — с новой
// страницы. Форма АРМ показывает документ; PWA получает его HTML (команда АРМ_OData «Печать», ВHTML).

#Область ПрограммныйИнтерфейс

// Виды печати для меню: Массив Структур Вид, Заголовок, Узел.
Функция ВидыПечати() Экспорт

	Виды = Новый Массив;
	Виды.Добавить(Новый Структура("Вид, Заголовок, Узел", "Ведомость", "Отгрузочная ведомость", "M12"));
	Виды.Добавить(Новый Структура("Вид, Заголовок, Узел", "СборочныйЛист", "Сборочный лист", "K3"));
	Виды.Добавить(Новый Структура("Вид, Заголовок, Узел", "Корректировка", "Корректировка отгрузочной ведомости", "M19"));
	Возврат Виды;

КонецФункции

// Печать по отмеченным строкам продаж текущего пользователя, без отметок — по строке ИдентификаторТекущей.
// Возврат: Структура ТабличныйДокумент (Неопределено — нечего печатать), Сообщение.
Функция Сформировать(Знач Вид, Знач ИдентификаторТекущей = Неопределено) Экспорт

	Заказы = ЗаказыДляПечати(ИдентификаторТекущей);
	Возврат СформироватьПоЗаказам(Вид, Заказы);

КонецФункции

// То же по списку заказов покупателя (PWA, команда АРМ_OData «Печать»).
Функция СформироватьПоЗаказам(Знач Вид, Знач Заказы) Экспорт

	Результат = Новый Структура("ТабличныйДокумент, Сообщение", Неопределено, "");
	Описание = ОписаниеВида(Вид);
	Если Описание = Неопределено Тогда
		Результат.Сообщение = СтрШаблон("Неизвестная печатная форма «%1».", Вид);
		Возврат Результат;
	КонецЕсли;
	Если Заказы.Количество() = 0 Тогда
		Результат.Сообщение = "Отметьте строки продаж (или встаньте на строку) — печать идёт по их заказам покупателя.";
		Возврат Результат;
	КонецЕсли;

	Строки = СтрокиПечати(Заказы, Описание.Статусы);
	Если Строки.Количество() = 0 Тогда
		Результат.Сообщение = СтрШаблон("%1: в выбранных заказах нет строк в статусе %2.", Описание.Заголовок, Описание.СтатусыТекстом);
		Возврат Результат;
	КонецЕсли;

	ТД = Новый ТабличныйДокумент;
	ТД.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_АРМ_" + Вид;
	ТД.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТД.АвтоМасштаб = Истина;
	ТД.ТолькоПросмотр = Истина;
	Первый = Истина;
	Для Каждого Заказ Из Заказы Цикл
		СтрокиЗаказа = Строки.НайтиСтроки(Новый Структура("Заказ", Заказ));
		Если СтрокиЗаказа.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		Если Не Первый Тогда
			ТД.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		Первый = Ложь;
		ВывестиЗаказ(ТД, Вид, Описание, СтрокиЗаказа);
	КонецЦикла;
	Результат.ТабличныйДокумент = ТД;
	Возврат Результат;

КонецФункции

// HTML табличного документа (для PWA: печать из браузера).
Функция ВHTML(ТабличныйДокумент) Экспорт

	ИмяФайла = ПолучитьИмяВременногоФайла("html");
	ТабличныйДокумент.Записать(ИмяФайла, ТипФайлаТабличногоДокумента.HTML5);
	Текст = Новый ТекстовыйДокумент;
	Текст.Прочитать(ИмяФайла, КодировкаТекста.UTF8);
	Результат = Текст.ПолучитьТекст();
	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
		// временный файл удалит платформа
	КонецПопытки;
	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеВида(Вид)

	Статусы = Новый Массив;
	Если Вид = "Ведомость" Тогда
		Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Собран);
		Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Подготовлено);
		Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Отгружено);
		Возврат Новый Структура("Заголовок, Статусы, СтатусыТекстом, Цены",
			"Отгрузочная ведомость", Статусы, "«Собран», «Подготовлено», «Отгружено»", Истина);
	ИначеЕсли Вид = "СборочныйЛист" Тогда
		Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Комплектуется);
		Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Резервирование);
		Возврат Новый Структура("Заголовок, Статусы, СтатусыТекстом, Цены",
			"Сборочный лист", Статусы, "«Комплектуется», «Резервирование»", Ложь);
	ИначеЕсли Вид = "Корректировка" Тогда
		Статусы.Добавить(Перечисления.Арм_СтатусыАРМ.Возврат);
		Возврат Новый Структура("Заголовок, Статусы, СтатусыТекстом, Цены",
			"Корректировка отгрузочной ведомости", Статусы, "«Возврат»", Истина);
	КонецЕсли;
	Возврат Неопределено;

КонецФункции

Функция ЗаказыДляПечати(ИдентификаторТекущей)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Т.ДокументЗаказПокупателя КАК Заказ,
	|	Т.ДокументЗаказПокупателя.Дата КАК Дата
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|	И НЕ Т.Удаление
	|	И Т.ДокументЗаказПокупателя <> ЗНАЧЕНИЕ(Документ.ЗаказПокупателя.ПустаяСсылка)
	|	И (Т.ОтметкаСтроки И Т.АвторСтроки = &Автор И &ЕстьОтметки
	|		ИЛИ Т.ИдентификаторЗаписи = &Текущая И НЕ &ЕстьОтметки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата";
	Запрос.УстановитьПараметр("Автор", ПараметрыСеанса.ТекущийПользователь);
	Запрос.УстановитьПараметр("Текущая", ?(ИдентификаторТекущей = Неопределено, "", ИдентификаторТекущей));
	Запрос.УстановитьПараметр("ЕстьОтметки", Истина);
	Заказы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Заказ");
	Если Заказы.Количество() = 0 Тогда
		Запрос.УстановитьПараметр("ЕстьОтметки", Ложь);
		Заказы = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Заказ");
	КонецЕсли;
	Возврат Заказы;

КонецФункции

Функция СтрокиПечати(Заказы, Статусы)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	Т.ДокументЗаказПокупателя КАК Заказ,
	|	Т.Порядок КАК Порядок,
	|	Т.Номенклатура КАК Номенклатура,
	|	ЕСТЬNULL(Т.Номенклатура.Артикул, """") КАК Артикул,
	|	ЕСТЬNULL(Т.Номенклатура.ЕдиницаИзмерения, НЕОПРЕДЕЛЕНО) КАК Единица,
	|	Т.НоменклатураКлиента КАК НоменклатураКлиента,
	|	Т.АртикулКлиента КАК АртикулКлиента,
	|	Т.ЕдиницаИзмеренияКлиента КАК ЕдиницаКлиента,
	|	Т.Количество КАК Количество,
	|	Т.Цена КАК Цена,
	|	Т.Цена * Т.Количество КАК Сумма,
	|	Т.ЯчейкаСклада КАК ЯчейкаСклада,
	|	Т.Партия КАК Партия,
	|	Т.СтатусСтроки КАК Статус,
	|	Т.НомерОтгрузки КАК НомерОтгрузки,
	|	Т.ДатаОтгрузки КАК ДатаОтгрузки,
	|	Т.ДатаОтправкиНаСборку КАК ДатаОтправкиНаСборку,
	|	Т.НомерЗаказаКлиента КАК НомерЗаказаКлиента,
	|	Т.Покупатель КАК Покупатель,
	|	Т.Договор КАК Договор,
	|	Т.ГРЗКлиента КАК ГРЗ,
	|	Т.ТерриторияКлиента КАК Территория,
	|	Т.КомментарийКСтроке КАК Комментарий,
	|	Т.КомментарийКСтроке2 КАК Комментарий2
	|ИЗ
	|	РегистрСведений.Арм_ДанныеЗакупокИПродаж КАК Т
	|ГДЕ
	|	Т.ВидОперации = ЗНАЧЕНИЕ(Перечисление.Арм_ВидыОпераций.Продажа)
	|	И НЕ Т.Удаление
	|	И Т.ДокументЗаказПокупателя В (&Заказы)
	|	И Т.СтатусСтроки В (&Статусы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Т.Порядок";
	Запрос.УстановитьПараметр("Заказы", Заказы);
	Запрос.УстановитьПараметр("Статусы", Статусы);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Процедура ВывестиЗаказ(ТД, Вид, Описание, СтрокиЗаказа)

	Первая = СтрокиЗаказа[0];
	Заказ = Первая.Заказ;
	Ширины = ?(Вид = "СборочныйЛист", "5,12,16,42,8,9,22", "5,16,46,7,9,12,13");
	Колонок = СтрРазделить(Ширины, ",").Количество();
	Строка0 = ТД.ВысотаТаблицы + 1;
	Если Строка0 = 1 Тогда
		Номер = 1;
		Для Каждого Ширина Из СтрРазделить(Ширины, ",") Цикл
			ТД.Область(1, Номер, 1, Номер).ШиринаКолонки = Число(Ширина);
			Номер = Номер + 1;
		КонецЦикла;
	КонецЕсли;

	// шапка
	Р = Строка0;
	Заголовок = Описание.Заголовок;
	Если Вид <> "СборочныйЛист" И ЗначениеЗаполнено(Первая.НомерОтгрузки) Тогда
		Заголовок = Заголовок + " № " + СокрЛП(Первая.НомерОтгрузки)
			+ ?(ЗначениеЗаполнено(Первая.ДатаОтгрузки), " от " + Формат(Первая.ДатаОтгрузки, "ДЛФ=D"), "");
	КонецЕсли;
	Текст(ТД, Р, 1, Колонок, Заголовок, 14, Истина);
	Р = Р + 2;
	Организация = ?(ЗначениеЗаполнено(Заказ), Заказ.Организация, Неопределено);
	Реквизиты = Новый Массив;
	Если ЗначениеЗаполнено(Организация) Тогда
		Реквизиты.Добавить("Поставщик: " + Строка(Организация));
	КонецЕсли;
	Реквизиты.Добавить("Покупатель: " + Строка(Первая.Покупатель) + ?(ЗначениеЗаполнено(Первая.Договор), ", договор " + Строка(Первая.Договор), ""));
	Реквизиты.Добавить("Заказ покупателя: " + СокрЛП(Заказ.Номер) + " от " + Формат(Заказ.Дата, "ДЛФ=D")
		+ ?(ЗначениеЗаполнено(Первая.НомерЗаказаКлиента), ", заявка клиента № " + СокрЛП(Первая.НомерЗаказаКлиента), ""));
	Если ЗначениеЗаполнено(Первая.ГРЗ) Или ЗначениеЗаполнено(Первая.Территория) Тогда
		Реквизиты.Добавить("Машина (ГРЗ): " + СокрЛП(Первая.ГРЗ) + ?(ЗначениеЗаполнено(Первая.Территория), ", территория: " + СокрЛП(Первая.Территория), ""));
	КонецЕсли;
	Если Вид = "СборочныйЛист" Тогда
		Реквизиты.Добавить("Отправлено на сборку: " + ?(ЗначениеЗаполнено(Первая.ДатаОтправкиНаСборку),
			Формат(Первая.ДатаОтправкиНаСборку, "ДЛФ=D"), "—") + ";  напечатано " + Формат(ТекущаяДатаСеанса(), "ДЛФ=DT"));
	ИначеЕсли Вид = "Корректировка" Тогда
		Реквизиты.Добавить("Возврат от покупателя: позиции ниже исключаются из отгрузки"
			+ ?(ЗначениеЗаполнено(Первая.НомерОтгрузки), " № " + СокрЛП(Первая.НомерОтгрузки), "") + ".");
	КонецЕсли;
	Для Каждого Реквизит Из Реквизиты Цикл
		Текст(ТД, Р, 1, Колонок, Реквизит);
		Р = Р + 1;
	КонецЦикла;
	Р = Р + 1;

	// таблица
	Если Вид = "СборочныйЛист" Тогда
		Колонки = СтрРазделить("№|Ячейка|Артикул|Наименование|Кол-во|Собрано|Дефект / недостача", "|");
	Иначе
		Колонки = СтрРазделить("№|Артикул|Наименование|Ед.|Кол-во|Цена|Сумма", "|");
	КонецЕсли;
	Для Номер = 1 По Колонки.Количество() Цикл
		Ячейка(ТД, Р, Номер, Колонки[Номер - 1], Истина, ГоризонтальноеПоложение.Центр);
	КонецЦикла;
	Р = Р + 1;
	Итого = 0;
	КоличествоИтого = 0;
	НомерСтроки = 0;
	Для Каждого Стр Из СтрокиЗаказа Цикл
		НомерСтроки = НомерСтроки + 1;
		Наименование = ?(ЗначениеЗаполнено(Стр.Номенклатура), Строка(Стр.Номенклатура), Стр.НоменклатураКлиента);
		Артикул = ?(ЗначениеЗаполнено(Стр.Артикул), Стр.Артикул, Стр.АртикулКлиента);
		Если Вид = "СборочныйЛист" Тогда
			Значения = Новый Массив;
			Значения.Добавить(НомерСтроки);
			Значения.Добавить(Стр.ЯчейкаСклада);
			Значения.Добавить(Артикул);
			Значения.Добавить(Наименование + ?(ЗначениеЗаполнено(Стр.Партия), Символы.ПС + "партия: " + Строка(Стр.Партия), ""));
			Значения.Добавить(Стр.Количество);
			Значения.Добавить("☐");
			Значения.Добавить("");
		Иначе
			Единица = ?(ЗначениеЗаполнено(Стр.Единица), Строка(Стр.Единица), Стр.ЕдиницаКлиента);
			Значения = Новый Массив;
			Значения.Добавить(НомерСтроки);
			Значения.Добавить(Артикул);
			Значения.Добавить(Наименование);
			Значения.Добавить(Единица);
			Значения.Добавить(Стр.Количество);
			Значения.Добавить(Формат(Стр.Цена, "ЧДЦ=2"));
			Значения.Добавить(Формат(Стр.Сумма, "ЧДЦ=2"));
			Итого = Итого + Стр.Сумма;
		КонецЕсли;
		КоличествоИтого = КоличествоИтого + Стр.Количество;
		Для Номер = 1 По Значения.Количество() Цикл
			// числа, цена и сумма — вправо, «собрано» — по центру, текст — влево
			Если Вид = "СборочныйЛист" И Номер = 6 Тогда
				Положение = ГоризонтальноеПоложение.Центр;
			ИначеЕсли ТипЗнч(Значения[Номер - 1]) = Тип("Число") Или Вид <> "СборочныйЛист" И Номер >= 6 Тогда
				Положение = ГоризонтальноеПоложение.Право;
			Иначе
				Положение = ГоризонтальноеПоложение.Лево;
			КонецЕсли;
			Ячейка(ТД, Р, Номер, Значения[Номер - 1], Ложь, Положение);
		КонецЦикла;
		Р = Р + 1;
	КонецЦикла;
	ИтогоТекст = СтрШаблон("Позиций: %1, количество: %2", НомерСтроки, КоличествоИтого)
		+ ?(Описание.Цены, ", сумма: " + Формат(Итого, "ЧДЦ=2; ЧН=0,00"), "");
	Текст(ТД, Р, 1, Колонок, ИтогоТекст, , Истина);
	Р = Р + 2;

	// подписи
	Если Вид = "СборочныйЛист" Тогда
		Подписи = СтрРазделить("Собрал (кладовщик) ____________________ / ____________________|"
			+ "Проверил ____________________ / ____________________", "|");
	ИначеЕсли Вид = "Корректировка" Тогда
		Подписи = СтрРазделить("Возврат принял (кладовщик) ____________________ / ____________________|"
			+ "Сдал (покупатель) ____________________ / ____________________", "|");
	Иначе
		Подписи = СтрРазделить("Отпустил ____________________ / ____________________|"
			+ "Получил ____________________ / ____________________|"
			+ "Оригиналы документов получены: ☐   дата ____________", "|");
	КонецЕсли;
	Для Каждого Подпись Из Подписи Цикл
		Текст(ТД, Р, 1, Колонок, Подпись);
		Р = Р + 2;
	КонецЦикла;

КонецПроцедуры

Процедура Текст(ТД, Ряд, КолонкаС, КолонкаПо, Знач Значение, Знач Размер = 10, Знач Жирный = Ложь)

	Область = ТД.Область(Ряд, КолонкаС, Ряд, КолонкаПо);
	Область.Объединить();
	Область.Текст = Значение;
	Область.Шрифт = Новый Шрифт("Arial", Размер, Жирный);
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;

КонецПроцедуры

Процедура Ячейка(ТД, Ряд, Колонка, Знач Значение, Знач Жирный, Знач Положение)

	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	Область = ТД.Область(Ряд, Колонка, Ряд, Колонка);
	Область.Текст = ?(ТипЗнч(Значение) = Тип("Число"), Формат(Значение, "ЧГ=0"), Строка(Значение));
	Область.Шрифт = Новый Шрифт("Arial", 9, Жирный);
	Область.ГоризонтальноеПоложение = Положение;
	Область.ВертикальноеПоложение = ВертикальноеПоложение.Верх;
	Область.РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
	Область.Обвести(Линия, Линия, Линия, Линия);

КонецПроцедуры

#КонецОбласти
