// v2.23 (блок 2 плана): уведомления АРМ — регистр Арм_Уведомления, адресат — роль АРМ (Арм_РолиИнтерфейса).
// Создаются при записи регистра Арм_ДанныеЗакупокИПродаж (модуль набора записей) по смене статуса строки — так их
// дают все пути: форма АРМ, фоновые задания, команды АРМ_OData, прямые записи PWA через OData.
//   M8      закупка -> «На складе»                -> менеджер   «Приход на склад»
//   M11     продажа -> «Собран» / «Подготовлено»  -> менеджер   «Готово к отгрузке»
//   K9, M17 закупка -> «Отгружено» (самовывоз клиентом у поставщика, узел N4) -> кладовщик и менеджер «Самовывоз»
// Одно непрочитанное уведомление на узел, роль и заказ за день: новые строки дописываются в его текст.
// Прочитано — общее для роли (уведомление — задача роли: кто открыл, тот отметил).

#Область ПрограммныйИнтерфейс

// Статусы записей набора до записи, для ПослеЗаписиДанныхАРМ: Соответствие ИдентификаторЗаписи -> СтатусСтроки и
// «ключ связи|вид операции|статус» -> Истина (АРМ пересобирает строки по партиям с новыми ИД — это не смена статуса).
// Набор без отбора (запись всего регистра) — Неопределено: уведомления не создаются.
Функция СтатусыДоЗаписи(НаборЗаписей) Экспорт

	Прежний = РегистрыСведений.Арм_ДанныеЗакупокИПродаж.СоздатьНаборЗаписей();
	ЕстьОтбор = Ложь;
	Для Каждого ЭлементОтбора Из НаборЗаписей.Отбор Цикл
		Если ЭлементОтбора.Использование Тогда
			Прежний.Отбор[ЭлементОтбора.Имя].Установить(ЭлементОтбора.Значение);
			ЕстьОтбор = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьОтбор Тогда
		Возврат Неопределено;
	КонецЕсли;
	Прежний.Прочитать();
	Статусы = Новый Соответствие;
	Для Каждого Запись Из Прежний Цикл
		Статусы.Вставить(Запись.ИдентификаторЗаписи, Запись.СтатусСтроки);
		Статусы.Вставить(КлючСтатуса(Запись, Запись.СтатусСтроки), Истина);
	КонецЦикла;
	Возврат Статусы;

КонецФункции

// После записи набора регистра АРМ: уведомления по сменам статуса (правила — в заголовке модуля).
Процедура ПослеЗаписиДанныхАРМ(НаборЗаписей, СтатусыДо) Экспорт

	Если СтатусыДо = Неопределено Тогда
		Возврат;
	КонецЕсли;
	События = Новый Соответствие;   // "узел|роль|заказ" -> Структура
	Для Каждого Запись Из НаборЗаписей Цикл
		Если Запись.Удаление Тогда
			Продолжить;
		КонецЕсли;
		Было = СтатусыДо.Получить(Запись.ИдентификаторЗаписи);
		Стало = Запись.СтатусСтроки;
		Если Было = Стало Или Было = Неопределено И СтатусыДо.Получить(КлючСтатуса(Запись, Стало)) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Закупка = Запись.ВидОперации = Перечисления.Арм_ВидыОпераций.Закупка;
		Если Закупка И Стало = Перечисления.Арм_СтатусыАРМ.НаСкладе Тогда
			ДобавитьСобытие(События, "M8", "Приход на склад", Перечисления.Арм_РолиИнтерфейса.Менеджер, Запись);
		ИначеЕсли Закупка И Стало = Перечисления.Арм_СтатусыАРМ.Отгружено Тогда
			ДобавитьСобытие(События, "K9", "Самовывоз", Перечисления.Арм_РолиИнтерфейса.Кладовщик, Запись);
			ДобавитьСобытие(События, "M17", "Самовывоз", Перечисления.Арм_РолиИнтерфейса.Менеджер, Запись);
		ИначеЕсли Не Закупка И (Стало = Перечисления.Арм_СтатусыАРМ.Собран Или Стало = Перечисления.Арм_СтатусыАРМ.Подготовлено)
			И Было <> Перечисления.Арм_СтатусыАРМ.Собран И Было <> Перечисления.Арм_СтатусыАРМ.Подготовлено Тогда
			ДобавитьСобытие(События, "M11", "Готово к отгрузке", Перечисления.Арм_РолиИнтерфейса.Менеджер, Запись);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючИЗначение Из События Цикл
		Записать(КлючИЗначение.Значение);
	КонецЦикла;

КонецПроцедуры

// Уведомление от кода АРМ (неопознанная позиция, запрос прав и т. п. — блоки 4, 7 плана).
Процедура Создать(Знач Узел, Знач Вид, Знач РольПолучателя, Знач Текст, Знач Заказ = Неопределено) Экспорт

	Событие = Новый Структура("Узел, Вид, Роль, Заказ, Заголовок, Строки", Узел, Вид, РольПолучателя,
		?(Заказ = Неопределено, Документы.ЗаказПокупателя.ПустаяСсылка(), Заказ), "", Новый Массив);
	Событие.Строки.Добавить(Текст);
	Записать(Событие);

КонецПроцедуры

// Непрочитанные уведомления текущего пользователя (его роли АРМ; администратор — все): количество.
Функция КоличествоНепрочитанных() Экспорт

	Запрос = ЗапросНепрочитанных("ВЫБРАТЬ КОЛИЧЕСТВО(*) КАК Количество");
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.Количество, 0);

КонецФункции

// Непрочитанные уведомления текущего пользователя: Массив Структур Ид, Дата, Узел, Вид, Текст (новые первыми).
Функция Непрочитанные(Знач Максимум = 50) Экспорт

	Запрос = ЗапросНепрочитанных("ВЫБРАТЬ ПЕРВЫЕ " + Формат(Максимум, "ЧГ=0")
		+ " У.Ид КАК Ид, У.Дата КАК Дата, У.Узел КАК Узел, У.Вид КАК Вид, У.Текст КАК Текст");
	Запрос.Текст = Запрос.Текст + " УПОРЯДОЧИТЬ ПО У.Дата УБЫВ";
	Результат = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Элемент = Новый Структура("Ид, Дата, Узел, Вид, Текст");
		ЗаполнитьЗначенияСвойств(Элемент, Выборка);
		Результат.Добавить(Элемент);
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Отметить прочитанными (Массив Ид; Неопределено — все непрочитанные текущего пользователя). Возврат: сколько отмечено.
Функция ОтметитьПрочитанными(Знач Идентификаторы = Неопределено) Экспорт

	Если Идентификаторы = Неопределено Тогда
		Идентификаторы = Новый Массив;
		Для Каждого Элемент Из Непрочитанные(1000) Цикл
			Идентификаторы.Добавить(Элемент.Ид);
		КонецЦикла;
	КонецЕсли;
	Отмечено = 0;
	Для Каждого Ид Из Идентификаторы Цикл
		Набор = РегистрыСведений.Арм_Уведомления.СоздатьНаборЗаписей();
		Набор.Отбор.Ид.Установить(Ид);
		Набор.Прочитать();
		Для Каждого Запись Из Набор Цикл
			Если Не Запись.Прочитано Тогда
				Запись.Прочитано = Истина;
				Запись.Прочитал = ПараметрыСеанса.ТекущийПользователь;
				Запись.ДатаПрочтения = ТекущаяДатаСеанса();
				Отмечено = Отмечено + 1;
			КонецЕсли;
		КонецЦикла;
		Набор.Записать();
	КонецЦикла;
	Возврат Отмечено;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьСобытие(События, Узел, Вид, Роль, Запись)

	Ключ = Узел + "|" + Строка(Роль) + "|" + Строка(Запись.ДокументЗаказПокупателя.УникальныйИдентификатор());
	Событие = События.Получить(Ключ);
	Если Событие = Неопределено Тогда
		Заголовок = "";
		Если ЗначениеЗаполнено(Запись.ДокументЗаказПокупателя) Тогда
			Заголовок = "Заказ " + СокрЛП(Запись.ДокументЗаказПокупателя.Номер)
				+ ?(ЗначениеЗаполнено(Запись.НомерЗаказаКлиента), " (клиент № " + СокрЛП(Запись.НомерЗаказаКлиента) + ")", "")
				+ ?(ЗначениеЗаполнено(Запись.Покупатель), ", " + Строка(Запись.Покупатель), "") + ": ";
		КонецЕсли;
		Событие = Новый Структура("Узел, Вид, Роль, Заказ, Заголовок, Строки", Узел, Вид, Роль,
			Запись.ДокументЗаказПокупателя, Заголовок, Новый Массив);
		События.Вставить(Ключ, Событие);
	КонецЕсли;
	Наименование = ?(ЗначениеЗаполнено(Запись.Номенклатура), Строка(Запись.Номенклатура), Запись.НоменклатураКлиента);
	СтрокаТекста = СтрШаблон("%1 — %2", Наименование, Запись.Количество);
	Если Событие.Строки.Найти(СтрокаТекста) = Неопределено Тогда
		Событие.Строки.Добавить(СтрокаТекста);
	КонецЕсли;

КонецПроцедуры

// Запись уведомления; непрочитанное того же узла, роли и заказа за сегодня дополняется строками.
Процедура Записать(Событие)

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	У.Ид КАК Ид
	|ИЗ
	|	РегистрСведений.Арм_Уведомления КАК У
	|ГДЕ
	|	НЕ У.Прочитано
	|	И У.Узел = &Узел
	|	И У.РольПолучателя = &Роль
	|	И У.ДокументЗаказПокупателя = &Заказ
	|	И У.Дата >= &НачалоДня
	|	И &ЕстьЗаказ";
	Запрос.УстановитьПараметр("Узел", Событие.Узел);
	Запрос.УстановитьПараметр("Роль", Событие.Роль);
	Запрос.УстановитьПараметр("Заказ", Событие.Заказ);
	Запрос.УстановитьПараметр("ЕстьЗаказ", ЗначениеЗаполнено(Событие.Заказ));
	Запрос.УстановитьПараметр("НачалоДня", НачалоДня(ТекущаяДатаСеанса()));
	Выборка = Запрос.Выполнить().Выбрать();

	Набор = РегистрыСведений.Арм_Уведомления.СоздатьНаборЗаписей();
	Если Выборка.Следующий() Тогда
		Набор.Отбор.Ид.Установить(Выборка.Ид);
		Набор.Прочитать();
		Запись = Набор[0];
		Текст = Запись.Текст;
		Для Каждого СтрокаТекста Из Событие.Строки Цикл
			Если СтрНайти(Текст, СтрокаТекста) = 0 Тогда
				Текст = Текст + "; " + СтрокаТекста;
			КонецЕсли;
		КонецЦикла;
		Запись.Текст = Лев(Текст, 1000);
		Запись.Дата = ТекущаяДатаСеанса();
	Иначе
		Ид = Строка(Новый УникальныйИдентификатор);
		Набор.Отбор.Ид.Установить(Ид);
		Запись = Набор.Добавить();
		Запись.Ид = Ид;
		Запись.Дата = ТекущаяДатаСеанса();
		Запись.Узел = Событие.Узел;
		Запись.Вид = Событие.Вид;
		Запись.РольПолучателя = Событие.Роль;
		Запись.ДокументЗаказПокупателя = Событие.Заказ;
		Запись.Автор = ПараметрыСеанса.ТекущийПользователь;
		Запись.Текст = Лев(Событие.Заголовок + СтрСоединить(Событие.Строки, "; "), 1000);
	КонецЕсли;
	Набор.Записать();

КонецПроцедуры

Функция КлючСтатуса(Запись, Статус)
	Возврат Запись.КлючСвязиСтрок + "|" + Строка(Запись.ВидОперации) + "|" + Строка(Статус);
КонецФункции

Функция ЗапросНепрочитанных(Знач Выбор)

	Роль = РегистрыСведений.Арм_ПраваПользователей.ПолучитьРольИнтерфейсаСтрого(ПараметрыСеанса.ТекущийПользователь);
	Запрос = Новый Запрос;
	Запрос.Текст = Выбор + "
	|ИЗ
	|	РегистрСведений.Арм_Уведомления КАК У
	|ГДЕ
	|	НЕ У.Прочитано
	|	И (У.РольПолучателя В (&Роли) ИЛИ &ВсеРоли)";
	Роли = Новый Массив;
	Роли.Добавить(Роль);
	// D1d: «Снабжение» работает как кладовщик — видит его уведомления, и наоборот
	Если Роль = Перечисления.Арм_РолиИнтерфейса.Снабжение Тогда
		Роли.Добавить(Перечисления.Арм_РолиИнтерфейса.Кладовщик);
	ИначеЕсли Роль = Перечисления.Арм_РолиИнтерфейса.Кладовщик Тогда
		Роли.Добавить(Перечисления.Арм_РолиИнтерфейса.Снабжение);
	КонецЕсли;
	Запрос.УстановитьПараметр("Роли", Роли);
	Запрос.УстановитьПараметр("ВсеРоли", Роль = Перечисления.Арм_РолиИнтерфейса.Администратор);
	Возврат Запрос;

КонецФункции

#КонецОбласти
