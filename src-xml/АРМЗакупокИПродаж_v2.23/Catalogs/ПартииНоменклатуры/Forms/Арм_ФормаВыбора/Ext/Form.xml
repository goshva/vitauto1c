				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>
ВЫБРАТЬ
	СпрПартии.Ссылка КАК Партия,
	СпрПартии.ВладелецПартии КАК Поставщик,
	ЕСТЬNULL(ЗапасыОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(БроньАРМ.Занято, 0) КАК Количество,
	ВЫБОР 
		КОГДА ЕСТЬNULL(ЗапасыОстатки.КоличествоОстаток, 0) &lt;&gt; 0 
		ТОГДА ЕСТЬNULL(ЗапасыОстатки.СуммаОстаток, 0) / ЗапасыОстатки.КоличествоОстаток 
		ИНАЧЕ 0 
	КОНЕЦ КАК Цена
ИЗ
	Справочник.ПартииНоменклатуры КАК СпрПартии
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.Запасы.Остатки(, Номенклатура = &amp;Номенклатура) КАК ЗапасыОстатки
		ПО СпрПартии.Ссылка = ЗапасыОстатки.Партия
		ЛЕВОЕ СОЕДИНЕНИЕ (
			ВЫБРАТЬ 
				Партия, СУММА(Количество) КАК Занято 
			ИЗ РегистрСведений.Арм_ДанныеЗакупокИПродаж 
			ГДЕ Номенклатура = &amp;Номенклатура И РучнаяПравкаПартии = ИСТИНА
			СГРУППИРОВАТЬ ПО Партия
		) КАК БроньАРМ
		ПО СпрПартии.Ссылка = БроньАРМ.Партия
ГДЕ
	СпрПартии.Владелец = &amp;Номенклатура
	И (ЕСТЬNULL(ЗапасыОстатки.КоличествоОстаток, 0) - ЕСТЬNULL(БроньАРМ.Занято, 0)) &gt; 0</QueryText>
